        "content": {
            "optimal_code": "{% test is_even(model, column_name) %}\n\nwith validation as (\n  select\n    {{ column_name }} as even_field\n  from {{ model }}\n),\n\nvalidation_errors as (\n  select\n    even_field\n  from validation\n  -- if this is true, then even_field is actually odd!\n  where (even_field % 2) = 1\n)\n\nselect *\nfrom validation_errors\n\n{% endtest %}\n"
        },
