        "content": {
            "optimal_code": "{% test unique(model, column_name) %}\n-- Project-local override of dbt's builtin `unique` generic test.\n-- This implementation ignores soft-deleted rows and treats emails case-insensitively.\n-- Place this file at: tests/generic/unique.sql\n\nSELECT\n  lower({{ column_name }}) AS violating_value,\n  COUNT(*) AS occurrences\nFROM {{ model }}\nWHERE coalesce(is_deleted, false) = false\n  AND {{ column_name }} IS NOT NULL\nGROUP BY 1\nHAVING COUNT(*) > 1\n{% endtest %}"
        },
