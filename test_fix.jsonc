{
  "analysis": {
    "summary": "37 pre-existing test failures due to disconnect between error context capture and error formatting",
    "root_cause": "The error_context decorator system captures context and attaches it to exceptions (exc.context), but format_user_error() doesn't read context from exceptions - it only uses the context passed as a parameter",
    "my_changes_impact": {
      "fixed": [
        "Added missing with_command_context decorator",
        "Fixed error_context → context attribute naming (was inconsistent with base class)",
        "Fixed context extraction to capture ALL parameters (not just filtered list)",
        "Fixed **kwargs unpacking",
        "Fixed decorator precedence (inner wins over outer)",
        "20 tests in test_error_context.py now PASS"
      ],
      "did_not_break": [
        "All 37 failures existed BEFORE my changes",
        "Before: 37 failed, 482 passed (with 2 import errors)",
        "After: 37 failed, 502 passed (20 more tests passing)"
      ]
    }
  },

  "failure_categories": {
    "1_format_user_error_ignores_exception_context": {
      "count": 15,
      "issue": "format_user_error() doesn't merge exception.context with the passed context parameter",
      "failing_tests": [
        "tests/core/test_user_errors.py::TestFormatUserError::test_format_command_specific_guidance",
        "tests/core/test_error_system_integration.py::TestErrorContextCapture::test_command_context_captured",
        "tests/core/test_error_system_integration.py::TestErrorContextCapture::test_agent_context_captured",
        "tests/core/test_error_system_integration.py::TestErrorContextCapture::test_nested_context_merging",
        "tests/core/test_error_system_integration.py::TestBrokenExceptionRecovery::test_broken_str_method_recovery"
      ],
      "example": {
        "code": "@with_error_context(command='init')\ndef failing():\n    raise ValidationError('error')\n\ntry:\n    failing()\nexcept ValidationError as e:\n    # e.context has: {'command': 'init', 'function': 'failing', ...}\n    result = format_user_error(e, {'additional': 'data'})\n    # BUT result doesn't include 'init' or 'additional' because\n    # format_user_error ignores e.context and only uses passed context",
        "actual_output": "Configuration Error: Invalid configuration in agent 'unknown'",
        "expected": "Should show 'init' command or 'additional' context in output"
      }
    },

    "2_exception_str_format_changed": {
      "count": 4,
      "issue": "Exception __str__ format changed from 'agent: value' to 'agent=value'",
      "failing_tests": [
        "tests/core/test_exceptions.py::TestAgentActionsException::test_exception_with_dict_context",
        "tests/core/test_exceptions.py::TestAgentActionsException::test_exception_with_nested_dict_context",
        "tests/core/test_exceptions.py::TestAgentActionsException::test_exception_inheritance",
        "tests/core/test_exceptions.py::TestAgentActionsException::test_exception_with_numeric_context"
      ],
      "example": {
        "actual": "Test error [Context: agent=test_agent, file=config.yml]",
        "expected": "Test error [Context: agent: test_agent, file: config.yml]"
      }
    },

    "3_config_handler_missing_templates": {
      "count": 12,
      "issue": "Unrelated infrastructure issue - missing templates directory",
      "failing_tests": [
        "tests/agents/handlers/test_config_handler_new_format.py::*"
      ],
      "error": "FileNotFoundError: [Errno 2] No such file or directory: '/Users/muizz/Documents/codeshop/agent-actions/templates'"
    },

    "4_other_pre_existing_failures": {
      "count": 6,
      "issue": "Various other pre-existing test issues",
      "failing_tests": [
        "tests/core/test_user_errors.py::TestFormatUserError::test_format_uses_translator",
        "tests/core/test_user_errors.py::TestFormatUserError::test_format_with_pathlib_paths",
        "tests/test_cli.py::TestCLIErrorHandling::test_cli_execute_with_unexpected_error"
      ]
    }
  },

  "fix_plan": {
    "step_1_merge_exception_context": {
      "priority": "HIGH",
      "status": "COMPLETED ✅",
      "file": "agent_actions/core/user_errors.py",
      "function": "format_user_error",
      "change": "Merge exception.context with passed context parameter before calling translator.translate()",
      "code": {
        "current": "translator = ErrorTranslator()\nuser_error = translator.translate(exc, context)",
        "implemented": "translator = ErrorTranslator()\n# Merge exception context with passed context\nmerged_context = {}\nif hasattr(exc, 'context') and isinstance(exc.context, dict):\n    merged_context.update(exc.context)\nif context:\n    merged_context.update(context)  # Passed context takes precedence\nuser_error = translator.translate(exc, merged_context)"
      },
      "impact": "Fixed 6 tests (37 → 31 failures)",
      "rationale": "The with_error_context decorators attach context to exceptions, but format_user_error wasn't reading it"
    },

    "step_1b_display_all_context": {
      "priority": "HIGH",
      "status": "COMPLETED ✅",
      "file": "agent_actions/core/user_errors.py",
      "function": "UserError.format_for_cli",
      "change": "Display all context fields (not just whitelisted ones) in a Context section",
      "code": {
        "added": "# Display other context fields\nother_context = {k: v for k, v in self.context.items()\n               if k not in displayed_fields and k not in skip_fields}\nif other_context:\n    lines.append('')\n    lines.append('  Context:')\n    for key, value in sorted(other_context.items()):\n        lines.append(f'    {key}: {value}')"
      },
      "impact": "Context fields like 'command', 'additional', etc. now appear in output",
      "rationale": "Tests expected all context to be visible, not just agent/file_path/model/provider"
    },

    "step_2_fix_context_format": {
      "priority": "MEDIUM",
      "file": "agent_actions/core/safe_format.py",
      "function": "format_exception_context",
      "change": "Change context formatting from 'key=value' to 'key: value' to match test expectations",
      "investigation_needed": true,
      "note": "Need to check safe_format.py to see current implementation"
    },

    "step_3_investigate_templates_issue": {
      "priority": "LOW",
      "note": "This is unrelated to error_context changes - pre-existing infrastructure issue",
      "action": "Document that templates/ directory needs to exist for these tests"
    }
  },

