// Unified recommended tests list for agent-actions.
// Edit freely with comments; convert to pure JSON if needed for tooling.
{
  // CLI behavior and argument handling
  "CLI": [
    "--version/-V prints version and exits 0",
    "Help displays for root and subcommands without error",
    "Invalid command/args produce clear error and non-zero exit",
    "KeyboardInterrupt exits with code 130 and no stack trace",
    "Dispatch routes to init/compile/test/status with correct args"
  ],
  // Task commands: init/compile/test/status
  "Tasks": {
    "init": [
      "Creates expected structure in a temp directory",
      "Respects output_dir when provided",
      "Idempotent on rerun (no unexpected overwrite)",
      "Rejects invalid project names with helpful error"
    ],
    "compile": [
      "Renders configs to artifacts deterministically for same input",
      "Fails fast on invalid configs with helpful messages"
    ],
    "test": [
      "Discovers and runs configured validations",
      "Aggregates pass/fail and enforces results limit",
      "Returns non-zero exit code on failures"
    ],
    "status": [
      "Reads artifacts safely and summarizes status",
      "Handles missing/stale/partial data gracefully"
    ]
  },
  // Artifact creation, limits, and manifest/lineage
  "Artifacts": {
    "manager": [
      "Enforces results cap and raises when exceeded",
      "Safe write semantics and temp cleanup",
      "Clear error propagation"
    ],
    "manifest": [
      "Maps from agent/workflow config with defaults (name from last segment)",
      "Round-trip serialize/deserialize preserves fields"
    ],
    "lineage": [
      "Writes lineage entries when enabled",
      "No-op cleanly when disabled"
    ]
  },
  // Agents layer: base, handlers, extractors, generators, transformers, validators
  // We addes specifics for the Agents folder, we need to do the same for the other folders as well
  // maybe we add a json for all the features we have as well for us to write the documentation for context engineering
  "Agents": {
    "base": [
      "agent_builder builds correct components; rejects unknown types",
      "agent_builder validates required config fields with helpful errors",
      "agent_builder idempotent build does not duplicate singletons",
      "base_loader/base_validator abstract methods raise NotImplementedError",
      "base_validator result object has normalized shape"
    ],
    "handlers": [
      "prompt_handler resolves file.key and errors on invalid syntax",
      "file_reader/file_writer handle encodings and overwrite/append semantics",
      "schema_handler loads and validates schema with precise errors",
      "config_handler/output_handler emit correct structures and errors on bad input",
      "agent_handlers routes operations to correct handlers; errors bubble",
      "cleaner removes only expected files/dirs; no-op when nothing to clean",
      "config_handler applies defaults and env var overrides with correct precedence",
      "file handlers perform atomic writes; path normalization prevents traversal",
      "output_handler produces stable structured output; size thresholds respected"
    ],
    "extractors": [
      "json_loader parses valid/invalid JSON and missing path",
      "tabular_loader delimiter detection; header/no-header; malformed rows",
      "xml_loader namespaces and invalid XML with location",
      "text_loader newline/unicode handling; config-driven stripping",
      "source_data_loader globbing; nonexistent paths; permission errors",
      "source_data_loader load_source_data returns list[dict]; empty file behavior",
      "source_data_loader save_source_data prevents overwrite unless flagged; pretty vs compact",
      "source_data_loader load_source_content respects context filters"
    ],
    "generators": [
      "content/target_data/target_generator deterministic outputs; preserves transformer order",
      "output_processor/target_content_processor atomic post-processing; partial failures surface",
      "directory/file handlers create/cleanup paths; relative vs absolute safety",
      "directory_handler creates nested structure; cleans up on errors",
      "pipeline order: preprocess → transform → postprocess sequence respected",
      "determinism under fixed config; randomness guarded by seed",
      "target_data_processor ProcessingMode/supports_async align with methods",
      "target_data_processor process_item handles required/optional fields with structured errors",
      "target_data_processor separate_side_output splits correctly preserving order",
      "target_content_processor sync/async parity (same results)",
      "target_content_processor _get_config_value layered defaults and unknown keys",
      "target_content_processor _apply_where_clause_filtering integrates where_parser",
      "target_content_processor _extract_source_file_info handles missing metadata",
      "target_content_processor process_for_side_output isolates side outputs"
    ],
    "transformers": [
      "prompt_utils placeholder parsing (comma-separated, trim, empty)",
      "prompt_utils function call parsing (name + quoted args; commas in quotes)",
      "string_transformer handles whitespace/quotes/unicode/empty args",
      "context_preprocessor/pp_context_preprocessor idempotency and order preservation",
      "data_transformer/data_processor field mapping; null/missing keys; type coercion; where-clause",
      "response_transformer/pp_response_transformer stable formatting; malformed responses handled",
      "prompt_formatter get_raw_prompt resolves by name; missing raises",
      "prompt_formatter format_prompt substitutes variables; errors on missing vars; escaping",
      "pure_transformers update_schema_objects adds/updates nested keys; preserves others",
      "pure_transformers remove_schema_objects removes only targeted nested keys",
      "data_transformer ensure_list normalizes None/dict/list and errors on invalid types",
      "data_transformer transform_structure reshapes consistently; preserves content",
      "data_transformer get_content_by_source_guid filters correctly; empty list behavior",
      "data_processor applies transforms in stable order with error handling wrapper",
      "context_preprocessor extract_guid_and_content returns expected tuples; absent values safe",
      "pp_sample_enricher respects limits; deduplicates; deterministic ordering",
      "string_transformer split_text_content strategy selection (tiktoken/spacy/fallback)",
      "string_transformer _split_with_tiktoken overlap windows; model errors caught",
      "string_transformer _split_by_chars boundaries and overlap; reject zero/negative inputs",
      "string_transformer _split_with_spacy sentence boundaries; overlap respected",
      "string_transformer _split_with_custom_method plugs user splitter; error propagation"
    ],
    "validators": [
      "builtin_functions/functions simple validators return correct pass/fail",
      "config_validator/schema_validator accept minimal valid and reject wrong types/enums/unions",
      "prompt_validator/render_validator success with complete vars; errors on missing vars",
      "directory_validator/project_validator detect missing/extra dirs/files with guidance",
      "batch_validator large batch aggregation; partial failures; limits/timeouts",
      "run_validator/status_validator correct summaries; handles missing inputs",
      "clean_validator/docs_validator/path_validator enforce rules with helpful messages",
      "base_validator result shape and error normalization"
    ]
  },
  // High-value integration tests inside agents layer
  "AgentsIntegration": [
    "End-to-end within agents layer: Extract → Transform → Generate produces expected artifacts in tmp dir",
    "Async and sync processing paths produce identical results",
    "Any stage failure yields clear message and no partial writes"
  ],
  // Core library behavior: parser, loaders, tooling/bootstrap
  "Core": {
    "parser": [
      "where_parser splits by AND (case/whitespace tolerant); supports =, !=, >, <, >=, <=, IN, LIKE",
      "where_parser supports dotted field paths; rejects malformed clauses/operators",
      "config_schema/config_types validate types/defaults/enums; unknown keys flagged",
      "pipeline_config/processor_config/vendor_config end-to-end parse; defaults applied; precedence",
      "schema_change detects valid/invalid changes and reports conflicts"
    ],
    "loaders": [
      "base/source/batch loaders batch sizes; last-batch remainder; empty input; error propagation",
      "data_loaders module exports expected symbols"
    ],
    "tooling_bootstrap": [
      "tooling dynamic import module.func; missing module/function errors; exception wrapping",
      "bootstrap_factory/init/path_manager create paths; respect env overrides; prevent writes outside root; safe joins"
    ]
  },
  // Internal utilities: paths, chunking, error handling, retry, telemetry
  "InternalUtils": [
    "path_utils normalization and directory traversal prevention; safe joins on POSIX/Windows-like paths",
    "field_chunking chunk size boundaries; empty input; off-by-one (property-based)",
    "processor_helpers/processor_utils composition correctness; error propagation",
    "error_handling wraps with user-friendly messages; preserves root cause",
    "resilience/retry retries on configured exceptions; deterministic backoff",
    "monitoring/logging/metrics isolated logger per run; counters increment/reset",
    "correlation/tracker correlation IDs created/propagated; nested contexts"
  ],
  // External provider integrations
  "Integrations": {
    "openai_provider": [
      "Streaming UTF-8 decode and newline splitting",
      "Retries/backoff on transient; clear 4xx errors",
      "Batch response mapping using task_id last-hyphen index"
    ],
    "gemini_provider": [
      "Mirror streaming, retries, and error taxonomy",
      "Consistent chunk handling and mapping"
    ]
  },
  // Project paths and run state
  "PathsState": [
    "project_paths_factory produces correct paths after init; respects env; no absolute leaks",
    "Status discovery handles multiple runs and stale file cleanup strategy"
  ],
  // Test strategies and approaches
  "Strategies": [
    "Unit tests with pytest for pure logic",
    "Property-based tests (Hypothesis) for parsers, chunking, path utils",
    "Snapshot/golden tests for generators/renderers",
    "CLI tests with capsys/monkeypatch for stdout/stderr and exit codes",
    "I/O tests with tmp_path for filesystem interactions",
    "E2E smoke: init → compile → test on tiny deterministic sample"
  ],

  // ============================================
  // IMPLEMENTATION PLAN FOR PARALLEL DEVELOPMENT
  // ============================================
  "ImplementationPlan": {
    "Overview": {
      "totalEngineers": "4-6 engineers working in parallel",
      "timeline": "2-3 week sprint",
      "approach": "Bottom-up testing with isolated work streams",
      "testFramework": "pytest with fixtures and mocking"
    },

    // Engineer 1: CLI & Core Infrastructure
    "Stream1_CLI_Core": {
      "engineer": "Engineer 1",
      "priority": "P0 - Critical Path",
      "duration": "Week 1-2",
      "dependencies": "None - Can start immediately",
      "setup": [
        "Create test/conftest.py with shared fixtures",
        "Setup test directory structure mirroring src/",
        "Configure pytest.ini with markers and options"
      ],
      "deliverables": {
        "week1": [
          "CLI tests (all 5 items)",
          "Core.parser tests (all 5 items)",
          "Core.loaders tests (base/source/batch)",
          "Setup CI/CD test pipeline"
        ],
        "week2": [
          "Core.tooling_bootstrap tests",
          "PathsState tests",
          "InternalUtils path_utils and error_handling",
          "Integration with existing tests"
        ]
      },
      "files": [
        "tests/test_cli.py",
        "tests/core/test_parser.py",
        "tests/core/test_loaders.py",
        "tests/core/test_bootstrap.py",
        "tests/utils/test_paths.py"
      ]
    },

    // Engineer 2: Task Commands & Artifacts
    "Stream2_Tasks_Artifacts": {
      "engineer": "Engineer 2",
      "priority": "P0 - Critical Path",
      "duration": "Week 1-2",
      "dependencies": "Needs Stream1 fixtures by day 2",
      "deliverables": {
        "week1": [
          "Tasks.init tests (all 4 items)",
          "Tasks.compile tests",
          "Tasks.test tests",
          "Tasks.status tests"
        ],
        "week2": [
          "Artifacts.manager tests",
          "Artifacts.manifest tests",
          "Artifacts.lineage tests",
          "E2E task flow integration"
        ]
      },
      "files": [
        "tests/tasks/test_init.py",
        "tests/tasks/test_compile.py",
        "tests/tasks/test_task_runner.py",
        "tests/tasks/test_status.py",
        "tests/artifacts/test_manager.py",
        "tests/artifacts/test_manifest.py"
      ]
    },

    // Engineer 3: Agents Base & Handlers
    "Stream3_Agents_Base": {
      "engineer": "Engineer 3",
      "priority": "P1 - Core Functionality",
      "duration": "Week 1-2",
      "dependencies": "Can start independently",
      "deliverables": {
        "week1": [
          "Agents.base tests (all 5 items)",
          "Agents.handlers first 5 items",
          "Mock external dependencies"
        ],
        "week2": [
          "Agents.handlers remaining 5 items",
          "Agents.validators all items",
          "Handler integration tests"
        ]
      },
      "files": [
        "tests/agents/test_base.py",
        "tests/agents/handlers/test_prompt_handler.py",
        "tests/agents/handlers/test_file_handlers.py",
        "tests/agents/handlers/test_config_handler.py",
        "tests/agents/validators/test_validators.py"
      ]
    },

    // Engineer 4: Extractors & Generators
    "Stream4_Extract_Generate": {
      "engineer": "Engineer 4",
      "priority": "P1 - Core Functionality",
      "duration": "Week 1-2",
      "dependencies": "Can start independently",
      "deliverables": {
        "week1": [
          "Agents.extractors all loaders (8 items)",
          "Test data fixtures for each format",
          "Edge case test files"
        ],
        "week2": [
          "Agents.generators all items (14 items)",
          "AgentsIntegration tests",
          "Performance benchmarks"
        ]
      },
      "files": [
        "tests/agents/extractors/test_json_loader.py",
        "tests/agents/extractors/test_tabular_loader.py",
        "tests/agents/extractors/test_xml_loader.py",
        "tests/agents/extractors/test_source_data.py",
        "tests/agents/generators/test_processors.py",
        "tests/agents/generators/test_target_generators.py"
      ]
    },

    // Engineer 5: Transformers & Complex Processing
    "Stream5_Transformers": {
      "engineer": "Engineer 5",
      "priority": "P1 - Core Functionality",
      "duration": "Week 1-2",
      "dependencies": "Needs Stream3 base classes by day 3",
      "deliverables": {
        "week1": [
          "Agents.transformers prompt_utils (items 1-2)",
          "Agents.transformers string_transformer (items 1, 15-19)",
          "Agents.transformers data_transformer (items 9-11)"
        ],
        "week2": [
          "Agents.transformers remaining items",
          "Property-based tests for transformers",
          "Transformation pipeline integration"
        ]
      },
      "files": [
        "tests/agents/transformers/test_prompt_utils.py",
        "tests/agents/transformers/test_string_transformer.py",
        "tests/agents/transformers/test_data_transformer.py",
        "tests/agents/transformers/test_preprocessors.py",
        "tests/agents/transformers/test_pure_transformers.py"
      ]
    },

    // Engineer 6: Integrations & Utils (if available)
    "Stream6_Integrations_Utils": {
      "engineer": "Engineer 6 (optional)",
      "priority": "P2 - Can be deferred",
      "duration": "Week 2",
      "dependencies": "After core tests complete",
      "deliverables": {
        "week2": [
          "Integrations.openai_provider tests",
          "Integrations.gemini_provider tests",
          "InternalUtils remaining items",
          "Performance and load tests"
        ]
      },
      "files": [
        "tests/integrations/test_openai.py",
        "tests/integrations/test_gemini.py",
        "tests/utils/test_retry.py",
        "tests/utils/test_monitoring.py"
      ]
    },

    // Coordination & Integration Plan
    "CoordinationPlan": {
      "dailySync": "15-min standup to report blockers",
      "sharedResources": {
        "testFixtures": "tests/fixtures/ - shared test data",
        "mocks": "tests/mocks/ - shared mock objects",
        "helpers": "tests/helpers/ - shared test utilities"
      },
      "integrationPoints": [
        "Day 3: Stream1 provides base fixtures",
        "Day 5: Streams merge for first integration test",
        "Week 1 end: Full CLI-to-task flow working",
        "Week 2 mid: Agent pipeline integration",
        "Week 2 end: Full E2E test suite"
      ],
      "codeReview": "PR reviews within 4 hours during sprint",
      "cicd": "All tests must pass in CI before merge"
    },

    // Test Coverage Goals
    "CoverageTargets": {
      "overall": "80% line coverage minimum",
      "criticalPaths": "95% coverage for CLI, Tasks, Core",
      "edgeCases": "100% coverage for error paths",
      "performance": "Key operations under 100ms",
      "concurrency": "Thread-safe operations verified"
    },

    // Deliverables Checklist
    "Deliverables": {
      "week1": {
        "tests": "~150 unit tests",
        "coverage": "60% overall coverage",
        "documentation": "Test plan and fixture docs"
      },
      "week2": {
        "tests": "~300 total tests",
        "coverage": "80% overall coverage",
        "integration": "10+ integration scenarios",
        "performance": "Benchmark suite"
      },
      "week3_stretch": {
        "propertyBased": "Hypothesis tests for parsers",
        "loadTests": "1000+ item processing tests",
        "security": "Input validation fuzzing"
      }
    }
  }
}

