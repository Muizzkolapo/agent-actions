  "implementation": {
    "approach": "Lineage-based matching using prefix comparison",
    "algorithm": "record_lineage == caller_lineage[:len(record_lineage)]",
    "backwardCompatibility": "When caller_lineage is None, use legacy matching (source_guid + node_id only)",
    "performance": "O(n) where n = length of lineage array (typically < 30 nodes)",
    "edgeCases": [
      "No lineage provided → fallback to legacy behavior",
      "Record lineage longer than caller → return None",
      "Single record matching → works with or without lineage",
      "Multiple splits at same level → lineages still unique"
    ]
  },

