{
  "taskId": "fix-lineage-based-historical-lookup",
  "title": "Fix Historical Loader to Use Lineage-Based Matching for Split Records",
  "description": "Fix the bug where historical node loader returns wrong data for split records (e.g., when node_5 splits 1 record into 3, all descendants get data from the first split record instead of their correct parent). Implement lineage-based matching to uniquely identify records.",
  "branch": "fix/lineage-based-historical-lookup",
  "relatedIssues": [
    "#529 - File-granularity tools invisible in lineage tracking"
  ],
  "bugReport": {
    "summary": "Context scope passthrough returns wrong data for split records",
    "example": "In qanalabs_quiz_gen workflow, node_5 (flatten_clusters) splits 1 record into 3. Node_23 tries to retrieve flatten_clusters.url_list via passthrough, but all 3 records get url_list from the first split record instead of their correct parent.",
    "rootCause": "HistoricalNodeDataLoader._find_record_by_identifiers() matches on (source_guid, node_id) only. After a split, all records share the same source_guid and node_id, so it returns the first match.",
    "sampleData": "/Users/muizz/Documents/codeshop/agent-actions/sample/qanalabs_quiz_gen"
  },

  "tasks": [
    // ========================================================================
    // PHASE 1: TEST INFRASTRUCTURE
    // ========================================================================
