{
  // ========================================
  // CODING ASSISTANT INFORMATION & CONTEXT
  // ========================================
  // For future AI assistants working on this documentation project:
  //
  // KEY CONTEXT:
  // - Agent Actions is positioned as platform infrastructure (NOT single-use tool)
  // - Documentation uses "dbt-style" approach: schema-first, component reusability, best practices
  // - Avoid analogies like "Airflow for AI" or "dbt for AI" - let product stand on own merits
  //
  // CONFIDENTIALITY CONSTRAINTS:
  // - NEVER mention "QANALabs" or any specific customer names
  // - Use generic terms: "enterprise customer", "production example", "real-world implementation"
  // - All examples derived from enterprise_structure_reference.md (anonymized)
  //
  // CURRENT STRUCTURE PHILOSOPHY:
  // - Keep user-friendly structure vs over-engineering
  // - Current docs/ organization is COMPLETE and working
  // - Only add complexity when content volume justifies it
  // - Platform positioning successfully achieved in docs/platform/
  //
  // POSITIONING PRINCIPLES:
  // - Multi-agent coordination pain point → Agent Actions solution
  // - YAML-native, schema-validated, deterministic execution
  // - Component reusability across multiple workflows
  // - "If building 2+ agents that need coordination, you need Agent Actions"
  //
  // TECHNICAL APPROACH:
  // - Focus on platform patterns, not business logic
  // - Use generic examples (content_generation vs quiz_generation)
  // - Emphasize DAG workflows, schema validation, component sharing
  //
  // STATUS: Documentation foundation complete. Next priorities in plan below.
  // ========================================

  // ========================================
  // Agent Actions Documentation Plan
  // Platform-focused documentation based on enterprise real-world usage
  // Positioning: Infrastructure platform for building AI workflows
  // ========================================

  "positioning": {
    "tagline": "Build, deploy, and scale AI agent workflows with YAML-native infrastructure",
    "elevator_pitch": "Agent Actions is a platform for creating deterministic, schema-validated AI agent pipelines. Like Airflow orchestrates data workflows, Agent Actions orchestrates AI agent workflows.",
    "target_audience": [
      "AI Engineers building production agent systems",
      "Data Scientists creating repeatable AI pipelines",
      "MLOps teams scaling AI workflows",
      "Platform teams building AI infrastructure"
    ]
  },

  // ========================================
  // CORE VALUE PROPOSITIONS
  // ========================================

  "core_value_props": {
    "platform_not_tool": "Infrastructure for building multiple AI workflows, not a single-use solution",
    "reusable_components": "Shared schemas, prompts, tools, and templates across workflows",
    "deterministic_execution": "Same inputs always produce same outputs (unlike autonomous agents)",
    "yaml_native": "Declarative workflow definition without complex Python abstractions",
    "enterprise_ready": "Batch processing, custom tools, monitoring, and extensibility"
  },

