nce/validation/"}},{"id":"reference/execution/workflow-dependencies","title":"Workflow Dependencies","description":"Workflow dependencies enable orchestration across multiple workflows, creating multi-stage pipelines.","source":"@site/docs/reference/execution/workflow-dependencies.md","sourceDirName":"reference/execution","slug":"/reference/execution/workflow-dependencies","permalink":"/docs/reference/execution/workflow-dependencies","draft":false,"unlisted":false,"editUrl":"https://github.com/your-org/agent-actions/tree/main/agentaction-docs/docs/reference/execution/workflow-dependencies.md","tags":[],"version":"current","sidebarPosition":6,"frontMatter":{"title":"Workflow Dependencies","sidebar_position":6},"sidebar":"docsSidebar","previous":{"title":"Granularity","permalink":"/docs/reference/execution/granularity"},"next":{"title":"Retry & Error Handling","permalink":"/docs/reference/execution/retry"}},{"id":"reference/index","title":"Reference","description":"This is your comprehensive guide to Agent Actions features. Whether you're building your first agentic workflow or debugging a complex multi-action pipeline, you'll find detailed documentation here.","source":"@site/docs/reference/index.md","sourceDirName":"reference","slug":"/reference/","permalink":"/docs/reference/","draft":false,"unlisted":false,"editUrl":"https://github.com/your-org/agent-actions/tree/main/agentaction-docs/docs/reference/index.md","tags":[],"version":"current","sidebarPosition":1,"frontMatter":{"title":"Reference","sidebar_position":1},"sidebar":"docsSidebar","previous":{"title":"Troubleshooting","permalink":"/docs/guides/troubleshooting"},"next":{"title":"CLI Reference","permalink":"/docs/reference/cli/"}},{"id":"reference/inspect","title":"Inspect Commands","description":"Analyze workflow data flow and detect field conflicts before runtime","source":"@site/docs/reference/inspect.md","sourceDirName":"reference","slug":"/reference/inspect","permalink":"/docs/reference/inspect","draft":