## Phase 2: Decorator Update

### Files to Modify
- `agent_actions/utilities/udf_management/udf_registry.py`

### Step 2.1: New Parameters

```python
def udf_tool(
    func: Optional[Callable] = None,
    *,
    # Type-based schema (NEW)
    input_type: Optional[type] = None,
    output_type: Optional[type] = None,

    # Existing schema options
    input_schema: Optional[Dict] = None,
    output_schema: Optional[Dict] = None,
    schema: Optional[Dict] = None,
    schema_file: Optional[str] = None,

    granularity: Granularity = Granularity.RECORD,
) -> Callable:
```

### Step 2.2: Schema Resolution

```python
def decorator(f: Callable) -> Callable:
    # Resolve input schema (priority order)
    if input_type:
        resolved_input = derive_schema_from_type(input_type)
    elif input_schema:
        resolved_input = _validate_inline_schema(input_schema, f)
    elif schema:
        resolved_input = _validate_inline_schema(schema, f)
    elif schema_file:
        resolved_input = _load_schema_from_file_secure(schema_file, f)
    else:
        raise ConfigurationError(
            f"UDF '{f.__name__}' requires a schema. "
            f"Use input_type, input_schema, schema, or schema_file."
        )

    # Resolve output schema (optional)
    resolved_output = None
    if output_type:
        resolved_output = derive_schema_from_type(output_type)
    elif output_schema:
        resolved_output = _validate_inline_schema(output_schema, f)

    # Compile both schemas
    compiled_input = compile_schema_to_formats(resolved_input)
    compiled_output = compile_schema_to_formats(resolved_output) if resolved_output else None

    # Register
    UDF_REGISTRY[f.__name__.lower()] = {
        'function': f,
        'input_schema': resolved_input,
        'output_schema': resolved_output,
        'compiled_schemas': {
            'input': compiled_input,
            'output': compiled_output,
        },
        'granularity': granularity,
    }
```

