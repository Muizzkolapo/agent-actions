## Phase 4: Testing

### Test File
- `tests/core/test_type_hint_schemas.py`

### Test Cases

```python
import dataclasses
import pytest
from typing import TypedDict, List, Dict, Optional

from agent_actions.utilities.udf_management.udf_registry import (
    udf_tool, derive_schema_from_type, get_udf_metadata, is_typeddict
)
from agent_actions.utilities.udf_management.tooling import execute_user_defined_function
from agent_actions.errors.validation import OutputValidationError


# --- Type Detection ---

class TestTypeDetection:
    def test_typeddict_detected(self):
        class T(TypedDict):
            x: str
        assert is_typeddict(T)

    def test_dataclass_not_typeddict(self):
        @dataclasses.dataclass
        class D:
            x: str
        assert not is_typeddict(D)
        assert dataclasses.is_dataclass(D)

    @pytest.mark.skipif(not HAS_PYDANTIC, reason="Pydantic not installed")
    def test_pydantic_not_typeddict(self):
        from pydantic import BaseModel
        class P(BaseModel):
            x: str
        assert not is_typeddict(P)
        assert hasattr(P, 'model_json_schema')


# --- Schema Derivation ---

class TestTypedDictDerivation:
    def test_simple(self):
        class Input(TypedDict):
            name: str
            count: int

        schema = derive_schema_from_type(Input)

        assert schema['name'] == 'Input'
        assert len(schema['fields']) == 2
        fields = {f['id']: f for f in schema['fields']}
        assert fields['name']['type'] == 'string'
        assert fields['count']['type'] == 'integer'

    def test_optional_field(self):
        class Input(TypedDict, total=False):
            optional: str

        schema = derive_schema_from_type(Input)
        assert schema['fields'][0]['required'] is False

    def test_list_field(self):
        class Input(TypedDict):
            items: List[str]

        schema = derive_schema_from_type(Input)
        field = schema['fields'][0]
        assert field['type'] == 'array'
        assert field['items']['type'] == 'string'

    def test_dict_field(self):
        class Input(TypedDict):
            meta: Dict[str, int]

        schema = derive_schema_from_type(Input)
        field = schema['fields'][0]
        assert field['type'] == 'object'
        assert field['additionalProperties']['type'] == 'integer'

    def test_nested_typeddict(self):
        class Inner(TypedDict):
            value: int

        class Outer(TypedDict):
            inner: Inner

        schema = derive_schema_from_type(Outer)
        field = schema['fields'][0]
        assert field['type'] == 'object'
        assert 'properties' in field


class TestDataclassDerivation:
    def test_simple(self):
        @dataclasses.dataclass
        class Input:
            name: str
            count: int = 0

        schema = derive_schema_from_type(Input)
        fields = {f['id']: f for f in schema['fields']}
        assert fields['name']['required'] is True
        assert fields['count']['required'] is False

    def test_factory_default(self):
        @dataclasses.dataclass
        class Input:
            items: List[str] = dataclasses.field(default_factory=list)

        schema = derive_schema_from_type(Input)
        assert schema['fields'][0]['required'] is False


@pytest.mark.skipif(not HAS_PYDANTIC, reason="Pydantic not installed")
class TestPydanticDerivation:
    def test_simple(self):
        from pydantic import BaseModel

        class Input(BaseModel):
            name: str
            count: int = 0

        schema = derive_schema_from_type(Input)
        fields = {f['id']: f for f in schema['fields']}
        assert fields['name']['required'] is True
        assert fields['count']['required'] is False


class TestUnsupportedTypes:
    def test_plain_type_rejected(self):
        with pytest.raises(ValueError, match="Unsupported type"):
            derive_schema_from_type(str)

    def test_plain_dict_rejected(self):
        with pytest.raises(ValueError, match="Unsupported type"):
            derive_schema_from_type(dict)


# --- Decorator Integration ---

class TestDecoratorWithTypes:
    def test_input_type_registration(self):
        class Input(TypedDict):
            query: str

        @udf_tool(input_type=Input)
        def search(data):
            return data

        meta = get_udf_metadata('search')
        assert meta['input_schema']['name'] == 'Input'
        assert meta['compiled_schemas']['input'] is not None

    def test_output_type_registration(self):
        class Input(TypedDict):
            x: str

        class Output(TypedDict):
            result: str

        @udf_tool(input_type=Input, output_type=Output)
        def process(data):
            return {'result': data['x']}

        meta = get_udf_metadata('process')
        assert meta['output_schema']['name'] == 'Output'
        assert meta['compiled_schemas']['output'] is not None


# --- Output Validation ---

class TestOutputValidation:
    def test_valid_output_passes(self):
        class Input(TypedDict):
            x: str

        class Output(TypedDict):
            result: str

        @udf_tool(input_type=Input, output_type=Output)
        def good_tool(data):
            return {'result': 'ok'}

        result = execute_user_defined_function('good_tool', {'x': 'test'})
        assert result == {'result': 'ok'}

    def test_invalid_output_raises(self):
        class Input(TypedDict):
            x: str

        class Output(TypedDict):
            result: str

        @udf_tool(input_type=Input, output_type=Output)
        def bad_tool(data):
            return {'wrong': 'field'}

        with pytest.raises(OutputValidationError):
            execute_user_defined_function('bad_tool', {'x': 'test'})

    def test_validation_disabled(self):
        class Input(TypedDict):
            x: str

        class Output(TypedDict):
            result: str

        @udf_tool(input_type=Input, output_type=Output)
        def tool(data):
            return {'wrong': 'field'}

        # Should not raise
        result = execute_user_defined_function('tool', {'x': 'test'}, validate_output=False)
        assert result == {'wrong': 'field'}


# --- Backward Compatibility ---

class TestBackwardCompatibility:
    def test_schema_dict_still_works(self):
        @udf_tool(schema={'name': 'test', 'fields': [{'id': 'x', 'type': 'string'}]})
        def legacy_tool(data):
            return data

        result = execute_user_defined_function('legacy_tool', {'x': 'hello'})
        assert result == {'x': 'hello'}
```

---

## Implementation Order

1. **Phase 1**: Add `derive_schema_from_type()` and helpers to `udf_registry.py`
2. **Phase 2**: Update `udf_tool` decorator with new parameters
3. **Phase 3**: Add `OutputValidationError` and validation in `execute_user_defined_function`
4. **Phase 4**: Add tests

---

## Success Criteria

- [ ] `derive_schema_from_type()` handles TypedDict, Pydantic, dataclass
- [ ] `int` maps to `integer`, `float` maps to `number`
- [ ] `Optional[T]` makes field non-required
- [ ] Nested types produce inline `properties`
- [ ] `@udf_tool(input_type=X, output_type=Y)` works
- [ ] Output validation raises `OutputValidationError` on mismatch
- [ ] All existing `schema=` and `schema_file=` usage continues to work
- [ ] Tests pass
