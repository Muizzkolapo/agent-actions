## Phase 3: Output Validation

### Files to Modify
- `agent_actions/utilities/udf_management/tooling.py`
- `agent_actions/errors/validation.py`

### Step 3.1: Error Class

```python
# In errors/validation.py

class OutputValidationError(SchemaValidationError):
    """UDF output does not match declared output schema."""
    pass
```

### Step 3.2: Validation Function

```python
# In tooling.py

def _validate_output(output: Any, compiled_schema: Dict, udf_name: str) -> None:
    """Validate UDF output against compiled JSON Schema."""
    import jsonschema

    json_schema = compiled_schema.get('json_schema') or compiled_schema.get('openai', {}).get('schema')
    if not json_schema:
        return

    try:
        jsonschema.validate(instance=output, schema=json_schema)
    except jsonschema.ValidationError as e:
        path = ' -> '.join(str(p) for p in e.path) if e.path else 'root'
        raise OutputValidationError(
            f"Output validation failed for '{udf_name}' at {path}: {e.message}",
            context={'udf': udf_name, 'path': path, 'error': e.message}
        ) from e
```

### Step 3.3: Execution Update

```python
def execute_user_defined_function(
    udf_name: str,
    input_data: Union[Dict, List],
    validate_input: bool = True,
    validate_output: bool = True,
    **kwargs
) -> Any:
    """Execute UDF with optional input/output validation."""
    metadata = get_udf_metadata(udf_name)

    if validate_input:
        _validate_input(input_data, metadata['compiled_schemas']['input'], udf_name)

    result = metadata['function'](input_data, **kwargs)

    if validate_output and metadata['compiled_schemas'].get('output'):
        _validate_output(result, metadata['compiled_schemas']['output'], udf_name)

    return result
```

