# Implementation Plan: Type Hint Support & Output Validation

## Overview

Add `input_type`/`output_type` parameters to `@udf_tool` decorator, supporting TypedDict, Pydantic, and dataclasses.

---

## Design Decisions

### Single Internal Schema Format

All type hints are converted to the **unified schema format** used throughout the codebase:

```python
{
    'name': 'SchemaName',
    'fields': [
        {
            'id': 'field_name',
            'type': 'string',  # JSON Schema types: string, integer, number, boolean, array, object
            'required': True,
            'description': 'optional description',
            'items': {'type': 'string'},  # For arrays
            'properties': {...},  # For nested objects
        }
    ]
}
```

### Type Detection Strategy

Use explicit, unambiguous checks in priority order:
1. **Pydantic**: `hasattr(tp, 'model_json_schema')` - only Pydantic v2 has this
2. **Dataclass**: `dataclasses.is_dataclass(tp)` - stdlib function
3. **TypedDict**: Custom `is_typeddict()` that excludes the above

### Compilation Strategy

The unified schema is compiled to JSON Schema at registration time. Both input and output schemas go through the same compilation pipeline.

---

## Phase 1: Type Hint Derivation

### Files to Modify
- `agent_actions/utilities/udf_management/udf_registry.py`

### Step 1.1: Imports and Optional Dependencies

```python
import dataclasses
import sys
from typing import Any, Dict, List, Union, get_origin, get_args

# Optional Pydantic support
try:
    from pydantic import BaseModel as PydanticBaseModel
    HAS_PYDANTIC = True
except ImportError:
    HAS_PYDANTIC = False
    PydanticBaseModel = None


def is_typeddict(tp) -> bool:
    """Check if type is a TypedDict (not Pydantic or dataclass)."""
    if HAS_PYDANTIC and isinstance(tp, type) and issubclass(tp, PydanticBaseModel):
        return False
    if dataclasses.is_dataclass(tp):
        return False
    return (
        hasattr(tp, '__annotations__') and
        hasattr(tp, '__total__') and
        hasattr(tp, '__required_keys__')
    )
```

### Step 1.2: Type Mapping

```python
# JSON Schema type mapping
TYPE_MAP = {
    str: 'string',
    int: 'integer',
    float: 'number',
    bool: 'boolean',
    list: 'array',
    dict: 'object',
    type(None): 'null',
}


def get_schema_type(py_type) -> str:
    """Convert Python type to JSON Schema type string."""
    # Handle generic types (List[X], Dict[K,V], Optional[X])
    origin = get_origin(py_type)

    if origin is Union:
        # Optional[X] is Union[X, None]
        args = [a for a in get_args(py_type) if a is not type(None)]
        if len(args) == 1:
            return get_schema_type(args[0])
        return 'string'  # Complex unions default to string

    if origin is list:
        return 'array'
    if origin is dict:
        return 'object'

    return TYPE_MAP.get(py_type, 'string')


def is_optional(py_type) -> bool:
    """Check if type is Optional[X]."""
    origin = get_origin(py_type)
    if origin is Union:
        return type(None) in get_args(py_type)
    return False
```

### Step 1.3: Schema Derivation - Single Entry Point

```python
def derive_schema_from_type(type_hint) -> Dict[str, Any]:
    """
    Convert a type hint to unified schema format.

    Supports: TypedDict, Pydantic BaseModel, dataclass
    """
    if HAS_PYDANTIC and hasattr(type_hint, 'model_json_schema'):
        return _from_pydantic(type_hint)

    if dataclasses.is_dataclass(type_hint):
        return _from_dataclass(type_hint)

    if is_typeddict(type_hint):
        return _from_typeddict(type_hint)

    raise ValueError(
        f"Unsupported type: {type_hint}. "
        f"Expected TypedDict, Pydantic BaseModel, or dataclass."
    )
```

### Step 1.4: TypedDict Derivation

```python
def _from_typeddict(tp) -> Dict[str, Any]:
    """Convert TypedDict to unified schema."""
    required_keys = getattr(tp, '__required_keys__', set())
    fields = []

    for name, field_type in tp.__annotations__.items():
        field = _build_field(name, field_type)
        field['required'] = name in required_keys and not is_optional(field_type)
        fields.append(field)

    return {'name': tp.__name__, 'fields': fields}
```

### Step 1.5: Dataclass Derivation

```python
def _from_dataclass(tp) -> Dict[str, Any]:
    """Convert dataclass to unified schema."""
    fields = []

    for f in dataclasses.fields(tp):
        field = _build_field(f.name, f.type)
        has_default = not (
            f.default is dataclasses.MISSING and
            f.default_factory is dataclasses.MISSING
        )
        field['required'] = not has_default and not is_optional(f.type)
        fields.append(field)

    return {'name': tp.__name__, 'fields': fields}
```

### Step 1.6: Pydantic Derivation

```python
def _from_pydantic(tp) -> Dict[str, Any]:
    """Convert Pydantic model to unified schema."""
    json_schema = tp.model_json_schema()
    properties = json_schema.get('properties', {})
    required = set(json_schema.get('required', []))
    defs = json_schema.get('$defs', {})

    fields = []
    for name, prop in properties.items():
        # Resolve $ref
        if '$ref' in prop:
            ref_name = prop['$ref'].split('/')[-1]
            prop = defs.get(ref_name, prop)

        field = {
            'id': name,
            'type': prop.get('type', 'string'),
            'required': name in required,
        }

        if 'description' in prop:
            field['description'] = prop['description']
        if prop.get('type') == 'array' and 'items' in prop:
            field['items'] = prop['items']
        if 'enum' in prop:
            field['enum'] = prop['enum']

        fields.append(field)

    return {'name': json_schema.get('title', tp.__name__), 'fields': fields}
```

### Step 1.7: Field Builder (shared logic)

```python
def _build_field(name: str, py_type) -> Dict[str, Any]:
    """Build a field dict from name and Python type."""
    origin = get_origin(py_type)

    # Unwrap Optional
    if origin is Union:
        args = [a for a in get_args(py_type) if a is not type(None)]
        if len(args) == 1:
            py_type = args[0]
            origin = get_origin(py_type)

    field = {
        'id': name,
        'type': get_schema_type(py_type),
    }

    # Handle List[T]
    if origin is list:
        args = get_args(py_type)
        if args:
            inner = args[0]
            if is_typeddict(inner):
                field['items'] = {'type': 'object', 'properties': _inline_properties(inner)}
            elif dataclasses.is_dataclass(inner):
                field['items'] = {'type': 'object', 'properties': _inline_properties(inner)}
            else:
                field['items'] = {'type': get_schema_type(inner)}

    # Handle Dict[str, V]
    elif origin is dict:
        args = get_args(py_type)
        if len(args) == 2:
            field['additionalProperties'] = {'type': get_schema_type(args[1])}

    # Handle nested structured types
    elif is_typeddict(py_type) or dataclasses.is_dataclass(py_type):
        field['type'] = 'object'
        field['properties'] = _inline_properties(py_type)

    return field


def _inline_properties(tp) -> Dict[str, Any]:
    """Convert nested type to inline properties dict."""
    schema = derive_schema_from_type(tp)
    return {f['id']: {'type': f['type'], **{k: v for k, v in f.items() if k not in ('id', 'required')}}
            for f in schema['fields']}
```

