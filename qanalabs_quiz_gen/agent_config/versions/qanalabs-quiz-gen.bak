name: qanalabs_quiz_gen
description: "Educational quiz generation workflow with fact extraction, clustering, validation, and distractor generation"
version: "2.0.0"

# Global defaults applied to all actions unless overridden
defaults:
  model_vendor: openai
  model_name: gpt-5-mini
  json_mode: true
  granularity: Record
  run_mode: batch
  api_key: OPENAI_API_KEY
  is_operational: true
  prompt_debug: false
  few_shot: 0
  # Most common fields across actions - each action only adds unique fields
  observe: [id, url, platform_name, exam_name, page_content, bloom_details, fact, quote, fact_explanation, technical_level, questionable,quiz_type]
  drops: [rewrite_instruction, needs_rewrite, quiz_type, rationale]



actions:
  - name: fact_extractor
    intent: "Extract candidate facts from educational content"
    schema: candidate_facts_list
    drops: [id, url, topic]  # overrides defaults - unique drops for this action
    prompt: $qanalabs_quiz_gen.Fact_extraction

  - name: flatten_the_facts
    kind: tool
    impl: flatten_quotes
    intent: "Group extracted facts into logical clusters"
    observe: [topic, summary]  # only unique additions
    guard: 
      condition:  'candidate_facts_list != []'  # overrides default guard
      on_false: "filter"  # Options: "skip" | "filter"


  - name: fact_questionability
    intent: "Generate detailed explanations for extracted facts"
    schema: fact_questionability
    observe: [candidate_facts_list, why_questionable, flagged_items]  # only unique additions
    prompt: $qanalabs_quiz_gen.fact_questionability
    prompt_debug: False
    guard: 
      condition:  'candidate_facts_list != []'  # overrides default guard
      on_false: "filter"  # Options: "skip" | "filter"

  - name: explain_facts
    intent: "Generate detailed explanations for extracted facts"
    schema: {fact_explanation: string}
    observe: [candidate_facts_list, why_questionable, flagged_items,questionable]  # only unique additions
    prompt: $qanalabs_quiz_gen.Fact_Explanation_Agent_new
    guard:  
      condition: 'questionable != "Low Value"' 
      on_false: "filter"  # Options: "skip" | "filter"


  - name: classify_feynman
    intent: "Classify quiz type using Feynman technique principles"
    schema: {quiz_type: string, rationale: string}
    drops: [id, url, page_content, bloom_details]  # overrides defaults
    observe: [summary, question, options, answer_explanation, answer, excerpt, options_answer, question_type, target_word_counts, correct_answer_words, flagged_items]  # only unique additions
    few_shot: 6
    prompt: $feynman.classifer_feynman
    guard: 'questionable != "Low Value"'
    prompt_debug: False


  - name: generate_summary
    intent: "Generate quiz-type specific summaries with appropriate technical details and code snippets"
    schema: {
      summary_title: string,
      summary_content: string,
      key_concepts: array,
      technical_details: string,
      code_snippets: array,
      learning_objectives: array
    }
    observe: [quiz_type, rationale, fact_explanation, fact, quote, platform_name, exam_name,summary, question, options, answer_explanation, answer, excerpt, options_answer, question_type, target_word_counts, correct_answer_words]
    drops: [id, url, bloom_details, candidate_facts_list, why_questionable,platform_name,page_content]
    prompt: $qanalabs_quiz_gen.Summary_Generator
    guard: 'quiz_type != null'


  - name: review_summary_content
    api_key: CLAUDE_API_KEY
    model_vendor: "anthropic"
    model_name: "claude-3-5-haiku-20241022"
    intent: "This takes the quiz to show us if we have issues"
    schema: {"summary_content_valid": "boolean","summary_content_reasoning": "string","summary_content_response_confidence_level": "string"}
    prompt: "You are a quiz reviewer. Your task is to look at summary_content and validate it has appropriate technical summary and not fail callback message"
    prompt_debug: True
    observe: [
      question_context_based,question_context_confidence_level,question_context_response_confidence_level,
      ui_based,ui_based_confidence_level,ui_based_reasoning
      question, options, answer_explanation, summary_content, fact_explanation,
      answer, answer_indices, answer_reasoning, answer_text,
      my_answer_key, my_answer_text, my_confidence_level, my_reasoning,
      bloom_details, code_snippets, combined_explanation,
      concept_explanation_collapsible, correct_answers,
      distractor_1, distractor_2, distractor_3, distractors,
      exam_name, explanation_why_it_is_incorrect_1,
      explanation_why_it_is_incorrect_2, explanation_why_it_is_incorrect_3,
      fact, feynman_explanation_collapsible, id, key_concept_analogy,
      key_concepts, learning_objectives, marked_result_is_correct,
      memorable_takeaway, options_combined, page_content, platform_name,
      question_explanation, question_type, questionable, quiz_type,
      quote, technical_details, technical_level, url
    ]
    drops: [
      question, options, answer_explanation, fact_explanation,
      question_context_based,question_context_confidence_level,question_context_reasoning,
      ui_based,ui_based_confidence_level,ui_based_reasoning,
      answer, answer_indices, answer_reasoning, answer_text,
      my_answer_key, my_answer_text, my_confidence_level, my_reasoning,
      bloom_details, code_snippets, combined_explanation,
      concept_explanation_collapsible, correct_answers,
      distractor_1, distractor_2, distractor_3, distractors,
      exam_name, explanation_why_it_is_incorrect_1,
      explanation_why_it_is_incorrect_2, explanation_why_it_is_incorrect_3,
      fact, feynman_explanation_collapsible, id, key_concept_analogy,
      key_concepts, learning_objectives, marked_result_is_correct,
      memorable_takeaway, options_combined, page_content, platform_name,
      question_explanation, question_type, questionable, quiz_type,
      quote, technical_details, technical_level, url
    ]



  - name: regenerate_summary
    intent: "Regenerate summary_content for records where summary_content_valid is false"
    schema: {
      summary_title: string,
      summary_content: string,
      key_concepts: array,
      technical_details: string,
      code_snippets: array,
      learning_objectives: array
    }
    observe: [quiz_type, rationale, fact_explanation, fact, quote, platform_name, exam_name, summary, question, options, answer_explanation, answer, excerpt, options_answer, question_type, target_word_counts, correct_answer_words, summary_content_valid, summary_content_reasoning]
    drops: [id, url, bloom_details, candidate_facts_list, why_questionable, platform_name, page_content, summary_content_valid, summary_content_reasoning, summary_content_response_confidence_level]
    prompt: $qanalabs_quiz_gen.Summary_Generator
    guard:
      condition: 'summary_content_valid == false'
      on_false: "skip"



  - name: generate_scenarios
    intent: "Generate quiz scenarios based on classified facts and learning objectives"
    schema: ScenarioGenerator_schema
    drops: [id, url, page_content, bloom_details]  # overrides defaults (quiz_type, rationale already in defaults)
    observe: [candidate_facts_list, why_questionable, flagged_items, summary_title, summary_content, key_concepts, learning_objectives, technical_details, code_snippets]  # Enhanced with summary outputs
    prompt: $feynman.ScenarioGenerator_prompt



  - name: review_quiz_content
    api_key: CLAUDE_API_KEY
    model_vendor: "anthropic"
    model_name: "claude-3-5-haiku-20241022"
    intent: "This takes the quiz to show us if we have issues"
    schema: {"question_context_based": "boolean","question_context_reasoning": "string","question_context_response_confidence_level": "string"}
    prompt: "You are a quiz reviewer. Your task is to look at the source of this quiz which is summary_content,key_concepts and technical_details ensure this question can be answered within this context"
    prompt_debug: True
    observe: [
      ui_based,ui_based_response_confidence_level,ui_based_reasoning,
      question, options, answer_explanation, summary_content, fact_explanation,
      answer, answer_indices, answer_reasoning, answer_text,
      my_answer_key, my_answer_text, my_confidence_level, my_reasoning,
      bloom_details, code_snippets, combined_explanation,
      concept_explanation_collapsible, correct_answers,
      distractor_1, distractor_2, distractor_3, distractors,
      exam_name, explanation_why_it_is_incorrect_1,
      explanation_why_it_is_incorrect_2, explanation_why_it_is_incorrect_3,
      fact, feynman_explanation_collapsible, id, key_concept_analogy,
      key_concepts, learning_objectives, marked_result_is_correct,
      memorable_takeaway, options_combined, page_content, platform_name,
      question_explanation, question_type, questionable, quiz_type,
      quote, technical_details, technical_level, url
    ]
    drops: [
      ui_based,ui_based_confidence_level,ui_based_reasoning,
      answer, answer_indices, answer_reasoning, answer_text,
      my_answer_key, my_answer_text, my_confidence_level, my_reasoning,
      bloom_details, code_snippets, combined_explanation,
      concept_explanation_collapsible, correct_answers,
      distractor_1, distractor_2, distractor_3, distractors,
      exam_name, explanation_why_it_is_incorrect_1,
      explanation_why_it_is_incorrect_2, explanation_why_it_is_incorrect_3,
      fact, feynman_explanation_collapsible, id, key_concept_analogy,
      key_concepts, learning_objectives, marked_result_is_correct,
      memorable_takeaway, options_combined, page_content, platform_name,
      question_explanation, question_type, questionable, quiz_type,
      quote, technical_details, technical_level, url
    ]






  - name: flatten_questions
    kind: tool
    impl: flatten_questions
    intent: "Flatten nested question structures for processing"
    granularity: Record
    observe: [candidate_facts_list, why_questionable, flagged_items, summary_title, summary_content, key_concepts, learning_objectives, technical_details, code_snippets]  # Enhanced with summary outputs
    guard: 'questionable != "Low Value"'

  - name: generate_feynman_explanation
    intent: "Generate Feynman-style explanations for why the quiz answer is correct"
    schema: {
      question_explanation: string,
      answer_reasoning: string,
      key_concept_analogy: string,
      memorable_takeaway: string
    }
    observe: [question, options, answer, answer_explanation, quiz_type, learning_objectives, summary_content, key_concepts, technical_details, platform_name, exam_name,code_snippets]
    prompt: $qanalabs_quiz_gen.Feynman_Explanation_Generator
    guard: 'questionable != "Low Value"'

  - name: suggest_distractor_counts
    kind: tool
    impl: suggest_word_counts
    intent: "Suggest word counts for answer distractors"
    observe: [candidate_facts_list, why_questionable, flagged_items, summary_title, summary_content, key_concepts, learning_objectives, technical_details, code_snippets,question,options,answer,answer_explanation,fact_explanation,bloom_details,platform_name,exam_name,questionable,question_explanation,key_concept_analogy,memorable_takeaway,answer_reasoning,code_snippets]  # Enhanced with summary outputs

  - name: add_answer_text
    kind: tool
    impl: add_answer_text
    granularity: Record
    intent: "Add structured answer text to questions"
    observe: [candidate_facts_list, why_questionable, flagged_items, summary_title, summary_content, key_concepts, learning_objectives, technical_details, code_snippets,question_explanation,key_concept_analogy,memorable_takeaway,answer_reasoning]  # Enhanced with summary outputs

  - name: generate_distractors
    intent: "Generate answer distractors with explanations for multiple choice questions"
    api_key: CLAUDE_API_KEY
    model_vendor: "anthropic"
    model_name: "claude-3-5-haiku-20241022"
    run_mode: online
    loop:
      param: stage
      range: [1, 3]
    schema:
      distractor_${stage}: string 
      explanation_why_it_is_incorrect_${stage}: string
      thinking_process${stage}: string
    observe: [summary, question, answer_explanation, answer, excerpt, options_answer, question_type, target_word_counts, correct_answer_words, answer_text, flagged_items, quiz_type, summary_title, summary_content, key_concepts, learning_objectives, technical_details, code_snippets,question_explanation,key_concept_analogy,memorable_takeaway,answer_reasoning]  # Enhanced with learning objectives
    drops: [options]    
    prompt: $qanalabs_quiz_gen.AnswerLengthDistractorGenerator_prompt
    #guard: 'questionable != "Low Value"'
    prompt_debug: False # ISSUE: PROMPT DEBUG NOT WORKING IN LOOP

  - name: merge_alternatives
    kind: tool
    loop_consumption:
      source: "generate_distractors"
      pattern: "merge"
    impl: merge_alternatives
    intent: "Merge all code alternatives into single record"
    granularity: Record

  - name: reconstruct_options
    kind: tool
    impl: apply_edited_distractors
    intent: "Reconstruct final answer options from correct answer and distractors"
    observe: [target_word_counts,summary_title, summary_content, key_concepts, learning_objectives, technical_details, code_snippets,question_explanation,key_concept_analogy,memorable_takeaway,answer_reasoning]  
    granularity: Record
    #guard: 'questionable != "Low Value"'


  - name: QuizTaker
    api_key: CLAUDE_API_KEY
    model_vendor: "anthropic"
    model_name: "claude-3-5-haiku-20241022"
    intent: "This takes the quiz to show us if we have issues"
    schema: {"my_answer_key": "string","my_answer_text": "string","my_reasoning": "string","my_confidence_level": "string"}
    prompt: "You are a quiz taker. Your task is to answer the question based on the provided information by grounding your choice based on the fact_explanation. Please provide your answer, reasoning, and confidence level. RULE: your answer is solely based on the fact_explanation and no external knowledge. You must not use any external knowledge to answer the question. If you are not sure about the answer, please indicate that in your reasoning and confidence level(High, Medium, Low). If you are confident, provide your reasoning based on the fact_explanation provided. important: my_answer_letter_key(can only be A-Z)" 
    prompt_debug: False
    observe: [distractor_3, explanation_why_it_is_incorrect_3, explanation_why_it_is_incorrect_2, distractor_2, distractor_1, explanation_why_it_is_incorrect_1, answer_explanation,question_type,target_word_counts,answer_text,flagged_items,quiz_type,options,fact_explanation,question,answer,summary_title, summary_content, key_concepts, learning_objectives, technical_details, code_snippets,question_explanation,key_concept_analogy,memorable_takeaway,answer_reasoning]  

  - name: quiztaker_maker
    kind: tool
    impl: mark_and_attach
    intent: "Mark the quiz"
    observe: [target_word_counts,summary_title, summary_content, key_concepts, learning_objectives, technical_details, code_snippets,question_explanation,key_concept_analogy,memorable_takeaway,answer_reasoning]  
    granularity: Record
    guard: 'questionable != "Low Value"'



  - name: review_code_snippets
    api_key: CLAUDE_API_KEY
    model_vendor: "anthropic"
    model_name: "claude-3-5-haiku-20241022"
    intent: "Review code snippets and filter out non-code documentation"
    schema: {"code_snippets": "array", "removed_snippets": "array", "removal_reasoning": "string"}
    prompt: |
      You are a code snippet reviewer. Your task is to review the code_snippets array and determine which snippets contain ACTUAL executable code vs documentation/text.

      KEEP snippets that contain:
      - Actual code blocks (JSON, Python, JavaScript, Bash, YAML, SQL, etc.)
      - Complete functions, classes, or code structures
      - Configuration files (JSON, YAML, XML)
      - API requests/responses with actual data
      - Command-line examples that are executable

      REMOVE snippets that are:
      - Just field descriptions (e.g., "* `field`: Description text")
      - Bullet point lists without executable code
      - Plain text documentation
      - Log messages or error messages (unless showing actual code context)
      - Single-line field/property descriptions
      - Markdown formatting without code substance

      EXAMPLES:

      KEEP:
      ```json
      {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "completion/complete"
      }
      ```

      KEEP:
      ```python
      def calculate_total(items):
          return sum(item.price for item in items)
      ```

      REMOVE:
      "* `role`: Either "user" or "assistant" to indicate the speaker"

      REMOVE:
      "* `completion`: Object containing:\n  + `values`: Array of suggestions"

      REMOVE:
      "Field description: The name of the user"

      Return:
      - code_snippets: Array containing ONLY snippets with actual code
      - removed_snippets: Array of snippets that were removed
      - removal_reasoning: Brief explanation of why snippets were removed
    prompt_debug: True
    drops: [
      answer, answer_indices, answer_reasoning, answer_text,
      my_answer_key, my_answer_text, my_confidence_level, my_reasoning,
      bloom_details, combined_explanation,
      concept_explanation_collapsible, correct_answers,
      distractor_1, distractor_2, distractor_3, distractors,
      exam_name, explanation_why_it_is_incorrect_1,
      explanation_why_it_is_incorrect_2, explanation_why_it_is_incorrect_3,
      fact, feynman_explanation_collapsible, id, key_concept_analogy,
      key_concepts, learning_objectives, marked_result_is_correct,
      memorable_takeaway, options_combined, page_content, platform_name,
      question_explanation, question_type, questionable, quiz_type,
      quote, technical_details, technical_level, url,question, options, answer_explanation, summary_content, fact_explanation,target_word_counts
    ]
    observe: [
      answer, answer_indices, answer_reasoning, answer_text,
      my_answer_key, my_answer_text, my_confidence_level, my_reasoning,
      bloom_details, combined_explanation,
      concept_explanation_collapsible, correct_answers,
      distractor_1, distractor_2, distractor_3, distractors,
      exam_name, explanation_why_it_is_incorrect_1,
      explanation_why_it_is_incorrect_2, explanation_why_it_is_incorrect_3,
      fact, feynman_explanation_collapsible, id, key_concept_analogy,
      key_concepts, learning_objectives, marked_result_is_correct,
      memorable_takeaway, options_combined, page_content, platform_name,
      question_explanation, question_type, questionable, quiz_type,
      quote, technical_details, technical_level, url,question, options, answer_explanation, summary_content, fact_explanation,target_word_counts
    ]

  - name: fix_code_snippets_llm
    api_key: CLAUDE_API_KEY
    model_vendor: "anthropic"
    model_name: "claude-3-5-haiku-20241022"
    intent: "Fix double-escaped and malformed code snippets using LLM"
    schema: {"code_snippets": "array"}
    prompt: |
      You are a code snippet formatter. Review the code_snippets array and fix any rendering issues caused by double-escaping or improper formatting.

      RULES:
      1. If a snippet contains double-escaped characters (\\n, \\", \\\\) that make it unreadable, fix it by:
          - Removing outer quotes if the entire snippet is wrapped in quotes
          - Unescaping: convert \\n to actual newlines, \\" to ", \\\\ to \
          - Wrapping in appropriate markdown code fence (```json, ```javascript, ```python, etc.)

      2. If a snippet is already well-formatted (uses markdown bullets *, backticks `, clear structure), leave it as-is

      3. For JSON/code blocks, use this format:
          ```json
          {
            "key": "value"
          }
          ```

      4. For structured lists/documentation, preserve markdown formatting:
          * `field`: Description
          + `subfield`: Details

      5. Detect the code language from content and use appropriate fence (json, javascript, python, bash, yaml, etc.)

      EXAMPLES:

      Bad (double-escaped):
      "\"{\\n  \\\"jsonrpc\\\": \\\"2.0\\\",\\n  \\\"id\\\": 1\\n}\""

      Good (fixed):
      ```json
      {
        "jsonrpc": "2.0",
        "id": 1
      }
      ```

      Already good (keep as-is):
      "* `completion`: Object containing:\n  + `values`: Array of suggestions"

      Return the fixed code_snippets array with all snippets properly formatted.
    prompt_debug: True
    drops: [
      answer, answer_indices, answer_reasoning, answer_text,
      my_answer_key, my_answer_text, my_confidence_level, my_reasoning,
      bloom_details, combined_explanation,
      concept_explanation_collapsible, correct_answers,
      distractor_1, distractor_2, distractor_3, distractors,
      exam_name, explanation_why_it_is_incorrect_1,
      explanation_why_it_is_incorrect_2, explanation_why_it_is_incorrect_3,
      fact, feynman_explanation_collapsible, id, key_concept_analogy,
      key_concepts, learning_objectives, marked_result_is_correct,
      memorable_takeaway, options_combined, page_content, platform_name,
      question_explanation, question_type, questionable, quiz_type,
      quote, technical_details, technical_level, url,question, options, answer_explanation, summary_content, fact_explanation,target_word_counts
    ]
    observe: [
      answer, answer_indices, answer_reasoning, answer_text,
      my_answer_key, my_answer_text, my_confidence_level, my_reasoning,
      bloom_details, combined_explanation,
      concept_explanation_collapsible, correct_answers,
      distractor_1, distractor_2, distractor_3, distractors,
      exam_name, explanation_why_it_is_incorrect_1,
      explanation_why_it_is_incorrect_2, explanation_why_it_is_incorrect_3,
      fact, feynman_explanation_collapsible, id, key_concept_analogy,
      key_concepts, learning_objectives, marked_result_is_correct,
      memorable_takeaway, options_combined, page_content, platform_name,
      question_explanation, question_type, questionable, quiz_type,
      quote, technical_details, technical_level, url,question, options, answer_explanation, summary_content, fact_explanation,target_word_counts
    ]

  - name: fix_code_snippets
    kind: tool
    impl: fix_code_snippets
    intent: "Fix double-escaped code snippets in content.code_snippets field"
    granularity: Record


  #["ui_based","ui_based_reasoning","ui_based_confidence_level","question_context_based","question_context_reasoning","question_context_confidence_level","summary_content_valid","summary_content_reasoning","summary_content_confidence_level"]
  - name: review_quiz
    api_key: CLAUDE_API_KEY
    model_vendor: "anthropic"
    model_name: "claude-3-5-haiku-20241022"
    intent: "This takes the quiz to show us if we have issues"
    schema: {"ui_based": "boolean","ui_based_reasoning": "string","ui_based_response_confidence_level": "string"}
    prompt: "You are a quiz reviewer. Your task is to identify if a question is click ops style where user needs a ui, they need to click around a ui to get it, because we are technical assessment, we actually dont need UI based questions ui_based: true or false is this ui base,ui_based_reasoning: what was your thought process, ui_based_confidence_level: what is your confidence level for your response"
    prompt_debug: True
    observe: [
      question, options, answer_explanation, summary_content, fact_explanation,
      answer, answer_indices, answer_reasoning, answer_text,
      my_answer_key, my_answer_text, my_confidence_level, my_reasoning,
      bloom_details, code_snippets, combined_explanation,
      concept_explanation_collapsible, correct_answers,
      distractor_1, distractor_2, distractor_3, distractors,
      exam_name, explanation_why_it_is_incorrect_1,
      explanation_why_it_is_incorrect_2, explanation_why_it_is_incorrect_3,
      fact, feynman_explanation_collapsible, id, key_concept_analogy,
      key_concepts, learning_objectives, marked_result_is_correct,
      memorable_takeaway, options_combined, page_content, platform_name,
      question_explanation, question_type, questionable, quiz_type,
      quote, technical_details, technical_level, url
    ]
    drops: [
      answer, answer_indices, answer_reasoning, answer_text,
      my_answer_key, my_answer_text, my_confidence_level, my_reasoning,
      bloom_details, code_snippets, combined_explanation,
      concept_explanation_collapsible, correct_answers,
      distractor_1, distractor_2, distractor_3, distractors,
      exam_name, explanation_why_it_is_incorrect_1,
      explanation_why_it_is_incorrect_2, explanation_why_it_is_incorrect_3,
      fact, feynman_explanation_collapsible, id, key_concept_analogy,
      key_concepts, learning_objectives, marked_result_is_correct,
      memorable_takeaway, options_combined, page_content, platform_name,
      question_explanation, question_type, questionable, quiz_type,
      quote, technical_details, technical_level, url
    ]




  - name: OptionsCombiner
    kind: tool
    impl: merge_correct_answer_with_distractors
    observe: [target_word_counts,summary_title, summary_content, key_concepts, learning_objectives, technical_details, code_snippets,question_explanation,key_concept_analogy,memorable_takeaway,answer_reasoning,"ui_based","ui_based_reasoning","ui_based_confidence_level","question_context_based","question_context_reasoning","question_context_confidence_level","summary_content_valid","summary_content_reasoning","summary_content_confidence_level"]
    intent: "Create the quiz structure"
    granularity: Record
    guard:
      condition: 'summary_content_valid == true'
      on_false: "skip"

  - name: format_quiz_text
    kind: tool
    impl: format_quiz_object
    intent: "Format the quiz"
    granularity: Record
    guard:
      condition: 'summary_content_valid == true'
      on_false: "skip"




plan:
  - fact_extractor
  - flatten_the_facts <- fact_extractor
