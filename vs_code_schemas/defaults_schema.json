{
  "$defs": {
    "Granularity": {
      "description": "Granularity levels for action execution.",
      "enum": [
        "record",
        "file"
      ],
      "title": "Granularity",
      "type": "string"
    }
  },
  "description": "JSON Schema for Agent Actions workflow defaults configuration",
  "properties": {
    "model_vendor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Default model vendor",
      "title": "Model Vendor"
    },
    "model_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Default model name",
      "title": "Model Name"
    },
    "json_mode": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Default JSON mode setting",
      "title": "Json Mode"
    },
    "granularity": {
      "anyOf": [
        {
          "$ref": "#/$defs/Granularity"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Default granularity"
    },
    "run_mode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Default run mode",
      "title": "Run Mode"
    },
    "context_scope": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "include": {
              "items": {
                "type": "string"
              },
              "title": "Include",
              "type": "array",
              "description": "Fields to include in LLM additional context"
            },
            "exclude": {
              "items": {
                "type": "string"
              },
              "title": "Exclude",
              "type": "array",
              "description": "Fields to exclude from LLM context"
            },
            "passthrough": {
              "items": {
                "type": "string"
              },
              "title": "Passthrough",
              "type": "array",
              "description": "Fields from upstream actions to merge into output"
            }
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Default context scope configuration for all actions",
      "title": "Context Scope"
    }
  },
  "title": "DefaultsConfig",
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#"
}