  "implementation_details": {
    "core_data_structures": {
      "field_source_enum": {
        "values": ["SCHEMA", "OBSERVE", "SOURCE", "LOOP", "WORKFLOW"],
        "description": "Indicates where a field originates from"
      },
      "field_info_class": {
        "fields": ["name: str", "source: FieldSource", "type: Optional[str]", "description: Optional[str]"],
        "description": "Metadata about a single field"
      },
      "input_signature_class": {
        "fields": [
          "dependencies: Dict[str, List[FieldInfo]]",
          "source_fields: List[FieldInfo]", 
          "loop_fields: List[FieldInfo]",
          "workflow_fields: List[FieldInfo]"
        ],
        "methods": [
          "get_all_field_names() -> Set[str]",
          "get_dependency_fields(dep_name) -> List[FieldInfo]"
        ]
      },
      "output_signature_class": {
        "fields": [
          "schema_fields: List[FieldInfo]",
          "observe_fields: List[FieldInfo]", 
          "dropped_fields: List[FieldInfo]"
        ],
        "methods": [
          "get_available_fields() -> Set[str]",
          "get_all_field_names() -> Set[str]"
        ]
      }
    },
    "computation_engine": {
      "output_signature_computation": {
        "algorithm": [
          "1. Extract fields from output_schema (resolve references if needed)",
          "2. Extract fields from observe directive",
          "3. Extract fields from drops directive", 
          "4. Create FieldInfo objects with appropriate sources",
          "5. Return OutputSignature with all field lists"
        ],
        "integration": "Uses existing LLMContextUtils for validation"
      },
      "input_signature_computation": {
        "algorithm": [
          "1. Parse field references from prompt using PromptUtils",
          "2. Group references by dependency name",
          "3. For each dependency, compute available fields using LLMContextUtils",
          "4. Create FieldInfo objects for referenced fields",
          "5. Extract source/loop/workflow field references",
          "6. Return InputSignature with categorized fields"
        ],
        "integration": "Leverages existing prompt parsing and validation"
      }
    },
    "cli_integration": {
      "command_structure": {
        "base_command": "agent-actions inspect",
        "subcommands": ["signatures", "field-flow", "conflicts"],
        "common_options": ["--format json|table", "--agent agent_name"]
      },
      "output_formats": {
        "json": "Machine-readable format for tooling integration",
        "table": "Human-readable format for terminal usage"
      }
    }
  },

  "integration_points": {
    "existing_validation": {
      "llm_context_utils": "Reuse compute_llm_context() for output signature validation",
      "input_signature_validator": "Integrate with existing prompt validation",
      "config_validator": "Extend with signature-based validation"
    },
    "config_loading": {
