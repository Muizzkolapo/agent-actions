    }
  },

  "example_usage": {
    "programmatic_api": {
      "code": "# Get agent configuration\nconfig_manager = ConfigManager(workflow_path, default_path)\nconfig_manager.load_configs()\n# ... setup ...\n\n# Get specific agent\nagent_config = config_manager.get_agent_config('analyzer')\n\n# Get dependency configs\ndependency_configs = {\n    dep: config_manager.get_agent_config(dep) \n    for dep in agent_config.dependencies\n}\n\n# Compute signatures\ninput_sig = agent_config.input_signature(dependency_configs)\noutput_sig = agent_config.output_signature()\n\n# Inspect signatures\nprint(f\"Input fields: {input_sig.get_all_field_names()}\")\nprint(f\"Output fields: {output_sig.get_available_fields()}\")\nprint(f\"Dependencies: {list(input_sig.dependencies.keys())}\")"
    },
    "cli_usage": {
      "commands": [
        "agent-actions inspect signatures workflow.yml",
        "agent-actions inspect field-flow workflow.yml",
        "agent-actions inspect conflicts workflow.yml analyzer",
        "agent-actions inspect signatures workflow.yml --format json --agent analyzer"
      ]
    }
  },

