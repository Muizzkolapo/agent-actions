{
  "title": "Signature API Implementation Plan: `action.input_signature()` and `action.output_signature()`",
  "issue": "signature-apis",
  "priority": "medium",
  "type": "feature",
  "description": "Implement `action.input_signature()` and `action.output_signature()` APIs to enable programmatic inspection of field flow between agents. This provides developers with clear contracts for what fields flow between agents and enables better tooling, validation, and debugging.",

  "current_state": {
    "what_exists": {
      "signature_computation": {
        "file": "agent_actions/agents/validators/llm_context_utils.py",
        "lines": "20-66",
        "functionality": [
          "LLMContextUtils.compute_llm_context() computes available fields formula: (schema_fields + observe) - drops",
          "LLMContextUtils.compute_output_fields() computes output fields",
          "Handles output_schema, observe, drops directives",
          "Used for validation in InputSignatureValidator"
        ],
        "formula": "(schema_fields + observe) - drops + (input_data if return_collection)"
      },
      "config_structures": {
        "legacy_agent_config": {
          "file": "agent_actions/core/parser/config_schema.py",
          "lines": "157+",
          "fields": [
            "agent_type: str",
            "output_schema: Optional[str]",
            "observe: List[str] (pass-through fields)",
            "drops: List[str] (excluded fields)",
            "dependencies: List[str]"
          ]
        },
        "new_action_config": {
          "file": "agent_actions/core/migration/new_format_schema.py", 
          "lines": "44+",
          "fields": [
            "name: str",
            "intent: str",
            "kind: ActionKind",
            "output_schema: Optional[Union[str, Dict[str, Any]]]",
            "observe: List[str]",
            "drops: List[str]"
          ]
        }
      },
      "validation_infrastructure": {
        "file": "agent_actions/agents/validators/input_signature_validator.py",
        "lines": "48+",
        "functionality": [
          "InputSignatureValidator validates field references in prompts",
          "Uses LLMContextUtils for dependency output computation",
          "Validates that referenced fields will be available",
          "Integrated into ConfigManager._validate_input_signatures()"
        ]
      },
      "prompt_field_references": {
        "file": "agent_actions/agents/transformers/prompt_utils.py",
        "functionality": [
          "PromptUtils.parse_field_references() extracts field references from prompts",
          "Handles {reference.field} syntax parsing",
          "Used for input signature validation"
        ]
      },
      "config_management": {
        "file": "agent_actions/agents/handlers/config_handler.py",
        "lines": "21+",
        "functionality": [
          "ConfigManager loads and validates configurations",
          "Manages agent_configs dictionary",
          "Determines execution_order from dependencies",
          "Validates input signatures using InputSignatureValidator"
        ]
      }
    },
    "what_is_missing": {
      "data_structures": [
        "InputSignature class for representing input field requirements",
        "OutputSignature class for representing output field availability",
        "FieldInfo class for field metadata (name, source, type, description)"
      ],
      "computation_engine": [
        "SignatureComputer class to compute signatures from configs",
        "Integration with existing LLMContextUtils",
        "Prompt parsing for input signature extraction"
      ],
      "api_methods": [
        "AgentConfig.input_signature() method",
        "AgentConfig.output_signature() method", 
        "ActionConfig.input_signature() method",
        "ActionConfig.output_signature() method"
      ],
      "cli_tools": [
        "agent-actions inspect signatures command",
        "agent-actions inspect field-flow command",
        "agent-actions inspect conflicts command"
      ],
      "workflow_validation": [
        "Workflow-level signature validation",
        "Field flow validation across entire workflow",
        "Conflict detection between dependencies"
      ]
    }
  },

  "problem_statement": {
    "user_pain_points": [
      "Cannot programmatically inspect what fields flow between agents",
      "No clear contracts for agent input/output interfaces", 
      "Difficult to debug field reference errors",
      "No way to validate field dependencies before execution",
      "Cannot generate field flow documentation automatically",
      "IDE cannot provide autocomplete for field references"
    ],
    "use_cases": [
      {
        "name": "Workflow Validation",
        "description": "Validate field flow correctness before execution",
        "example": "Ensure agent B references only fields available from agent A"
      },
      {
        "name": "IDE Integration", 
        "description": "Enable autocomplete and validation in IDEs",
        "example": "Autocomplete {extractor.summary} based on extractor's output signature"
      },
      {
        "name": "Documentation Generation",
        "description": "Generate field flow diagrams and documentation", 
        "example": "Create visual workflow diagrams showing field dependencies"
      },
      {
        "name": "Debugging Support",
        "description": "Help developers understand field availability",
        "example": "Show exactly which fields are available at each step"
      },
      {
        "name": "Static Analysis",
        "description": "Validate workflows without execution",
        "example": "Catch field reference errors at config time"
      }
    ],
    "business_impact": "Enables better tooling ecosystem, reduces debugging time, improves workflow reliability"
  },

  "solution_overview": {
    "approach": "Build signature APIs on top of existing LLMContextUtils and validation infrastructure",
    "key_insight": "Reuse existing field computation logic and extend configuration objects with signature methods",
    "backward_compatibility": "Pure additive - no breaking changes to existing APIs",
    "deliverables": [
      "Core signature data structures (InputSignature, OutputSignature, FieldInfo)",
      "SignatureComputer class leveraging existing utilities",
      "Signature methods on AgentConfig and ActionConfig",
      "CLI inspection commands",
      "Workflow-level signature validation and conflict detection"
    ]
  },

