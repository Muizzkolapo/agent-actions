          "implementation": {
            "compute_output_signature": "Extract schema fields, observe fields, dropped fields",
            "compute_input_signature": "Parse prompt references, map to dependency outputs",
            "leverage_existing_utils": "Use LLMContextUtils.compute_llm_context()",
            "prompt_parsing": "Use PromptUtils.parse_field_references()"
          },
          "methods": [
            "SignatureComputer.compute_output_signature(agent_config, schema_registry) -> OutputSignature",
            "SignatureComputer.compute_input_signature(agent_config, dependency_configs, schema_registry) -> InputSignature"
          ],
          "lines_added": "~170 lines"
        }
      ],
      "validation_requirements": [
