  "edge_cases": {
    "handled": [
      {
        "case": "Duplicate function names",
        "solution": "Raise DuplicateFunctionError with both locations"
      },
      {
        "case": "Function not found",
        "solution": "Raise FunctionNotFoundError with fuzzy matching suggestions"
      },
      {
        "case": "Import errors in user code",
        "solution": "Wrap in UDFLoadError with module and file context"
      },
      {
        "case": "Circular imports",
        "solution": "Handle gracefully, provide clear error message"
      },
      {
        "case": "Permission errors",
        "solution": "Skip file, log warning, continue discovery"
      },
      {
        "case": "Empty user_code directory",
        "solution": "Log info message, allow workflow to continue"
      },
      {
        "case": "Function renamed after registration",
        "solution": "Re-discovery on config reload clears and rebuilds registry"
      }
    ],
    "testing": "Each edge case has dedicated test coverage"
