{
  "title": "Fix Loop Correlation ID Session Persistence for Batch Processing",
  "issue_number": "TBD",
  "priority": "critical",
  "type": "bugfix", 
  "status": "COMPLETED",
  "discovered_date": "2025-10-15",
  "completion_date": "2025-10-15",
  "description": "Loop correlation IDs are inconsistent across batch sessions when batches complete at different times. The current random UUID-based correlation ID generation combined with in-memory registry causes different correlation IDs for the same logical records when batch sessions restart or complete asynchronously.",

  "symptom": {
    "user_report": "3 batch were submitted... two of them finished at same time, while we waited for one, we noticed that the 3 had different loop corr id",
    "error_message": "Inconsistent correlation IDs across batch sessions for same source records",
    "affected_scenarios": [
      "Multi-batch workflows where batches complete at different times",
      "Batch session restarts or timeouts",
      "Any workflow requiring correlation across multiple batch executions",
      "Loop output merging failing due to correlation mismatches"
    ],
    "workflow_example": {
      "scenario": "3 parallel batches (generate_distractors_1, _2, _3) processing same source records",
      "problem": "Batch 1 & 2 complete → sessions close → registry cleared → Batch 3 generates new correlation IDs",
      "result": "Same source_guid gets different correlation IDs across batches"
    }
  },

  "root_causes": [
    {
      "cause_1": {
        "title": "Session-Isolated In-Memory Registry",
        "severity": "critical",
        "file": "agent_actions/core/utils/processor_utils.py",
        "location": "_loop_correlation_registry class variable (line 319)",
        "problem": "The correlation registry is an in-memory dictionary that gets cleared when batch sessions end, causing correlation ID loss between batches",
        "impact": "Different batch sessions generate different correlation IDs for the same logical records",
        "technical_details": {
          "current_flow": "Batch 1 starts → generates IDs → completes → session ends → registry cleared → Batch 2 starts → generates NEW IDs for same records",
          "registry_scope": "Process-level, not workflow-level",
          "persistence": "None - purely in-memory"
        }
      }
    },
    {
      "cause_2": {
        "title": "Random UUID Generation",
        "severity": "high", 
        "file": "agent_actions/core/utils/processor_utils.py",
        "location": "get_or_create_loop_correlation_id method (line 339)",
        "problem": "Using random UUIDs (uuid.uuid4()) means identical inputs produce different outputs across sessions",
        "impact": "No deterministic way to recreate the same correlation ID for the same source record",
        "technical_details": {
          "current_logic": "str(uuid.uuid4()) - completely random",
          "determinism": "None - same inputs = different outputs",
          "session_independence": "No way to recreate correlation IDs across sessions"
        }
      }
    },
    {
      "cause_3": {
        "title": "Missing Workflow Session Context",
        "severity": "medium",
        "file": "Multiple files in workflow execution",
        "problem": "No shared session/workflow identifier that persists across all batches in the same logical workflow",
        "impact": "No way to group batches that should share correlation IDs",
        "technical_details": {
          "missing_concept": "Workflow session ID that spans multiple batch executions",
          "current_scope": "Each batch creates its own isolated correlation context",
          "needed_scope": "All batches in same workflow share correlation context"
        }
      }
    }
  ],

  "solution_design": {
    "approach": "Deterministic Session-Aware Correlation IDs",
    "strategy": "Replace random UUIDs with deterministic hashes based on workflow session + source content",
    "key_principles": [
      "Same workflow session + source record = identical correlation ID",
      "Deterministic generation survives session restarts",
      "Backward compatible method signatures during development",
      "Thread-safe (builds on PR #458 foundation)"
    ],
    "implementation_overview": {
      "step_1": "✅ COMPLETED - Add workflow_session_id parameter to correlation methods",
      "step_2": "✅ COMPLETED - Implement deterministic correlation ID generation using content hashes",
      "step_3": "✅ COMPLETED - Generate workflow session IDs at workflow start",
      "step_4": "✅ COMPLETED - Thread workflow session ID through all correlation calls",
      "step_5": "✅ COMPLETED - Update tests and validate multi-batch scenarios"
    },
    "implementation_status": "COMPLETED",
    "completion_date": "2025-10-15"
  },

  "files_modified": [
    {
      "file": "agent_actions/core/utils/processor_utils.py",
      "changes": [
        {
          "location": "line 323 - get_or_create_loop_correlation_id signature",
          "change": "Add workflow_session_id: str parameter",
          "rationale": "Provide session context for deterministic correlation ID generation"
        },
        {
          "location": "line 344 - get_or_create_position_based_loop_correlation_id signature", 
          "change": "Add workflow_session_id: str parameter",
          "rationale": "Ensure position-based correlation also uses session context"
        },
        {
          "location": "line 376 - add_loop_correlation_id method",
          "change": "Extract workflow_session_id from agent_config and pass to correlation methods",
          "rationale": "Bridge between agent config and correlation ID generation"
        },
        {
          "location": "New method - _generate_deterministic_correlation_id",
          "change": "Add static method for deterministic ID generation using SHA256 hash",
          "rationale": "Replace random UUIDs with content-based deterministic IDs"
        },
        {
          "location": "New method - _get_workflow_session_id",
          "change": "Add method to extract/generate workflow session ID from context",
          "rationale": "Centralize workflow session ID management logic"
        },
        {
          "location": "line 335 & 361 - registry key generation",
          "change": "Include workflow_session_id in registry keys for proper scoping",
          "rationale": "Ensure correlation IDs are scoped to workflow sessions"
        },
        {
          "location": "line 339 & 365 - correlation ID generation",
          "change": "Replace str(uuid.uuid4()) with _generate_deterministic_correlation_id()",
          "rationale": "Use deterministic generation instead of random UUIDs"
        }
      ]
    },
    {
      "file": "agent_actions/core/graph/agent_workflow.py",
      "changes": [
        {
          "location": "line ~50 - __init__ method",
          "change": "Generate workflow_session_id during workflow initialization",
          "rationale": "Create persistent session ID for entire workflow execution"
        },
        {
          "location": "line ~564 - _handle_batch_agent method",
          "change": "Include workflow_session_id in agent_config passed to batch service",
          "rationale": "Ensure batch processing has access to workflow session context"
        },
        {
          "location": "line ~190 - _run_single_agent_async method",
          "change": "Pass workflow_session_id through to agent execution",
          "rationale": "Ensure parallel execution maintains session context"
        }
      ]
    },
    {
      "file": "agent_actions/tasks/services/batch_service.py", 
      "changes": [
        {
          "location": "line ~1145 - add_loop_correlation_id call in _convert_batch_results_to_workflow_format",
          "change": "Ensure agent_config contains workflow_session_id when calling ProcessorUtils.add_loop_correlation_id",
          "rationale": "Provide session context during batch result processing"
        }
      ]
    }
  ],

  "implementation_details": {
    "deterministic_algorithm": {
      "input": "workflow_session_id + loop_base_name + source_guid",
      "method": "SHA256 hash",
      "output_format": "corr_{first_16_chars_of_hash}",
      "example": "corr_a1b2c3d4e5f6g7h8",
      "collision_probability": "Negligible (SHA256 truncated to 16 chars = 64 bits entropy)"
    },
    "workflow_session_id_generation": {
      "format": "workflow_{timestamp}_{workflow_hash}",
      "timestamp": "Unix timestamp when workflow starts",
      "workflow_hash": "Hash of workflow configuration/name",
      "example": "workflow_1697385600_abc123def456",
      "persistence": "Stored in workflow context for entire execution"
    },
    "registry_key_format": {
      "before": "{loop_base_name}:{source_guid}",
      "after": "{workflow_session_id}:{loop_base_name}:{source_guid}",
      "benefit": "Session-scoped keys prevent cross-session conflicts"
    }
  },

