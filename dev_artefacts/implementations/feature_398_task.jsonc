{
  "title": "Simplify and unify schema compilation architecture (Issue #398 - Repurposed)",
  "issue": "#398",
  "priority": "medium",
  "description": "Remove redundant provider abstraction layer for schema compilation and unify online/batch pathways to use the same validation logic, error handling, and user feedback mechanisms.",

  "original_issue_assessment": {
    "original_title": "Utilize supports_schema_validation() capability flag in batch processing",
    "diagnosis": "Issue misdiagnosed - the supports_schema_validation() method is architecturally redundant",
    "root_cause": "Method exists but is never used because schema support is determined by compile_unified_schema(), not provider methods",
    "real_problems": [
      "Redundant provider abstraction layer (compile_schema() methods just delegate)",
      "Inconsistent architecture between online and batch modes",
      "No graceful handling or warnings for unsupported vendors",
      "Hardcoded vendor lists in multiple places instead of single source of truth"
    ]
  },

  "core_principle": {
    "requirement": "SAME PATHWAY FOR ONLINE AND BATCH - SAME VALIDATIONS APPLY",
    "explanation": [
      "Online and batch modes MUST use identical schema compilation logic",
      "Same vendor support checking mechanism",
      "Same error messages and warnings",
      "Same fallback behavior when vendor doesn't support schemas",
      "Same user experience regardless of run mode",
      "Single source of truth for schema support (compile_unified_schema())"
    ],
    "current_state": "INCONSISTENT - Two different code paths doing the same thing",
    "target_state": "UNIFIED - Both modes call compile_unified_schema() directly with identical error handling"
  },

  "current_architecture_problems": {
