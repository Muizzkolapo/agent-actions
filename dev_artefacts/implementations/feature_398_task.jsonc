    "phase_2_unify_pathways": {
      "priority": "high",
      "description": "Create unified schema preparation logic used by both online and batch modes",
      "status": "completed",
      "core_principle_reminder": "SAME PATHWAY FOR ONLINE AND BATCH - SAME VALIDATIONS APPLY",
      "tasks": [
        {
          "id": "create_unified_prepare_schema",
          "title": "Create unified _prepare_schema_unified() helper function",
          "file": "agent_actions/core/parser/schema_change.py",
          "description": "Single function that both online and batch modes will use",
          "function_signature": "def prepare_schema_unified(agent_config: Dict[str, Any], vendor: str) -> Optional[Dict[str, Any]]",
          "implementation": {
            "steps": [
              "1. Extract schema from agent_config (inline or schema_name)",
              "2. Return None if no schema provided",
              "3. Return None if vendor == 'tool' (special case)",
              "4. Load base schema using SchemaLoader",
              "5. Try to compile using compile_unified_schema(base_schema, vendor)",
              "6. If ConfigValidationError: log warning with helpful message, return None",
              "7. If success: return compiled schema"
            ],
            "warning_format": {
              "level": "WARNING",
              "message": "Vendor '{vendor}' does not support schema validation. Schema '{schema_name}' will be ignored.",
              "suggestion": "For schema support, use one of: openai, anthropic, gemini, ollama",
              "context": {
                "vendor": "The vendor that doesn't support schemas",
                "schema_name": "The schema user requested",
                "supported_vendors": ["openai", "anthropic", "gemini", "ollama"]
              }
            }
          },
          "lines_added": "~35 lines",
          "status": "completed"
        },
        {
          "id": "update_online_mode",
          "title": "Update agent_builder.py to use unified function",
          "file": "agent_actions/agents/base/agent_builder.py",
          "lines": "168-184",
          "current_code": "def _prepare_schema(agent_config, model_vendor):\n    # Hardcoded logic with SCHEMA_COMPILATION_VENDORS check",
          "new_code": "def _prepare_schema(agent_config, model_vendor):\n    from agent_actions.core.parser.schema_change import prepare_schema_unified\n    return prepare_schema_unified(agent_config, model_vendor)",
          "changes": "Replace entire function body with call to unified function",
          "lines_removed": "~16 lines",
          "lines_added": "~3 lines",
          "net_change": "-13 lines",
          "validation": "SAME as batch mode now",
          "status": "completed"
        },
        {
          "id": "update_batch_mode",
          "title": "Update batch_service.py to use unified function",
          "file": "agent_actions/tasks/services/batch_service.py",
          "lines": "363-380",
          "current_code": "def _prepare_schema(self, agent_config, provider=None):\n    # Delegates to provider.compile_schema()",
          "new_code": "def _prepare_schema(self, agent_config, provider=None):\n    from agent_actions.core.parser.schema_change import prepare_schema_unified\n    # Get vendor name from provider\n    vendor = type(provider).__name__.replace('BatchProvider', '').lower()\n    return prepare_schema_unified(agent_config, vendor)",
          "changes": "Replace delegation to provider with call to unified function",
          "lines_removed": "~17 lines",
          "lines_added": "~5 lines",
          "net_change": "-12 lines",
          "validation": "SAME as online mode now",
          "status": "completed"
        }
      ],
      "validation_requirements": [
        "✅ Both modes call prepare_schema_unified()",
        "✅ Both modes get same warning messages",
        "✅ Both modes handle unsupported vendors identically",
        "✅ Both modes return None for unsupported vendors",
        "✅ Single source of truth (compile_unified_schema())",
        "✅ Same user experience online and batch"
