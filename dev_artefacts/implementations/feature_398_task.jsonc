  "implementation_before_after": {
    "before_online_mode": {
      "file": "agent_builder.py",
      "code": "SCHEMA_COMPILATION_VENDORS = {'openai', 'anthropic', 'gemini', 'ollama'}\n\ndef _prepare_schema(agent_config, model_vendor):\n    inline_schema = agent_config.get(SCHEMA_KEY) if model_vendor != 'tool' else None\n    if inline_schema:\n        base_schema = SchemaLoader.construct_schema_from_dict(inline_schema)\n        return (compile_unified_schema(base_schema, model_vendor)\n                if model_vendor in SCHEMA_COMPILATION_VENDORS else base_schema)\n    \n    schema_name = agent_config.get(SCHEMA_NAME_KEY) if model_vendor != 'tool' else None\n    if not schema_name:\n        return None\n    \n    base_schema = SchemaLoader.load_schema(schema_name)\n    return (compile_unified_schema(base_schema, model_vendor)\n            if model_vendor in SCHEMA_COMPILATION_VENDORS else base_schema)",
      "issues": [
        "Hardcoded vendor set",
        "Returns base schema for unsupported (no warning)",
        "Different logic than batch mode"
      ]
    },
    "before_batch_mode": {
      "file": "batch_service.py",
      "code": "def _prepare_schema(self, agent_config, provider=None):\n    inline_schema = agent_config.get(SCHEMA_KEY)\n    if inline_schema:\n        base_schema = SchemaLoader.construct_schema_from_dict(inline_schema)\n    else:\n        schema_name = agent_config.get(SCHEMA_NAME_KEY)\n        if not schema_name:\n            return None\n        base_schema = SchemaLoader.load_schema(schema_name)\n    \n    if provider is None:\n        provider = self.provider\n    return provider.compile_schema(base_schema)",
      "issues": [
        "Delegates to provider method",
        "Provider method just calls compile_unified_schema()",
        "Extra indirection",
        "Different logic than online mode"
      ]
    },
    "after_both_modes": {
      "file": "schema_change.py (new unified function)",
      "code": "def prepare_schema_unified(agent_config: Dict[str, Any], vendor: str) -> Optional[Dict[str, Any]]:\n    \"\"\"Unified schema preparation for both online and batch modes.\"\"\"\n    \n    # Special case: tool vendor never uses schemas\n    if vendor == 'tool':\n        return None\n    \n    # Check for inline schema\n    inline_schema = agent_config.get(SCHEMA_KEY)\n    if inline_schema:\n        base_schema = SchemaLoader.construct_schema_from_dict(inline_schema)\n        schema_name = agent_config.get('name', 'inline_schema')\n    else:\n        # Check for schema_name\n        schema_name = agent_config.get(SCHEMA_NAME_KEY)\n        if not schema_name:\n            return None\n        base_schema = SchemaLoader.load_schema(schema_name)\n    \n    # Try to compile for this vendor\n    try:\n        return compile_unified_schema(base_schema, vendor)\n    except ConfigValidationError as e:\n        # Vendor doesn't support schemas\n        logger.warning(\n            f\"Vendor '{vendor}' does not support schema validation. \"\n            f\"Schema '{schema_name}' will be ignored. \"\n            f\"For schema support, use one of: openai, anthropic, gemini, ollama\"\n        )\n        return None",
      "benefits": [
        "✅ Single code path for online and batch",
        "✅ Same validations apply",
        "✅ Same warnings shown to users",
        "✅ Same error handling",
        "✅ Vendor support determined by compile_unified_schema()",
        "✅ No hardcoded vendor lists"
      ]
    },
    "updated_online_mode": {
      "file": "agent_builder.py",
      "code": "def _prepare_schema(agent_config, model_vendor):\n    from agent_actions.core.parser.schema_change import prepare_schema_unified\n    return prepare_schema_unified(agent_config, model_vendor)",
      "improvements": [
        "3 lines instead of 16",
        "Delegates to unified function",
        "Same behavior as batch mode"
      ]
    },
    "updated_batch_mode": {
      "file": "batch_service.py",
      "code": "def _prepare_schema(self, agent_config, provider=None):\n    from agent_actions.core.parser.schema_change import prepare_schema_unified\n    if provider is None:\n        provider = self.provider\n    vendor = type(provider).__name__.replace('BatchProvider', '').lower()\n    return prepare_schema_unified(agent_config, vendor)",
      "improvements": [
        "6 lines instead of 17",
        "Delegates to unified function",
        "Same behavior as online mode"
      ]
    }
  },

