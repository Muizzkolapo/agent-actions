  "codebase_discoveries": {
    "description": "Additional issues discovered during codebase review",
    "findings": [
      {
        "area": "Model Validation",
        "issue": "vendor_config.py has Pydantic validators for each vendor's models (validate_openai_model, validate_claude_model, etc.) but they're not integrated into the main config validation flow",
        "impact": "Users can specify invalid model names and won't get validation errors until runtime",
        "files": ["agent_actions/core/parser/vendor_config.py"]
      },
      {
        "area": "API Key Aliases",
        "issue": "Anthropic supports both CLAUDE_API_KEY and ANTHROPIC_API_KEY but handling is inconsistent across codebase",
        "impact": "Confusion about which env var to use, inconsistent behavior",
        "files": [
          "agent_actions/integrations/providers/factory.py (line 84 - uses CLAUDE_API_KEY)",
          "agent_actions/integrations/providers/anthropic/provider.py (line 59 - expects ANTHROPIC_API_KEY)",
          "agent_actions/core/context/environment_config.py (line 49 - has alias support)"
        ]
      },
      {
        "area": "VendorRegistry Unused",
        "issue": "vendor_config.py has VendorRegistry class with useful methods but it's never instantiated or used",
        "impact": "Missing opportunity for centralized vendor configuration and validation",
        "files": ["agent_actions/core/parser/vendor_config.py (lines 231-269)"]
      },
      {
        "area": "Environment Variable Interpolation",
        "issue": "System supports ${VAR} syntax in configs but doesn't validate that vars exist before runtime",
        "impact": "Cryptic errors when env vars are missing",
        "current_usage": "Used in api_key field throughout configs"
      },
      {
        "area": "Batch Service Config",
        "issue": "Batch service uses different config approach than main agent flow",
        "impact": "Inconsistent configuration experience, hierarchy may not be respected",
        "files": ["agent_actions/tasks/services/batch_service.py (lines 240-250)"]
      },
      {
        "area": "Tool Actions",
        "issue": "Tool actions have special behaviors (vendor='tool', no batch mode) but limited documentation",
        "impact": "Users don't understand when to use tool vs llm actions",
        "files": ["agent_actions/core/parser/action_expander.py (lines 134-150)"]
      },
      {
        "area": "Configuration Examples",
        "issue": "No example agent_actions.yml or workflow templates found in codebase",
        "impact": "Users have no reference for how to structure configs",
        "searched": "**/*example*.yml, **/agent_actions.yml - found none"
      },
      {
        "area": "JSON Schema Generation",
        "issue": "Pydantic models exist but no JSON Schema generated for IDE autocomplete",
        "impact": "Users miss out on IDE validation and autocomplete",
        "opportunity": "Can generate from AgentConfig and VendorConfig models"
      }
    ],
    "positive_findings": [
      {
        "area": "Error Handling",
        "note": "Issue #394 has been completed - comprehensive error handling system in place",
        "benefit": "New validation can leverage format_user_error() for consistent user-friendly messages"
      },
      {
        "area": "Test Infrastructure",
        "note": "test_config_handler_new_format.py has good foundation for hierarchy tests",
        "benefit": "Can extend existing test structure for new validation"
      },
      {
        "area": "Pydantic Models",
        "note": "Strong Pydantic model foundation with validators already written",
        "benefit": "Just need to integrate validators into config flow, not write from scratch"
      }
    ]
  },

