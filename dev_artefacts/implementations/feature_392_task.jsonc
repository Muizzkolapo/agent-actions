{
  "title": "Review and improve configuration hierarchy and validation",
  "issue": "#392",
  "priority": "high",
  "description": "Review and improve the configuration hierarchy system to ensure proper inheritance and validation across all levels: project → workflow → action. Add clear documentation, improved validation, and consider field name consistency. EXPANDED after codebase review to include: model/vendor validation, API key handling, environment variable interpolation, VendorRegistry integration, configuration examples, and JSON schema generation.",

  "background": {
    "description": "Recent changes improved the configuration hierarchy to properly support project-level config (agent_actions.yml), workflow-level config (defaults section), and action-level config (individual action settings). However, there are opportunities to improve validation and clarity.",
    "current_support": [
      "Project-level config (agent_actions.yml)",
      "Workflow-level config (defaults section)",
      "Action-level config (individual action settings)"
    ],
    "field_name_differences": {
      "project_level": ["model_vendor", "model_name"],
      "workflow_action_level": ["vendor", "model"]
    }
  },

  "phases": {
    "phase_1_configuration_hierarchy_documentation": {
      "priority": "critical",
      "description": "Document the 3-level hierarchy clearly with examples and explanations",
      "status": "completed",
      "completion_date": "2025-10-01",
      "tasks": [
        {
          "id": "document_3_level_hierarchy",
          "title": "Document the 3-level hierarchy structure",
          "description": "Create clear documentation explaining project → workflow → action hierarchy",
          "sections_to_create": [
            "Overview of 3-level hierarchy",
            "How inheritance works at each level",
            "Precedence order (action > workflow > project)"
          ],
          "suggested_location": "agentaction-docs/docs/core-concepts/configuration-hierarchy.md",
          "status": "completed",
          "implementation_summary": "Created comprehensive documentation with visual diagram showing 3-level hierarchy and precedence order"
        },
        {
          "id": "document_field_name_differences",
          "title": "Explain field name differences (vendor vs model_vendor, model vs model_name)",
          "description": "Document why different field names exist and when to use each",
          "content_to_cover": [
            "Project-level uses model_vendor/model_name",
            "Workflow/Action-level uses vendor/model",
            "Historical reasons for the difference",
            "Backward compatibility considerations"
          ],
          "status": "completed",
          "implementation_summary": "Added dedicated section explaining field naming conventions with table comparing levels. Created GitHub issue #416 to standardize naming in future"
        },
        {
          "id": "provide_hierarchy_examples",
          "title": "Provide examples showing how inheritance works",
          "description": "Create comprehensive examples demonstrating config inheritance",
          "examples_needed": [
            {
              "scenario": "Project defaults only",
              "example": "All actions inherit project-level vendor/model"
            },
            {
              "scenario": "Workflow defaults override project",
              "example": "Workflow defaults override project settings for all actions in workflow"
            },
            {
              "scenario": "Action-level overrides workflow",
              "example": "Individual action overrides both workflow and project defaults"
            },
            {
              "scenario": "Mixed inheritance",
              "example": "Some fields from project, some from workflow, some from action"
            }
          ],
          "status": "completed",
          "implementation_summary": "Created 4 complete examples (Example 1-4) with full YAML configurations showing each inheritance pattern. Each example includes detailed comments explaining the final merged configuration"
        },
        {
          "id": "document_required_fields",
          "title": "Document which fields are required at which level",
          "description": "Clarify which configuration fields must be present at each level",
          "fields_to_document": [
            {
              "field": "vendor/model_vendor",
              "required_at": "At least one level (project, workflow, or action)",
              "note": "Required after hierarchy resolution"
            },
            {
              "field": "model/model_name",
              "required_at": "At least one level (project, workflow, or action)",
              "note": "Required after hierarchy resolution"
            },
            {
              "field": "api_key",
              "required_at": "At least one level (project, workflow, or action)",
              "note": "Can be environment variable reference. Required after hierarchy resolution"
            }
          ],
          "status": "completed",
          "implementation_summary": "Created comprehensive 'Required Fields' section with table, explanation of 'after hierarchy resolution', and valid/invalid configuration examples"
        }
      ],
      "deliverables": {
        "files_created": [
          "agentaction-docs/docs/core-concepts/configuration-hierarchy.md (~525 lines)"
        ],
        "files_modified": [
          "agentaction-docs/sidebars.ts (added to navigation)"
        ],
        "verification": [
          "Verified merge logic against config_handler.py:161",
          "Verified precedence logic against action_expander.py:61-63",
          "Verified examples against test_config_handler_new_format.py",
          "Docusaurus build successful - no broken links"
        ],
        "related_issues": [
          "Created issue #416 for field name standardization"
        ]
      },
      "key_achievements": [
        "Clear visual representation of 3-level hierarchy",
        "4 realistic examples covering all inheritance patterns",
        "Comprehensive required fields documentation",
        "Best practices and FAQ section",
        "Successfully integrated into Docusaurus navigation"
      ]
    },

    "phase_2_validation_improvements": {
      "priority": "critical",
      "description": "Add validation to ensure required fields are present after hierarchy resolution",
      "status": "completed",
      "completion_date": "2025-10-01",
      "tasks": [
        {
          "id": "validate_required_fields",
          "title": "Add validation to ensure required fields (vendor, model, api_key) are present after hierarchy resolution",
          "files_to_modify": [
            "agent_actions/core/parser/action_expander.py",
            "agent_actions/agents/handlers/config_handler.py"
          ],
          "description": "Add validation logic that checks for required fields after config hierarchy is resolved",
          "validation_points": [
            "After merging project → workflow → action configs",
            "Before passing config to vendor/provider"
          ],
          "required_fields": ["vendor", "model", "api_key"],
          "status": "completed",
          "implementation_summary": "Added _validate_required_fields() method in action_expander.py (lines 96-140). Validation called after config merge (line 170). Raises ConfigValidationError with detailed context including missing fields and hints."
        },
        {
          "id": "validate_api_key_env_vars",
          "title": "Validate that API key environment variables actually exist",
          "files_to_modify": [
            "agent_actions/integrations/providers/vendor_base.py"
          ],
          "description": "Check if referenced environment variables exist before attempting to use them",
          "validation_logic": [
            "If api_key starts with ${...}, extract env var name",
            "Check if env var is set in environment",
            "Raise clear error if env var doesn't exist"
          ],
          "error_message_template": "Environment variable '${VAR_NAME}' referenced in api_key is not set. Please set it or update your configuration.",
          "status": "completed",
          "implementation_summary": "Enhanced get_api_key() method in vendor_base.py (lines 10-65). Parses both ${VAR} and direct VAR formats. Validates env var exists with os.getenv(). Raises ConfigurationError with env var name and export command hint."
        },
        {
          "id": "clear_error_messages",
          "title": "Provide clear error messages when required config is missing",
          "description": "Create user-friendly error messages that guide users to fix configuration issues",
          "error_scenarios": [
            {
              "scenario": "Missing vendor after hierarchy resolution",
              "error_message": "Configuration Error: Missing required field 'vendor'\n\n  Action: {action_name}\n  Issue: No vendor specified at project, workflow, or action level\n\n  Fix: Add vendor to one of:\n  1. agent_actions.yml (project-level)\n  2. Workflow defaults section\n  3. Action-level config\n\n  Example:\n  model_vendor: anthropic\n  model_name: claude-3-5-sonnet-20241022"
            },
            {
              "scenario": "Missing model after hierarchy resolution",
              "error_message": "Configuration Error: Missing required field 'model'\n\n  Action: {action_name}\n  Issue: No model specified at project, workflow, or action level"
            },
            {
              "scenario": "Missing API key environment variable",
              "error_message": "Configuration Error: API key environment variable not found\n\n  Action: {action_name}\n  Variable: ${ANTHROPIC_API_KEY}\n  Issue: Environment variable is not set\n\n  Fix: Set the environment variable:\n  export ANTHROPIC_API_KEY=your-key-here"
            },
            {
              "scenario": "Invalid vendor value",
              "error_message": "Configuration Error: Invalid vendor specified\n\n  Action: {action_name}\n  Vendor: {invalid_vendor}\n  Supported vendors: anthropic, openai, gemini, groq"
            }
          ],
          "status": "completed",
          "implementation_summary": "Added _format_missing_required_fields_error() and _format_missing_env_var_error() methods to user_errors.py (lines 234-323). Enhanced _handle_config_error() to detect and format these errors. Messages include action name, missing fields, and examples at all 3 hierarchy levels."
        },
        {
          "id": "deprecated_field_warnings",
          "title": "Add warnings for deprecated field names",
          "description": "Warn users if they're using deprecated or inconsistent field names",
          "implementation": "Add deprecation warnings when old field names are detected",
          "warning_template": "Warning: Field name '{old_name}' is deprecated. Please use '{new_name}' instead.",
          "status": "completed",
          "implementation_summary": "Added _check_deprecated_field_names() method in action_expander.py (lines 46-93). Checks workflow defaults and actions for model_vendor/model_name usage. Issues DeprecationWarning with link to issue #416. Called before config merge (line 158)."
        }
      ],
      "deliverables": {
        "files_modified": [
          "agent_actions/core/parser/action_expander.py - Added validation and deprecation checking",
          "agent_actions/integrations/providers/vendor_base.py - Enhanced env var validation",
          "agent_actions/core/user_errors.py - Added config-specific error formatting"
        ],
        "new_methods": [
          "ActionExpander._validate_required_fields()",
          "ActionExpander._check_deprecated_field_names()",
          "BaseVendorHandler.get_api_key() - enhanced",
          "ErrorTranslator._format_missing_required_fields_error()",
          "ErrorTranslator._format_missing_env_var_error()"
        ],
        "error_improvements": [
          "Missing vendor/model/api_key → Clear message with 3-level hierarchy examples",
          "Missing env var → Shows exact export command",
          "Deprecated field names → DeprecationWarning with migration guide link"
        ]
      },
      "key_achievements": [
        "Validation catches missing config at parse time (not runtime)",
        "User-friendly errors show exactly where to add missing config",
        "Environment variable validation prevents late-stage auth failures",
        "Deprecation warnings guide users toward consistent naming",
        "All errors leverage format_user_error() from issue #394"
      ]
    },

