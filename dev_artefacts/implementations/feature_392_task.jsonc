  "user_experience_examples": {
    "missing_vendor": {
      "before": {
        "user_sees": "KeyError: 'vendor'",
        "user_action": "??? Confused - where should vendor be specified?"
      },
      "after": {
        "user_sees": "Configuration Error: Missing required field 'vendor'\n\n  Action: my-action\n  Issue: No vendor specified at project, workflow, or action level\n\n  Fix: Add vendor to one of:\n  1. agent_actions.yml (project-level): model_vendor: anthropic\n  2. Workflow defaults: vendor: anthropic\n  3. Action config: vendor: anthropic",
        "user_action": "Clear - add vendor to one of the three levels"
      }
    },
    "missing_env_var": {
      "before": {
        "user_sees": "KeyError: 'ANTHROPIC_API_KEY'",
        "user_action": "??? Where should this be set?"
      },
      "after": {
        "user_sees": "Configuration Error: API key environment variable not found\n\n  Action: my-action\n  Variable: ANTHROPIC_API_KEY\n  Issue: Environment variable is not set\n\n  Fix: Set the environment variable:\n  export ANTHROPIC_API_KEY=your-key-here\n\n  Or add to .env file:\n  ANTHROPIC_API_KEY=your-key-here",
        "user_action": "Clear - set the environment variable"
      }
    },
    "field_name_confusion": {
      "before": {
        "user_sees": "Config works in workflow but not in agent_actions.yml",
        "user_action": "??? Why is vendor not working in project config?"
      },
      "after": {
        "user_sees": "Documentation clearly explains:\n  - Project-level: use model_vendor and model_name\n  - Workflow/Action-level: use vendor and model\n\nOr after standardization:\n  - All levels: use vendor and model (consistent everywhere)",
        "user_action": "Clear - knows which field names to use at each level"
      }
    }
  },

