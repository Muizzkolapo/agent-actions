      "✅ No breaking changes",
      "✅ Clear documentation",
      "✅ Helpful error messages"
    ],
    "user_experience": [
      "✅ Matches behavior of familiar tools (git, dbt, npm)",
      "✅ No surprise behavior",
      "✅ Clear feedback about what's happening",
      "✅ Helpful suggestions when something goes wrong"
    ]
  },

  "comparison": {
    "before": {
      "must_be_at_root": true,
      "example": {
        "directory": "/my-project",
        "command": "agent-actions run -a my_agent",
        "result": "✅ Works"
      },
      "fails_from_subdirectory": {
        "directory": "/my-project/src/utils",
        "command": "agent-actions run -a my_agent",
        "result": "❌ Error: Cannot find agent_actions.yml"
      }
    },
    "after": {
      "works_from_root": {
        "directory": "/my-project",
        "command": "agent-actions run -a my_agent",
        "output": "📁 Project root: .\n✅ Works"
      },
      "works_from_subdirectory": {
        "directory": "/my-project/src/utils",
        "command": "agent-actions run -a my_agent",
        "output": "📁 Project root: ../..\n✅ Works"
      },
      "clear_error_outside_project": {
        "directory": "/tmp",
        "command": "agent-actions run -a my_agent",
        "output": "❌ Error: Not in an agent-actions project\n   Solutions:\n     1. Navigate to your agent-actions project directory\n     2. Run 'agent-actions init' to create a new project"
      }
    }
  },

