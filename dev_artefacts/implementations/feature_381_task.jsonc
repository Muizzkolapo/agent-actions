  "implementation_before_after": {
    "before_parallel_only": {
      "schema": {
        "loop": {
          "param": "stage",
          "range": [1, 5]
        }
      },
      "expansion": {
        "agents_created": ["refiner_1", "refiner_2", "refiner_3", "refiner_4", "refiner_5"],
        "dependencies": {
          "refiner_1": ["input_agent"],
          "refiner_2": ["input_agent"],
          "refiner_3": ["input_agent"],
          "refiner_4": ["input_agent"],
          "refiner_5": ["input_agent"]
        },
        "execution": "All 5 iterations run in parallel",
        "limitation": "Cannot implement iterative refinement - each iteration is independent"
      }
    },
    "after_with_sequential": {
      "schema": {
        "loop": {
          "param": "stage",
          "range": [1, 5],
          "mode": "sequential"
        },
        "reads": ["input_data", "refined_${stage-1}"],
        "writes": ["refined_${stage}"],
        "prompt": "Stage ${stage}: Refine the output from stage ${stage-1}"
      },
      "expansion": {
        "agents_created": ["refiner_1", "refiner_2", "refiner_3", "refiner_4", "refiner_5"],
        "dependencies": {
          "refiner_1": ["input_agent"],
          "refiner_2": ["refiner_1"],
          "refiner_3": ["refiner_2"],
          "refiner_4": ["refiner_3"],
          "refiner_5": ["refiner_4"]
        },
        "execution": "Iterations run in sequence: 1 → 2 → 3 → 4 → 5",
        "capability": "✅ Each iteration can access and refine previous iteration output"
      }
    },
