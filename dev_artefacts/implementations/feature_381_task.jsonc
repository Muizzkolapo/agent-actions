  "batch_online_parity": {
    "core_principle": "SEQUENTIAL LOOPS MUST WORK IDENTICALLY IN BATCH AND ONLINE MODES",
    "why_this_matters": {
      "problem": "Batch and online modes use same dependency chain but different execution mechanisms",
      "risk": "Sequential dependencies could break in batch mode if not properly validated",
      "solution": "Comprehensive testing and validation to ensure identical behavior"
    },

    "how_batch_mode_works": {
      "current_architecture": {
        "execution_flow": [
          "1. AgentWorkflow iterates through execution_order sequentially",
          "2. For each agent, checks if run_mode=='batch'",
          "3. If batch: Submits batch jobs, updates status to 'batch_submitted', BREAKS execution",
          "4. User runs workflow again later",
          "5. Workflow checks batch status, if completed, continues to next agent",
          "6. If next agent also batch, process repeats"
        ],
        "key_files": {
          "workflow": "agent_actions/core/graph/agent_workflow.py (lines 414-438, 492-524)",
          "batch_service": "agent_actions/tasks/services/batch_service.py",
          "strategies": "agent_actions/core/runtime/agent_strategies.py"
        }
      },
      "dependency_enforcement": {
        "mechanism": "Execution order list enforces dependencies",
        "file": "agent_actions/core/graph/agent_workflow.py (lines 386)",
        "how_it_works": [
          "execution_order is built from dependency graph (topological sort)",
          "Agents execute in order: [agent_1, agent_2, agent_3, ...]",
          "If agent_2 depends on agent_1, agent_2 comes after agent_1 in list",
          "Batch mode: If agent_1 is batch, workflow breaks, agent_2 never runs until agent_1 completes"
        ],
        "critical_insight": "Dependencies are implicit in execution_order, not checked at runtime"
      }
    },

    "sequential_loops_in_batch_mode": {
      "scenario": "5-iteration sequential loop where each iteration runs in batch mode",
      "configuration": {
        "loop": {
          "param": "stage",
          "range": [1, 5],
          "mode": "sequential"
        },
        "run_mode": "batch"
      },
      "execution_timeline": {
        "run_1": {
          "actions": [
            "User runs 'agent run'",
            "Workflow starts, finds refiner_1 (batch mode)",
            "Submits batch job for refiner_1",
            "Updates status: refiner_1='batch_submitted'",
            "BREAKS execution (lines 433, 503)",
            "refiner_2, refiner_3, refiner_4, refiner_5 never execute"
          ],
          "status": {
            "refiner_1": "batch_submitted",
            "refiner_2": "pending",
            "refiner_3": "pending",
            "refiner_4": "pending",
            "refiner_5": "pending"
          }
        },
        "run_2": {
          "actions": [
            "User waits for batch to complete, runs 'agent run' again",
            "Workflow checks refiner_1 status (line 414)",
            "Batch completed → marks refiner_1='completed'",
            "Continues to refiner_2 (depends on refiner_1)",
            "Submits batch job for refiner_2",
            "Updates status: refiner_2='batch_submitted'",
            "BREAKS execution again"
          ],
          "status": {
            "refiner_1": "completed",
            "refiner_2": "batch_submitted",
            "refiner_3": "pending",
            "refiner_4": "pending",
            "refiner_5": "pending"
          }
        },
        "run_3_through_5": {
          "pattern": "Same pattern repeats for refiner_3, refiner_4, refiner_5",
          "total_runs_needed": 6,
          "run_breakdown": "1 submit + 5 checks = 6 total runs"
        },
        "final_status": {
          "refiner_1": "completed",
          "refiner_2": "completed",
          "refiner_3": "completed",
          "refiner_4": "completed",
          "refiner_5": "completed"
        }
      },
      "correctness_analysis": {
        "sequential_guarantee": "✅ YES - Each iteration waits for previous to complete",
        "dependency_chain": "✅ ENFORCED - refiner_2 cannot run until refiner_1 completes",
        "data_access": "✅ WORKS - refiner_2 reads from refiner_1 output directory",
        "error_propagation": "✅ CORRECT - If refiner_3 fails, refiner_4 never runs"
      }
    },

    "online_vs_batch_comparison": {
      "online_mode": {
        "execution": "Sequential, all in one run",
        "timeline": [
          "refiner_1 runs → completes → refiner_2 runs → completes → refiner_3 runs → ... → refiner_5 completes"
        ],
        "total_time": "Sum of all iteration times (blocking, sequential)",
        "user_experience": "Single 'agent run' command, wait for all to complete"
      },
      "batch_mode": {
        "execution": "Sequential, across multiple runs",
        "timeline": [
          "Run 1: Submit refiner_1 batch → break",
          "Run 2: Check refiner_1 (done) → submit refiner_2 batch → break",
          "Run 3: Check refiner_2 (done) → submit refiner_3 batch → break",
          "Run 4: Check refiner_3 (done) → submit refiner_4 batch → break",
          "Run 5: Check refiner_4 (done) → submit refiner_5 batch → break",
          "Run 6: Check refiner_5 (done) → workflow complete"
        ],
        "total_time": "Sum of all iteration times (async, but still sequential due to dependencies)",
        "user_experience": "Multiple 'agent run' commands, each checks status and submits next"
      },
      "key_difference": {
        "mechanism": "Online blocks within single run, batch blocks across multiple runs",
        "end_result": "✅ IDENTICAL - Both enforce sequential execution, same data flow, same outputs",
        "correctness": "✅ SAME - Dependencies enforced equally in both modes"
      }
    },

    "why_it_works": {
      "reason_1": {
        "title": "Execution order is single source of truth",
        "explanation": "Both modes iterate through same execution_order list in same sequence",
        "code": "for idx, agent_name in enumerate(self.execution_order): (line 386)"
      },
      "reason_2": {
        "title": "Dependencies encoded in order, not checked dynamically",
        "explanation": "Sequential loop dependencies create: [refiner_1, refiner_2, refiner_3, refiner_4, refiner_5]. This order is respected by both modes.",
        "code": "agents[agent_idx]['dependencies'] = [prev_agent['agent_type']] (action_expander.py)"
      },
      "reason_3": {
        "title": "Batch mode break mechanism preserves order",
        "explanation": "When batch job submitted, workflow breaks at that index. Next run resumes from same index, checks status, proceeds if complete.",
        "code": "break (lines 433, 438, 524) preserves idx position"
      },
      "reason_4": {
        "title": "Input directory resolution uses execution order",
        "explanation": "Each iteration reads from previous iteration's output: node_{idx-1}_{prev_agent}",
        "code": "_get_input_directory() (line 218) uses prev_agent = execution_order[idx-1]"
      }
    },

    "validation_requirements": {
      "functional_requirements": [
        "✅ Sequential loops work in batch mode",
        "✅ Each batch iteration waits for previous to complete",
        "✅ Data flows correctly between batch iterations",
        "✅ Error in batch iteration N prevents iteration N+1",
        "✅ Loop correlation works with batch sequential loops"
      ],
      "parity_requirements": [
