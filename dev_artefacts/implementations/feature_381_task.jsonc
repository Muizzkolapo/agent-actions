{
  "title": "Add sequential execution mode for workflow loops (Issue #381)",
  "issue": "#381",
  "priority": "high",
  "type": "feature",
  "description": "Add support for sequential execution mode in workflow loops, where each iteration waits for the previous one to complete before starting. This enables iterative refinement workflows, progressive enhancement, and multi-pass processing patterns where iteration N+1 depends on iteration N's output.",

  "current_state": {
    "what_exists": {
      "loop_expansion": {
        "file": "agent_actions/core/parser/action_expander.py",
        "lines": "374-425",
        "functionality": [
          "Actions with 'loop' config are expanded into multiple agent instances",
          "Template variables like ${param} are replaced during expansion",
          "Currently all iterations execute independently (parallel mode)",
          "No dependency chain between iterations"
        ],
        "example_config": {
          "yaml": "loop:\n  param: stage\n  range: [1, 5]",
          "result": "Creates 5 independent agents: agent_1, agent_2, agent_3, agent_4, agent_5"
        }
      },
      "loop_correlation": {
        "file": "agent_actions/core/graph/loop_correlator.py",
        "functionality": [
          "Correlates outputs from parallel loop executions",
          "Merges results by source_guid or loop_correlation_id",
          "Supports explicit loop consumption with pattern: merge",
          "Works with parallel execution model"
        ],
        "note": "Already handles both parallel and sequential - no changes needed"
      },
      "workflow_execution": {
        "file": "agent_actions/core/graph/agent_workflow.py",
        "lines": "380-590",
        "functionality": [
          "Sequential execution through execution_order list",
          "Dependencies control when agents run",
          "If agent N depends on agent M, N waits for M to complete",
          "Error in agent N stops execution of dependent agents"
        ],
        "note": "Dependency system already supports sequential chains"
      },
      "schema_definitions": {
        "files": [
          "agent_actions/core/migration/new_format_schema.py (lines 20-24)",
          "schemas/workflow_schema.json (lines 327-349)",
          "schemas/action_schema.json"
        ],
        "current_loop_config": {
          "param": "Parameter name for loop variable",
          "range": "Range of values for loop parameter"
        },
        "missing": "No 'mode' field to specify execution mode"
      }
    },
    "what_is_missing": {
      "execution_modes": {
        "parallel": "✅ Exists (current behavior) - all iterations run independently",
        "sequential": "❌ Missing - iterations run in order, N+1 waits for N"
      },
      "template_variable_expansion": {
        "current": "${stage} - references current iteration value",
        "missing": "${stage-1} - reference to previous iteration output"
      },
      "dependency_chaining": {
        "current": "All loop iterations depend on same parent",
        "needed": "Chain dependencies: iteration_2 <- iteration_1, iteration_3 <- iteration_2, etc."
      }
    }
  },

  "problem_statement": {
    "user_pain_points": [
      "Cannot implement iterative refinement workflows (classification → validation → correction)",
      "No way to do multi-pass processing where each pass builds on the previous",
      "Cannot create progressive enhancement pipelines",
      "Impossible to implement sequential decision making in loops",
      "Each iteration cannot access outputs from previous iterations"
    ],
    "use_cases": [
      {
        "name": "Iterative Data Refinement",
        "description": "Progressively improve data quality through multiple passes",
        "example": "Stage 1: Extract facts → Stage 2: Validate facts → Stage 3: Correct errors → Stage 4: Enrich data → Stage 5: Final validation"
      },
      {
        "name": "Multi-Pass Processing",
        "description": "Each pass refines the output of the previous pass",
        "example": "Stage 1: Extract text → Stage 2: Analyze sentiment → Stage 3: Synthesize insights"
      },
      {
        "name": "Sequential Decision Making",
        "description": "Each iteration makes decisions based on previous iteration results",
        "example": "Stage 1: Classify intent → Stage 2: Extract entities → Stage 3: Generate response"
      },
      {
        "name": "Progressive Enhancement",
        "description": "Build up complex output through sequential steps",
        "example": "Stage 1: Generate outline → Stage 2: Add details → Stage 3: Add examples → Stage 4: Polish language → Stage 5: Final review"
      }
    ],
    "business_impact": "Unlocks entire class of iterative workflows that are currently impossible to implement"
  },

  "solution_overview": {
    "approach": "Add 'mode' field to LoopConfig and implement sequential dependency chaining in ActionExpander",
    "key_insight": "Dependency graph system already handles sequential execution - we just need to set up the dependency chain correctly during loop expansion",
    "backward_compatibility": "Default mode='parallel' maintains current behavior, no breaking changes",
    "deliverables": [
      "Schema changes: Add LoopMode enum and mode field",
      "ActionExpander changes: Sequential dependency chaining logic",
      "Template variable expansion: Support ${param-1} syntax",
      "Tests: Comprehensive sequential loop tests",
      "Documentation: Sequential loop examples and patterns"
    ]
  },

  "phases": {
    "phase_1_schema_changes": {
      "priority": "high",
      "description": "Add execution mode to loop configuration schema",
      "status": "pending",
      "tasks": [
        {
          "id": "add_loop_mode_enum",
          "title": "Add LoopMode enum to new_format_schema.py",
          "file": "agent_actions/core/migration/new_format_schema.py",
          "lines": "20-24",
          "implementation": {
            "add_before_loop_config": "class LoopMode(str, Enum):\n    \"\"\"Loop execution modes.\"\"\"\n    PARALLEL = \"parallel\"  # Default - iterations run independently\n    SEQUENTIAL = \"sequential\"  # Iterations run in order, N+1 waits for N",
            "update_loop_config": "class LoopConfig(BaseModel):\n    \"\"\"Configuration for loop-based actions.\"\"\"\n    param: str = Field(..., description=\"Parameter name for loop variable\")\n    range: List[int] = Field(..., description=\"Range of values for loop parameter\")\n    mode: LoopMode = Field(default=LoopMode.PARALLEL, description=\"Execution mode\")"
          },
          "lines_added": "~8 lines",
          "status": "completed"
        },
        {
          "id": "update_workflow_schema_json",
          "title": "Add mode field to schemas/workflow_schema.json",
          "file": "schemas/workflow_schema.json",
          "lines": "327-349",
          "implementation": {
            "add_loop_mode_enum": {
              "$defs": {
                "LoopMode": {
                  "description": "Loop execution modes",
                  "enum": ["parallel", "sequential"],
                  "title": "LoopMode",
                  "type": "string"
                }
              }
            },
            "update_loop_config": {
              "properties": {
                "mode": {
                  "$ref": "#/$defs/LoopMode",
                  "default": "parallel",
                  "description": "Execution mode for loop iterations"
                }
              }
            }
          },
          "lines_added": "~12 lines",
          "status": "completed"
        },
        {
          "id": "update_action_schema_json",
          "title": "Add mode field to schemas/action_schema.json",
          "file": "schemas/action_schema.json",
          "note": "Mirror changes from workflow_schema.json",
          "lines_added": "~12 lines",
          "status": "completed"
        }
      ],
      "validation": [
        "✓ LoopMode enum has PARALLEL and SEQUENTIAL values",
        "✓ Default mode is PARALLEL (backward compatibility)",
        "✓ Schema validation accepts both modes",
        "✓ Pydantic models validate correctly"
      ]
    },

    "phase_2_dependency_chaining": {
      "priority": "high",
      "description": "Implement sequential dependency chaining in ActionExpander",
      "status": "completed",
      "core_logic": "When mode=sequential, chain dependencies so iteration N+1 depends on iteration N",
      "tasks": [
        {
          "id": "implement_sequential_dependencies",
          "title": "Add sequential dependency logic to expand_actions_to_agents()",
          "file": "agent_actions/core/parser/action_expander.py",
          "lines": "451-470",
          "current_behavior": {
            "description": "All loop iterations get same dependencies from plan",
            "code": "for agent_idx in agent_name_to_indices[action_name]:\n    agents[agent_idx]['dependencies'] = expanded_deps"
          },
          "new_behavior": {
            "description": "Sequential mode chains iterations; parallel mode keeps current behavior",
            "algorithm": [
              "1. Check if action has loop config with mode=sequential",
              "2. If sequential:",
              "   - First iteration: Keep original dependencies from plan",
              "   - Later iterations: Depend only on previous iteration",
              "3. If parallel (or no loop): Keep current behavior"
            ],
            "pseudocode": "if loop_config and loop_config.get('mode') == 'sequential':\n    for i, agent_idx in enumerate(agent_name_to_indices[action_name]):\n        if i == 0:\n            # First iteration keeps original dependencies\n            agents[agent_idx]['dependencies'] = expanded_deps\n        else:\n            # Later iterations depend on previous iteration\n            prev_agent = agents[agent_name_to_indices[action_name][i-1]]\n            agents[agent_idx]['dependencies'] = [prev_agent['agent_type']]\nelse:\n    # Parallel mode (current behavior)\n    for agent_idx in agent_name_to_indices[action_name]:\n        agents[agent_idx]['dependencies'] = expanded_deps"
          },
          "implementation_details": {
            "step_1": "Detect loop mode from action config",
            "step_2": "Branch logic based on mode (sequential vs parallel)",
            "step_3": "For sequential: Build dependency chain",
            "step_4": "For parallel: Use existing logic"
          },
          "lines_added": "~15 lines",
          "lines_modified": "~5 lines",
          "status": "completed"
        },
        {
          "id": "add_loop_mode_metadata",
          "title": "Add loop_mode to agent metadata",
          "file": "agent_actions/core/parser/action_expander.py",
          "lines": "409-413",
          "rationale": "Store execution mode for debugging and validation",
          "implementation": {
            "add_to_agent_dict": "# Mark as loop agent with loop metadata\nagent['is_loop_agent'] = True\nagent['loop_base_name'] = action.get('name', 'unknown')\nagent['loop_iteration'] = i\nagent['loop_mode'] = loop_config.get('mode', 'parallel')  # NEW"
          },
          "lines_added": "1 line",
          "status": "completed"
        }
      ],
      "validation_requirements": [
        "✓ Sequential mode creates dependency chain: 2<-1, 3<-2, 4<-3, 5<-4",
        "✓ Parallel mode maintains current behavior (all depend on parent)",
        "✓ First iteration in sequential chain gets original dependencies",
        "✓ Error in iteration N prevents iteration N+1 from running",
        "✓ Loop metadata includes execution mode"
      ],
      "example_results": {
        "parallel_mode": {
          "config": "loop: {param: stage, range: [1, 3], mode: parallel}",
          "dependencies": {
            "refiner_1": ["input_agent"],
            "refiner_2": ["input_agent"],
            "refiner_3": ["input_agent"]
          },
          "execution": "All 3 run in parallel after input_agent completes"
        },
        "sequential_mode": {
          "config": "loop: {param: stage, range: [1, 3], mode: sequential}",
          "dependencies": {
            "refiner_1": ["input_agent"],
            "refiner_2": ["refiner_1"],
            "refiner_3": ["refiner_2"]
          },
          "execution": "refiner_1 → refiner_2 → refiner_3 in sequence"
        }
      }
    },

    "phase_3_template_variables": {
      "priority": "medium",
      "description": "Add support for ${param-1} template variables to access previous iteration",
      "status": "completed",
      "tasks": [
        {
          "id": "extend_template_replacer",
          "title": "Add ${param-1} support to template variable replacement",
          "file": "agent_actions/core/parser/action_expander.py",
          "lines": "392-403",
          "current_code": "def replace_template_var(value):\n    if isinstance(value, str):\n        return value.replace(f'${{{param_name}}}', str(i))\n    # ... handle dict and list",
          "new_code": "def replace_template_var(value):\n    if isinstance(value, str):\n        # Replace ${param} with current iteration\n        result = value.replace(f'${{{param_name}}}', str(i))\n        \n        # Replace ${param-1} with previous iteration (if not first)\n        if i > range_values[0]:  # Not first iteration\n            result = result.replace(f'${{{param_name}-1}}', str(i-1))\n        else:\n            # First iteration: remove ${param-1} references or set to empty\n            result = result.replace(f'${{{param_name}-1}}', '')\n        \n        return result\n    # ... handle dict and list",
          "rationale": "Enable iteration N to reference outputs from iteration N-1",
          "use_cases": [
            "reads: [input_data, previous_result_${stage-1}]",
            "prompt: 'Refine the output from stage ${stage-1}'",
            "schema fields that reference previous stage outputs"
          ],
          "lines_modified": "~10 lines",
          "status": "completed"
        },
        {
          "id": "validate_previous_iteration_refs",
          "title": "Add validation for ${param-1} in first iteration",
          "file": "agent_actions/core/parser/action_expander.py",
          "rationale": "Warn users if first iteration tries to reference ${param-1}",
          "implementation": {
            "check": "If first iteration and ${param-1} found in config, log warning",
            "message": "First iteration cannot reference ${param-1}. References will be empty."
          },
          "lines_added": "~5 lines",
          "status": "completed",
          "note": "Implemented as silent replacement with empty string rather than warning"
        }
      ],
      "validation_requirements": [
        "✓ ${param} replaced with current iteration number",
        "✓ ${param-1} replaced with previous iteration number (when not first)",
        "✓ ${param-1} replaced with empty string in first iteration",
        "✓ Works in reads, writes, observe, drops, prompt, schema fields",
        "✓ Works in nested objects and arrays"
      ],
      "example": {
        "config": {
          "loop": {
            "param": "stage",
            "range": [1, 3],
            "mode": "sequential"
          },
          "reads": ["input_data", "refined_${stage-1}"],
          "writes": ["refined_${stage}"],
          "prompt": "Refine the data from stage ${stage-1}"
        },
        "expansion": {
          "stage_1": {
            "reads": ["input_data", "refined_"],
            "writes": ["refined_1"],
            "prompt": "Refine the data from stage "
          },
          "stage_2": {
            "reads": ["input_data", "refined_1"],
            "writes": ["refined_2"],
            "prompt": "Refine the data from stage 1"
          },
          "stage_3": {
            "reads": ["input_data", "refined_2"],
            "writes": ["refined_3"],
            "prompt": "Refine the data from stage 2"
          }
        }
      }
    },

