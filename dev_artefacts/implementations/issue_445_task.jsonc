  "cli_interface": {
    "command_name": "render",
    "usage": "agent-actions -a render <workflow-name> [OPTIONS]",
    "arguments": {
      "workflow_name": "Name of the workflow (without .yml extension)"
    },
    "options": {
      "--output, -o": "Save to file instead of stdout",
      "--pretty": "Pretty print with syntax highlighting",
      "--validate": "Validate YAML syntax after rendering",
      "--diff": "Show diff from last render"
    },
    "examples": [
      {
        "command": "agent-actions -a render qanalabs-quiz-gen",
        "description": "Render and display to stdout"
      },
