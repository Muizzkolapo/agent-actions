{
  "title": "Add `agent-actions -a render` Command for Jinja2 Template Debugging (Issue #445)",
  "issue": "#445",
  "priority": "medium-high",
  "type": "feature",
  "status": "📋 PLANNED",
  "description": "Add a CLI command to render Jinja2 templates in workflow YAML files without executing them, enabling users to debug template rendering issues, verify macro expansion, and troubleshoot YAML parsing errors.",

  "executive_summary": {
    "problem": "Users can't preview rendered Jinja2 templates before execution, making it hard to debug indentation, macro expansion, and YAML parsing issues. Current workaround requires manually adding debug prints to render_workflow.py.",
    "solution": "Add `agent-actions -a render <workflow-name>` command that renders templates and outputs the result without execution",
    "impact": "Significantly improves developer experience when working with Jinja2 templates. Enables faster debugging, better error messages, and serves as learning tool for template usage.",
    "implementation": "Reuse existing render_pipeline_with_templates() function, add new CLI command with click, provide options for output formatting, validation, and comparison",
    "testing": "Unit tests for render function, integration tests with sample workflows, manual testing with qanalabs workflows",
    "code_changes": "~200-300 lines across CLI module, render module, and tests"
  },

  "current_state": {
    "what_works": {
      "template_rendering_engine": {
        "feature": "render_pipeline_with_templates()",
        "file": "agent_actions/workflow/render_workflow.py",
        "functionality": [
          "Renders Jinja2 templates in workflow YAML",
          "Loads template files from templates/ directory",
          "Processes macros and variables",
          "Returns rendered YAML string"
        ],
        "status": "✅ Works perfectly - we'll reuse this"
      },
      "workflow_loading": {
        "feature": "Workflow config loading and parsing",
        "file": "agent_actions/core/config/",
        "functionality": [
          "Loads workflow files",
          "Validates YAML syntax",
          "Parses configuration"
        ],
        "status": "✅ Available for validation mode"
      }
    },
    "what_is_missing": {
      "cli_command": {
        "problem": "No command to render templates without execution",
        "current_workaround": "Manually add print statements to render_workflow.py",
        "user_pain": "Must modify source code and re-run workflow just to see rendered output"
      },
      "output_formatting": {
        "problem": "No way to format/highlight rendered YAML",
        "needed": "Pretty printing with syntax highlighting for better readability"
      },
      "validation": {
        "problem": "Can't validate YAML syntax after rendering",
        "needed": "Optional validation to catch template-induced YAML errors"
      },
      "comparison": {
        "problem": "No way to compare renders over time",
        "needed": "Diff functionality to see how template changes affect output"
      }
    }
  },

  "problem_statement": {
    "user_experience": {
      "scenario": "User writes Jinja2 macro in workflow YAML with indentation issues",
      "what_happens": [
        "1. User creates workflow with {{ thinkific_tools() }} macro",
        "2. Runs workflow: agent-actions run qanalabs-quiz-gen",
        "3. ❌ YAML parsing error - indentation is wrong",
        "4. User can't see rendered output to debug",
        "5. Must add print() to render_workflow.py",
        "6. Re-run workflow to see output",
        "7. Fix template, remove debug code",
        "8. Repeat cycle"
      ],
      "user_frustration": "Too many steps just to see what the template renders to",
      "impact": "Slows down development, makes template debugging painful"
    },
    "technical_root_cause": {
      "issue": "Template rendering is coupled with workflow execution",
      "current_flow": [
        "Load workflow config → Render templates → Parse YAML → Execute workflow",
        "User can't access intermediate rendered YAML without execution"
      ],
      "needed": "Expose render step as standalone operation"
    }
  },

  "solution_overview": {
    "approach": "Add new CLI command that renders templates and outputs result",
    "key_insight": "We already have render_pipeline_with_templates() - just need to expose it via CLI",
    "architecture_goals": [
      "✅ Reuse existing rendering infrastructure",
      "✅ Clean CLI interface with intuitive options",
      "✅ Support multiple output modes (stdout, file, pretty, validated)",
      "✅ Provide helpful error messages with context",
      "✅ Optional diff support for iterative development"
    ],
    "command_syntax": "agent-actions -a render <workflow-name> [options]",
    "implementation": [
      "1. Add render command to CLI",
      "2. Create render function that calls existing rendering code",
      "3. Add output formatting options (pretty, validate)",
      "4. Add file output option",
      "5. Add diff option (compare with cached previous render)",
      "6. Provide clear error messages for template failures"
    ]
  },

  "implementation_plan": {
    "phase_1_core_render_command": {
      "priority": "critical",
      "description": "Add basic render command that outputs rendered YAML to stdout",
      "tasks": [
        {
          "id": "add_render_cli_command",
          "title": "Add render command to CLI",
          "file": "agent_actions/cli/commands.py",
          "implementation": {
            "command_definition": "@click.command()\n@click.argument('workflow_name')\ndef render(workflow_name):\n    \"\"\"\n    Render Jinja2 templates in workflow YAML without executing.\n    \n    Shows the fully rendered YAML after template expansion.\n    Useful for debugging template issues, verifying macro expansion,\n    and troubleshooting YAML parsing errors.\n    \n    Examples:\n        agent-actions -a render qanalabs-quiz-gen\n        agent-actions -a render my-workflow\n    \"\"\"\n    from agent_actions.workflow.render_debug import render_workflow_for_debug\n    \n    try:\n        rendered_yaml = render_workflow_for_debug(workflow_name)\n        click.echo(rendered_yaml)\n    except Exception as e:\n        click.echo(f\"❌ Error rendering workflow: {e}\", err=True)\n        sys.exit(1)",
            "registration": "Add to CLI command group"
          },
          "lines_added": 20
        },
        {
          "id": "create_render_debug_module",
          "title": "Create render_debug.py with render_workflow_for_debug()",
          "file": "agent_actions/workflow/render_debug.py",
          "purpose": "Wrapper around existing render function for CLI use",
          "implementation": {
            "code": "\"\"\"\nWorkflow template rendering for debugging purposes.\n\nProvides utilities to render Jinja2 templates in workflow YAML files\nwithout executing the workflow.\n\"\"\"\n\nfrom pathlib import Path\nfrom typing import Optional\nimport yaml\n\nfrom agent_actions.workflow.render_workflow import render_pipeline_with_templates\n\n\ndef render_workflow_for_debug(\n    workflow_name: str,\n    workflow_path: Optional[str] = None\n) -> str:\n    \"\"\"\n    Render Jinja2 templates in a workflow YAML file.\n    \n    Args:\n        workflow_name: Name of the workflow (without .yml extension)\n        workflow_path: Optional custom path to workflow file.\n                      If not provided, looks in default locations.\n    \n    Returns:\n        str: The fully rendered YAML as a string\n        \n    Raises:\n        FileNotFoundError: If workflow file not found\n        jinja2.TemplateError: If template rendering fails\n        \n    Example:\n        >>> rendered = render_workflow_for_debug('qanalabs-quiz-gen')\n        >>> print(rendered)\n    \"\"\"\n    # Find workflow file\n    if workflow_path is None:\n        workflow_path = _find_workflow_file(workflow_name)\n    \n    # Read original YAML\n    with open(workflow_path, 'r') as f:\n        original_yaml = f.read()\n    \n    # Render templates\n    try:\n        rendered_yaml = render_pipeline_with_templates(\n            original_yaml,\n            workflow_name\n        )\n    except Exception as e:\n        raise RenderError(\n            f\"Failed to render templates in {workflow_name}.yml\",\n            original_error=e,\n            workflow_path=workflow_path\n        )\n    \n    return rendered_yaml\n\n\ndef _find_workflow_file(workflow_name: str) -> Path:\n    \"\"\"\n    Find workflow file in default locations.\n    \n    Searches:\n    1. Current directory: ./{workflow_name}.yml\n    2. Workflows directory: ./workflows/{workflow_name}.yml\n    3. Sample directories: ./sample/*/{workflow_name}.yml\n    \n    Args:\n        workflow_name: Name of workflow (without extension)\n        \n    Returns:\n        Path to workflow file\n        \n    Raises:\n        FileNotFoundError: If workflow not found in any location\n    \"\"\"\n    search_paths = [\n        Path(f\"{workflow_name}.yml\"),\n        Path(f\"workflows/{workflow_name}.yml\"),\n        Path(f\"sample/qanalabs/{workflow_name}.yml\"),\n    ]\n    \n    for path in search_paths:\n        if path.exists():\n            return path\n    \n    raise FileNotFoundError(\n        f\"Workflow '{workflow_name}.yml' not found. Searched:\\n\" +\n        \"\\n\".join(f\"  - {p}\" for p in search_paths)\n    )\n\n\nclass RenderError(Exception):\n    \"\"\"\n    Error during template rendering.\n    \n    Provides context about what went wrong and where.\n    \"\"\"\n    \n    def __init__(self, message: str, original_error: Exception, workflow_path: str):\n        self.message = message\n        self.original_error = original_error\n        self.workflow_path = workflow_path\n        super().__init__(self._format_message())\n    \n    def _format_message(self) -> str:\n        return (\n            f\"{self.message}\\n\"\n            f\"File: {self.workflow_path}\\n\"\n            f\"Error: {self.original_error}\"\n        )",
            "lines_added": 110
          }
        }
      ],
      "validation_requirements": [
        "✅ Command renders workflow templates",
        "✅ Output is valid YAML",
        "✅ Clear error messages on failure",
        "✅ Finds workflow in default locations"
      ]
    },

    "phase_2_output_options": {
      "priority": "high",
      "description": "Add options for file output, pretty printing, and validation",
      "tasks": [
        {
          "id": "add_output_file_option",
          "title": "Add --output option to save rendered YAML to file",
          "file": "agent_actions/cli/commands.py",
          "implementation": {
            "option": "@click.option('--output', '-o', type=click.Path(), help='Save to file instead of stdout')",
            "logic": "if output:\n    with open(output, 'w') as f:\n        f.write(rendered_yaml)\n    click.echo(f\"✅ Rendered YAML saved to {output}\")\nelse:\n    click.echo(rendered_yaml)"
          },
          "lines_added": 10
        },
        {
          "id": "add_pretty_option",
          "title": "Add --pretty option for syntax highlighting",
          "file": "agent_actions/workflow/render_debug.py",
          "dependencies": ["pygments library"],
          "implementation": {
            "function": "def prettify_yaml(yaml_str: str) -> str:\n    \"\"\"\n    Add syntax highlighting to YAML string.\n    \n    Uses pygments for terminal-friendly colored output.\n    \"\"\"\n    try:\n        from pygments import highlight\n        from pygments.lexers import YamlLexer\n        from pygments.formatters import TerminalFormatter\n        \n        return highlight(\n            yaml_str,\n            YamlLexer(),\n            TerminalFormatter()\n        )\n    except ImportError:\n        # Pygments not available - return plain\n        return yaml_str",
            "cli_integration": "@click.option('--pretty', is_flag=True, help='Pretty print with syntax highlighting')\n\nif pretty:\n    rendered_yaml = prettify_yaml(rendered_yaml)"
          },
          "lines_added": 25
        },
        {
          "id": "add_validate_option",
          "title": "Add --validate option to check YAML syntax",
          "file": "agent_actions/workflow/render_debug.py",
          "implementation": {
            "function": "def validate_rendered_yaml(yaml_str: str) -> tuple[bool, Optional[str]]:\n    \"\"\"\n    Validate YAML syntax of rendered output.\n    \n    Returns:\n        (is_valid, error_message)\n    \"\"\"\n    try:\n        yaml.safe_load(yaml_str)\n        return True, None\n    except yaml.YAMLError as e:\n        return False, str(e)",
            "cli_integration": "@click.option('--validate', is_flag=True, help='Validate YAML syntax after rendering')\n\nif validate:\n    is_valid, error = validate_rendered_yaml(rendered_yaml)\n    if is_valid:\n        click.echo(\"✅ YAML validation passed\")\n    else:\n        click.echo(f\"❌ YAML validation failed: {error}\", err=True)\n        sys.exit(1)"
          },
          "lines_added": 20
        }
      ],
      "validation_requirements": [
        "✅ Can save to file with --output",
        "✅ Pretty printing works with --pretty",
        "✅ Validation catches YAML syntax errors",
        "✅ Options work in combination"
      ]
    },

    "phase_3_diff_support": {
      "priority": "medium",
      "description": "Add --diff option to compare with previous render",
      "tasks": [
        {
          "id": "implement_render_caching",
          "title": "Cache rendered output for diff comparison",
          "file": "agent_actions/workflow/render_debug.py",
          "implementation": {
            "cache_location": ".agent-actions/cache/rendered/<workflow-name>.yml",
            "functions": {
              "save_render_cache": "def save_render_cache(workflow_name: str, rendered_yaml: str):\n    cache_dir = Path('.agent-actions/cache/rendered')\n    cache_dir.mkdir(parents=True, exist_ok=True)\n    cache_file = cache_dir / f\"{workflow_name}.yml\"\n    cache_file.write_text(rendered_yaml)",
              "load_render_cache": "def load_render_cache(workflow_name: str) -> Optional[str]:\n    cache_file = Path(f'.agent-actions/cache/rendered/{workflow_name}.yml')\n    if cache_file.exists():\n        return cache_file.read_text()\n    return None"
            }
          },
          "lines_added": 25
        },
        {
          "id": "add_diff_option",
          "title": "Add --diff option to show changes",
          "file": "agent_actions/cli/commands.py",
          "implementation": {
            "option": "@click.option('--diff', is_flag=True, help='Show diff from last render')",
            "logic": "if diff:\n    previous = load_render_cache(workflow_name)\n    if previous:\n        diff_output = generate_diff(previous, rendered_yaml)\n        click.echo(diff_output)\n    else:\n        click.echo(\"No previous render found for comparison\")\n\n# Always save current render for future diffs\nsave_render_cache(workflow_name, rendered_yaml)",
            "diff_function": "import difflib\n\ndef generate_diff(old: str, new: str) -> str:\n    \"\"\"\n    Generate unified diff between two YAML strings.\n    \"\"\"\n    diff = difflib.unified_diff(\n        old.splitlines(keepends=True),\n        new.splitlines(keepends=True),\n        fromfile='previous render',\n        tofile='current render',\n        lineterm=''\n    )\n    return ''.join(diff)"
          },
          "lines_added": 35
        }
      ],
      "validation_requirements": [
        "✅ Renders cached on first use",
        "✅ Diff shows changes clearly",
        "✅ Works when no previous render exists",
        "✅ Cache directory created automatically"
      ]
    },

    "phase_4_enhanced_error_messages": {
      "priority": "high",
      "description": "Provide helpful error messages with context",
      "tasks": [
        {
          "id": "improve_template_error_messages",
          "title": "Add context to Jinja2 template errors",
          "file": "agent_actions/workflow/render_debug.py",
          "implementation": {
            "error_formatting": "def format_template_error(error: Exception, workflow_name: str) -> str:\n    \"\"\"\n    Format Jinja2 errors with helpful context.\n    \"\"\"\n    if isinstance(error, jinja2.UndefinedError):\n        return (\n            f\"❌ Template Rendering Error\\n\\n\"\n            f\"Problem: Undefined variable in template\\n\"\n            f\"Workflow: {workflow_name}.yml\\n\"\n            f\"Error: {error}\\n\\n\"\n            f\"Possible causes:\\n\"\n            f\"  1. Macro not defined in templates/*.jinja2\\n\"\n            f\"  2. Template file not loaded (check templates folder path)\\n\"\n            f\"  3. Typo in variable/macro name\\n\\n\"\n            f\"Fix: Check your template definitions in the templates/ folder\"\n        )\n    elif isinstance(error, jinja2.TemplateSyntaxError):\n        return (\n            f\"❌ Template Syntax Error\\n\\n\"\n            f\"Problem: Invalid Jinja2 syntax\\n\"\n            f\"Workflow: {workflow_name}.yml\\n\"\n            f\"Line: {error.lineno if hasattr(error, 'lineno') else 'unknown'}\\n\"\n            f\"Error: {error}\\n\\n\"\n            f\"Fix: Check Jinja2 syntax in your workflow file\"\n        )\n    else:\n        return f\"❌ Error rendering workflow: {error}\""
          },
          "lines_added": 40
        },
        {
          "id": "add_yaml_error_context",
          "title": "Add context to YAML parsing errors",
          "file": "agent_actions/workflow/render_debug.py",
          "implementation": {
            "error_formatting": "def format_yaml_error(error: yaml.YAMLError, workflow_name: str) -> str:\n    \"\"\"\n    Format YAML errors with line numbers and context.\n    \"\"\"\n    return (\n        f\"❌ YAML Parsing Error\\n\\n\"\n        f\"Problem: Invalid YAML syntax after template rendering\\n\"\n        f\"Workflow: {workflow_name}.yml\\n\"\n        f\"Error: {error}\\n\\n\"\n        f\"This usually means:\\n\"\n        f\"  1. Template macro generated incorrect indentation\\n\"\n        f\"  2. Missing quotes around special characters\\n\"\n        f\"  3. Invalid YAML structure from template expansion\\n\\n\"\n        f\"Tip: Use --pretty to see the rendered YAML and identify the issue\"\n    )"
          },
          "lines_added": 20
        }
      ],
      "validation_requirements": [
        "✅ Template errors show helpful context",
        "✅ YAML errors indicate template issues",
        "✅ Error messages suggest fixes",
        "✅ Line numbers shown when available"
      ]
    },

