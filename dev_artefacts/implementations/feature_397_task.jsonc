{
  "title": "Create user-facing documentation for reprompting with custom validators (Issue #397)",
  "issue": "#397",
  "priority": "medium",
  "type": "documentation",
  "description": "Transform internal design documentation into comprehensive user-facing documentation for the reprompting feature with custom validators. Users need practical guides on how to configure and use this feature, not technical architecture details.",

  "current_state": {
    "what_exists": {
      "internal_design_doc": {
        "file": "dev_artefacts/markdown_docs/conditional-reprompting-design.md",
        "type": "Technical/architectural documentation",
        "audience": "Developers/maintainers",
        "content": [
          "Architecture diagrams",
          "Component design",
          "Implementation details",
          "Code-level examples",
          "Mermaid diagrams"
        ],
        "issue": "Not user-facing - too technical for end users"
      },
      "implementation_files": {
        "reprompt_interceptor": "agent_actions/integrations/interceptors/reprompt_interceptor.py",
        "validation_interceptor": "agent_actions/agents/validators/validation_interceptor.py",
        "builtin_validators": "agent_actions/agents/validators/builtin_functions.py",
        "tooling_loader": "agent_actions/core/tooling.py"
      },
      "feature_status": "✅ Fully implemented and working"
    },
    "what_is_missing": {
      "user_docs_directory": "agentaction-docs/docs/",
      "missing_files": [
        "No reprompting user guide",
        "No interceptor configuration guide",
        "No custom validator tutorial",
        "No troubleshooting guide"
      ],
      "search_result": "0 of 26 user-facing docs mention reprompting/validators"
    }
  },

  "problem_statement": {
    "user_pain_points": [
      "Users don't know the reprompting feature exists",
      "No guide on configuring interceptors",
      "No examples of using built-in validators",
      "No tutorial on creating custom validators",
      "Users can't find information on reprompt strategies",
      "No troubleshooting guidance"
    ],
    "business_impact": "Powerful feature exists but is undiscoverable and underutilized"
  },

  "solution_overview": {
    "approach": "Extract relevant content from design doc and rewrite for end-user audience",
    "deliverables": [
      "User guide: agentaction-docs/docs/guides/reprompting.md",
      "Reference doc: Update configuration-fields.md with interceptor fields",
      "Examples: Add to examples/configurations/"
    ],
    "content_sources": [
      "dev_artefacts/markdown_docs/conditional-reprompting-design.md (rewrite for users)",
      "Issue #397 (has excellent user-facing examples)",
      "Implementation files (for accurate config options)"
    ]
  },

  "phases": {
    "phase_1_create_user_guide": {
      "priority": "high",
      "description": "Create comprehensive user guide for reprompting feature",
      "status": "completed",
      "tasks": [
        {
          "id": "create_reprompting_guide",
          "title": "Create agentaction-docs/docs/guides/reprompting.md",
          "file": "agentaction-docs/docs/guides/reprompting.md",
          "sections": [
            {
              "name": "Overview",
              "content": [
                "What is reprompting?",
                "When to use it",
                "How it works (user perspective, not architecture)",
                "Prerequisites"
              ]
            },
            {
              "name": "Quick Start",
              "content": [
                "Simple example with built-in validator",
                "Basic configuration",
                "Running your first reprompt"
              ]
            },
            {
              "name": "Built-in Validators",
              "content": [
                "word_count_validator - ensure specific word count",
                "char_count_validator - ensure character count",
                "keywords_validator - ensure keywords present",
                "Configuration examples for each"
              ],
              "reference": "agent_actions/agents/validators/builtin_functions.py"
            },
            {
              "name": "Reprompt Strategies",
              "content": [
                {
                  "strategy": "llm",
                  "description": "Uses an LLM to analyze failure and generate improved prompts",
                  "when_to_use": "Complex validations, nuanced failures",
                  "configuration": {
                    "required": ["model_vendor"],
                    "optional": ["model_name", "temperature"],
                    "example": "yaml config with OpenAI GPT-4"
                  }
                },
                {
                  "strategy": "simple",
                  "description": "Appends validation error to original prompt",
                  "when_to_use": "Basic validations, clear error messages",
                  "configuration": {
                    "required": ["max_attempts"],
                    "example": "yaml config"
                  }
                },
                {
                  "strategy": "template",
                  "description": "Uses pattern-based templates for common failures",
                  "when_to_use": "Known failure patterns, structured requirements",
                  "configuration": {
                    "required": ["templates"],
                    "example": "yaml config with template patterns"
                  }
                }
              ],
              "reference": "agent_actions/integrations/strategies/reprompt_strategy.py"
            },
            {
              "name": "Custom Validators",
              "content": [
                "Function signature: (response: Any, **kwargs) -> Tuple[bool, str | None]",
                "Where to place validator files (tools directory)",
                "How to reference in config: 'module_name.function_name'",
                "Accessing validator_args",
                "Accessing context data from workflow",
                "Complete working example"
              ]
            },
            {
              "name": "Error Handling",
              "content": [
                "on_failure options: retry, fail, continue",
                "When to use each option",
                "Examples of error handling strategies"
              ]
            },
            {
              "name": "Advanced Patterns",
              "content": [
                "Chaining multiple validators",
                "Combining validation + reprompt interceptors",
                "Using context data in validators",
                "Progressive validation (different validators per attempt)"
              ]
            },
            {
              "name": "Troubleshooting",
              "content": [
                "Common issues and solutions",
                "Validator not found errors",
                "Infinite retry loops",
                "Debugging reprompt generation",
                "Logging and observability"
              ]
            }
          ],
          "examples_to_include": [
            "Word count validation (from issue #397)",
            "JSON structure validation (from issue #397)",
            "Custom domain-specific validator",
            "LLM-based reprompting with GPT-4",
            "Template-based reprompting"
          ],
          "estimated_lines": "~400-500 lines",
          "status": "completed"
        }
      ]
    },

    "phase_2_update_configuration_reference": {
      "priority": "high",
      "description": "Document interceptor configuration fields in reference documentation",
      "status": "completed",
      "tasks": [
        {
          "id": "document_interceptor_fields",
          "title": "Add interceptor fields to configuration-fields.md",
          "file": "agentaction-docs/docs/reference/configuration-fields.md",
          "sections_to_add": [
            {
              "field": "interceptors",
              "type": "List[InterceptorConfig]",
              "level": "action",
              "description": "Response interceptors for validation and reprompting",
              "schema_reference": "InterceptorConfig in core/parser/config_schema.py",
              "sub_fields": [
                {
                  "field": "type",
                  "type": "string",
                  "required": true,
                  "enum": ["validation", "reprompt", "logging"],
                  "description": "Type of interceptor"
                },
                {
                  "field": "validator_function",
                  "type": "string",
                  "required_when": "type=validation",
                  "description": "Validator function reference (module.function or builtin)",
                  "examples": [
                    "agent_actions.agents.validators.builtin_functions.word_count_validator",
                    "my_validators.validate_json_structure"
                  ]
                },
                {
                  "field": "validator_args",
                  "type": "dict",
                  "optional": true,
                  "description": "Arguments passed to validator function"
                },
                {
                  "field": "on_failure",
                  "type": "string",
                  "enum": ["retry", "fail", "continue"],
                  "default": "retry",
                  "description": "Action to take when validation fails"
                },
                {
                  "field": "strategy",
                  "type": "string",
                  "required_when": "type=reprompt",
                  "enum": ["llm", "simple", "template"],
                  "description": "Reprompt generation strategy"
                },
                {
                  "field": "max_attempts",
                  "type": "integer",
                  "required_when": "type=reprompt",
                  "default": 3,
                  "description": "Maximum number of retry attempts"
                },
                {
                  "field": "llm_config",
                  "type": "dict",
                  "required_when": "strategy=llm",
                  "description": "LLM configuration for reprompt generation",
                  "sub_fields": [
                    "model_vendor (required)",
                    "model_name (optional)",
                    "temperature (optional)"
                  ]
                },
                {
                  "field": "templates",
                  "type": "dict",
                  "required_when": "strategy=template",
                  "description": "Template patterns for reprompt generation"
                }
              ]
            }
          ],
          "estimated_lines": "~100-150 lines",
          "status": "completed"
        }
      ]
    },

