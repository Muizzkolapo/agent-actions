        "name": "BatchRegistryManager",
        "responsibility": "Manage .batch_registry.json CRUD operations with caching and locking",
        "replaces_methods": [
          "_save_batch_job_id",
          "_get_batch_job_id_for_file",
          "_update_batch_registry_status",
          "_are_all_batch_jobs_completed",
          "_get_batch_registry_status",
          "_get_last_batch_job_id",
          "_check_for_existing_batch_job"
        ],
        "benefits": [
          "Single source of truth for registry structure",
          "In-memory caching eliminates repeated file reads",
          "Thread-safe with locking",
          "Consistent error handling"
        ]
      },
      {
        "name": "BatchResultProcessor",
        "responsibility": "Transform batch provider results to workflow format",
        "replaces_methods": [
          "_convert_batch_results_to_workflow_format"
        ],
        "pipeline_stages": [
          "_process_single_result - orchestrates processing",
          "_process_success - handles successful results",
          "_process_error - handles failed results",
          "_parse_content - JSON parsing and validation",
          "_apply_passthrough - context_scope passthrough logic",
          "_transform_structure - data transformation",
          "_add_metadata - metadata and lineage enrichment"
        ],
        "benefits": [
          "Reduces complexity from 46 → ~5 per method",
          "Each stage testable independently",
          "Clear data flow through pipeline",
          "Easy to add transformation steps"
        ]
      },
      {
        "name": "BatchTaskPreparator",
        "responsibility": "Prepare batch tasks with filtering and prompt generation",
        "replaces_methods": [
          "prepare_batch_tasks_from_data"
        ],
        "methods": [
          "prepare_tasks - main orchestration",
          "_validate_and_prepare_config - config validation",
          "_apply_filters - WHERE clause and conditional filtering",
          "_prepare_prompts - prompt preparation with context",
          "_build_context_map - context map construction"
        ],
        "benefits": [
          "Separates validation from processing",
          "Context map built as return value (no side effects)",
          "Easier to test each stage",
          "Clear data flow"
        ]
      },
      {
        "name": "PassthroughDataBuilder",
