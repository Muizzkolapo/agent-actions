    "phase_2_fix_dispatch_task": {
      "status": "✅ COMPLETED (with simplified design)",
      "priority": "critical - main bug fix",
      "description": "Fix dispatch_task() by adding replace_field_references() BEFORE inject_function_outputs_into_prompt()",
      "prerequisite": "Phase 1 MUST be complete",
      "actual_implementation": "Redesigned to use simple dispatch_task('function_name') syntax with no arguments",

      "tasks": [
        {
          "id": "fix_agent_builder_non_batch",
          "title": "Fix dispatch_task() in non-batch mode",
          "file": "agent_actions/agents/base/agent_builder.py",
          "location": "Lines 83-105",
          "problem": "No field reference replacement before dispatch processing",

          "current_code": "# ----- prompt selection / templating ----------------------------------\nprompt_config_base = _prepare_prompt(agent_config, formatted_prompt)\n\n# ... tools_path setup ...\n\n# ❌ WRONG: dispatch processed before field refs\nprompt_config, captured_results = PromptUtils.inject_function_outputs_into_prompt(\n    prompt_config_base,  # RAW prompt\n    tools_path,\n    context_data,\n    agent_config=agent_config\n)",

          "new_code": "# ----- prompt selection / templating ----------------------------------\nprompt_config_base = _prepare_prompt(agent_config, formatted_prompt)\n\n# ... tools_path setup ...\n\n# NEW: Build field context from context_data_str\nfield_context = _build_field_context_from_context_data(context_data_str, agent_config)\n\n# NEW: Replace {reference.field} patterns FIRST\nif field_context:\n    prompt_config_base = PromptUtils.replace_field_references(\n        prompt_config_base,\n        field_context\n    )\n\n# ✅ FIXED: dispatch processed AFTER field refs replaced\nprompt_config, captured_results = PromptUtils.inject_function_outputs_into_prompt(\n    prompt_config_base,  # NOW resolved\n    tools_path,\n    context_data,\n    agent_config=agent_config\n)",

          "helper_function_needed": {
            "name": "_build_field_context_from_context_data",
            "signature": "def _build_field_context_from_context_data(context_data: Union[str, Dict], agent_config: Dict) -> Optional[Dict]",
            "purpose": "Build field_context from context_data for field reference replacement",
            "implementation": "def _build_field_context_from_context_data(context_data: Union[str, Dict], agent_config: Dict) -> Optional[Dict]:\n    \"\"\"\n    Build field_context dict from context_data.\n    \n    In agent_builder, we don't have full dependency graph like DataGenerator,\n    but we can build basic field_context from available data.\n    \n    Args:\n        context_data: The context data (str or dict)\n        agent_config: Agent configuration\n    \n    Returns:\n        field_context dict or None\n    \"\"\"\n    # Parse context_data to dict\n    if isinstance(context_data, str):\n        try:\n            parsed = json.loads(context_data)\n        except (json.JSONDecodeError, TypeError):\n            return None\n    elif isinstance(context_data, dict):\n        parsed = context_data\n    else:\n        return None\n    \n    # Build field_context\n    # In agent_builder, context_data typically contains flattened source + dependency data\n    # We create a 'source' namespace with all available data\n    return {'source': parsed}",
            "location": "Add after _prepare_prompt() helper (~line 60)",
            "lines_added": "~25 lines"
          },

          "lines_added": "~15 lines (replacement logic) + ~25 lines (helper function) = 40 lines",
          "impact": "dispatch_task() now works in non-batch mode"
        },

        {
          "id": "fix_agent_builder_interceptor",
          "title": "Fix dispatch_task() in interceptor mode",
          "file": "agent_actions/agents/base/agent_builder.py",
          "location": "Lines 216-242",
          "problem": "Same issue as non-batch mode",

          "current_code": "prompt_config_base = _prepare_prompt(agent_config, current_prompt)\n\n# ... tools_path setup ...\n\n# ❌ WRONG: dispatch processed before field refs\nprompt_config, captured_results = PromptUtils.inject_function_outputs_into_prompt(\n    prompt_config_base,\n    tools_path,\n    context_data,\n    agent_config=agent_config,\n)",

          "new_code": "prompt_config_base = _prepare_prompt(agent_config, current_prompt)\n\n# ... tools_path setup ...\n\n# NEW: Build field context\nfield_context = _build_field_context_from_context_data(context_data_str, agent_config)\n\n# NEW: Replace {reference.field} patterns FIRST\nif field_context:\n    prompt_config_base = PromptUtils.replace_field_references(\n        prompt_config_base,\n        field_context\n    )\n\n# ✅ FIXED: dispatch processed AFTER field refs replaced\nprompt_config, captured_results = PromptUtils.inject_function_outputs_into_prompt(\n    prompt_config_base,  # NOW resolved\n    tools_path,\n    context_data,\n    agent_config=agent_config,\n)",

          "lines_added": "~15 lines (uses same helper as non-batch)",
          "impact": "dispatch_task() now works in interceptor mode"
        },

        {
          "id": "fix_batch_service_prepare",
          "title": "Fix dispatch_task() in batch mode",
          "file": "agent_actions/tasks/services/batch_service.py",
          "location": "Lines 670-679",
          "problem": "Only old replace_placeholders() called, missing replace_field_references()",

          "current_code": "# Apply drops\nprocessed_row = apply_drops(row_content, agent_config)\n\n# ❌ WRONG: Old pattern replacement (removed in Phase 1)\nformatted_prompt, cleaned_row = PromptUtils.replace_placeholders(raw_prompt, processed_row)\n\n# ❌ WRONG: dispatch processed before NEW field refs\nformatted_prompt, _ = PromptUtils.inject_function_outputs_into_prompt(\n    formatted_prompt,\n    tools_path,\n    json.dumps(processed_row, ensure_ascii=False),\n    agent_config=agent_config\n)",

          "new_code": "# Apply drops\nprocessed_row = apply_drops(row_content, agent_config)\n\n# NEW: Build field_context for this row\nfield_context = {'source': processed_row}  # In batch mode, each row is 'source'\n\n# NEW: Replace {reference.field} patterns FIRST\nformatted_prompt = PromptUtils.replace_field_references(\n    raw_prompt,\n    field_context\n)\n\n# ✅ FIXED: dispatch processed AFTER field refs replaced\nformatted_prompt, _ = PromptUtils.inject_function_outputs_into_prompt(\n    formatted_prompt,  # NOW resolved\n    tools_path,\n    json.dumps(processed_row, ensure_ascii=False),\n    agent_config=agent_config\n)\n\n# Use processed_row as cleaned_row (no placeholder removal needed)\ncleaned_row = processed_row",

          "lines_modified": "~10 lines",
          "impact": "dispatch_task() now works in batch mode"
        },

        {
          "id": "fix_batch_service_retry",
          "title": "Fix dispatch_task() in batch retry mode",
          "file": "agent_actions/tasks/services/batch_service.py",
          "location": "Lines 1810-1820",
          "problem": "Same as batch prepare mode",

          "current_code": "# ❌ WRONG: Old pattern (removed in Phase 1)\nformatted_prompt, cleaned_row = PromptUtils.replace_placeholders(raw_prompt, processed_row)\n\nformatted_prompt, _ = PromptUtils.inject_function_outputs_into_prompt(\n    formatted_prompt,\n    tools_path,\n    json.dumps(processed_row, ensure_ascii=False),\n    agent_config=agent_config\n)",

          "new_code": "# NEW: Build field_context for this retry row\nfield_context = {'source': processed_row}\n\n# NEW: Replace {reference.field} patterns FIRST\nformatted_prompt = PromptUtils.replace_field_references(\n    raw_prompt,\n    field_context\n)\n\n# ✅ FIXED: dispatch processed AFTER field refs replaced\nformatted_prompt, _ = PromptUtils.inject_function_outputs_into_prompt(\n    formatted_prompt,  # NOW resolved\n    tools_path,\n    json.dumps(processed_row, ensure_ascii=False),\n    agent_config=agent_config\n)\n\ncleaned_row = processed_row",

          "lines_modified": "~10 lines",
          "impact": "dispatch_task() now works in batch retry mode"
        },

