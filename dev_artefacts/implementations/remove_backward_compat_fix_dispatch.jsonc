          },
          "new_implementation": "def format_prompt(raw_prompt, source_content=None, context_data=None, field_context=None):\n    try:\n        # Only pattern: {reference.field}\n        if field_context:\n            return PromptUtils.replace_field_references(raw_prompt, field_context)\n        return raw_prompt\n    except Exception as e:\n        raise PromptValidationError(...)",
