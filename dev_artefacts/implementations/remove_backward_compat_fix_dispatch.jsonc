  "issue": "dispatch_task() not working in batch and non-batch modes",
  "priority": "critical",
  "type": "bug_fix + cleanup",
  "description": "Remove all backward compatibility code for source_context{{}} and return_collection[] patterns, then fix dispatch_task() to work with {reference.field} pattern by ensuring proper processing order.",

  "status": "COMPLETED",
  "completion_summary": {
    "completed_date": "2025-10-18",
