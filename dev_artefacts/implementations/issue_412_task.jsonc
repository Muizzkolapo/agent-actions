                    "internal_id": {}
                  }
                },
                "drops": ["internal_id"]
              },
              "expected_llm_context": ["metrics", "summary"],
              "expected_output": ["metrics", "summary"]
            },
            {
              "name": "test_context_with_observe",
              "config": {
                "output_schema": {
                  "properties": {
                    "metrics": {}
                  }
                },
                "observe": ["original_id", "metadata"]
              },
              "expected_llm_context": ["metrics", "original_id", "metadata"],
              "expected_output": ["metrics", "original_id", "metadata"],
              "note": "observe fields ARE in both output and LLM context (pass-through from input)"
            },
            {
              "name": "test_context_with_return_collection",
              "config": {
                "output_schema": {
                  "properties": {
                    "result": {}
                  }
                },
                "return_collection": true
              },
              "expected_llm_context": ["result", "input_data"]
            },
            {
              "name": "test_context_with_all_directives",
              "config": {
                "output_schema": {
                  "properties": {
                    "metrics": {},
                    "summary": {},
                    "internal_id": {}
                  }
                },
                "drops": ["internal_id"],
                "observe": ["original_id", "metadata"],
                "return_collection": true
              },
              "expected_llm_context": ["metrics", "summary", "original_id", "metadata", "input_data"],
              "expected_output": ["metrics", "summary", "original_id", "metadata"],
              "note": "Output = (schema + observe) - drops. LLM sees all output + input_data."
            }
          ],
          "lines_added": "~150 lines"
        }
      ],
      "validation_requirements": [
        "✅ Computes LLM context correctly ((schema + observe) - drops)",
        "✅ Handles drops directive (removes from output completely)",
        "✅ Handles observe directive (adds input fields to output and LLM context)",
        "✅ Handles return_collection (adds input_data)",
        "✅ Understands that output fields = LLM context fields (next agent sees all output)"
      ],
      "completion_summary": "Phase 2 COMPLETE: Created LLMContextUtils with compute_llm_context() and compute_output_fields() methods. All 17 tests passing. Clean implementation using set operations.",
      "actual_implementation": {
        "file": "agent_actions/agents/validators/llm_context_utils.py",
        "lines": 107,
        "methods": [
          "compute_llm_context(agent_config) -> Set[str]",
          "compute_output_fields(agent_config) -> Set[str]"
        ],
        "formula": "(schema_fields | observe) - drops + (input_data if return_collection)",
        "tests": "tests/agents/validators/test_llm_context_utils.py (17 tests, all passing)"
      }
    },

    "phase_3_validation_logic": {
      "priority": "critical",
      "status": "✅ COMPLETED (2025-10-05)",
      "description": "Implement validation of field references against LLM context",
      "tasks": [
        {
          "id": "create_input_signature_validator",
          "title": "Create InputSignatureValidator class",
          "file": "agent_actions/core/validators/input_signature_validator.py",
          "status": "new",
          "implementation": {
            "class_name": "InputSignatureValidator",
            "method": "validate_agent_inputs(agent_config: dict, dependency_configs: dict) -> ValidationResult",
            "logic": [
              "1. Parse prompt to extract field references",
              "2. For each reference, validate against dependency's LLM context",
              "3. Use 3-tier validation hierarchy for clear errors",
              "4. Return ValidationResult with errors/warnings/successes"
            ]
          },
          "pseudocode": "class InputSignatureValidator:\n    def __init__(self):\n        self.parser = PromptFieldParser()\n        self.context_computer = LLMContextComputer()\n    \n    def validate_agent_inputs(\n        self,\n        agent_config: dict,\n        dependency_configs: dict\n    ) -> ValidationResult:\n        \n        prompt = agent_config.get('prompt', '')\n        references = self.parser.extract_field_references(prompt)\n        \n        errors = []\n        warnings = []\n        successes = []\n        \n        for ref in references:\n            if ref.pattern_type == 'dependency':\n                result = self._validate_dependency_reference(\n                    ref,\n                    dependency_configs\n                )\n                \n                if result.is_error:\n                    errors.append(result)\n                elif result.is_warning:\n                    warnings.append(result)\n                else:\n                    successes.append(result)\n        \n        return ValidationResult(\n            errors=errors,\n            warnings=warnings,\n            successes=successes\n        )\n    \n    def _validate_dependency_reference(\n        self,\n        ref: FieldReference,\n        dependency_configs: dict\n    ) -> FieldValidationResult:\n        \n        source_agent = ref.source_agent\n        field_name = ref.field_name\n        \n        if source_agent not in dependency_configs:\n            return FieldValidationResult(\n                is_error=True,\n                message=f\"Agent '{source_agent}' not found in dependencies\"\n            )\n        \n        dep_config = dependency_configs[source_agent]\n        \n        # Tier 1: Check if field in schema\n        schema_fields = set(\n            dep_config.get('output_schema', {}).get('properties', {}).keys()\n        )\n        \n        if field_name not in schema_fields:\n            return FieldValidationResult(\n                is_error=True,\n                message=f\"Field '{field_name}' not in '{source_agent}' output schema\",\n                help=f\"Available fields: {', '.join(schema_fields)}\"\n            )\n        \n        # Tier 2: Check if field in drops\n        drops = set(dep_config.get('drops', []))\n        \n        if field_name in drops:\n            return FieldValidationResult(\n                is_error=True,\n                message=f\"Field '{field_name}' was dropped by '{source_agent}'\",\n                help=\"Remove from drops or don't reference in prompt\"\n            )\n        \n        # Tier 3: Check if field in observe (LLM context check)\n        observe = set(dep_config.get('observe', []))\n        \n        if field_name in observe:\n            return FieldValidationResult(\n                is_error=True,\n                message=f\"Field '{field_name}' not in LLM context\",\n                help=f\"Field in observe (output-only, not passed to next agent's LLM). Remove from observe if LLM needs it.\",\n                critical=True\n            )\n        \n        # Success - field available in LLM context\n        return FieldValidationResult(\n            is_error=False,\n            message=f\"✅ {source_agent}.{field_name} (in LLM context)\"\n        )",
          "lines_added": "~100 lines"
        },
        {
          "id": "create_validation_result_models",
          "title": "Create ValidationResult Pydantic models",
          "file": "agent_actions/core/validators/input_signature_validator.py",
          "implementation": {
            "models": [
              "class FieldValidationResult(BaseModel):\n    is_error: bool\n    is_warning: bool = False\n    message: str\n    help: Optional[str] = None\n    critical: bool = False",
              "class ValidationResult(BaseModel):\n    errors: List[FieldValidationResult]\n    warnings: List[FieldValidationResult]\n    successes: List[FieldValidationResult]\n    \n    def has_errors(self) -> bool:\n        return len(self.errors) > 0"
            ]
          },
          "lines_added": "~20 lines"
        },
        {
          "id": "test_input_signature_validation",
          "title": "Test input signature validation",
          "file": "tests/core/validators/test_input_signature_validator.py",
          "status": "new",
          "test_cases": [
