{
  "title": "Input Signature Validation for Agent Prompts (Issue #412)",
  "issue": "#412",
  "priority": "high",
  "type": "feature",
  "description": "Implement validation of field references in agent prompts against actual LLM context to prevent runtime errors. Currently, agents can reference fields from dependencies without validation of what the LLM will actually see, leading to runtime failures when fields are dropped, observed, or don't exist in schema.",

  "current_state": {
    "what_exists": {
      "prompt_rendering": {
        "file": "agent_actions/core/parser/prompt_renderer.py",
        "functionality": [
          "Renders prompt templates with field references like {agent.field}",
          "Substitutes values from dependencies at runtime",
          "No validation that fields exist or will be in LLM context"
        ],
        "status": "✅ Works but no validation"
      },
      "output_schema_validation": {
        "file": "agent_actions/agents/validators/output_schema_validator.py",
        "functionality": [
          "Validates output schema structure",
          "Ensures required fields exist",
          "Does not validate input references"
        ],
        "status": "✅ Output validation only"
      },
      "dependency_resolution": {
        "file": "agent_actions/core/graph/agent_workflow.py",
        "functionality": [
          "Resolves dependencies between agents",
          "Builds execution order",
          "No validation of field references in prompts"
        ],
        "status": "✅ Dependency graph works"
      },
      "field_directives": {
        "drops": {
          "purpose": "Remove fields completely from output",
          "impact": "Field unavailable to downstream agents",
          "validation": "None - references to dropped fields not caught"
        },
        "observe": {
          "purpose": "Pass-through fields from input to output (not generated by LLM)",
          "impact": "Field added to output and AVAILABLE to next agent's LLM",
          "validation": "None - references to observed fields should be valid",
          "note": "These are input fields that get enriched into the output post-generation"
        },
        "return_collection": {
          "purpose": "Add input_data to context for loop agents",
          "impact": "Makes collection data available to agent",
          "validation": "None - not validated"
        }
      }
    },
    "what_is_missing": {
      "prompt_field_extraction": {
        "problem": "No parser to extract field references from prompt templates",
        "needed": "Parse {agent_name.field_name} patterns from prompts",
        "examples": [
          "{extractor.metrics}",
          "{workflow_input.data}",
          "{field_name}"
        ]
      },
      "llm_context_computation": {
        "problem": "No logic to compute what LLM will actually see",
        "needed": "Calculate: (schema_fields + observe) - drops + (input_data if return_collection)",
        "critical": "Must understand that observe fields ARE available to next agent's LLM"
      },
      "validation_at_config_load": {
        "problem": "No validation when config is loaded",
        "needed": "Validate all prompt references before workflow execution",
        "timing": "During config loading, not at runtime"
      },
      "clear_error_messages": {
        "problem": "Runtime errors are cryptic",
        "needed": "Explain why field is unavailable (dropped vs observed vs missing)",
        "examples": [
          "Field 'internal_id' was dropped by agent 'extractor'",
          "Field 'debug_info' in observe (LLM won't see it)",
          "Field 'metrics' not in schema"
        ]
      }
    }
  },

  "problem_statement": {
    "user_pain_points": [
      "Runtime errors when referencing fields that were dropped",
      "Confusion when LLM can't see observed fields",
      "No validation until workflow execution",
      "Cryptic error messages that don't explain root cause",
      "Silent failures if fields renamed during refactoring",
      "User expects LLM to see a field but it won't be in context"
    ],
    "use_cases": [
      {
        "name": "Dropped Field Reference",
        "current": "Agent references {extractor.internal_id} but it was dropped → runtime error",
        "desired": "Config load error: 'Field internal_id was dropped by extractor'",
        "impact": "Fail fast with clear explanation"
      },
      {
        "name": "Valid Observed Field Reference",
        "current": "Agent references {extractor.debug_info} from observe → should work fine",
        "desired": "Config load success: 'Field debug_info available (from observe)'",
        "impact": "Confirm observed fields ARE available to next agent's LLM"
      },
      {
        "name": "Missing Schema Field",
        "current": "Agent references {extractor.metrics} but not in schema → runtime error",
        "desired": "Config load error: 'Field metrics not in extractor schema'",
        "impact": "Catch typos and schema mismatches early"
      },
      {
        "name": "Safe Refactoring",
        "current": "Rename field → all referencing agents break at runtime",
        "desired": "Rename field → immediate config load errors show impact",
        "impact": "Confident refactoring with clear impact analysis"
      }
    ],
    "business_impact": "Prevent production failures, improve developer experience, enable safe refactoring"
  },

  "solution_overview": {
    "approach": "Auto-validate all prompt field references at config load time by computing expected LLM context",
    "key_insight": "LLM context = (schema_fields + observe) - drops + (input_data if return_collection)",
    "critical_distinction": "observe adds input fields to output, drops removes fields from output",
    "deliverables": [
      "Prompt template parser to extract field references",
      "LLM context computation for each agent",
      "Validation logic to check references against LLM context",
      "Clear error messages explaining why fields unavailable",
      "Tests for all validation scenarios",
      "Documentation for input signatures"
    ]
  },

  "implementation_approach": {
    "validation_hierarchy": {
      "title": "3-tier validation for clear error messages",
      "description": "Check field availability in specific order to provide most helpful error",
      "tiers": [
        {
          "level": 1,
          "check": "Field exists in output schema",
          "error": "Field '{field}' not in '{agent}' output schema",
          "help": "Available fields: {list_of_schema_fields}"
        },
        {
          "level": 2,
          "check": "Field not in drops directive",
          "error": "Field '{field}' was dropped by '{agent}'",
          "help": "Remove from drops or don't reference in prompt"
        },
        {
          "level": 3,
          "check": "Field in output (schema or observe, but not dropped)",
          "error": "Field '{field}' not available",
          "help": "Field must be in output schema or observe list, and not in drops",
          "critical": true
        }
      ],
      "success": "Field validated as available in LLM context"
    },
    "llm_context_formula": {
      "title": "Compute actual LLM context",
      "formula": "llm_context = (schema_fields + observe) - drops + (input_data if return_collection)",
      "implementation": "def compute_llm_context(agent_config):\n    schema_fields = set(agent_config['output_schema']['properties'].keys())\n    drops = set(agent_config.get('drops', []))\n    observe = set(agent_config.get('observe', []))\n    \n    # Next agent sees: schema + observe - drops\n    llm_context = (schema_fields | observe) - drops\n    \n    if agent_config.get('return_collection'):\n        llm_context.add('input_data')\n    \n    return llm_context",
      "explanation": {
        "observe": "Pass-through fields from input → added to output → available to next agent's LLM",
        "drops": "Fields removed completely from output → not available to next agent",
        "output_equals_context": "Next agent's LLM sees everything in the output"
      }
    },
    "field_reference_patterns": {
      "dependency_field": {
        "pattern": "{agent_name.field_name}",
        "example": "{extractor.metrics}",
        "validation": "Check if field in agent's LLM context"
      },
      "workflow_input": {
        "pattern": "{workflow_input.field}",
        "example": "{workflow_input.data}",
        "validation": "Check if field in workflow input schema"
      },
      "current_context": {
        "pattern": "{field_name}",
        "example": "{user_query}",
        "validation": "Check if field in current agent's input context"
      }
    }
  },

  "phases": {
    "phase_1_prompt_parser": {
      "priority": "critical",
      "status": "✅ COMPLETED (2025-10-05) - REUSING #429",
      "description": "Implement prompt template field reference parser",
      "tasks": [
        {
          "id": "create_prompt_parser",
          "title": "Create PromptFieldParser class",
          "file": "agent_actions/core/validators/prompt_field_parser.py",
          "status": "new",
          "implementation": {
            "class_name": "PromptFieldParser",
            "method": "extract_field_references(prompt: str) -> List[FieldReference]",
            "logic": [
              "1. Use regex to find all {agent.field} patterns",
              "2. Parse into FieldReference objects with source_agent and field_name",
              "3. Handle {workflow_input.field} separately",
              "4. Handle {field} (current context) separately"
            ],
            "regex_pattern": "\\\\{([\\\\w_]+)\\\\.([\\\\w_]+)\\\\}",
            "return_type": "List[FieldReference(source_agent: str, field_name: str, pattern_type: str)]"
          },
          "pseudocode": "class PromptFieldParser:\n    @staticmethod\n    def extract_field_references(prompt: str) -> List[FieldReference]:\n        references = []\n        \n        # Pattern: {agent.field}\n        dependency_pattern = r'\\{([\\w_]+)\\.([\\w_]+)\\}'\n        for match in re.finditer(dependency_pattern, prompt):\n            source_agent = match.group(1)\n            field_name = match.group(2)\n            \n            if source_agent == 'workflow_input':\n                pattern_type = 'workflow_input'\n            else:\n                pattern_type = 'dependency'\n            \n            references.append(FieldReference(\n                source_agent=source_agent,\n                field_name=field_name,\n                pattern_type=pattern_type\n            ))\n        \n        # Pattern: {field} (current context)\n        simple_pattern = r'\\{([\\w_]+)\\}'\n        for match in re.finditer(simple_pattern, prompt):\n            if '.' not in match.group(0):  # Skip already matched\n                references.append(FieldReference(\n                    source_agent='current',\n                    field_name=match.group(1),\n                    pattern_type='current_context'\n                ))\n        \n        return references",
          "lines_added": "~50 lines"
        },
        {
          "id": "add_field_reference_model",
          "title": "Create FieldReference Pydantic model",
          "file": "agent_actions/core/validators/prompt_field_parser.py",
          "implementation": {
            "model": "class FieldReference(BaseModel):\n    source_agent: str  # 'extractor' or 'workflow_input' or 'current'\n    field_name: str    # 'metrics'\n    pattern_type: str  # 'dependency' | 'workflow_input' | 'current_context'"
          },
          "lines_added": "~10 lines"
        },
        {
          "id": "test_prompt_parser",
          "title": "Test prompt field reference extraction",
          "file": "tests/core/validators/test_prompt_field_parser.py",
          "status": "new",
          "test_cases": [
            {
              "name": "test_extract_dependency_references",
              "prompt": "Analyze {extractor.metrics} and {analyzer.summary}",
              "expected": [
                "FieldReference(source_agent='extractor', field_name='metrics', pattern_type='dependency')",
                "FieldReference(source_agent='analyzer', field_name='summary', pattern_type='dependency')"
              ]
            },
            {
              "name": "test_extract_workflow_input",
              "prompt": "Process {workflow_input.data}",
              "expected": [
                "FieldReference(source_agent='workflow_input', field_name='data', pattern_type='workflow_input')"
              ]
            },
            {
              "name": "test_extract_current_context",
              "prompt": "Use {user_query} to process",
              "expected": [
                "FieldReference(source_agent='current', field_name='user_query', pattern_type='current_context')"
              ]
            },
            {
              "name": "test_mixed_references",
              "prompt": "Combine {extractor.data} with {workflow_input.config} for {task}",
              "expected": "All 3 references extracted correctly"
            }
          ],
          "lines_added": "~100 lines"
        }
      ],
      "validation_requirements": [
        "✅ Extracts dependency field references ({agent.field})",
        "✅ Extracts source references ({source.field})",
        "✅ Extracts loop references ({loop.index}, {loop.item.field})",
        "✅ Extracts workflow references ({workflow.name})",
        "✅ Handles multiple references in one prompt",
        "✅ Returns structured dict objects"
      ],
      "completion_summary": "Phase 1 COMPLETE - Reusing PromptUtils.parse_field_references() from #429. Already handles all field reference patterns. No new code needed for this phase.",
      "actual_implementation": {
        "file": "agent_actions/agents/transformers/prompt_utils.py",
        "method": "parse_field_references(prompt: str) -> list",
        "lines": "219-251",
        "from_issue": "#429",
        "tests": "tests/agents/transformers/test_prompt_field_refs.py (6 tests covering parsing)"
      }
    },

    "phase_2_llm_context_computation": {
      "priority": "critical",
      "status": "✅ COMPLETED (2025-10-05)",
      "description": "Implement LLM context computation for each agent",
      "tasks": [
        {
          "id": "create_context_computer",
          "title": "Create LLMContextComputer class",
          "file": "agent_actions/core/validators/llm_context_computer.py",
          "status": "new",
          "implementation": {
            "class_name": "LLMContextComputer",
            "method": "compute_llm_context(agent_config: dict) -> Set[str]",
            "logic": [
              "1. Get all fields from output_schema properties",
              "2. Remove fields in drops directive",
              "3. Remove fields in observe directive",
              "4. Add input_data if return_collection is True",
              "5. Return set of fields LLM will actually see"
            ],
            "critical": "This is the core logic - must be correct!"
          },
          "pseudocode": "class LLMContextComputer:\n    @staticmethod\n    def compute_llm_context(agent_config: dict) -> Set[str]:\n        # Start with all schema fields\n        schema_fields = set(\n            agent_config.get('output_schema', {}).get('properties', {}).keys()\n        )\n        \n        # Remove dropped fields (completely removed)\n        drops = set(agent_config.get('drops', []))\n        \n        # Remove observed fields (output-only, not in LLM context)\n        observe = set(agent_config.get('observe', []))\n        \n        # LLM context = schema - drops - observe\n        llm_context = schema_fields - drops - observe\n        \n        # Add input_data if return_collection\n        if agent_config.get('return_collection'):\n            llm_context.add('input_data')\n        \n        return llm_context\n    \n    @staticmethod\n    def compute_output_fields(agent_config: dict) -> Set[str]:\n        \"\"\"What's in output (different from LLM context)\"\"\"\n        schema_fields = set(\n            agent_config.get('output_schema', {}).get('properties', {}).keys()\n        )\n        drops = set(agent_config.get('drops', []))\n        \n        # Output = schema - drops (observe stays in output)\n        return schema_fields - drops",
          "lines_added": "~40 lines"
        },
        {
          "id": "test_llm_context_computation",
          "title": "Test LLM context computation",
          "file": "tests/core/validators/test_llm_context_computer.py",
          "status": "new",
          "test_cases": [
