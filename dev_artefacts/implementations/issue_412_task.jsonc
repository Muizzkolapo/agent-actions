{
  "title": "Input Signature Validation for Agent Prompts (Issue #412)",
  "issue": "#412",
  "priority": "high",
  "type": "feature",
  "description": "Implement validation of field references in agent prompts against actual LLM context to prevent runtime errors. Currently, agents can reference fields from dependencies without validation of what the LLM will actually see, leading to runtime failures when fields are dropped, observed, or don't exist in schema.",

  "current_state": {
    "what_exists": {
      "prompt_rendering": {
        "file": "agent_actions/core/parser/prompt_renderer.py",
        "functionality": [
          "Renders prompt templates with field references like {agent.field}",
          "Substitutes values from dependencies at runtime",
          "No validation that fields exist or will be in LLM context"
        ],
        "status": "✅ Works but no validation"
      },
      "output_schema_validation": {
        "file": "agent_actions/agents/validators/output_schema_validator.py",
        "functionality": [
          "Validates output schema structure",
          "Ensures required fields exist",
          "Does not validate input references"
        ],
        "status": "✅ Output validation only"
      },
      "dependency_resolution": {
        "file": "agent_actions/core/graph/agent_workflow.py",
        "functionality": [
          "Resolves dependencies between agents",
          "Builds execution order",
          "No validation of field references in prompts"
        ],
        "status": "✅ Dependency graph works"
      },
      "field_directives": {
        "drops": {
          "purpose": "Remove fields completely from output",
          "impact": "Field unavailable to downstream agents",
          "validation": "None - references to dropped fields not caught"
        },
        "observe": {
          "purpose": "Include in output but NOT in next agent's LLM context",
          "impact": "Field exists in output but LLM cannot see it",
          "validation": "None - references to observed fields not caught",
          "critical": "This is the most confusing case for users"
        },
        "return_collection": {
          "purpose": "Add input_data to context for loop agents",
          "impact": "Makes collection data available to agent",
          "validation": "None - not validated"
        }
      }
    },
    "what_is_missing": {
      "prompt_field_extraction": {
        "problem": "No parser to extract field references from prompt templates",
        "needed": "Parse {agent_name.field_name} patterns from prompts",
        "examples": [
          "{extractor.metrics}",
          "{workflow_input.data}",
          "{field_name}"
        ]
      },
      "llm_context_computation": {
        "problem": "No logic to compute what LLM will actually see",
        "needed": "Calculate: schema_fields - drops - observe + (input_data if return_collection)",
        "critical": "Must distinguish between output fields and LLM context fields"
      },
      "validation_at_config_load": {
        "problem": "No validation when config is loaded",
        "needed": "Validate all prompt references before workflow execution",
        "timing": "During config loading, not at runtime"
      },
      "clear_error_messages": {
        "problem": "Runtime errors are cryptic",
        "needed": "Explain why field is unavailable (dropped vs observed vs missing)",
        "examples": [
          "Field 'internal_id' was dropped by agent 'extractor'",
          "Field 'debug_info' in observe (LLM won't see it)",
          "Field 'metrics' not in schema"
        ]
      }
    }
  },

  "problem_statement": {
    "user_pain_points": [
      "Runtime errors when referencing fields that were dropped",
      "Confusion when LLM can't see observed fields",
      "No validation until workflow execution",
      "Cryptic error messages that don't explain root cause",
      "Silent failures if fields renamed during refactoring",
      "User expects LLM to see a field but it won't be in context"
    ],
    "use_cases": [
      {
        "name": "Dropped Field Reference",
        "current": "Agent references {extractor.internal_id} but it was dropped → runtime error",
        "desired": "Config load error: 'Field internal_id was dropped by extractor'",
        "impact": "Fail fast with clear explanation"
      },
      {
        "name": "Observed Field Reference (Critical)",
        "current": "Agent references {extractor.debug_info} from observe → LLM can't see it, fails mysteriously",
        "desired": "Config load error: 'Field debug_info in observe (LLM won't see it)'",
        "impact": "Prevent silent LLM failures"
      },
      {
        "name": "Missing Schema Field",
        "current": "Agent references {extractor.metrics} but not in schema → runtime error",
        "desired": "Config load error: 'Field metrics not in extractor schema'",
        "impact": "Catch typos and schema mismatches early"
      },
      {
        "name": "Safe Refactoring",
        "current": "Rename field → all referencing agents break at runtime",
        "desired": "Rename field → immediate config load errors show impact",
        "impact": "Confident refactoring with clear impact analysis"
      }
    ],
    "business_impact": "Prevent production failures, improve developer experience, enable safe refactoring"
  },

  "solution_overview": {
    "approach": "Auto-validate all prompt field references at config load time by computing expected LLM context",
    "key_insight": "LLM context = schema_fields - drops - observe + (input_data if return_collection)",
    "critical_distinction": "Output fields (what agent produces) vs LLM context fields (what next agent's LLM sees)",
    "deliverables": [
      "Prompt template parser to extract field references",
      "LLM context computation for each agent",
      "Validation logic to check references against LLM context",
      "Clear error messages explaining why fields unavailable",
      "Tests for all validation scenarios",
      "Documentation for input signatures"
    ]
  },

  "implementation_approach": {
    "validation_hierarchy": {
      "title": "3-tier validation for clear error messages",
      "description": "Check field availability in specific order to provide most helpful error",
      "tiers": [
        {
          "level": 1,
          "check": "Field exists in output schema",
          "error": "Field '{field}' not in '{agent}' output schema",
          "help": "Available fields: {list_of_schema_fields}"
        },
        {
          "level": 2,
          "check": "Field not in drops directive",
          "error": "Field '{field}' was dropped by '{agent}'",
          "help": "Remove from drops or don't reference in prompt"
        },
        {
          "level": 3,
          "check": "Field not in observe directive (LLM context check)",
          "error": "Field '{field}' not in LLM context",
          "help": "Field in observe (output-only, not passed to next agent's LLM). Remove from observe if LLM needs it.",
          "critical": true
        }
      ],
      "success": "Field validated as available in LLM context"
    },
    "llm_context_formula": {
      "title": "Compute actual LLM context",
      "formula": "llm_context = schema_fields - drops - observe + (input_data if return_collection)",
      "implementation": "def compute_llm_context(agent_config):\n    schema_fields = set(agent_config['output_schema']['properties'].keys())\n    drops = set(agent_config.get('drops', []))\n    observe = set(agent_config.get('observe', []))\n    \n    llm_context = schema_fields - drops - observe\n    \n    if agent_config.get('return_collection'):\n        llm_context.add('input_data')\n    \n    return llm_context"
    },
    "field_reference_patterns": {
      "dependency_field": {
        "pattern": "{agent_name.field_name}",
        "example": "{extractor.metrics}",
        "validation": "Check if field in agent's LLM context"
      },
      "workflow_input": {
        "pattern": "{workflow_input.field}",
        "example": "{workflow_input.data}",
        "validation": "Check if field in workflow input schema"
      },
      "current_context": {
        "pattern": "{field_name}",
        "example": "{user_query}",
        "validation": "Check if field in current agent's input context"
      }
    }
  },

  "phases": {
    "phase_1_prompt_parser": {
      "priority": "critical",
      "description": "Implement prompt template field reference parser",
      "tasks": [
        {
          "id": "create_prompt_parser",
          "title": "Create PromptFieldParser class",
          "file": "agent_actions/core/validators/prompt_field_parser.py",
          "status": "new",
          "implementation": {
            "class_name": "PromptFieldParser",
            "method": "extract_field_references(prompt: str) -> List[FieldReference]",
            "logic": [
              "1. Use regex to find all {agent.field} patterns",
              "2. Parse into FieldReference objects with source_agent and field_name",
              "3. Handle {workflow_input.field} separately",
              "4. Handle {field} (current context) separately"
            ],
            "regex_pattern": r"\\{([\\w_]+)\\.([\\w_]+)\\}",
            "return_type": "List[FieldReference(source_agent: str, field_name: str, pattern_type: str)]"
          },
          "pseudocode": "class PromptFieldParser:\n    @staticmethod\n    def extract_field_references(prompt: str) -> List[FieldReference]:\n        references = []\n        \n        # Pattern: {agent.field}\n        dependency_pattern = r'\\{([\\w_]+)\\.([\\w_]+)\\}'\n        for match in re.finditer(dependency_pattern, prompt):\n            source_agent = match.group(1)\n            field_name = match.group(2)\n            \n            if source_agent == 'workflow_input':\n                pattern_type = 'workflow_input'\n            else:\n                pattern_type = 'dependency'\n            \n            references.append(FieldReference(\n                source_agent=source_agent,\n                field_name=field_name,\n                pattern_type=pattern_type\n            ))\n        \n        # Pattern: {field} (current context)\n        simple_pattern = r'\\{([\\w_]+)\\}'\n        for match in re.finditer(simple_pattern, prompt):\n            if '.' not in match.group(0):  # Skip already matched\n                references.append(FieldReference(\n                    source_agent='current',\n                    field_name=match.group(1),\n                    pattern_type='current_context'\n                ))\n        \n        return references",
          "lines_added": "~50 lines"
        },
        {
          "id": "add_field_reference_model",
          "title": "Create FieldReference Pydantic model",
          "file": "agent_actions/core/validators/prompt_field_parser.py",
          "implementation": {
            "model": "class FieldReference(BaseModel):\n    source_agent: str  # 'extractor' or 'workflow_input' or 'current'\n    field_name: str    # 'metrics'\n    pattern_type: str  # 'dependency' | 'workflow_input' | 'current_context'"
          },
          "lines_added": "~10 lines"
        },
        {
          "id": "test_prompt_parser",
          "title": "Test prompt field reference extraction",
          "file": "tests/core/validators/test_prompt_field_parser.py",
          "status": "new",
          "test_cases": [
            {
              "name": "test_extract_dependency_references",
              "prompt": "Analyze {extractor.metrics} and {analyzer.summary}",
              "expected": [
                "FieldReference(source_agent='extractor', field_name='metrics', pattern_type='dependency')",
                "FieldReference(source_agent='analyzer', field_name='summary', pattern_type='dependency')"
              ]
            },
            {
              "name": "test_extract_workflow_input",
              "prompt": "Process {workflow_input.data}",
              "expected": [
                "FieldReference(source_agent='workflow_input', field_name='data', pattern_type='workflow_input')"
              ]
            },
            {
              "name": "test_extract_current_context",
              "prompt": "Use {user_query} to process",
              "expected": [
                "FieldReference(source_agent='current', field_name='user_query', pattern_type='current_context')"
              ]
            },
            {
              "name": "test_mixed_references",
              "prompt": "Combine {extractor.data} with {workflow_input.config} for {task}",
              "expected": "All 3 references extracted correctly"
            }
          ],
          "lines_added": "~100 lines"
        }
      ],
      "validation_requirements": [
        "✓ Extracts dependency field references ({agent.field})",
        "✓ Extracts workflow_input references ({workflow_input.field})",
        "✓ Extracts current context references ({field})",
        "✓ Handles multiple references in one prompt",
        "✓ Returns structured FieldReference objects"
      ]
    },

    "phase_2_llm_context_computation": {
      "priority": "critical",
      "description": "Implement LLM context computation for each agent",
      "tasks": [
        {
          "id": "create_context_computer",
          "title": "Create LLMContextComputer class",
          "file": "agent_actions/core/validators/llm_context_computer.py",
          "status": "new",
          "implementation": {
            "class_name": "LLMContextComputer",
            "method": "compute_llm_context(agent_config: dict) -> Set[str]",
            "logic": [
              "1. Get all fields from output_schema properties",
              "2. Remove fields in drops directive",
              "3. Remove fields in observe directive",
              "4. Add input_data if return_collection is True",
              "5. Return set of fields LLM will actually see"
            ],
            "critical": "This is the core logic - must be correct!"
          },
          "pseudocode": "class LLMContextComputer:\n    @staticmethod\n    def compute_llm_context(agent_config: dict) -> Set[str]:\n        # Start with all schema fields\n        schema_fields = set(\n            agent_config.get('output_schema', {}).get('properties', {}).keys()\n        )\n        \n        # Remove dropped fields (completely removed)\n        drops = set(agent_config.get('drops', []))\n        \n        # Remove observed fields (output-only, not in LLM context)\n        observe = set(agent_config.get('observe', []))\n        \n        # LLM context = schema - drops - observe\n        llm_context = schema_fields - drops - observe\n        \n        # Add input_data if return_collection\n        if agent_config.get('return_collection'):\n            llm_context.add('input_data')\n        \n        return llm_context\n    \n    @staticmethod\n    def compute_output_fields(agent_config: dict) -> Set[str]:\n        \"\"\"What's in output (different from LLM context)\"\"\"\n        schema_fields = set(\n            agent_config.get('output_schema', {}).get('properties', {}).keys()\n        )\n        drops = set(agent_config.get('drops', []))\n        \n        # Output = schema - drops (observe stays in output)\n        return schema_fields - drops",
          "lines_added": "~40 lines"
        },
        {
          "id": "test_llm_context_computation",
          "title": "Test LLM context computation",
          "file": "tests/core/validators/test_llm_context_computer.py",
          "status": "new",
          "test_cases": [
            {
              "name": "test_basic_context",
              "config": {
                "output_schema": {
                  "properties": {
                    "metrics": {},
                    "summary": {}
                  }
                }
              },
              "expected_llm_context": ["metrics", "summary"]
            },
            {
              "name": "test_context_with_drops",
              "config": {
                "output_schema": {
                  "properties": {
                    "metrics": {},
                    "summary": {},
                    "internal_id": {}
                  }
                },
                "drops": ["internal_id"]
              },
              "expected_llm_context": ["metrics", "summary"],
              "expected_output": ["metrics", "summary"]
            },
            {
              "name": "test_context_with_observe",
              "config": {
                "output_schema": {
                  "properties": {
                    "metrics": {},
                    "debug_info": {}
                  }
                },
                "observe": ["debug_info"]
              },
              "expected_llm_context": ["metrics"],
              "expected_output": ["metrics", "debug_info"],
              "note": "debug_info in output but NOT in LLM context"
            },
            {
              "name": "test_context_with_return_collection",
              "config": {
                "output_schema": {
                  "properties": {
                    "result": {}
                  }
                },
                "return_collection": true
              },
              "expected_llm_context": ["result", "input_data"]
            },
            {
              "name": "test_context_with_all_directives",
              "config": {
                "output_schema": {
                  "properties": {
                    "metrics": {},
                    "summary": {},
                    "internal_id": {},
                    "debug_info": {}
                  }
                },
                "drops": ["internal_id"],
                "observe": ["debug_info"],
                "return_collection": true
              },
              "expected_llm_context": ["metrics", "summary", "input_data"],
              "expected_output": ["metrics", "summary", "debug_info"]
            }
          ],
          "lines_added": "~150 lines"
        }
      ],
      "validation_requirements": [
        "✓ Computes LLM context correctly (schema - drops - observe)",
        "✓ Handles drops directive (removes completely)",
        "✓ Handles observe directive (removes from LLM context, keeps in output)",
        "✓ Handles return_collection (adds input_data)",
        "✓ Distinguishes between output fields and LLM context fields"
      ]
    },

    "phase_3_validation_logic": {
      "priority": "critical",
      "description": "Implement validation of field references against LLM context",
      "tasks": [
        {
          "id": "create_input_signature_validator",
          "title": "Create InputSignatureValidator class",
          "file": "agent_actions/core/validators/input_signature_validator.py",
          "status": "new",
          "implementation": {
            "class_name": "InputSignatureValidator",
            "method": "validate_agent_inputs(agent_config: dict, dependency_configs: dict) -> ValidationResult",
            "logic": [
              "1. Parse prompt to extract field references",
              "2. For each reference, validate against dependency's LLM context",
              "3. Use 3-tier validation hierarchy for clear errors",
              "4. Return ValidationResult with errors/warnings/successes"
            ]
          },
          "pseudocode": "class InputSignatureValidator:\n    def __init__(self):\n        self.parser = PromptFieldParser()\n        self.context_computer = LLMContextComputer()\n    \n    def validate_agent_inputs(\n        self,\n        agent_config: dict,\n        dependency_configs: dict\n    ) -> ValidationResult:\n        \n        prompt = agent_config.get('prompt', '')\n        references = self.parser.extract_field_references(prompt)\n        \n        errors = []\n        warnings = []\n        successes = []\n        \n        for ref in references:\n            if ref.pattern_type == 'dependency':\n                result = self._validate_dependency_reference(\n                    ref,\n                    dependency_configs\n                )\n                \n                if result.is_error:\n                    errors.append(result)\n                elif result.is_warning:\n                    warnings.append(result)\n                else:\n                    successes.append(result)\n        \n        return ValidationResult(\n            errors=errors,\n            warnings=warnings,\n            successes=successes\n        )\n    \n    def _validate_dependency_reference(\n        self,\n        ref: FieldReference,\n        dependency_configs: dict\n    ) -> FieldValidationResult:\n        \n        source_agent = ref.source_agent\n        field_name = ref.field_name\n        \n        if source_agent not in dependency_configs:\n            return FieldValidationResult(\n                is_error=True,\n                message=f\"Agent '{source_agent}' not found in dependencies\"\n            )\n        \n        dep_config = dependency_configs[source_agent]\n        \n        # Tier 1: Check if field in schema\n        schema_fields = set(\n            dep_config.get('output_schema', {}).get('properties', {}).keys()\n        )\n        \n        if field_name not in schema_fields:\n            return FieldValidationResult(\n                is_error=True,\n                message=f\"Field '{field_name}' not in '{source_agent}' output schema\",\n                help=f\"Available fields: {', '.join(schema_fields)}\"\n            )\n        \n        # Tier 2: Check if field in drops\n        drops = set(dep_config.get('drops', []))\n        \n        if field_name in drops:\n            return FieldValidationResult(\n                is_error=True,\n                message=f\"Field '{field_name}' was dropped by '{source_agent}'\",\n                help=\"Remove from drops or don't reference in prompt\"\n            )\n        \n        # Tier 3: Check if field in observe (LLM context check)\n        observe = set(dep_config.get('observe', []))\n        \n        if field_name in observe:\n            return FieldValidationResult(\n                is_error=True,\n                message=f\"Field '{field_name}' not in LLM context\",\n                help=f\"Field in observe (output-only, not passed to next agent's LLM). Remove from observe if LLM needs it.\",\n                critical=True\n            )\n        \n        # Success - field available in LLM context\n        return FieldValidationResult(\n            is_error=False,\n            message=f\"✅ {source_agent}.{field_name} (in LLM context)\"\n        )",
          "lines_added": "~100 lines"
        },
        {
          "id": "create_validation_result_models",
          "title": "Create ValidationResult Pydantic models",
          "file": "agent_actions/core/validators/input_signature_validator.py",
          "implementation": {
            "models": [
              "class FieldValidationResult(BaseModel):\n    is_error: bool\n    is_warning: bool = False\n    message: str\n    help: Optional[str] = None\n    critical: bool = False",
              "class ValidationResult(BaseModel):\n    errors: List[FieldValidationResult]\n    warnings: List[FieldValidationResult]\n    successes: List[FieldValidationResult]\n    \n    def has_errors(self) -> bool:\n        return len(self.errors) > 0"
            ]
          },
          "lines_added": "~20 lines"
        },
        {
          "id": "test_input_signature_validation",
          "title": "Test input signature validation",
          "file": "tests/core/validators/test_input_signature_validator.py",
          "status": "new",
          "test_cases": [
            {
              "name": "test_valid_field_reference",
              "agent_config": {
                "prompt": "Analyze {extractor.metrics}"
              },
              "dependency_configs": {
                "extractor": {
                  "output_schema": {
                    "properties": {
                      "metrics": {}
                    }
                  }
                }
              },
              "expected": "No errors, 1 success"
            },
            {
              "name": "test_missing_schema_field",
              "agent_config": {
                "prompt": "Check {extractor.metrics}"
              },
              "dependency_configs": {
                "extractor": {
                  "output_schema": {
                    "properties": {
                      "summary": {}
                    }
                  }
                }
              },
              "expected_error": "Field 'metrics' not in 'extractor' output schema"
            },
            {
              "name": "test_dropped_field_reference",
              "agent_config": {
                "prompt": "Use {extractor.internal_id}"
              },
              "dependency_configs": {
                "extractor": {
                  "output_schema": {
                    "properties": {
                      "internal_id": {}
                    }
                  },
                  "drops": ["internal_id"]
                }
              },
              "expected_error": "Field 'internal_id' was dropped by 'extractor'"
            },
            {
              "name": "test_observed_field_reference",
              "agent_config": {
                "prompt": "Debug with {extractor.debug_info}"
              },
              "dependency_configs": {
                "extractor": {
                  "output_schema": {
                    "properties": {
                      "debug_info": {}
                    }
                  },
                  "observe": ["debug_info"]
                }
              },
              "expected_error": "Field 'debug_info' not in LLM context",
              "expected_help": "Field in observe (output-only, not passed to next agent's LLM)"
            },
            {
              "name": "test_multiple_references_mixed",
              "agent_config": {
                "prompt": "Use {extractor.metrics} and {extractor.debug_info} and {extractor.internal_id}"
              },
              "dependency_configs": {
                "extractor": {
                  "output_schema": {
                    "properties": {
                      "metrics": {},
                      "debug_info": {},
                      "internal_id": {}
                    }
                  },
                  "drops": ["internal_id"],
                  "observe": ["debug_info"]
                }
              },
              "expected": "1 success (metrics), 2 errors (debug_info, internal_id)"
            }
          ],
          "lines_added": "~200 lines"
        }
      ],
      "validation_requirements": [
        "✓ Validates field exists in schema (Tier 1)",
        "✓ Validates field not dropped (Tier 2)",
        "✓ Validates field not observed (Tier 3 - LLM context)",
        "✓ Provides clear error messages for each tier",
        "✓ Returns structured ValidationResult with errors/warnings/successes"
      ]
    },

    "phase_4_config_load_integration": {
      "priority": "critical",
      "description": "Integrate validation into config loading process",
      "tasks": [
        {
          "id": "add_validation_to_config_loader",
          "title": "Add input signature validation to config loader",
          "file": "agent_actions/core/parser/config_loader.py",
          "implementation": {
            "location": "After dependency graph is built",
            "logic": [
              "1. Build dependency graph (existing)",
              "2. For each agent, get its dependency configs",
              "3. Run InputSignatureValidator.validate_agent_inputs()",
              "4. If errors found, log and raise ConfigValidationError",
              "5. If warnings, log but continue"
            ]
          },
          "pseudocode": "# In ConfigLoader.load_config()\n\ndef load_config(self, config_path: str) -> WorkflowConfig:\n    # Existing: Parse YAML, build dependency graph\n    workflow_config = self._parse_yaml(config_path)\n    dependency_graph = self._build_dependency_graph(workflow_config)\n    \n    # NEW: Validate input signatures\n    validator = InputSignatureValidator()\n    \n    for agent_config in workflow_config.agents:\n        agent_name = agent_config['name']\n        dependencies = dependency_graph.get_dependencies(agent_name)\n        \n        # Get dependency configs\n        dep_configs = {\n            dep: next(a for a in workflow_config.agents if a['name'] == dep)\n            for dep in dependencies\n        }\n        \n        # Validate\n        result = validator.validate_agent_inputs(agent_config, dep_configs)\n        \n        if result.has_errors():\n            self._log_validation_errors(agent_name, result)\n            raise ConfigValidationError(\n                f\"Input signature validation failed for agent '{agent_name}'\"\n            )\n        \n        if result.warnings:\n            self._log_validation_warnings(agent_name, result)\n    \n    self.console.print('[green]✅ All input signatures validated[/green]')\n    return workflow_config",
          "lines_modified": "~30 lines"
        },
        {
          "id": "create_config_validation_error",
          "title": "Create ConfigValidationError exception",
          "file": "agent_actions/core/exceptions.py",
          "implementation": {
            "class": "class ConfigValidationError(Exception):\n    \"\"\"Raised when config validation fails\"\"\"\n    pass"
          },
          "lines_added": "~5 lines"
        },
        {
          "id": "add_validation_logging",
