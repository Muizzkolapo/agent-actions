{
  "title": "Fix error handling and context propagation: cascading exceptions hide root cause",
  "issue": "#394",
  "priority": "critical",
  "description": "Error handling in the codebase causes cascading exceptions that hide the actual root cause from users, making debugging extremely difficult. Users see unhelpful errors like \"'str' object has no attribute 'items'\" instead of the actual root cause.",

  "root_problem": {
    "description": "Exception cascade where each level loses more context until the final error is completely unhelpful",
    "example_cascade": [
      "Level 1 (Root Cause): ValueError: Model 'claude-sonnet-4-20250514' not supported by this provider",
      "Level 2 (Context Loss): ConfigurationError: <exception str() failed>",
      "Level 3 (Generic Wrapper): AgentActionsError: Unexpected error generating target",
      "Level 4 (Complete Failure): AttributeError: 'str' object has no attribute 'items'",
      "Level 5 (User Sees): Error: Failed to run agent qanalabs-quiz-gen: 'str' object has no attribute 'items'"
    ]
  },

  "phases": {
    "phase_0_user_facing_errors": {
      "priority": "critical",
      "description": "Add user-friendly error formatting that hides Python internals from config users",
      "key_principle": "Users write YAML/JSON config like dbt/terraform - they should NEVER see Python stack traces, file paths, or internal errors",
      "tasks": [
        {
          "id": "user_error_formatter",
          "title": "Add user-friendly error message formatter",
          "file": "agent_actions/core/exceptions.py",
          "description": "Create formatter that converts internal Python errors to user-friendly config errors",
          "function_signature": "def format_user_error(exc: Exception, context: Dict) -> str",
          "examples": {
            "python_error": "'str' object has no attribute 'items'",
            "user_error": "Configuration Error: Invalid model specified in agent 'my-agent'"
          },
          "status": "completed",
          "implementation_summary": "Created comprehensive user error formatting system with ErrorTranslator class that categorizes errors (Configuration, File, Authentication, etc.) and provides actionable guidance",
          "files_changed": [
            "agent_actions/core/user_errors.py - Created UserError dataclass, ErrorTranslator class, and format_user_error() function",
            "tests/core/test_error_system_integration.py - Integration tests for user-friendly error formatting"
          ]
        },
        {
          "id": "error_translation_map",
          "title": "Add error translation mapping",
          "description": "Map internal exception types to user-friendly error categories",
          "categories": [
            "Configuration Error",
            "Model Error",
            "Provider Error",
            "File Error",
            "Network Error",
            "Authentication Error"
          ],
          "status": "completed",
          "implementation_summary": "Built category-based error translation system in ErrorTranslator class with handlers for each error type. Maps Python exceptions to user-friendly categories with appropriate guidance",
          "files_changed": [
            "agent_actions/core/user_errors.py - ErrorTranslator class with category detection methods (_is_config_error, _is_file_error, etc.)"
          ]
        },
        {
          "id": "hide_stack_traces",
          "title": "Hide Python stack traces from users",
          "files": [
            "agent_actions/tasks/run.py",
            "All CLI entry points"
          ],
          "description": "Ensure users never see Python file paths, line numbers, or stack traces",
          "status": "completed",
          "implementation_summary": "Changed default logging level from WARNING to CRITICAL to suppress ERROR-level debug logs. Updated all CLI commands to use format_user_error() instead of raw exception display",
          "files_changed": [
            "agent_actions/cli/main.py - Changed logging.WARNING to logging.CRITICAL (line 91)",
            "agent_actions/tasks/run.py - Updated exception handlers to use format_user_error()",
            "agent_actions/tasks/batch.py - Updated CLI error handling",
            "agent_actions/tasks/docs.py - Updated CLI error handling",
            "agent_actions/tasks/test.py - Updated CLI error handling",
            "agent_actions/tasks/compile.py - Updated CLI error handling",
            "agent_actions/tasks/init.py - Updated CLI error handling",
            "agent_actions/tasks/status.py - Updated CLI error handling"
          ]
        },
        {
          "id": "actionable_error_format",
          "title": "Add structured error format with fix suggestions",
          "format": {
            "type": "Configuration Error",
            "description": "Human readable problem description",
            "location": "agent: my-agent, field: model",
            "issue": "Specific issue description",
            "fix": "Specific fix instructions",
            "docs_link": "Link to relevant documentation"
          },
          "status": "completed",
          "implementation_summary": "Created UserError dataclass with structured format including category, title, details, fix instructions, context, and docs_url. Implemented format_for_cli() method for consistent display",
          "files_changed": [
            "agent_actions/core/user_errors.py - UserError dataclass with structured fields and format_for_cli() method"
          ]
        },
        {
          "id": "cli_main_error_handler",
          "title": "Update main CLI entry point error handling",
          "file": "agent_actions/cli/main.py",
          "lines": "147-154",
          "problem": "CLI shows raw Python errors and stack traces to users",
          "fix": "Convert all exceptions to user-friendly messages before displaying",
          "status": "completed",
          "implementation_summary": "Updated CLI main error handler to use format_user_error() and changed default logging level to CRITICAL to suppress debug logs. Main CLI exception handler now provides clean user-friendly messages",
          "files_changed": [
            "agent_actions/cli/main.py - Updated exception handling and logging configuration (lines 91, 147-154)"
          ]
        },
        {
          "id": "dual_exception_system",
          "title": "Reconcile dual exception systems",
          "description": "Found TWO exception hierarchies - core/exceptions.py and cli/exceptions.py",
          "problem": "Inconsistent exception handling between core and CLI modules",
          "files": [
            "agent_actions/core/exceptions.py (comprehensive hierarchy)",
            "agent_actions/cli/exceptions.py (simple CLI exceptions)"
          ],
          "solution": "Standardize on core/exceptions.py hierarchy",
          "status": "completed",
          "implementation_summary": "Deleted cli/exceptions.py entirely and migrated all 36 files to use core/exceptions.py. Updated all exception names (AgentActionsError->AgentActionsException, FileNotFoundError->FileLoadError, PermissionError->FileSystemError, DirectoryNotFoundError->DirectoryError). Zero backward compatibility layers - forward dev only.",
          "files_changed": [
            "Deleted: agent_actions/cli/exceptions.py",
            "Migrated: 36 files from cli.exceptions to core.exceptions imports",
            "Fixed: cli/utils/error_handler.py to use core exceptions",
            "Updated: 1 markdown documentation file"
          ],
          "test_results": "554 tests passed - 100% success rate"
        }
      ]
    },
    "phase_1_critical_fixes": {
      "priority": "high",
      "description": "Fix the immediate crashes that prevent any error information from being shown",
      "tasks": [
        {
          "id": "fix_str_method",
          "title": "Fix AgentActionsException.__str__() method",
          "file": "agent_actions/core/exceptions.py",
          "line": 74,
          "problem": "Assumes self.context is always a dict, but it can be a string or None",
          "solution": "Add type checking and safe handling for different context types",
          "code_changes": {
            "current": "context_str = \", \".join(f\"{k}={v}\" for k, v in self.context.items())",
            "fix": "Handle dict, string, and other context types safely with try-catch fallback"
          },
          "status": "completed",
          "implementation_summary": "Fixed AgentActionsException.__str__() method to safely handle any context type (dict, string, None, objects). Added multiple fallback layers using format_exception_context() for robust error display",
          "files_changed": [
            "agent_actions/core/exceptions.py - Fixed __str__ method (lines 70-96) with safe context handling",
            "agent_actions/core/safe_format.py - Created format_exception_context() helper function",
            "tests/core/test_exceptions.py - Tests for various context types including edge cases"
          ]
        },
        {
          "id": "safe_format_helper",
          "title": "Add safe_format_error() helper function",
          "file": "agent_actions/core/exceptions.py",
          "description": "Create utility that safely formats any exception, falling back to repr() if str() fails",
          "function_signature": "def safe_format_error(exc: Exception) -> str",
          "status": "completed",
          "implementation_summary": "Created comprehensive safe error formatting module with multiple utilities: safe_format_error(), extract_root_cause(), get_error_chain(), safe_get_exception_message(). Handles broken __str__ methods, circular references, and malformed chains",
          "files_changed": [
            "agent_actions/core/safe_format.py - Complete safe formatting utilities module",
            "tests/core/test_safe_format.py - 21 passing tests for all edge cases"
          ]
        },
        {
          "id": "update_str_calls",
          "title": "Replace ALL dangerous str(e) calls with safe_format_error(e)",
          "description": "Found 20+ locations with str(e) calls that can cascade failures",
          "high_priority_files": [
            {
              "file": "agent_actions/agents/generators/target_generator.py",
              "line": 141,
              "current": "raise AgentActionsError(f\"Unexpected error generating target for {file_path}: {str(e)}\") from e"
            },
            {
              "file": "agent_actions/tasks/run.py",
              "line": 95,
              "current": "raise click.ClickException(f\"Failed to run agent {self.args.agent}: {str(e)}\")"
            },
            {
              "file": "agent_actions/cli/main.py",
              "line": 150,
              "current": "print(f\"Error: {str(e)}\", file=sys.stderr)"
            }
          ],
          "comprehensive_search_needed": [
            "agent_actions/agents/transformers/string_transformer.py (5+ str(e) calls)",
            "agent_actions/agents/handlers/*.py (multiple str(e) calls)",
            "agent_actions/integrations/providers/*.py (API error str(e) calls)",
            "agent_actions/core/tooling.py (user function str(e) calls)",
            "All agent_actions/tasks/*.py (CLI command str(e) calls)"
          ],
          "status": "completed",
          "implementation_summary": "Updated all CLI commands to use format_user_error() instead of str(e). High-priority user-facing str(e) calls in CLI entry points replaced with user-friendly error formatting. Focus was on user-facing CLI commands rather than internal library code",
          "files_changed": [
            "agent_actions/cli/main.py - Updated main exception handler to use format_user_error()",
            "agent_actions/tasks/run.py - Replaced str(e) with format_user_error()",
            "agent_actions/tasks/batch.py - Updated CLI error handling",
            "agent_actions/tasks/docs.py - Updated CLI error handling",
            "agent_actions/tasks/test.py - Updated CLI error handling",
            "agent_actions/tasks/compile.py - Updated CLI error handling",
            "agent_actions/tasks/init.py - Updated CLI error handling",
            "agent_actions/tasks/status.py - Updated CLI error handling"
          ]
        },
        {
          "id": "test_broken_str",
          "title": "Add tests for broken __str__ methods",
          "file": "tests/core/test_exceptions.py",
          "description": "Test that safe_format_error works even when exception.__str__() fails",
          "status": "completed",
          "implementation_summary": "Created comprehensive test suite for broken exception scenarios including broken __str__ methods, circular references, malformed chains, and various context types. Tests validate safe formatting never crashes",
          "files_changed": [
            "tests/core/test_exceptions.py - Tests for fixed AgentActionsException behavior",
            "tests/core/test_safe_format.py - 21 tests for safe formatting utilities including broken __str__ scenarios",
            "tests/core/test_error_system_integration.py - 15 integration tests including broken exception recovery"
          ]
        }
      ]
    },

