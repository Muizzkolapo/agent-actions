    "mocking_strategies": {
      "ollama": "No mocking - uses local file-based processing",
      "openai": "Direct client replacement after initialization with comprehensive mock configuration",
      "anthropic": "sys.modules patching before import with yield pattern to maintain context",
      "gemini": "sys.modules patching for google.genai with yield pattern"
    },
    "design_decisions": [
      "Use conftest.py for test data (fixtures) rather than test logic",
      "Use base class for contract tests (test logic) to enable inheritance",
      "Allow provider tests to override base tests when format differences require it",
      "Skip integration workflow tests for providers with different batch APIs (Anthropic, Gemini)",
      "Provider-specific tests focus on unique features (e.g., Anthropic tool_use, Gemini contents/parts)"
    ]
