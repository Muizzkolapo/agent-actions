  "bugs_discovered_and_fixed": [
    {
      "bug_id": 1,
      "title": "Python syntax error: 'null' instead of 'None'",
      "description": "Used JavaScript/JSON syntax 'null' instead of Python 'None' in _transform_ollama_response method",
      "file": "agent_actions/integrations/providers/ollama/provider.py",
      "line": 435,
      "error": "NameError: name 'null' is not defined",
      "fix": "Changed 'error': null to 'error': None",
      "severity": "critical",
      "impact": "Prevented all batch requests from completing successfully",
      "discovered_during": "integration_testing"
    },
    {
      "bug_id": 2,
      "title": "max_tokens: null added to JSONL when value is None",
      "description": "When max_tokens is None in agent_config, it was being added to JSONL body as null, potentially causing issues",
      "file": "agent_actions/integrations/providers/ollama/provider.py",
      "lines": "63-66",
      "fix": "Only add max_tokens to body if value is not None",
      "severity": "medium",
      "impact": "Clean JSONL files without unnecessary null values",
      "discovered_during": "integration_testing"
    },
    {
      "bug_id": 3,
      "title": "Schema required validation blocked json_mode: false",
      "description": "BatchService validation required schema even when json_mode: false, preventing non-JSON batch workflows",
      "file": "agent_actions/tasks/services/batch_service.py",
      "lines": "466-478",
      "error": "ConfigurationError: Schema is required for batch processing",
      "fix": "Modified validation to only require schema when json_mode: true",
      "severity": "high",
      "impact": "Enabled non-JSON batch mode for all providers",
      "discovered_during": "integration_testing",
      "scope": "system-wide fix affecting all batch providers"
    },
    {
      "bug_id": 4,
      "title": "Schema added even when json_mode: false",
      "description": "Ollama provider was adding response_format/schema to JSONL regardless of json_mode setting",
      "file": "agent_actions/integrations/providers/ollama/provider.py",
      "lines": "150-153",
      "fix": "Check json_mode in prepare_tasks and only pass schema when json_mode: true",
      "severity": "high",
      "impact": "Respects json_mode configuration, prevents forcing JSON mode when not needed",
      "discovered_during": "integration_testing"
    },
    {
      "bug_id": 5,
      "title": "output_field not working in batch mode",
      "description": "When json_mode: false, batch mode was storing raw string in 'content' field instead of output_field",
      "file": "agent_actions/tasks/services/batch_service.py",
      "lines": "1274-1279",
      "fix": "Wrap string content in output_field when json_mode: false, matching online mode behavior",
      "severity": "medium",
      "impact": "output_field now works correctly in batch mode with json_mode: false",
      "discovered_during": "feature_testing",
      "scope": "system-wide fix affecting all batch providers"
    }
  ],

