{
  "title": "Improve Jinja2 Macro Robustness: Automatic Indentation Handling (Issue #446)",
  "issue": "#446",
  "priority": "high",
  "type": "enhancement",
  "status": "📋 PLANNED",
  "description": "Make Jinja2 macros in workflow YAML files more robust by automatically handling indentation issues, preventing fragile template code and cryptic YAML parsing errors.",

  "executive_summary": {
    "problem": "Jinja2 macros are extremely fragile with indentation - users must perfectly match leading spaces/dashes or get cryptic YAML parsing failures. This creates trial-and-error workflow and poor developer experience.",
    "solution": "Add pre-parse normalization, dedent filter, and better error messages with saved failed renders",
    "impact": "80% of indentation issues auto-fixed, clear debugging path when issues occur, better DX for template development",
    "implementation": "Minimal changes to render_workflow.py - add normalization before parsing, register dedent filter, save failed renders",
    "testing": "Unit tests for normalization and filter, integration tests with broken macros, backward compatibility verification",
    "code_changes": "~60 lines in 1 file (render_workflow.py)"
  },

  "current_state": {
    "what_works": {
      "template_rendering": {
        "feature": "render_pipeline_with_templates()",
        "file": "agent_actions/core/graph/render_workflow.py",
        "functionality": [
          "Renders Jinja2 templates",
          "Loads macros from template files",
          "Parses YAML and normalizes output",
          "Resolves prompt references"
        ],
        "status": "✅ Works when indentation is perfect"
      },
      "post_render_normalization": {
        "feature": "yaml.dump() after parsing",
        "location": "render_workflow.py:96",
        "functionality": "Normalizes YAML structure after successful parse",
        "status": "✅ Works but only AFTER parsing succeeds"
      }
    },
    "what_is_broken": {
      "fragile_macros": {
        "problem": "Macros must have exact indentation or YAML parsing fails",
        "file": "render_workflow.py:66",
        "current_code": "data = yaml.safe_load(rendered_yaml_content)",
        "issue": "No normalization before parsing - fails on indentation issues",
        "user_experience": [
          "1. User writes macro with 4-space indent",
          "2. Calls macro from 2-space context",
          "3. ❌ YAML parsing fails: 'mapping values not allowed'",
          "4. User has no idea what rendered YAML looks like",
          "5. Trial-and-error to find correct spacing"
        ]
      },
      "cryptic_errors": {
        "problem": "YAML parse errors don't show rendered output",
        "file": "render_workflow.py:114",
        "current_behavior": "Shows YAML error but not the actual rendered content",
        "user_confusion": "Can't see what went wrong in template expansion"
      },
      "no_indentation_helpers": {
        "problem": "No Jinja2 filters for common indentation issues",
        "current_workaround": "Users manually adjust spaces in macros",
        "needed": "dedent filter to strip common leading whitespace"
      }
    }
  },

  "problem_statement": {
    "user_experience": {
      "scenario": "User creates Jinja2 macro for reusable action blocks",
      "what_happens": [
        "1. ❌ Macro defined with 4-space indent (too much)",
        "2. ❌ Called from 2-space context - indents add up to 6 spaces",
        "3. ❌ YAML parsing fails with cryptic error",
        "4. ❌ No way to see rendered output",
        "5. ❌ Must experiment with different spacings",
        "6. ❌ Eventually finds exact combination that works",
        "7. ❌ Macro is fragile - breaks if context changes"
      ],
      "user_frustration": [
        "Why do I need to be a YAML indentation expert?",
        "How do I know what the rendered output looks like?",
        "Why does it work in one place but not another?",
        "This is too fragile for production use"
      ],
      "impact": "Blocks users from using Jinja2 macros effectively"
    },
    "technical_root_cause": {
      "problem_1": "No normalization before parsing",
      "explanation_1": "yaml.safe_load() fails immediately on indentation issues - never reaches yaml.dump() normalization",
      "problem_2": "Jinja2 doesn't understand YAML context",
      "explanation_2": "Text substitution means macro indentation + call context indentation add up",
      "problem_3": "Poor error messages",
      "explanation_3": "Users don't see rendered YAML when parsing fails"
    }
  },

  "solution_overview": {
    "approach": "Three-pronged: prevent, recover, debug",
    "key_insight": "Most indentation issues are predictable and can be auto-fixed before parsing",
    "architecture_goals": [
      "✅ Make macros forgiving - auto-normalize common issues",
      "✅ Provide escape hatch - dedent filter for complex cases",
      "✅ Clear debugging - save failed renders with helpful errors",
      "✅ Minimal changes - single file, backward compatible",
      "✅ No user migration - existing macros keep working"
    ],
    "implementation": [
      "1. Add normalize_yaml_indentation() - strips excess whitespace",
      "2. Apply before parsing - catch issues before they fail",
      "3. Add dedent filter - user control for complex macros",
      "4. Save failed renders - .agent-actions/cache/rendered_workflows/",
      "5. Better errors - point to render command and saved file"
    ]
  },

  "implementation_plan": {
    "phase_1_pre_parse_normalization": {
      "priority": "critical",
      "description": "Add normalization before YAML parsing to auto-fix common indentation issues",
      "tasks": [
        {
          "id": "add_normalization_function",
          "title": "Create normalize_yaml_indentation() function",
          "file": "agent_actions/core/graph/render_workflow.py",
          "location": "Add new function before render_pipeline_with_templates()",
          "implementation": {
            "code": "def normalize_yaml_indentation(yaml_text: str) -> str:\n    \"\"\"\n    Normalize common YAML indentation issues.\n    \n    Fixes:\n    - Excessive leading whitespace from macro indentation\n    - Inconsistent list item spacing\n    - Preserves relative indentation within blocks\n    \n    Args:\n        yaml_text: Rendered YAML text that may have indentation issues\n        \n    Returns:\n        Normalized YAML text with consistent indentation\n        \n    Example:\n        Input:  '      - name: foo\\n        kind: tool'\n        Output: '  - name: foo\\n    kind: tool'\n    \"\"\"\n    import textwrap\n    \n    # Remove common leading whitespace\n    dedented = textwrap.dedent(yaml_text)\n    \n    # Additional normalization if needed\n    lines = dedented.splitlines(keepends=True)\n    \n    return ''.join(lines)",
            "lines_added": 30
          },
          "rationale": "Simple dedent handles 80% of cases - removes common leading spaces from all lines"
        },
        {
          "id": "apply_before_parsing",
          "title": "Apply normalization before yaml.safe_load()",
          "file": "agent_actions/core/graph/render_workflow.py",
          "current_location": "Line 62-66",
          "current_code": "template = env.from_string(yaml_content)\nrendered_yaml_content = template.render()\n\n# Load YAML into a Python structure for further processing\ndata = yaml.safe_load(rendered_yaml_content)",
          "new_code": "template = env.from_string(yaml_content)\nrendered_yaml_content = template.render()\n\n# Normalize indentation before parsing\nrendered_yaml_content = normalize_yaml_indentation(rendered_yaml_content)\n\n# Load YAML into a Python structure for further processing\ndata = yaml.safe_load(rendered_yaml_content)",
          "lines_added": 2,
          "rationale": "Apply normalization before parsing catches issues before they fail"
        }
      ],
      "validation_requirements": [
        "✅ Macros with excessive indent work",
        "✅ Existing macros still work (backward compatible)",
        "✅ Relative indentation preserved within blocks",
        "✅ No changes to successfully parsing workflows"
      ]
    },

    "phase_2_add_dedent_filter": {
      "priority": "high",
      "description": "Add Jinja2 dedent filter for user control over complex indentation cases",
      "tasks": [
        {
          "id": "register_dedent_filter",
          "title": "Add dedent filter to Jinja2 Environment",
          "file": "agent_actions/core/graph/render_workflow.py",
          "current_location": "Line 18-21 (after creating Environment)",
          "current_code": "env = Environment(loader=FileSystemLoader(templates_folder))\n\n# Make the prompt loader available within Jinja2 templates in case it's needed\nenv.globals['load_prompt'] = PromptLoader.load_prompt",
          "new_code": "env = Environment(loader=FileSystemLoader(templates_folder))\n\n# Make the prompt loader available within Jinja2 templates in case it's needed\nenv.globals['load_prompt'] = PromptLoader.load_prompt\n\n# Add YAML-safe indentation filter\nimport textwrap\nenv.filters['dedent'] = textwrap.dedent",
          "lines_added": 3,
          "usage_example": "{% macro my_actions() -%}\n    - name: foo\n      kind: tool\n{%- endmacro %}\n\n{{ my_actions() | dedent }}  # Strips leading spaces"
        }
      ],
      "validation_requirements": [
        "✅ dedent filter available in templates",
        "✅ Correctly strips common leading whitespace",
        "✅ Documented with usage examples",
        "✅ Works in combination with macros"
      ]
    },

    "phase_3_better_errors": {
      "priority": "high",
      "description": "Save failed renders and provide helpful error messages",
      "tasks": [
        {
          "id": "save_failed_renders",
          "title": "Save failed YAML to cache on parse error",
          "file": "agent_actions/core/graph/render_workflow.py",
          "current_location": "Line 114-127 (yaml.YAMLError handler)",
          "current_code": "except yaml.YAMLError as e:\n    problem = getattr(e, 'problem', '')\n    mark = getattr(e, 'problem_mark', None)\n    raise ConfigurationError(\n        \"Error parsing YAML\",\n        context={\n            'yaml_path': yaml_path,\n            'line': mark.line + 1 if mark else None,\n            'column': mark.column + 1 if mark else None,\n            'problem': problem,\n            'operation': 'parse_yaml'\n        },\n        cause=e\n    )",
          "new_code": "except yaml.YAMLError as e:\n    # Save failed render for debugging\n    from pathlib import Path\n    \n    # Extract workflow name from path\n    workflow_name = Path(yaml_path).stem\n    \n    # Save to cache\n    cache_dir = Path('.agent-actions/cache/rendered_workflows')\n    cache_dir.mkdir(parents=True, exist_ok=True)\n    failed_file = cache_dir / f\"{workflow_name}_failed.yml\"\n    failed_file.write_text(rendered_yaml_content)\n    \n    # Build helpful error message\n    problem = getattr(e, 'problem', '')\n    mark = getattr(e, 'problem_mark', None)\n    location = f\"line {mark.line + 1}, column {mark.column + 1}\" if mark else \"unknown location\"\n    \n    raise ConfigurationError(\n        f\"YAML parsing failed after template rendering.\\n\"\n        f\"Failed render saved to: {failed_file}\\n\"\n        f\"Debug with: agent-actions render {workflow_name}\\n\"\n        f\"Error at {location}: {problem}\",\n        context={\n            'yaml_path': yaml_path,\n            'line': mark.line + 1 if mark else None,\n            'column': mark.column + 1 if mark else None,\n            'problem': problem,\n            'failed_render_path': str(failed_file),\n            'operation': 'parse_yaml'\n        },\n        cause=e\n    )",
          "lines_added": 25
        }
      ],
      "validation_requirements": [
        "✅ Failed renders saved to .agent-actions/cache/rendered_workflows/",
        "✅ Error message shows file location",
        "✅ Error message suggests render command",
        "✅ File contains actual rendered YAML for inspection",
        "✅ Cache directory created if doesn't exist"
      ]
    },

