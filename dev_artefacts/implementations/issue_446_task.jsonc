  "technical_considerations": {
    "normalization_approach": {
      "choice": "Use textwrap.dedent()",
      "rationale": "Built-in, well-tested, handles common case (excessive leading spaces)",
      "limitation": "Doesn't fix all YAML issues, but prevents most fragile macro problems",
      "fallback": "Users can still use dedent filter for fine control"
    },
    "when_to_normalize": {
      "choice": "After Jinja2 render, before YAML parse",
      "rationale": "Catches template-generated indentation issues before parsing fails",
      "alternative_considered": "Normalize after parse",
      "why_rejected": "Too late - parse already failed"
    },
    "backward_compatibility": {
      "strategy": "Normalization is additive - makes broken things work, doesn't break working things",
      "scenarios": [
        {
          "case": "Workflow with correct indentation",
          "behavior": "Normalization does nothing → works as before"
        },
        {
          "case": "Workflow with excessive indent",
          "behavior": "Normalization fixes it → now works (was broken before)"
        },
        {
          "case": "Workflow using dedent filter",
          "behavior": "Filter + normalization both apply → works"
        }
      ],
      "risk": "Very low - only changes behavior of currently-broken workflows"
    },
    "performance": {
      "overhead": "Minimal - dedent is O(n) where n = number of lines",
      "operations": [
        "Split text into lines",
        "Find common leading whitespace",
        "Remove from each line"
      ],
      "impact": "Negligible compared to Jinja2 rendering and YAML parsing"
    },
    "cache_location": {
      "choice": ".agent-actions/cache/rendered_workflows/",
      "rationale": "Consistent with #445 render command cache structure",
      "naming": "{workflow_name}_failed.yml clearly indicates debug artifact",
      "cleanup": "Manual - users can delete cache dir, or add cleanup command later"
