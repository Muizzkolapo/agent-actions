    "bug_1_exclude_not_working": {
      "severity": "critical",
      "discovered": "2025-01-30",
      "reported_by": "User testing with QanaLabs quiz generation workflow",
      "symptom": "Fields configured in context_scope.exclude were still appearing in [Context Data Preview] sent to LLM",
      "example_config": {
        "context_scope": {
          "exclude": ["similarity_group_id"]
        },
        "problem": "similarity_group_id still visible in context data despite being excluded"
      },

      "investigation_timeline": {
        "step_1_wrong_path": {
          "initial_fix_attempt": "Tried filtering in data_generator._format_prompt() by modifying contents dict",
          "file": "agent_actions/prompt_generation/data_generator.py",
          "approach": "Added code at lines 231-258 to remove excluded fields",
          "why_wrong": [
            "Filtering too early in pipeline",
            "Inconsistent with how drops works",
            "contents dict passes through multiple layers before reaching agent"
          ]
        },
        "step_2_user_insight": {
          "user_feedback": "can we just use exactly same pathway drop uses?",
          "impact": "Critical insight that led to correct fix",
          "lesson": "Use existing proven patterns instead of creating new approaches"
        },
        "step_3_trace_drops": {
          "action": "Traced how drops directive actually works",
          "findings": [
            "drops filtering happens in run_dynamic_agent() in utils_processor_helpers.py",
            "Uses apply_drops() which calls DataTransformer.remove_schema_objects()",
            "Filtering happens AFTER guards but BEFORE passing to agent_builder"
          ]
        },
        "step_4_implement_same_pattern": {
          "action": "Applied exclude filtering in run_dynamic_agent() using same mechanism as drops",
          "location": "agent_actions/utilities/utils_processor_helpers.py lines 62-79",
          "approach": "Extract field names from context_scope.exclude, use DataTransformer.remove_schema_objects()"
        },
        "step_5_still_not_working": {
          "observation": "Debug output showed context_scope was NOT in agent_config when it reached run_dynamic_agent()",
          "debug_evidence": "[DataGenerator.__init__] ❌ context_scope NOT in agent_config",
          "critical_discovery": "Config was being stripped during processing"
        }
      },

      "root_cause": {
        "problem": "ActionExpander not copying context_scope from YAML config to agent_config dict",
        "file": "agent_actions/response_processing/action_expander.py",
        "explanation": [
          "ActionExpander converts YAML actions to agent_config dicts",
          "Simple fields in SIMPLE_CONFIG_FIELDS whitelist are auto-inherited",
          "Complex fields (observe, drops, context_scope) need manual handling",
          "context_scope was defined in TypedDict schema but NOT being copied by ActionExpander"
        ],
        "why_missed_initially": [
          "context_scope was in config_types.py TypedDict schema (line 28)",
          "DataGenerator and agent_builder code all looked correct",
          "Bug was in config processing layer, not runtime execution layer",
          "No error thrown - config was silently dropped"
        ]
      },

      "fix": {
        "file": "agent_actions/response_processing/action_expander.py",
        "location": "Lines 170-173",
        "code_added": [
          "# Handle context_scope (complex field - not in SIMPLE_CONFIG_FIELDS)",
          "context_scope = action.get('context_scope')",
          "if context_scope:",
          "    agent['context_scope'] = context_scope"
        ],
        "pattern": "Same pattern used for observe and drops (lines 165-168)",
        "result": "✅ context_scope now properly flows from YAML → agent_config → DataGenerator → run_dynamic_agent"
      },

      "lessons_learned": {
        "architecture_insight": "Complex config fields need TWO levels of handling: schema definition AND manual copying in ActionExpander",
        "debugging_strategy": "Trace config flow end-to-end, not just runtime execution",
        "pattern_reuse": "When implementing similar features, use exact same mechanisms (like drops pathway)",
        "testing_gap": "Unit tests passed because they used agent_config directly, not YAML expansion"
      },

      "time_to_fix": {
        "investigation": "2 hours (debugging, tracing, adding debug prints)",
        "fix_implementation": "5 minutes (4 lines of code)",
        "total": "~2 hours",
        "note": "Most time spent finding root cause, not implementing fix"
      }
    },

    "bug_2_include_wrong_implementation": {
      "severity": "critical",
      "discovered": "2025-01-30 (after Bug 1 fix)",
      "reported_by": "User observation during testing",
      "symptom": "Include fields were being formatted as text and appended to prompt instead of merged into JSON context",
      "example_evidence": {
        "wrong_output": [
          "Additional context:",
          "candidate_facts_list: [...]",
          "",
          "[Context Data Preview]",
          "{\"similarity_group_id\": \"...\", \"platform_name\": \"Azure\"}"
        ],
        "problem": "candidate_facts_list appearing as text above context, not inside context JSON"
      },

      "root_cause": {
        "problem": "Misunderstanding of how include directive should work",
        "original_implementation": [
          "llm_additional_context passed as additional_context parameter to agent_builder",
          "agent_builder formatted it as text with ContextScopeProcessor.format_llm_context()",
          "Text appended to prompt with double newline separator"
        ],
        "files": [
          "agent_actions/utilities/utils_processor_helpers.py line 60 (old)",
          "agent_actions/llm_invocation/realtime/agent_builder.py lines 61-73"
        ],
        "why_wrong": "Include fields should be part of the context DATA (JSON dict), not prompt TEXT"
      },

      "user_clarification": {
        "quote": "hmm should have attached it to the njson instead of beingin additonal context",
        "meaning": "Include fields should be merged into the JSON context data sent to LLM",
        "correct_approach": "Merge into processed_context dict, not append as text to prompt"
      },

      "fix": {
        "file": "agent_actions/utilities/utils_processor_helpers.py",
        "location": "Lines 81-88",
        "changes": [
          {
            "action": "Merge llm_additional_context directly into processed_context",
            "code": "processed_context = {**processed_context, **llm_additional_context}",
            "timing": "BEFORE passing to agent_builder"
          },
          {
            "action": "Pass additional_context=None to agent_builder",
            "reason": "Bypass text-appending code path in agent_builder",
            "code": "additional_context=None"
          }
        ],
        "expected_result": {
          "before": [
            "Additional context: candidate_facts_list: [...]",
            "[Context Data Preview] {\"platform_name\": \"Azure\"}"
          ],
          "after": [
            "[Context Data Preview] {\"platform_name\": \"Azure\", \"candidate_facts_list\": [...]}"
          ]
        }
      },

      "lessons_learned": {
        "specification_clarity": "Feature spec should clarify 'context' means JSON data structure, not text appended to prompt",
        "llm_provider_apis": "Different LLM APIs handle context differently - should merge into data, not format as text",
        "user_feedback": "Real-world testing caught design flaw that unit tests missed",
        "testing_gap": "Integration tests should verify HOW data is sent to LLM (JSON vs text), not just THAT it's sent"
      },

      "time_to_fix": {
        "investigation": "15 minutes (user clarification was immediate)",
        "fix_implementation": "5 minutes (4 lines of code change)",
        "total": "~20 minutes",
        "note": "Quick fix once correct approach was clarified"
      },

      "verification_status": "⚠️ PENDING USER CONFIRMATION",
      "verification_note": "Fix implemented but needs Python module reload to take effect. User instructed to restart workflow execution to test."
    },

