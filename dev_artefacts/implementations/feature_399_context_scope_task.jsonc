    "phase_2_context_scope_processor": {
      "priority": "critical",
      "status": "✅ COMPLETE",
      "completion_date": "2025-01-29",
      "description": "Create ContextScopeProcessor utility class for field processing",
      "tasks": [
        {
          "id": "create_processor_class",
          "title": "Create ContextScopeProcessor class",
          "status": "✅ COMPLETE",
          "file": "agent_actions/utilities/context_scope_processor.py (NEW)",
          "implementation": {
            "class_name": "ContextScopeProcessor",
            "methods": [
              {
                "name": "parse_field_reference",
                "signature": "parse_field_reference(field_ref: str) -> Tuple[str, str]",
                "purpose": "Parse 'action.field' into (action_name, field_name)",
                "implementation": "parts = field_ref.split('.', 1)\nif len(parts) != 2: raise ValueError\nreturn (parts[0], parts[1])",
                "example": "parse_field_reference('fact_extractor.document_id') → ('fact_extractor', 'document_id')",
                "status": "✅ Implemented with comprehensive validation and error messages"
              },
              {
                "name": "extract_field_value",
                "signature": "extract_field_value(field_context: Dict, action_name: str, field_name: str) -> Any",
                "purpose": "Extract value from field_context[action][field]",
                "implementation": "if action not in field_context: return None\naction_data = field_context[action]\nif not isinstance(action_data, dict): return None\nreturn action_data.get(field_name)",
                "handles_nested": "Supports nested fields like 'action.obj.field' via recursive get",
                "status": "✅ Implemented with graceful None handling for missing actions/fields"
              },
              {
                "name": "apply_context_scope",
                "signature": "apply_context_scope(field_context: Dict, context_scope: Dict) -> Tuple[Dict, Dict, Dict]",
                "purpose": "Apply context_scope rules to split field_context",
                "returns": "(prompt_context, llm_context, passthrough_fields)",
                "algorithm": [
                  "1. Start with prompt_context = deepcopy(field_context)",
                  "2. llm_context = {}, passthrough_fields = {}",
                  "3. Process exclude: remove from prompt_context",
                  "4. Process include: extract value → llm_context, remove from prompt_context",
                  "5. Process passthrough: extract value → passthrough_fields, remove from prompt_context",
                  "6. Return 3-tuple"
                ],
                "key_insight": "prompt_context ends up with ONLY fields not in include/exclude/passthrough",
                "status": "✅ Implemented with deep copy to prevent mutation, handles invalid refs gracefully"
              },
              {
                "name": "format_llm_context",
                "signature": "format_llm_context(llm_context: Dict) -> str",
                "purpose": "Format llm_context dict as readable text for LLM",
                "implementation": "lines = ['Additional context:']\nfor key, value in llm_context.items():\n  lines.append(f'{key}: {json.dumps(value, indent=2)}')\nreturn '\\n'.join(lines)",
                "note": "Used for system message or appended to user context",
                "status": "✅ Implemented with JSON pretty-printing, returns empty string for empty context"
              },
              {
                "name": "merge_passthrough_fields",
                "signature": "merge_passthrough_fields(llm_response: List[Dict], passthrough_fields: Dict) -> List[Dict]",
                "purpose": "Merge passthrough fields into LLM response (like observe)",
                "implementation": "Similar to ProcessorUtils.transform_with_observe()\nFor each item in llm_response:\n  if 'content' in item: item['content'].update(passthrough_fields)\n  else: item.update(passthrough_fields)",
                "handles_structured": "Works with both flat dicts and {source_guid, content} structure",
                "status": "✅ Implemented with support for list/dict responses, structured/flat formats"
              }
            ]
          },
          "lines_added": "~200 lines",
          "implementation_summary": {
            "file_created": "agent_actions/utilities/context_scope_processor.py",
            "total_lines": 355,
            "methods_implemented": 5,
            "features": [
              "✅ Full type hints throughout (typing module)",
              "✅ Comprehensive docstrings with examples for every method",
              "✅ Error handling with clear ValueError messages",
              "✅ Deep copy to prevent field_context mutation",
              "✅ Graceful handling of missing actions/fields (returns None)",
              "✅ Silent skipping of invalid field references",
              "✅ JSON pretty-printing for LLM context formatting",
              "✅ Support for both structured and flat response formats"
            ],
            "dependencies": [
              "json - for formatting llm_context",
              "typing - for type hints",
              "copy.deepcopy - for immutable field_context processing"
            ],
            "key_design_decisions": [
              "Used deepcopy() instead of shallow copy to prevent mutation",
              "Silent failure for invalid refs (skip, don't crash)",
              "Flat dicts for llm_context and passthrough (field name as key)",
              "Returns empty string/list for empty inputs (no-op)",
              "Similar pattern to ProcessorUtils.transform_with_observe()"
            ]
          }
        }
      ],
      "phase_summary": {
        "status": "✅ COMPLETE",
        "effort_actual": "30 minutes",
        "effort_estimated": "2-3 hours",
        "files_created": 1,
