{
  "feature": "context_scope - Control Field Flow to LLM Context and Output",
  "feature_number": 399,
  "title": "Add context_scope config for granular control of upstream field flow",
  "priority": "high",
  "type": "feature",
  "status": "✅ COMPLETE",
  "current_phase": "all_phases_complete",
  "phases_completed": ["phase_1_config_schema", "phase_2_context_scope_processor", "phase_3_data_generator_updates", "phase_4_agent_runner_updates", "phase_5_agent_builder_updates", "phase_6_testing", "phase_7_documentation"],
  "related_features": [
    "historical_node_field_referencing - Leverages {action.field} infrastructure",
    "observe - Similar to passthrough but for flat fields",
    "drops - Similar to exclude but removes from output"
  ],

  "executive_summary": {
    "problem": "Users cannot control which upstream fields go to LLM context vs output. observe only works with flat fields, no way to exclude sensitive data from LLM, cannot send reference data to LLM without bloating prompt.",
    "solution": "Add context_scope config with three directives: include (LLM context only), exclude (block from LLM), passthrough (merge to output only)",
    "impact": "Enables security controls, lineage tracking, large reference data handling, and explicit field flow control using {action.field} syntax",
    "implementation": "New ContextScopeProcessor class, DataGenerator 3-way split logic, leverages historical node field referencing",
    "estimated_effort": "8-12 hours (1.5-2 days)",
    "code_changes": "1 new file, 4 modified files, ~600 lines total"
  },

  "current_state": {
    "what_works": {
      "observe_directive": {
        "feature": "observe field in agent config",
        "functionality": "Passthrough fields from input to output",
        "example": "observe: [document_id, page_number]",
        "limitation": "Only works with FLAT fields in contents dict from immediate predecessor",
        "file": "agent_actions/utilities/utils_processor_utils.py:193"
      },
      "drops_directive": {
        "feature": "drops field in agent config",
        "functionality": "Remove fields from output",
        "example": "drops: [temp_field, debug_info]",
        "limitation": "Only removes from output, LLM still sees them in prompt",
        "file": "agent_actions/utilities/utils_processor_utils.py:172"
      },
      "schema_output": {
        "feature": "schema field defines LLM output structure",
        "functionality": "LLM generates fields matching schema",
        "formula": "Final Output = (schema_fields + observe) - drops",
        "file": "agent_actions/validation/llm_context_utils.py:20-61"
      },
      "historical_node_referencing": {
        "feature": "{action.field} syntax for upstream data",
        "functionality": "Reference ANY upstream action's output",
        "example": "{fact_extractor.candidate_facts_list}",
        "implementation": "Uses lineage + source_guid to load historical data",
        "files": [
          "agent_actions/preprocessing/historical_node_loader.py",
          "agent_actions/prompt_generation/data_generator.py:124-147"
        ]
      }
    },
    "what_is_missing": {
      "cannot_control_llm_context": {
        "problem": "No way to send fields to LLM as context without rendering in prompt",
        "use_case": "Large reference tables, lookup data, metadata",
        "current_workaround": "Must include in prompt, bloating it",
        "example": "Cannot send 10KB reference table as context without {action.field} in prompt"
      },
      "cannot_exclude_sensitive_data": {
        "problem": "No security controls to prevent data from reaching LLM",
        "use_case": "API keys, PII, internal metadata in upstream actions",
        "current_workaround": "Manually filter in code or hope user doesn't include",
        "risk": "Accidental data leakage to LLM providers"
      },
      "observe_limitations": {
        "problem": "observe only works with flat fields, cannot reference specific upstream actions",
        "limitation_1": "observe: [document_id] - which action's document_id?",
        "limitation_2": "Cannot reference fields from non-immediate predecessors",
        "limitation_3": "No {action.field} syntax support"
      },
      "no_lineage_tracking_helper": {
        "problem": "Must manually observe IDs for lineage, easy to forget",
        "use_case": "Carrying document_id, source_id through pipeline",
        "current_workaround": "Add observe: [id] to every agent"
      }
    }
  },

  "problem_statement": {
    "user_pain_points": [
      "Cannot send large reference data to LLM without bloating prompt",
      "No security controls to block sensitive fields from LLM",
      "observe doesn't support {action.field} syntax - ambiguous and limited",
      "Must manually track lineage fields through observe in every agent",
      "Cannot control what LLM sees vs what goes in final output"
    ],
    "technical_gaps": [
      "No mechanism to send fields to LLM context separate from prompt",
      "No exclusion mechanism for sensitive data",
      "observe works on flat contents, not namespaced field_context",
      "Passthrough (observe) and prompt rendering share same field_context"
    ],
    "user_scenarios": {
      "scenario_1_large_reference_data": {
        "user_need": "Send 50KB reference table to LLM for lookup",
        "current_problem": "Must include in prompt with {action.field}, bloats prompt",
        "desired_solution": "context_scope.include: [researcher.reference_tables] - LLM gets it as context"
      },
      "scenario_2_security": {
        "user_need": "Analyze data but never send API keys to LLM",
        "current_problem": "If api_key in upstream output, no way to block it",
        "desired_solution": "context_scope.exclude: [source.api_key, collector.credentials]"
      },
      "scenario_3_lineage": {
        "user_need": "Carry document_id through 5-stage pipeline",
        "current_problem": "Must add observe: [document_id] to all 5 agents",
        "desired_solution": "context_scope.passthrough: [extractor.document_id] - auto-carries forward"
      }
    }
  },

  "solution_design": {
    "overview": "Add context_scope config field with three directives controlling how upstream fields flow",
    "key_insight": "Split field_context into 3 streams: prompt rendering, LLM context, output passthrough",

    "directive_1_include": {
      "purpose": "Send fields to LLM as additional context, NOT in prompt, NOT in output",
      "syntax": "context_scope.include: ['action.field', ...]",
      "behavior": [
        "1. Remove field from prompt_context (cannot use {action.field} in prompt)",
        "2. Extract field value from field_context",
        "3. Format and append to LLM context message (like system context)",
        "4. LLM sees it in context, NOT in final output"
      ],
      "use_cases": [
        "Large reference tables (>10KB)",
        "Lookup dictionaries",
        "Historical context",
        "Metadata for LLM decision-making"
      ],
      "example": {
        "config": "context_scope:\n  include:\n    - researcher.full_reference_tables\n    - enricher.historical_statistics",
        "result": "LLM gets reference_tables + stats as context, user prompt stays clean"
      }
    },

    "directive_2_exclude": {
      "purpose": "Block fields from LLM entirely (security/privacy)",
      "syntax": "context_scope.exclude: ['action.field', ...]",
      "behavior": [
        "1. Remove field from prompt_context (cannot use {action.field})",
        "2. Remove field from LLM context (never sent to LLM)",
        "3. NOT in final output"
      ],
      "use_cases": [
        "API keys, credentials",
        "PII (emails, phone numbers)",
        "Internal metadata",
        "Compliance requirements"
      ],
      "example": {
        "config": "context_scope:\n  exclude:\n    - source.api_credentials\n    - collector.customer_pii\n    - source.internal_system_ids",
        "result": "Sensitive data never reaches LLM provider"
      }
    },

    "directive_3_passthrough": {
      "purpose": "Merge fields into current action's output, LLM NEVER sees them",
      "syntax": "context_scope.passthrough: ['action.field', ...]",
      "behavior": [
        "1. Remove field from prompt_context (cannot use {action.field})",
        "2. NOT sent to LLM context",
        "3. After LLM generates response, merge into output",
        "4. Next agent can reference with {current_action.passthrough_field}"
      ],
      "use_cases": [
        "Lineage tracking (document_id, source_id)",
        "Metadata that flows through pipeline",
        "IDs for downstream correlation",
        "Timestamps, filenames, etc."
      ],
      "example": {
        "config": "schema:\n  classification: string\n  confidence: number\ncontext_scope:\n  passthrough:\n    - extractor.document_id\n    - source.original_filename",
        "result": "Output = {classification, confidence, document_id, original_filename}"
      },
      "comparison_with_observe": {
        "observe": "observe: [document_id] - flat field, ambiguous source",
        "passthrough": "passthrough: [extractor.document_id] - explicit action, uses {action.field}",
        "advantage": "Explicit about where field comes from, leverages historical node infrastructure"
      }
    },

    "output_formula": {
      "current": "Final Output = (schema_fields + observe) - drops",
      "new": "Final Output = (schema_fields + observe + passthrough) - drops",
      "explanation": "passthrough adds fields from upstream actions using {action.field} syntax"
    },

    "data_flow_split": {
      "input": "field_context = {source: {...}, action1: {...}, action2: {...}}",
      "process": "ContextScopeProcessor.apply_context_scope(field_context, context_scope)",
      "output_1": "prompt_context - For {action.field} rendering (exclude/include/passthrough removed)",
      "output_2": "llm_context - Only include fields, formatted for LLM",
      "output_3": "passthrough_fields - Only passthrough fields, for output merge"
    }
  },

  "implementation_plan": {
