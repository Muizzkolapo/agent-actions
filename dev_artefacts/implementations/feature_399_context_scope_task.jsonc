          "file": "agent_actions/utilities/utils_processor_helpers.py",
          "lines_changed": "Lines 81-88",
          "old_approach": "Pass llm_additional_context as additional_context parameter → agent_builder formats as text → appends to prompt",
          "new_approach": "Merge llm_additional_context into processed_context → part of JSON data → pass additional_context=None",
