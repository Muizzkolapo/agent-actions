  "technical_details": {
    "data_flow_ascii": {
      "description": "How field_context flows through context_scope processing",
      "diagram": [
        "field_context (all upstream data)",
        "    │",
        "    ├─ exclude → REMOVE from everything",
        "    ├─ include → REMOVE from prompt_context, ADD to llm_context",
        "    └─ passthrough → REMOVE from prompt_context, SAVE for output merge",
        "",
        "prompt_context (for {action.field} rendering)",
        "    → Only fields NOT in include/exclude/passthrough",
        "    → Used by PromptUtils.replace_field_references()",
        "",
        "llm_context (appended to context message)",
        "    → Only fields from include directive",
        "    → Formatted and sent to LLM as additional context",
        "",
        "passthrough_fields (merged after LLM response)",
        "    → Only fields from passthrough directive",
        "    → LLM never sees these",
        "    → Merged into final output (like observe)"
      ]
    },
    "integration_with_historical_nodes": {
      "leverages": [
        "Uses existing HistoricalNodeDataLoader to load upstream data",
        "field_context already contains ALL upstream actions via lineage",
        "PromptUtils.replace_field_references() already parses {action.field}",
        "Same target file structure: target/node_X_action_name/file.json"
      ],
      "new_behavior": "context_scope FILTERS what goes where from field_context"
    },
    "comparison_table": {
      "observe_vs_passthrough": {
        "observe": {
          "syntax": "observe: [field_name]",
          "source": "Flat fields in contents dict",
          "limitation": "Only immediate predecessor, ambiguous source",
          "example": "observe: [document_id] - which action's document_id?"
        },
        "context_scope_passthrough": {
          "syntax": "context_scope.passthrough: [action.field]",
          "source": "Explicit upstream action via {action.field}",
          "advantage": "ANY upstream action, explicit, uses historical nodes",
          "example": "passthrough: [fact_extractor.document_id] - clear source"
        }
      },
      "drops_vs_exclude": {
        "drops": {
          "syntax": "drops: [field_name]",
          "behavior": "Remove from output only",
          "limitation": "LLM still sees field in prompt/context",
          "use_case": "Remove temporary/debug fields from output"
        },
        "context_scope_exclude": {
          "syntax": "context_scope.exclude: [action.field]",
          "behavior": "Block from LLM entirely (prompt + context + output)",
          "advantage": "Security - LLM never sees the data",
          "use_case": "API keys, PII, sensitive data"
        }
      }
    },
    "output_formula_evolution": {
      "v1_basic": "Output = schema_fields",
      "v2_observe": "Output = (schema_fields + observe) - drops",
      "v3_context_scope": "Output = (schema_fields + observe + passthrough) - drops",
      "note": "passthrough adds {action.field} explicit references"
    }
  },

  "example_use_cases": {
    "use_case_1_large_reference_data": {
      "title": "Send large lookup tables to LLM without bloating prompt",
      "scenario": "Researcher agent produces 50KB reference table, analyzer needs it for lookups",
      "config": {
        "researcher": {
          "schema": {
            "research_summary": "string",
            "reference_tables": "object",
            "citation_count": "number"
          }
        },
        "analyzer": {
          "depends_on": ["researcher"],
          "prompt": "Analyze findings: {researcher.research_summary}",
          "context_scope": {
            "include": [
              "researcher.reference_tables"
            ]
          }
        }
      },
      "result": {
        "prompt": "Analyze findings: [summary text] (clean, concise)",
        "llm_context": "Additional context:\nreference_tables: {50KB of data}",
        "output": "{analysis} (reference_tables NOT in output)"
      },
      "benefit": "Clean prompt + LLM has full reference data for accurate analysis"
    },

    "use_case_2_security_exclusion": {
      "title": "Block sensitive data from reaching LLM",
      "scenario": "Data collector fetches from API with credentials, must never send credentials to LLM",
      "config": {
        "data_collector": {
          "schema": {
            "collected_data": "array",
            "api_credentials": "object",
            "internal_system_id": "string"
          }
        },
        "public_analyzer": {
          "depends_on": ["data_collector"],
          "prompt": "Analyze: {data_collector.collected_data}",
          "context_scope": {
            "exclude": [
              "data_collector.api_credentials",
              "data_collector.internal_system_id",
              "source.api_key"
            ]
          }
        }
      },
      "result": {
        "prompt": "Analyze: [data] (credentials stripped)",
        "llm_never_sees": "api_credentials, internal_system_id, api_key",
        "security": "Compliance with data governance policies"
      },
      "benefit": "Security guarantee - sensitive data never leaves the system"
    },

    "use_case_3_lineage_tracking": {
      "title": "Carry IDs through multi-stage pipeline",
      "scenario": "5-stage pipeline, need document_id and source_filename in every output",
      "without_context_scope": {
        "problem": "Must add observe: [document_id] to all 5 agents",
        "fragile": "Easy to forget, breaks lineage"
      },
      "with_context_scope": {
        "extractor": {
          "schema": {
            "facts": "array",
            "document_id": "string",
            "source_filename": "string"
          }
        },
        "stage_2_through_5": {
          "context_scope": {
            "passthrough": [
              "extractor.document_id",
              "extractor.source_filename"
            ]
          }
        }
      },
      "result": {
        "all_outputs_contain": "document_id + source_filename (automatic)",
        "maintenance": "Single declaration, flows through entire pipeline"
      },
      "benefit": "Robust lineage tracking without manual observe in every agent"
    },

    "use_case_4_combined_usage": {
      "title": "All three directives working together",
      "scenario": "Complex multi-agent analysis with security, large data, and lineage",
      "config": {
        "advanced_analyzer": {
          "depends_on": ["extractor", "enricher"],
          "prompt": "Analyze: {extractor.summary}",
          "schema": {
            "analysis": "string",
            "confidence": "number"
          },
          "context_scope": {
            "include": [
              "enricher.reference_database",
              "enricher.historical_statistics"
            ],
            "exclude": [
              "source.api_credentials",
              "extractor.internal_metadata"
            ],
            "passthrough": [
              "extractor.document_id",
              "extractor.source_filename",
              "source.timestamp"
            ]
          }
        }
      },
      "result": {
        "prompt": "Analyze: [summary] (clean)",
        "llm_context": "reference_database + historical_statistics (large data)",
        "llm_never_sees": "api_credentials, internal_metadata (security)",
        "output": "{analysis, confidence, document_id, source_filename, timestamp}",
        "next_agent_can_reference": "{advanced_analyzer.document_id}"
      },
      "benefit": "Complete control over field flow"
    }
  },

