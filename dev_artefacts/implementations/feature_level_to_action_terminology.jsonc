{
  "title": "Change Execution Terminology from 'Level' to 'Action' in Workflow Logging",
  "issue_number": "TBD",
  "date": "2025-01-07",
  "priority": "low",
  "type": "enhancement",
  "status": "✅ COMPLETED",
  "category": "user_experience",

  "executive_summary": {
    "problem": "Workflow execution logging used 'Level' terminology which was confusing - users think in terms of 'actions' not 'levels'",
    "solution": "Changed all execution logging to use 'Action' instead of 'Level' for clearer, more intuitive output",
    "impact": "Improved user experience with more intuitive terminology that matches workflow YAML structure",
    "files_changed": 1,
    "lines_changed": "7 lines modified",
    "effort": "15 minutes"
  },

  "user_request": {
    "description": "User wanted execution output to show 'Action' instead of 'Level'",
    "example_before": [
      "📊 Execution: 18 level(s)",
      "  Level 0: fact_extractor (sequential)",
      "  Level 12: 3 agents in parallel - generate_distractors_3, generate_distractors_2, generate_distractors_1",
      "Level 0: All agents complete (skipped)",
      "Level 12: Starting 3 agent(s)..."
    ],
    "example_after": [
      "📊 Execution: 18 action(s)",
      "  Action 0: fact_extractor (sequential)",
      "  Action 12: 3 agents in parallel - generate_distractors_1, generate_distractors_2, generate_distractors_3",
      "Action 0: All agents complete (skipped)",
      "Action 12: Starting 3 agent(s)..."
    ],
    "rationale": "Users define 'actions' in their YAML, so referring to them as 'actions' in output is more intuitive"
  },

  "terminology_analysis": {
    "before": {
      "term": "Level",
      "meaning": "Execution level in the dependency graph (technical, internal concept)",
      "user_perspective": "Confusing - users don't think about graph levels",
      "yaml_alignment": "Misaligned - YAML uses 'actions' not 'levels'",
      "examples": [
        "Level 0: fact_extractor (sequential)",
        "Level 12: 3 agents in parallel - ...",
        "Level 12 complete (5.23s)"
      ]
    },

    "after": {
      "term": "Action",
      "meaning": "Execution step corresponding to workflow action (user-facing concept)",
      "user_perspective": "Clear - matches how users define workflows",
      "yaml_alignment": "Perfectly aligned - users write 'actions:' in YAML",
      "examples": [
        "Action 0: fact_extractor (sequential)",
        "Action 12: 3 agents in parallel - ...",
        "Action 12 complete (5.23s)"
      ]
    },

    "technical_note": "Internally these are still 'execution levels' (topological sort of dependency graph), but we present them as 'actions' to users"
  },

  "implementation": {
    "file": "agent_actions/core/graph/agent_workflow.py",
    "changes": [
      {
        "function": "_log_execution_levels",
        "line": 438,
        "before": "self.console.print(f\"[blue]📊 Execution: {len(levels)} level(s)[/blue]\")",
        "after": "self.console.print(f\"[blue]📊 Execution: {len(levels)} action(s)[/blue]\")",
        "description": "Summary line at start of execution"
      },
      {
        "function": "_log_execution_levels",
        "line": 445,
        "before": "f\"[blue]  Level {i}: {len(level)} agents in parallel - {', '.join(sorted_agents)}[/blue]\"",
        "after": "f\"[blue]  Action {i}: {len(level)} agents in parallel - {', '.join(sorted_agents)}[/blue]\"",
        "description": "Parallel action logging"
      },
      {
        "function": "_log_execution_levels",
        "line": 449,
        "before": "f\"[dim]  Level {i}: {level[0]} (sequential)[/dim]\"",
        "after": "f\"[dim]  Action {i}: {level[0]} (sequential)[/dim]\"",
        "description": "Sequential action logging"
      },
      {
        "function": "async_run",
        "line": 48,
        "before": "self.console.print(f\"[yellow]Level {level_idx}: All agents complete (skipped)[/yellow]\")",
        "after": "self.console.print(f\"[yellow]Action {level_idx}: All agents complete (skipped)[/yellow]\")",
        "description": "Skipped action message"
      },
      {
        "function": "async_run",
        "line": 51,
        "before": "self.console.print(f\"[cyan]Level {level_idx}: Starting {len(pending_agents)} agent(s)...[/cyan]\")",
        "after": "self.console.print(f\"[cyan]Action {level_idx}: Starting {len(pending_agents)} agent(s)...[/cyan]\")",
        "description": "Starting action message"
      },
      {
        "function": "async_run",
        "line": 110,
        "before": "self.console.print(f\"[yellow]Level {level_idx}: {len(batch_pending)} batch job(s) submitted ({duration:.2f}s)[/yellow]\")",
        "after": "self.console.print(f\"[yellow]Action {level_idx}: {len(batch_pending)} batch job(s) submitted ({duration:.2f}s)[/yellow]\")",
        "description": "Batch submission message"
      },
      {
        "function": "async_run",
        "line": 116,
        "before": "self.console.print(f\"[green]Level {level_idx} complete ({duration:.2f}s)[/green]\")",
        "after": "self.console.print(f\"[green]Action {level_idx} complete ({duration:.2f}s)[/green]\")",
        "description": "Action completion message"
      }
    ],

    "error_messages": [
      {
        "line": 86,
        "before": "error_msg = f\"Multiple agents failed in parallel level {level_idx}:\\n{error_details}\"",
        "after": "error_msg = f\"Multiple agents failed in parallel action {level_idx}:\\n{error_details}\"",
        "description": "Error message for parallel failures"
      },
      {
        "line": 105,
        "before": "error_msg = f\"Partial failure in parallel level {level_idx}: {', '.join(failed_agents)} failed while batch jobs were submitted\"",
        "after": "error_msg = f\"Partial failure in parallel action {level_idx}: {', '.join(failed_agents)} failed while batch jobs were submitted\"",
        "description": "Error message for partial batch failures"
      }
    ],

    "total_changes": {
      "user_facing_messages": 7,
      "error_messages": 2,
      "total": 9,
      "search_replace_pattern": "Level {level_idx} → Action {level_idx}, level(s) → action(s)"
    }
  },

  "example_output": {
    "workflow": "qanalabs-quiz-gen with 18 actions including parallel loop",

    "before": {
      "summary": "📊 Execution: 18 level(s)",
      "action_list": [
        "  Level 0: fact_extractor (sequential)",
        "  Level 1: cluster_list (sequential)",
        "  Level 2: combine_by_cluster_and_id (sequential)",
        "  ...",
        "  Level 12: 3 agents in parallel - generate_distractors_3, generate_distractors_2, generate_distractors_1",
        "  Level 13: reconstruct_options (sequential)",
        "  ..."
      ],
      "execution": [
        "Level 0: All agents complete (skipped)",
        "Level 1: All agents complete (skipped)",
        "...",
        "Level 12: Starting 3 agent(s)...",
        "  → 3 agents in parallel",
        "Level 12 complete (5.23s)"
      ]
    },

    "after": {
      "summary": "📊 Execution: 18 action(s)",
      "action_list": [
        "  Action 0: fact_extractor (sequential)",
        "  Action 1: cluster_list (sequential)",
        "  Action 2: combine_by_cluster_and_id (sequential)",
        "  ...",
        "  Action 12: 3 agents in parallel - generate_distractors_1, generate_distractors_2, generate_distractors_3",
        "  Action 13: reconstruct_options (sequential)",
        "  ..."
      ],
      "execution": [
        "Action 0: All agents complete (skipped)",
        "Action 1: All agents complete (skipped)",
        "...",
        "Action 12: Starting 3 agent(s)...",
        "  → 3 agents in parallel",
        "Action 12 complete (5.23s)"
      ]
    }
  },

  "user_experience_improvements": {
    "clarity": {
      "before": "Users see 'Level' and wonder what it means - sounds technical",
      "after": "Users see 'Action' which directly corresponds to their YAML actions",
      "benefit": "Immediate understanding without needing to learn internal terminology"
    },

    "yaml_alignment": {
      "yaml_structure": [
        "actions:",
        "  - name: fact_extractor",
        "  - name: generate_distractors",
        "    loop: ..."
      ],
      "before_output": "Level 0: fact_extractor",
      "after_output": "Action 0: fact_extractor",
      "benefit": "Terminology matches what users write in YAML"
    },

    "mental_model": {
      "user_thinks": "I defined 18 actions in my workflow",
      "before_output": "📊 Execution: 18 level(s) - 'What are levels?'",
      "after_output": "📊 Execution: 18 action(s) - 'Yes, my 18 actions!'",
      "benefit": "Reinforces correct mental model of workflow structure"
    },

    "debugging": {
      "scenario": "Action 12 fails",
      "before": "User sees 'Level 12 failed' - has to map back to action name",
      "after": "User sees 'Action 12 failed' - knows it's the 13th action in plan",
      "benefit": "Easier to locate issues in workflow definition"
    }
  },

  "technical_details": {
    "internal_concept": {
      "name": "Execution Levels",
      "definition": "Result of topological sort on workflow dependency graph",
      "purpose": "Determine which agents can run in parallel vs sequential",
      "implementation": "_compute_execution_levels() in agent_workflow.py"
    },

    "user_facing_concept": {
      "name": "Actions",
      "definition": "Steps in workflow execution corresponding to YAML actions",
      "purpose": "Communicate workflow progress to users",
      "implementation": "Display layer only - internal code still uses 'levels'"
    },

    "why_numbers_still_work": {
      "explanation": "Action numbers still correspond to execution order (topological sort result)",
      "example": "Action 0 = first action, Action 12 = 13th action step",
      "note": "Numbers may not match YAML line order due to dependency resolution"
    }
  },

  "edge_cases": {
    "parallel_loops": {
      "description": "Multiple agents in same action (parallel execution)",
      "before": "Level 12: 3 agents in parallel - generate_distractors_3, generate_distractors_2, generate_distractors_1",
      "after": "Action 12: 3 agents in parallel - generate_distractors_1, generate_distractors_2, generate_distractors_3",
      "note": "Still clearly shows multiple agents in single action"
    },

    "batch_mode": {
      "description": "Batch job submissions",
      "before": "Level 5: 2 batch job(s) submitted (1.23s)",
      "after": "Action 5: 2 batch job(s) submitted (1.23s)",
      "note": "Terminology consistent with batch workflows"
    },

    "error_scenarios": {
      "parallel_failure": {
        "before": "Multiple agents failed in parallel level 12: ...",
        "after": "Multiple agents failed in parallel action 12: ...",
        "note": "Error messages also use 'action' terminology"
      },
      "partial_failure": {
        "before": "Partial failure in parallel level 8: agent_x failed while batch jobs were submitted",
        "after": "Partial failure in parallel action 8: agent_x failed while batch jobs were submitted",
        "note": "Consistent error messaging"
      }
    }
  },

  "validation": {
    "manual_testing": {
      "test_workflow": "qanalabs-quiz-gen (18 actions with loops)",
