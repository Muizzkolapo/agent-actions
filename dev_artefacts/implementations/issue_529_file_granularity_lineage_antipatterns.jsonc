    "antipattern_5_code_duplication": {
      "status": "✅ FIXED - Implemented on 2025-11-12",
      "severity": "⚠️ LOW (WAS)",
      "type": "DRY Violation - Code Duplication",
      "locations": [
        "agent_actions/llm_invocation/batch/batch_service.py:287 (was 268-270)",
        "agent_actions/preprocessing/staging_loader.py:139 (was 122-124)"
      ],
      "description": "Same deduplication logic appeared in multiple files. FIXED by extracting to shared utility.",
      "duplicated_code": "# Appears in both files:\nexisting_guids = {item.get('source_guid') for item in existing_source if isinstance(item, dict)}\nnew_items = [item for item in src_text if isinstance(item, dict) and item.get('source_guid') not in existing_guids]",
      "problem": {
        "issue": "Same logic in 2+ places",
        "impact": "Changes need to be made in multiple locations",
        "risk": "Logic divergence if one location updated but not others",
        "maintenance": "Higher maintenance burden"
      },
      "fix_required": {
        "approach": "Extract to shared utility function",
        "location": "Create new file: agent_actions/utilities/source_data_utils.py",
        "implementation": "\"\"\"Utilities for source data manipulation.\"\"\"\nfrom typing import List, Dict, Any\n\ndef deduplicate_by_source_guid(\n    existing: List[Dict[str, Any]],\n    new: List[Dict[str, Any]]\n) -> List[Dict[str, Any]]:\n    \"\"\"Deduplicate items by source_guid field.\n    \n    Args:\n        existing: List of existing items with source_guid field\n        new: List of new items to deduplicate against existing\n        \n    Returns:\n        List of items from 'new' that don't exist in 'existing'\n        \n    Example:\n        >>> existing = [{'source_guid': 'a', 'data': 1}]\n        >>> new = [{'source_guid': 'a', 'data': 2}, {'source_guid': 'b', 'data': 3}]\n        >>> deduplicate_by_source_guid(existing, new)\n        [{'source_guid': 'b', 'data': 3}]\n    \"\"\"\n    existing_guids = {\n        item.get('source_guid') \n        for item in existing \n        if isinstance(item, dict) and item.get('source_guid')\n    }\n    \n    return [\n        item \n        for item in new \n        if isinstance(item, dict) \n        and item.get('source_guid') \n        and item.get('source_guid') not in existing_guids\n    ]",
        "usage_batch_service": "from agent_actions.utilities.source_data_utils import deduplicate_by_source_guid\n\n# In _save_task_source:\nif output_src_path.exists():\n    with open(output_src_path, 'r') as existing_file:\n        existing_source = json.load(existing_file)\n    \n    new_items = deduplicate_by_source_guid(existing_source, src_text)\n    \n    if new_items:\n        existing_source.extend(new_items)\n        with open(output_src_path, 'w') as f:\n            json.dump(existing_source, f, indent=2)",
        "usage_staging_loader": "from agent_actions.utilities.source_data_utils import deduplicate_by_source_guid\n\n# In generate_staging:\nif output_src_path.exists():\n    with open(output_src_path, 'r') as existing_file:\n        existing_source = json.load(existing_file)\n    \n    new_items = deduplicate_by_source_guid(existing_source, src_text)\n    \n    if new_items:\n        existing_source.extend(new_items)\n        source_file_writer = FileWriter(str(output_src_path))\n        source_file_writer.write_source(existing_source)"
      },
      "benefits": [
        "Single source of truth",
        "Easier to maintain and update",
        "Can add tests for deduplication logic",
        "Reduced code size"
      ],
      "testing": {
        "file": "tests/utilities/test_source_data_utils.py",
        "test_cases": [
          "test_deduplicates_by_source_guid",
          "test_handles_missing_source_guid",
          "test_handles_non_dict_items",
          "test_empty_lists",
          "test_all_duplicates",
          "test_no_duplicates"
        ]
      },
      "priority": "✅ COMPLETED - Fixed on 2025-11-12",

      "implementation_completed": {
        "date": "2025-11-12",
        "new_file_created": "agent_actions/utilities/source_data_utils.py",
        "files_modified": [
          {
            "file": "batch_service.py",
            "line": 10,
            "change": "Added import: from agent_actions.utilities.source_data_utils import deduplicate_by_source_guid"
          },
          {
            "file": "batch_service.py",
            "line": 287,
            "before": "existing_guids = {item.get('source_guid') for item in existing_source if isinstance(item, dict)}\nnew_items = [item for item in src_text if isinstance(item, dict) and item.get('source_guid') not in existing_guids]",
            "after": "new_items = deduplicate_by_source_guid(existing_source, src_text)"
          },
          {
            "file": "staging_loader.py",
            "line": 8,
