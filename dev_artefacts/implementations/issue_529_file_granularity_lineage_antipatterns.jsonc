          "new_format": "{source_guid: 'xxx', ...data}",
          "deduplication": "By source_guid using set comprehension",
          "changes": [
            "Accept src_text as list in flat format",
            "Deduplicate by source_guid field instead of nested guid keys",
            "Write list of flat objects instead of list of nested objects"
          ]
        },
        "data_transformer.py": {
          "method": "get_content_by_source_guid",
          "lines": "125-144",
          "removed_support": [
