        "option_2_migration_script": {
          "approach": "Provide script to migrate old source files to new format",
          "implementation": "#!/usr/bin/env python3\n\"\"\"Migrate source files from legacy nested format to flat format.\"\"\"\n\nimport json\nfrom pathlib import Path\nimport sys\n\ndef migrate_source_file(file_path: Path):\n    \"\"\"Migrate a single source file to flat format.\"\"\"\n    with open(file_path, 'r') as f:\n        data = json.load(f)\n    \n    migrated = []\n    for item in data:\n        if isinstance(item, dict):\n            # Already flat format?\n            if 'source_guid' in item:\n                migrated.append(item)\n            else:\n                # Legacy nested format: {guid: {data}}\n                for guid, value in item.items():\n                    if isinstance(value, dict):\n                        flat_item = value.copy()\n                        flat_item['source_guid'] = guid\n                        migrated.append(flat_item)\n    \n    # Write back\n    backup_path = file_path.with_suffix('.json.bak')\n    file_path.rename(backup_path)\n    \n    with open(file_path, 'w') as f:\n        json.dump(migrated, f, indent=2)\n    \n    print(f\"Migrated {file_path} (backup: {backup_path})\")\n\ndef main():\n    source_dir = Path(sys.argv[1]) if len(sys.argv) > 1 else Path('agent_io/source')\n    \n    for json_file in source_dir.rglob('*.json'):\n        try:\n            migrate_source_file(json_file)\n        except Exception as e:\n            print(f\"Error migrating {json_file}: {e}\", file=sys.stderr)\n\nif __name__ == '__main__':\n    main()",
          "usage": "python scripts/migrate_source_format.py agent_io/source",
          "pros": ["One-time migration", "Clean codebase after migration"],
          "cons": ["Manual user action required", "Risk of data loss if script fails"],
          "recommendation": "⚠️ CONDITIONAL - Only if backward compat is truly not needed"
        },
        "option_3_fail_fast_with_clear_error": {
          "approach": "Detect legacy format and raise explicit error with migration instructions",
          "implementation": "@staticmethod\ndef get_content_by_source_guid(\n    data: List[Dict[str, Any]],\n    source_guid: str\n) -> Optional[Any]:\n    \"\"\"Retrieve content by source_guid (flat format only).\"\"\"\n    for item in data:\n        if isinstance(item, dict):\n            # Check for flat format\n            if item.get('source_guid') == source_guid:\n                return item\n            \n            # Detect legacy format and fail fast\n            if source_guid in item and isinstance(item[source_guid], dict):\n                raise AgentActionsException(\n                    f\"Legacy nested source format detected: {{guid: {{data}}}}. \"\n                    f\"Please migrate to flat format: {{source_guid: ..., ...}}. \"\n                    f\"Run migration script: python scripts/migrate_source_format.py\",\n                    context={'source_guid': source_guid, 'legacy_format_detected': True}\n                )\n    \n    return None",
          "pros": ["Clear error message", "Forces migration", "No technical debt"],
          "cons": ["Breaks existing workflows immediately", "User friction"],
          "recommendation": "⚠️ ACCEPTABLE - If combined with migration script"
        }
