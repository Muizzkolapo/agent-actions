    "antipattern_1_race_condition_in_file_io": {
      "status": "✅ FIXED - Implemented on 2025-11-12",
      "severity": "🔴 HIGH - PRODUCTION BLOCKING (WAS)",
      "type": "Race Condition / TOCTOU Bug",
      "locations": [
        "agent_actions/llm_invocation/batch/batch_service.py:239-301",
        "agent_actions/preprocessing/staging_loader.py:119-153"
      ],
      "description": "File read and write operations were not atomic, creating Time-Of-Check-Time-Of-Use vulnerability. FIXED with portalocker cross-platform file locking.",
      "vulnerable_code": "if output_src_path.exists():\n    with open(output_src_path, 'r') as existing_file:\n        existing_source = json.load(existing_file)\n    # ... process ...\n    if new_items:\n        existing_source.extend(new_items)\n        with open(output_src_path, 'w') as f:\n            json.dump(existing_source, f, indent=2)",
      "problem": {
        "issue": "Time gap between read and write allows concurrent modifications",
        "scenario": [
          "Process A reads file at T0 → gets [item1, item2]",
          "Process B reads file at T1 → gets [item1, item2]",
          "Process A writes [item1, item2, item3] at T2",
          "Process B writes [item1, item2, item4] at T3 → OVERWRITES A's changes!",
          "Result: item3 is lost permanently"
        ],
        "impact": "Data loss in parallel/distributed processing environments",
        "when_it_occurs": [
          "Multiple agents processing same source file",
          "Batch processing with parallelization",
          "Distributed workflow execution",
          "Retry logic on failures"
        ]
      },
      "fix_required": {
        "approach": "Use file locking to ensure atomic read-modify-write",
        "implementation": "import fcntl  # Unix/Linux\nimport msvcrt  # Windows\n\ndef _save_task_source_atomic(self, src_text, file_path, base_directory, output_directory):\n    \"\"\"Save task source data with file locking to prevent race conditions.\"\"\"\n    from pathlib import Path\n    import json\n    \n    relative_path = Path(file_path).relative_to(base_directory)\n    base_path = Path(base_directory).parent\n    source_path = base_path / 'source'\n    output_src_path = source_path / relative_path.with_suffix('.json')\n    ensure_directory_exists(output_src_path, is_file=True)\n    \n    # Ensure src_text is a list\n    if not isinstance(src_text, list):\n        src_text = [src_text]\n    \n    # Use r+ mode for atomic read-modify-write, or w for new file\n    mode = 'r+' if output_src_path.exists() else 'w'\n    \n    with open(output_src_path, mode) as f:\n        # Acquire exclusive lock (blocks until available)\n        try:\n            fcntl.flock(f.fileno(), fcntl.LOCK_EX)  # Unix/Linux\n        except:\n            # Windows fallback\n            msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)\n        \n        try:\n            # Read existing data if file exists\n            if mode == 'r+':\n                try:\n                    f.seek(0)\n                    existing_source = json.load(f)\n                except json.JSONDecodeError as e:\n                    logger.warning(\"Corrupted source file %s: %s. Starting fresh.\", output_src_path, e)\n                    existing_source = []\n            else:\n                existing_source = []\n            \n            # Deduplicate by source_guid\n            existing_guids = {item.get('source_guid') for item in existing_source if isinstance(item, dict)}\n            new_items = [item for item in src_text if isinstance(item, dict) and item.get('source_guid') not in existing_guids]\n            \n            # Write back if we have new items\n            if new_items or mode == 'w':\n                if new_items:\n                    existing_source.extend(new_items)\n                f.seek(0)\n                f.truncate()\n                json.dump(existing_source, f, indent=2)\n        finally:\n            # Lock automatically released when file closes\n            pass",
        "alternative_approaches": [
          {
            "approach": "Use database instead of JSON files",
            "pros": ["Built-in concurrency control", "ACID guarantees", "Better for high concurrency"],
            "cons": ["Significant architecture change", "More dependencies", "Overkill for small-scale usage"],
            "recommendation": "Consider for v2.0 if scaling issues persist"
          },
          {
            "approach": "Use message queue for source writes",
            "pros": ["Single writer eliminates race conditions", "Better for distributed systems"],
            "cons": ["Additional infrastructure", "Complexity increase"],
            "recommendation": "Good for production-scale deployments"
          },
          {
            "approach": "Use atomic write + rename pattern",
            "pros": ["No locking needed", "Simple", "Cross-platform"],
            "cons": ["Doesn't prevent duplicate work", "Only prevents corrupted writes"],
            "implementation": "Write to temp file → rename to target (atomic on most filesystems)",
            "recommendation": "Minimum fix if file locking is problematic"
          }
        ]
      },
      "testing_requirements": [
        "Test concurrent writes to same source file",
        "Test distributed processing scenario",
        "Test recovery from partial writes",
        "Benchmark performance impact of locking"
      ],
      "priority": "✅ COMPLETED - Fixed with portalocker",

      "implementation_completed": {
