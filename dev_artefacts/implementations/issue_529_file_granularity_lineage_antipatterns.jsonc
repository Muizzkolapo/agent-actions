  "problem_statement": {
    "original_issue": {
      "title": "File-granularity tools invisible in lineage tracking",
      "description": "Tools with granularity: file (e.g., cluster_list, group_by_similarity) transform data at file level but do NOT generate new node_id values or add themselves to lineage arrays",
      "user_impact": [
        "❌ Debugging confusion: lineage shows [node_0, node_1, node_4, node_5] - appears nodes 2 & 3 were skipped",
        "❌ Historical data access: Cannot reference file-granularity tool outputs using lineage-based lookups",
        "❌ Audit trail gaps: No record that file-level transformations occurred",
        "❌ Incomplete provenance: Can't track which clustering/grouping operations were applied"
      ],
      "example_workflow": {
        "agents": [
          "node_0: fact_extractor (record-level) ✅",
          "node_1: flatten_the_facts (record-level) ✅",
          "node_2: cluster_list (file-level) ❌ INVISIBLE",
          "node_3: group_by_similarity (file-level) ❌ INVISIBLE",
          "node_4: Cluster_Validation_Agent (record-level) ✅",
          "node_5: flatten_clusters (record-level) ✅"
        ],
        "lineage_before_fix": "[node_0, node_1, node_4, node_5]  ← nodes 2 & 3 missing!",
        "lineage_after_fix": "[node_0, node_1, node_2, node_3, node_4, node_5]  ← complete!"
      }
    },
    "root_cause": {
      "file": "agent_actions/prompt_generation/target_content_processor.py",
      "line": "185-187 (before fix)",
      "code_before": "if model_vendor == 'tool' and granularity == 'file':\n    if isinstance(generated_data, list):\n        return generated_data\n    else:\n        return [generated_data]",
      "problem": "File-level tools just returned data as-is without adding node_id or lineage tracking",
      "consequence": "Downstream nodes inherited lineage from node_1, skipping nodes 2 & 3 entirely"
    }
  },

  "solution_overview": {
    "implementation_approach": "Add lineage tracking to file-granularity tools similar to record-level processing",
    "key_changes": [
      "1. Modified target_content_processor.py to call LineageBuilder.add_lineage_tracking() for file-level tools",
      "2. Generate unique node_ids per output item using IDGenerator.generate_node_id()",
      "3. Ensure required fields via FieldManager.ensure_required_fields()",
      "4. Standardized source data format from nested {guid: data} to flat {source_guid: ..., ...}"
    ],
    "architecture_goals": [
      "✅ Make file-level tools visible in lineage",
      "✅ Maintain consistency with record-level processing",
      "✅ Support lineage-based historical lookups",
      "✅ Standardize source data format across codebase"
    ]
  },

  "implementation_completed": {
    "phase_1_add_lineage_to_file_tools": {
      "description": "Add lineage tracking to file-granularity tools",
      "file": "agent_actions/prompt_generation/target_content_processor.py",
      "lines_modified": "185-209",
      "changes": {
        "before": "if model_vendor == 'tool' and granularity == 'file':\n    if isinstance(generated_data, list):\n        return generated_data\n    else:\n        return [generated_data]",
        "after": "if model_vendor == 'tool' and granularity == 'file':\n    # File-level tools need lineage tracking too (issue #529)\n    data_list = generated_data if isinstance(generated_data, list) else [generated_data]\n    \n    # Get the first item from input data for lineage inheritance\n    source_item = data[0] if data else {}\n    \n    # Add lineage tracking to each item with unique node_ids\n    base_node_id = IDGenerator.generate_node_id(self.idx)\n    tracked_data = []\n    for i, item in enumerate(data_list):\n        if isinstance(item, dict):\n            # Ensure required fields first\n            item = FieldManager().ensure_required_fields(item, source_guid, self.idx)\n            # Generate unique node_id per item (like record-level processing)\n            node_id = f\"{base_node_id}_{i}\" if len(data_list) > 1 else base_node_id\n            # Add lineage tracking\n            item = LineageBuilder.add_lineage_tracking(item, source_item, node_id)\n            tracked_data.append(item)\n        else:\n            tracked_data.append(item)\n    \n    return tracked_data"
      },
      "logic": [
        "1. Normalize generated_data to list",
        "2. Get first item from input data for lineage inheritance",
        "3. Generate base node_id using IDGenerator",
        "4. For each output item:",
        "   a. Ensure required fields (target_id, source_guid, node_id)",
        "   b. Generate unique node_id (append _0, _1, etc. for multiple items)",
        "   c. Add lineage tracking via LineageBuilder.add_lineage_tracking()",
        "5. Return tracked data"
      ],
      "status": "✅ COMPLETE - Working as verified in lineage analysis"
    },

    "phase_2_standardize_source_format": {
      "description": "Standardize source data from nested {guid: data} to flat {source_guid: ..., ...}",
