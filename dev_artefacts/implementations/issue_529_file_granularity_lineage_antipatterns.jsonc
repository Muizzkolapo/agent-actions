        },
        "scenario_2_bug_in_caller": {
          "case": "Caller should always pass list but has a bug",
          "verdict": "❌ MASKED - Silent coercion hides the bug"
        }
      },
      "fix_options": {
        "option_1_log_warning": {
          "change": "if not isinstance(src_text, list):\n    logger.warning(\n        \"_save_task_source received non-list src_text. \"\n        \"This may indicate a bug in the calling code. \"\n        \"Converting to list.\",\n        extra={'src_text_type': type(src_text).__name__}\n    )\n    src_text = [src_text]",
