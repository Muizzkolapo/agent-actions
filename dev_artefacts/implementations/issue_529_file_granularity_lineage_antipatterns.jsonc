          "approach": "Restore legacy format support with deprecation warning",
          "implementation": "@staticmethod\ndef get_content_by_source_guid(\n    data: List[Dict[str, Any]],\n    source_guid: str\n) -> Optional[Any]:\n    \"\"\"Retrieve content by source_guid with backward compatibility.\"\"\"\n    for item in data:\n        if isinstance(item, dict):\n            # New flat format (preferred)\n            if item.get('source_guid') == source_guid:\n                return item\n            \n            # Legacy nested format (deprecated)\n            if source_guid in item:\n                logger.warning(\n                    \"Deprecated source data format detected: {guid: {data}}. \"\n                    \"Please migrate to flat format: {source_guid: ..., ...}. \"\n                    \"Support will be removed in v3.0.\"\n                )\n                return item[source_guid]\n            \n            # Target ID lookup (deprecated)\n            for key, value in item.items():\n                if isinstance(value, dict) and value.get('target_id') == source_guid:\n                    logger.warning(\n                        \"Deprecated target_id lookup detected. \"\n                        \"Please migrate to flat format with source_guid field. \"\n                        \"Support will be removed in v3.0.\"\n                    )\n                    return value\n    \n    return None",
