    "antipattern_3_data_mutation_in_loop": {
      "status": "✅ FIXED - Implemented on 2025-11-12",
      "severity": "⚠️ MEDIUM (WAS)",
      "type": "Potential Side Effects from Loop Mutation",
      "location": "agent_actions/prompt_generation/target_content_processor.py:197-217",
      "description": "Was creating new FieldManager instance in loop and potentially mutating shared data references. FIXED with explicit copy and single FieldManager instance.",
      "vulnerable_code": "for i, item in enumerate(data_list):\n    if isinstance(item, dict):\n        # Ensure required fields first\n        item = FieldManager().ensure_required_fields(item, source_guid, self.idx)  # ⚠️ New instance per iteration\n        # Generate unique node_id per item (like record-level processing)\n        node_id = f\"{base_node_id}_{i}\" if len(data_list) > 1 else base_node_id\n        # Add lineage tracking\n        item = LineageBuilder.add_lineage_tracking(item, source_item, node_id)\n        tracked_data.append(item)",
      "problems": [
        {
          "issue": "FieldManager instantiated in loop",
          "impact": "Unnecessary object creation on every iteration",
          "severity": "Low - minor performance impact"
        },
        {
          "issue": "Potential mutation of shared references",
          "detail": "If generated_data is a reference to external list, and ensure_required_fields/add_lineage_tracking don't copy, mutations could leak",
          "impact": "Could cause unexpected side effects if generated_data is reused",
          "severity": "Medium - depends on whether methods return copies"
        },
        {
          "issue": "No explicit copy of item",
          "detail": "While ensure_required_fields and add_lineage_tracking likely return copies (need to verify), it's not explicit in this code",
          "impact": "Code clarity - intent not obvious",
          "severity": "Low - documentation/clarity issue"
        }
      },
      "fix_required": {
        "implementation": "# Create FieldManager once outside loop\nfield_manager = FieldManager()\n\n# Explicitly copy items to avoid mutation\nfor i, item in enumerate(data_list):\n    if isinstance(item, dict):\n        # Explicitly copy to prevent mutation of original\n        item_copy = item.copy()\n        \n        # Ensure required fields\n        item_copy = field_manager.ensure_required_fields(item_copy, source_guid, self.idx)\n        \n        # Generate unique node_id per item\n        node_id = f\"{base_node_id}_{i}\" if len(data_list) > 1 else base_node_id\n        \n        # Add lineage tracking\n        item_copy = LineageBuilder.add_lineage_tracking(item_copy, source_item, node_id)\n        \n        tracked_data.append(item_copy)\n    else:\n        tracked_data.append(item)",
        "improvements": [
          "✅ FieldManager created once",
          "✅ Explicit item.copy() prevents mutation",
          "✅ Clear intent - we're creating new tracked items",
          "✅ No performance regression"
        ]
      },
      "verification_needed": {
        "questions": [
          "Does FieldManager().ensure_required_fields() return a copy or mutate in place?",
          "Does LineageBuilder.add_lineage_tracking() return a copy or mutate in place?",
          "Is generated_data ever reused after this function returns?"
        ],
        "action": "Code review of FieldManager and LineageBuilder implementations"
      },
      "priority": "✅ COMPLETED - Fixed on 2025-11-12",

      "implementation_completed": {
        "date": "2025-11-12",
        "changes": [
          "Created FieldManager once outside loop (line 199)",
          "Added explicit item.copy() to prevent mutation (line 204)",
          "Renamed variable to item_copy for clarity",
          "Reuse same field_manager instance in loop (line 207)"
        ],
        "benefits": [
          "Performance: FieldManager created once instead of N times",
          "Safety: Original data never mutated",
          "Clarity: Explicit intent with item_copy variable",
          "Defensive: Protected against future method changes"
        ]
      }
    },

