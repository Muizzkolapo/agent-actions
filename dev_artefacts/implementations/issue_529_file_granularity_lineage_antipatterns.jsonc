          "change": "def _save_task_source(\n    self, \n    src_text: Union[Dict, List[Dict]],  # Document that both are acceptable\n    file_path, \n    base_directory, \n    output_directory\n):\n    \"\"\"Save task source data.\n    \n    Args:\n        src_text: Single item (Dict) or list of items (List[Dict])\n    \"\"\"\n    # Normalize to list\n    if not isinstance(src_text, list):\n        src_text = [src_text]",
          "pros": ["Documents intent", "Type hints match reality", "Clear API contract"],
