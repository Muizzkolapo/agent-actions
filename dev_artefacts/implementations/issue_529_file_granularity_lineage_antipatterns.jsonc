        "explicit_set": "source_guid = row.get('source_guid')\nif source_guid:\n    src_text = row.copy()\n    src_text['source_guid'] = source_guid  # Explicit set, no conditional\n    batch_service._save_task_source([src_text], file_path, base_directory, output_directory)"
      },
