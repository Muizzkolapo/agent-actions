{
  "title": "Automate Config Field Inheritance in ActionExpander (Issue #434)",
  "issue": "#434",
  "priority": "high",
  "type": "refactor",
  "status": "📋 READY TO START",
  "description": "Replace manual field-by-field copying in ActionExpander._create_agent_from_action() with an automated system that inherits all config fields from defaults without requiring explicit code for each field.",

  "executive_summary": {
    "problem": "Every new config field requires manual boilerplate code in ActionExpander, leading to bugs (prompt_debug was forgotten) and maintenance burden",
    "solution": "Create a whitelist-based inheritance system that automatically handles simple fields while preserving special handling for complex fields",
    "impact": "Prevents future bugs, reduces maintenance, makes adding new fields require only 1 line instead of scattered code changes",
    "implementation": "4 phases: (1) Create config field definitions module, (2) Add auto-inheritance function, (3) Update ActionExpander, (4) Add comprehensive tests",
    "estimated_effort": "3-5 hours",
    "code_changes": "~250 lines added (150 core + 100 tests), ~20 lines removed"
  },

  "problem_statement": {
    "current_pain_points": {
      "manual_field_copying": {
        "description": "Each config field requires explicit manual copying in ActionExpander._create_agent_from_action()",
        "file": "agent_actions/core/parser/action_expander.py",
        "lines": "139-161",
        "example_code": "agent['model_vendor'] = action.get('model_vendor', defaults.get('model_vendor'))\nagent['model_name'] = action.get('model_name', defaults.get('model_name'))\nagent['api_key'] = action.get('api_key', defaults.get('api_key'))\nagent['json_mode'] = action.get('json_mode', defaults.get('json_mode', False))\nagent['prompt_debug'] = action.get('prompt_debug', defaults.get('prompt_debug', False))\n# ... repeated for every field",
        "problems": [
          "Repetitive boilerplate code",
          "Easy to forget when adding new fields",
          "Default values scattered throughout code",
          "Maintenance burden grows with each new field"
        ]
      },
      "recent_bug_example": {
        "field": "prompt_debug",
        "commit": "ef0f388 (Oct 6, 2025)",
        "issue": "Field existed in YAML API and was used throughout codebase, but wasn't being copied in ActionExpander",
        "impact": "Field was silently ignored, especially in loop actions",
        "root_cause": "Developer added prompt_debug to YAML API but forgot to add manual copy line in ActionExpander",
        "fix": "Added line 161: agent['prompt_debug'] = action.get('prompt_debug', defaults.get('prompt_debug', False))",
        "how_automation_prevents": "Would have automatically inherited if in SIMPLE_CONFIG_FIELDS whitelist"
      },
      "maintenance_cost": {
        "current_workflow": [
          "1. Add field to YAML schema",
          "2. Add field to Pydantic model",
          "3. Add manual copy line in ActionExpander",
          "4. Remember to handle field in template replacement if needed",
          "5. Add tests",
          "6. Update documentation"
        ],
        "proposed_workflow": [
          "1. Add field to YAML schema",
          "2. Add field to Pydantic model",
          "3. Add ONE LINE to SIMPLE_CONFIG_FIELDS dict",
          "4. Tests automatically cover inheritance",
          "5. Update documentation"
        ],
        "time_saved": "~30% reduction in steps, 0% chance of forgetting"
      }
    },
    "validation_from_codebase": {
      "manual_field_copying_confirmed": {
