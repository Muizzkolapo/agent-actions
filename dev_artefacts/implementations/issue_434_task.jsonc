      "complex_fields": {
        "definition": "Require special handling beyond simple get()",
        "examples": {
          "schema": "Template replacement + type handling (string vs dict)",
          "guard": "Parsing guard expressions (SQL vs UDF)",
          "prompt": "Template replacement",
          "granularity": "String capitalization",
          "observe/drops": "Additive merging with deduplication",
          "chunk_config": "Nested config extraction",
          "loop_consumption": "Special structure",
          "interceptors": "Special structure"
        },
        "handling": "Keep current manual approach - NOT in SIMPLE_CONFIG_FIELDS"
      },
      "future_additions": {
        "guideline": "If field needs more than action.get(field, defaults.get(field, default)), it's complex",
        "examples_of_simple": [
          "retry_count: int",
