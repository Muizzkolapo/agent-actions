  "solution_overview": {
    "approach": "Whitelist-based automatic field inheritance (Approach 1 from issue)",
    "why_chosen": [
      "✅ Explicit - clear what fields are simple vs complex",
      "✅ Safe - won't accidentally inherit wrong fields",
      "✅ Maintainable - easy to add new simple fields",
      "✅ Gradual - can migrate incrementally without breaking changes",
      "✅ Debuggable - clear where each field comes from"
    ],
    "alternatives_rejected": {
      "approach_2_blacklist": {
        "description": "Auto-merge everything except blacklist",
        "pros": ["Most automated", "New fields just work"],
        "cons": ["Less explicit", "Could accidentally inherit unwanted fields", "Harder to debug"],
        "why_rejected": "Too risky - prefer explicit over implicit for config inheritance"
      },
      "approach_3_pydantic": {
        "description": "Use Pydantic model field definitions",
        "pros": ["Type safety", "Single source of truth", "Built-in validation"],
        "cons": ["Bigger refactor", "Pydantic overhead", "Field mappings harder"],
        "why_rejected": "Too large a change for this issue - could be future enhancement"
      }
    },
    "architecture": {
      "new_module": "agent_actions/core/parser/config_field_definitions.py",
      "purpose": "Centralized config field definitions and inheritance logic",
      "exports": [
        "SIMPLE_CONFIG_FIELDS - Dict mapping field names to default values",
        "FIELD_MAPPINGS - Dict mapping YAML names to internal names",
        "inherit_simple_fields() - Function to auto-inherit fields"
      ]
    },
    "key_design_decisions": {
      "simple_vs_complex": {
        "simple_fields": "Follow pattern: action.get(field, defaults.get(field, default_value))",
        "complex_fields": "Need special handling (transformation, validation, merging logic)",
        "boundary": "If it needs more than a simple get() with default, it's complex"
      },
      "field_mappings": {
        "why_needed": "Some YAML fields have different internal names",
        "example": "'few_shot' in YAML → 'use_few_shot_samples' internally",
        "approach": "Explicit mapping dict for clarity"
      },
      "default_values": {
        "centralization": "All default values defined in SIMPLE_CONFIG_FIELDS",
        "types": [
          "None - required fields that must be provided (model_vendor, model_name, api_key)",
          "False - boolean flags (json_mode, prompt_debug)",
          "0 - numeric defaults (few_shot)",
          "'online' - string defaults (run_mode)",
          "True - boolean defaults (is_operational)"
        ]
      }
    }
  },

  "implementation_plan": {
    "phase_1_create_infrastructure": {
      "priority": "critical",
      "description": "Create centralized config field definitions module",
      "status": "✅ COMPLETED",
      "tasks": [
        {
          "id": "create_config_field_definitions_module",
          "title": "Create agent_actions/core/parser/config_field_definitions.py",
          "file": "agent_actions/core/parser/config_field_definitions.py",
          "status": "✅ COMPLETED",
          "content": {
            "imports": [
              "from typing import Dict, Any, Optional"
            ],
            "constants": {
              "SIMPLE_CONFIG_FIELDS": {
                "description": "Simple config fields that follow standard inheritance pattern",
                "format": "'yaml_field_name': default_value",
                "fields": {
                  "model_vendor": null,
                  "model_name": null,
                  "api_key": null,
                  "run_mode": "online",
                  "is_operational": true,
                  "json_mode": false,
                  "prompt_debug": false,
                  "few_shot": 0
                },
                "note": "Future fields go here - just add one line!"
              },
              "FIELD_MAPPINGS": {
                "description": "Field name mappings (YAML name -> internal name)",
                "mappings": {
                  "few_shot": "use_few_shot_samples"
                },
                "note": "Add here if YAML field name differs from internal name"
              }
            },
            "function": {
              "name": "inherit_simple_fields",
              "signature": "def inherit_simple_fields(agent: Dict[str, Any], action: Dict[str, Any], defaults: Dict[str, Any]) -> None",
              "docstring": "Automatically inherit simple config fields from action/defaults.\n\nInheritance order: action > defaults > hardcoded default\n\nArgs:\n    agent: Agent config dict to populate\n    action: Action config from YAML\n    defaults: Default config from YAML",
              "logic": [
                "For each field in SIMPLE_CONFIG_FIELDS:",
                "  1. Get internal field name from FIELD_MAPPINGS (or use YAML name)",
                "  2. Inherit value: action.get(yaml_field, defaults.get(yaml_field, default_value))",
                "  3. Set agent[internal_field] = inherited_value"
              ],
              "implementation": "def inherit_simple_fields(\n    agent: Dict[str, Any],\n    action: Dict[str, Any],\n    defaults: Dict[str, Any]\n) -> None:\n    \"\"\"\n    Automatically inherit simple config fields from action/defaults.\n    \n    Inheritance order: action > defaults > hardcoded default\n    \n    Args:\n        agent: Agent config dict to populate\n        action: Action config from YAML\n        defaults: Default config from YAML\n    \"\"\"\n    for yaml_field, default_value in SIMPLE_CONFIG_FIELDS.items():\n        # Get the internal field name (might be different from YAML)\n        internal_field = FIELD_MAPPINGS.get(yaml_field, yaml_field)\n        \n        # Standard inheritance: action > defaults > hardcoded default\n        agent[internal_field] = action.get(yaml_field, defaults.get(yaml_field, default_value))"
            }
          },
          "lines_added": 80,
          "validation": [
            "Module imports without errors",
            "Constants are valid Python dicts",
            "inherit_simple_fields() function signature correct",
            "Docstring clearly explains behavior"
          ]
        }
      ],
      "success_criteria": [
        "✅ New module created with proper structure",
        "✅ SIMPLE_CONFIG_FIELDS contains all simple fields",
        "✅ FIELD_MAPPINGS handles few_shot mapping",
        "✅ inherit_simple_fields() function implemented",
        "✅ Code is well-documented with docstrings"
      ]
    },

