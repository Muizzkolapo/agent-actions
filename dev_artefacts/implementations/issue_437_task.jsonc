  "for_future_developers": {
    "understanding_the_architecture": {
      "core_concepts": {
        "flat_data_everywhere": {
          "description": "Data flows through the pipeline as flat dictionaries for efficiency",
          "example": "{'bloom_details': 'xyz', 'cluster_id': '123', 'page_content': 'abc'}",
          "why": "Simple, fast, no nested structure complexity",
          "where": "All file I/O, data transformations, processor outputs"
        },
        "namespaced_field_context": {
          "description": "field_context has agent namespaces ONLY for prompt resolution",
          "example": "{'create_new_clusters': {'bloom_details': 'xyz', 'cluster_id': '123'}}",
          "why": "Enables {agent.field} references to resolve correctly",
          "where": "ONLY in DataGenerator._format_prompt() - local variable, never persisted",
          "lifetime": "Created on-demand, used once, discarded"
        },
        "dependency_output_signatures": {
          "description": "Each agent declares what fields it outputs via output_schema + observe - drops",
          "computed_by": "LLMContextUtils.compute_llm_context(agent_config)",
          "formula": "(output_schema.properties.keys() + observe) - drops",
          "example": "Agent with schema={result}, observe=[id], drops=[temp] → outputs: {result, id}",
          "used_for": "Validation (config-time) AND field_context building (runtime)"
        }
      },
      "data_flow_explained": {
        "step_1_agent_execution": {
          "agent": "create_new_clusters",
          "outputs": "{'cluster_id': '123', 'should_keep_cluster': True, 'reasoning': '...'}",
          "observe_adds": "['bloom_details', 'page_content'] from input",
          "result_on_disk": "{'cluster_id': '123', 'should_keep_cluster': True, 'reasoning': '...', 'bloom_details': 'xyz', 'page_content': 'abc'}",
          "structure": "FLAT dict written to JSON file"
        },
        "step_2_next_agent_reads": {
          "agent": "fact_questionability",
          "dependencies": "['create_new_clusters']",
          "reads_from_disk": "{'cluster_id': '123', 'bloom_details': 'xyz', ...} ← FLAT",
          "prompt_has": "{create_new_clusters.bloom_details}",
          "problem_before_fix": "field_context = flat dict → no 'create_new_clusters' key → reference fails"
        },
        "step_3_our_fix": {
          "when": "DataGenerator._format_prompt() is called",
          "input": "contents = {'cluster_id': '123', 'bloom_details': 'xyz', ...} ← FLAT",
          "process": [
            "1. Get dependencies from agent_config: ['create_new_clusters']",
            "2. Get create_new_clusters config from dependency_configs",
            "3. Compute output signature: LLMContextUtils.compute_llm_context(dep_config)",
            "4. Extract those fields from flat contents",
            "5. Group under agent name: {'create_new_clusters': {extracted_fields}}"
          ],
          "output": "field_context = {'create_new_clusters': {'cluster_id': '123', 'bloom_details': 'xyz'}}",
          "result": "PromptUtils.replace_field_references() finds 'create_new_clusters' → resolves {create_new_clusters.bloom_details} ✅"
        }
      },
      "key_components_reference": {
        "LLMContextUtils": {
          "file": "agent_actions/agents/validators/llm_context_utils.py",
          "key_method": "compute_llm_context(agent_config) -> Set[str]",
          "purpose": "Computes what fields an agent makes available to LLM",
          "used_by": ["InputSignatureValidator (validation)", "DataGenerator (field_context building)"],
          "example": "compute_llm_context({'output_schema': {'properties': {'x': {}}}, 'observe': ['y']}) → {'x', 'y'}"
        },
        "DataGenerator": {
          "file": "agent_actions/agents/generators/data_generator.py",
          "key_attributes": {
            "agent_config": "Config for THIS agent",
            "agent_name": "Name of THIS agent",
            "dependency_configs": "Dict[agent_name -> config] for all dependencies"
          },
          "key_methods": {
            "_build_namespaced_field_context": {
              "purpose": "Reconstruct agent namespaces from flat contents",
              "inputs": "contents (flat dict), source_content, loop_context, workflow_metadata",
              "output": "field_context with agent namespaces",
              "algorithm": "For each dependency: get output signature → extract fields → group by agent name"
            },
            "_format_prompt": {
              "purpose": "Format prompt template with actual values",
              "uses": "_build_namespaced_field_context() to get field_context",
              "passes_to": "PromptUtils.replace_field_references(prompt, field_context)"
            }
          }
        },
        "PromptUtils": {
          "file": "agent_actions/agents/transformers/prompt_utils.py",
          "key_methods": {
            "parse_field_references": "Extracts {agent.field} patterns from prompt",
            "replace_field_references": "Replaces {agent.field} with values from field_context",
            "resolve_field_reference": "Navigates nested field_context to find value"
          },
          "important": "These methods UNCHANGED by our fix - they already supported {agent.field}, just needed proper field_context"
        },
        "InputSignatureValidator": {
          "file": "agent_actions/agents/validators/input_signature_validator.py",
          "purpose": "Validates field references at config load time",
          "unchanged_by_fix": "Still works the same - validates {agent.field} against dependency outputs",
          "complements": "Runtime field_context building - validation at config-time, resolution at runtime"
        }
      }
    },
    "how_to_extend_this": {
      "add_explicit_input_signature": {
        "motivation": "Currently input signature is implicit (derived from dependencies). Could make it explicit in YAML.",
        "yaml_example": "actions:\n  - name: fact_questionability\n    dependencies: [create_new_clusters]\n    input_signature:\n      create_new_clusters: [bloom_details, cluster_id]\n      source: [page_content]",
        "implementation_guide": [
          "1. Add input_signature field to AgentConfig schema",
          "2. Update InputSignatureValidator to check explicit input_signature if present",
          "3. In DataGenerator._build_namespaced_field_context(), prefer explicit input_signature over computed",
          "4. Benefits: Clearer intent, can detect unused fields, better error messages"
        ],
        "backward_compatibility": "Make input_signature optional - fall back to current behavior if not present"
      },
      "add_output_signature_property": {
        "motivation": "Enable programmatic access to agent signatures: agent.output_signature",
        "implementation_guide": [
          "1. Add @property to DataGenerator:",
          "   @property",
          "   def output_signature(self) -> Dict[str, List[str]]:",
          "       return {",
          "           'schema_fields': list(self.agent_config.get('output_schema', {}).get('properties', {}).keys()),",
          "           'observe_fields': self.agent_config.get('observe', []),",
          "           'drops': self.agent_config.get('drops', []),",
          "           'available_to_llm': list(LLMContextUtils.compute_llm_context(self.agent_config))",
          "       }",
          "2. Similarly add input_signature property using self.dependency_configs",
          "3. Use cases: Debugging, introspection, dynamic workflow generation"
        ],
        "stub_already_present": "See line 730+ in issue_437_task.jsonc for stub implementation"
      },
      "add_field_conflict_detection": {
        "motivation": "Warn if multiple dependencies produce same field name",
        "example_conflict": "agent_A outputs {result}, agent_B outputs {result} → which one wins?",
        "implementation_guide": [
          "1. In _build_namespaced_field_context(), track field origins",
          "2. If field exists in multiple dependency outputs, log warning or error",
          "3. Options: (a) fail fast, (b) last-dependency-wins with warning, (c) require explicit resolution",
          "4. Add test case for field conflicts"
        ],
        "complexity": "Medium - need to decide on conflict resolution strategy"
      },
      "add_field_provenance_tracking": {
        "motivation": "Track which agent produced each field in the data itself",
        "current_state": "Data is flat with no provenance - we reconstruct it from configs",
        "alternative_approach": "Tag data with metadata: {'_meta': {'field_origins': {'bloom_details': 'create_new_clusters'}}}",
        "pros": "Simpler field_context building, no need for dependency_configs",
        "cons": "Changes data structure (violates our design principle), metadata overhead",
        "recommendation": "Current approach (reconstruct from configs) is better - keeps data clean"
      }
    },
    "troubleshooting_guide": {
      "common_issues": {
        "reference_not_found_error": {
          "error": "Reference 'agent_name' not found. Available: [field1, field2, ...]",
          "cause_1": "dependency_configs not passed through - agent namespace not built",
          "check_1": "Verify DataGenerator.__init__ receives dependency_configs (should not be empty dict for agents with dependencies)",
          "cause_2": "Agent not in dependencies list",
          "check_2": "Verify agent_config['dependencies'] includes the referenced agent",
          "cause_3": "Typo in agent name",
          "check_3": "Check prompt has correct agent name, matches config exactly"
        },
        "field_not_found_in_agent": {
          "error": "Field 'field_name' not found in reference 'agent_name'",
          "cause_1": "Field not in dependency's output signature",
          "check_1": "Verify field is in dependency's output_schema OR observe list (and NOT in drops)",
          "cause_2": "Field name typo",
          "check_2": "Check prompt has correct field name",
          "cause_3": "Field missing from actual data",
          "check_3": "Check dependency's output file - does it actually contain that field?"
        },
        "validation_passes_runtime_fails": {
          "symptom": "InputSignatureValidator says valid but runtime error",
          "should_not_happen": "Our fix resolves this! If you see this, something is wrong.",
          "debug_steps": [
            "1. Check DataGenerator has dependency_configs (print in __init__)",
            "2. Check _build_namespaced_field_context() is being called (add print statement)",
            "3. Check field_context has agent namespaces (print before replace_field_references)",
            "4. Run test_data_generator_field_context.py tests - do they pass?",
            "5. If tests pass but real workflow fails, there may be a config loading issue"
          ]
        }
      },
      "debugging_tips": {
