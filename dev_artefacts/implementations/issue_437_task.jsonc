  "technical_considerations": {
    "data_structure_invariant": {
      "rule": "Data must remain flat throughout the pipeline",
      "why": [
        "Efficient data flow",
        "Existing code expects flat dicts",
        "No breaking changes to data structure"
      ],
      "where_namespacing_happens": "ONLY in field_context during prompt formatting",
      "enforcement": "field_context is local to _format_prompt(), never persisted"
    },
    "dependency_config_availability": {
      "challenge": "DataGenerator needs dependency configs but doesn't have them",
      "options": [
        {
          "option": "Pass through constructor",
          "pros": ["Clean dependency injection", "Explicit", "Testable"],
          "cons": ["Requires threading through multiple layers"],
          "chosen": true
        },
        {
          "option": "Global registry/cache",
          "pros": ["Easy access anywhere"],
          "cons": ["Global state", "Harder to test", "Not DI-friendly"],
          "chosen": false
        },
        {
          "option": "Lazy lookup via agent_runner",
          "pros": ["On-demand loading"],
          "cons": ["Tight coupling", "Circular dependency risk"],
          "chosen": false
        }
      ]
    },
    "backward_compatibility": {
      "strategy": "Optional parameter with safe defaults",
      "scenarios": [
        {
          "case": "dependency_configs provided",
          "behavior": "Build namespaced field_context → {agent.field} works"
        },
        {
          "case": "dependency_configs = None or {}",
          "behavior": "Skip namespacing → flat field_context → backward compatible"
        },
        {
          "case": "Old code not updated",
          "behavior": "DataGenerator(config, name) still works → dependency_configs defaults to {}"
        }
      ]
    },
    "performance": {
      "overhead": "Minimal - only during prompt formatting (once per agent execution)",
      "operations": [
        "LLMContextUtils.compute_llm_context() - simple set operations",
        "Dict field extraction - O(fields)",
        "No nested loops or expensive operations"
      ],
      "impact": "Negligible compared to LLM call time"
    }
  },

  "testing_strategy": {
    "unit_tests": {
      "test_build_namespaced_field_context": {
        "file": "tests/agents/generators/test_data_generator_field_context.py",
        "test_cases": [
          {
            "name": "test_builds_namespaced_context_with_dependency_configs",
            "setup": {
              "agent_config": "{'dependencies': ['agent_A']}",
              "dependency_configs": "{'agent_A': {'output_schema': {'properties': {'field1': {}, 'field2': {}}}}}",
              "contents": "{'field1': 'value1', 'field2': 'value2', 'field3': 'value3'}"
            },
            "expected": "{'agent_A': {'field1': 'value1', 'field2': 'value2'}}",
            "validates": "Fields grouped by agent based on output signature"
          },
          {
            "name": "test_handles_observe_fields_correctly",
            "setup": {
              "dependency_config": "{'output_schema': {'properties': {'result': {}}}, 'observe': ['id', 'metadata']}",
              "contents": "{'result': '...', 'id': '123', 'metadata': {...}}"
            },
            "expected": "{'agent': {'result': '...', 'id': '123', 'metadata': {...}}}",
            "validates": "Observe fields included in agent's output signature"
          },
          {
            "name": "test_handles_drops_correctly",
            "setup": {
              "dependency_config": "{'output_schema': {'properties': {'field1': {}, 'field2': {}}}, 'drops': ['field2']}",
              "contents": "{'field1': 'v1', 'field2': 'v2'}"
            },
            "expected": "{'agent': {'field1': 'v1'}}",
            "validates": "Dropped fields excluded from agent's namespace"
          },
          {
            "name": "test_backward_compatible_without_dependency_configs",
            "setup": {
              "dependency_configs": "{}",
              "contents": "{'field1': 'v1', 'field2': 'v2'}"
            },
            "expected": "{}",
            "validates": "No namespacing when dependency_configs not provided"
          },
          {
            "name": "test_multiple_dependencies",
            "setup": {
              "dependencies": "['agent_A', 'agent_B']",
              "agent_A_outputs": "['field1', 'field2']",
              "agent_B_outputs": "['field3', 'field4']",
              "contents": "{'field1': 'v1', 'field2': 'v2', 'field3': 'v3', 'field4': 'v4'}"
            },
            "expected": "{'agent_A': {'field1': 'v1', 'field2': 'v2'}, 'agent_B': {'field3': 'v3', 'field4': 'v4'}}",
            "validates": "Multiple dependencies correctly namespaced"
          },
          {
            "name": "test_preserves_source_loop_workflow_contexts",
            "setup": {
              "source_content": "{'text': '...'}",
