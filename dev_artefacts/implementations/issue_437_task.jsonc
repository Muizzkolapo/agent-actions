    "phase_4_future_signature_api": {
      "priority": "low",
      "description": "Add foundation for future agent.input_signature / agent.output_signature API",
      "note": "NOT implementing now, just setting up the architecture",
      "tasks": [
        {
          "id": "add_signature_properties",
          "title": "Add @property methods for signatures (stubbed)",
          "file": "agent_actions/agents/generators/data_generator.py",
          "implementation": "# Future API (not fully implemented yet)\n@property\ndef output_signature(self) -> Dict[str, List[str]]:\n    \"\"\"\n    Get the output signature of this agent.\n    \n    Returns dict with:\n        - schema_fields: Fields from output_schema\n        - observe_fields: Fields from observe directive\n        - drops: Fields that are dropped\n        \n    Future: This will be the standard way to query what an agent outputs.\n    \"\"\"\n    from agent_actions.agents.validators.llm_context_utils import LLMContextUtils\n    \n    return {\n        'schema_fields': list(self.agent_config.get('output_schema', {}).get('properties', {}).keys()),\n        'observe_fields': self.agent_config.get('observe', []),\n        'drops': self.agent_config.get('drops', []),\n        'available_to_llm': list(LLMContextUtils.compute_llm_context(self.agent_config))\n    }\n\n@property\ndef input_signature(self) -> Dict[str, Dict[str, List[str]]]:\n    \"\"\"\n    Get the input signature of this agent (what it expects from dependencies).\n    \n    Returns dict mapping dependency names to their fields.\n    \n    Future: This will be the standard way to query what an agent expects.\n    Currently reconstructed from dependency_configs.\n    \"\"\"\n    # For now, just list dependencies and their available fields\n    input_sig = {}\n    dependencies = self.agent_config.get('dependencies', [])\n    \n    for dep_name in dependencies:\n        dep_config = self.dependency_configs.get(dep_name)\n        if dep_config:\n            from agent_actions.agents.validators.llm_context_utils import LLMContextUtils\n            input_sig[dep_name] = list(LLMContextUtils.compute_llm_context(dep_config))\n    \n    return input_sig",
          "lines_added": 50,
          "note": "These are simple property accessors. Future enhancement would be explicit input_signature in YAML config."
        }
      ],
      "validation_requirements": [
