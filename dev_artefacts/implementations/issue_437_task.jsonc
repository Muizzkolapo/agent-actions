{
  "title": "Fix Agent Field Reference Resolution via Dependency Output Signatures (Issue #437)",
  "issue": "#437",
  "priority": "high",
  "type": "bugfix",
  "status": "✅ COMPLETED",
  "completion_date": "2025-01-06",
  "description": "Enable {agent.field} references to work at runtime by using dependency output signatures to build namespaced field_context, without changing the flat data structure used throughout the pipeline.",

  "executive_summary": {
    "problem": "{agent.field} references failed at runtime despite passing validation at config-time because field_context was flat with no agent namespaces",
    "solution": "Thread dependency_configs through DI system and use LLMContextUtils to reconstruct agent namespaces in field_context from flat data",
    "impact": "Enables {agent.field} pattern to work end-to-end. Users can now reference specific agent outputs in prompts.",
    "implementation": "2 phases: (1) Thread configs through 7 files, (2) Build namespaced field_context in DataGenerator",
    "testing": "87 tests passing (75 existing + 12 new). 100% backward compatible.",
    "code_changes": "~228 lines added/modified across 7 files + 1 new test file"
  },

  "current_state": {
    "what_works": {
      "validation_at_config_time": {
        "feature": "InputSignatureValidator from #412",
        "file": "agent_actions/agents/validators/input_signature_validator.py",
        "functionality": [
          "Validates {agent.field} references against dependency output schemas",
          "Uses LLMContextUtils.compute_llm_context() to check field availability",
          "Validates at config load time - catches errors early"
        ],
        "status": "✅ Works perfectly"
      },
      "field_reference_parsing": {
        "feature": "PromptUtils.parse_field_references() from #429",
        "file": "agent_actions/agents/transformers/prompt_utils.py",
        "lines": "219-251",
        "functionality": [
          "Parses {agent.field} patterns from prompts",
          "Returns structured field references",
          "Supports nested fields, array indices"
        ],
        "status": "✅ Works perfectly"
      },
      "field_reference_resolution": {
        "feature": "PromptUtils.replace_field_references() from #429",
        "file": "agent_actions/agents/transformers/prompt_utils.py",
        "lines": "299-339",
        "functionality": [
          "Replaces {agent.field} with actual values",
          "Navigates nested structures",
          "Handles JSON serialization"
        ],
        "status": "✅ Works perfectly"
      }
    },
    "what_is_broken": {
      "runtime_field_context_building": {
        "problem": "field_context doesn't have agent namespaces",
        "file": "agent_actions/agents/generators/data_generator.py",
        "line": 137,
        "current_code": "field_context.update(contents)  # ❌ contents is flat",
        "current_behavior": {
          "contents": "{'bloom_details': '...', 'cluster_id': '...', 'page_content': '...'}",
          "field_context": "{'bloom_details': '...', 'cluster_id': '...', ...}",
          "result": "NO 'create_new_clusters' KEY! {create_new_clusters.bloom_details} fails"
        },
        "needed_behavior": {
          "contents": "{'bloom_details': '...', 'cluster_id': '...'} ← stays flat!",
          "field_context": "{'create_new_clusters': {'bloom_details': '...', 'cluster_id': '...'}}",
          "result": "{create_new_clusters.bloom_details} resolves correctly"
        },
        "why_it_breaks": [
          "Validation passes (checks if bloom_details exists in create_new_clusters output)",
          "Runtime fails (can't find 'create_new_clusters' key in field_context)",
          "User sees: \"Reference 'create_new_clusters' not found. Available: [bloom_details, page_content, ...]\"",
          "User confusion: \"But bloom_details IS from create_new_clusters!\""
        ]
      },
      "missing_dependency_configs": {
        "problem": "DataGenerator doesn't have access to dependency configs",
        "file": "agent_actions/agents/generators/data_generator.py",
        "lines": "21-30",
        "current_signature": "def __init__(self, agent_config: AgentEntryDict, agent_name: str)",
        "needed": "Need dependency_configs to know which fields belong to which agent",
        "why": "To build field_context = {'agent_name': {fields from that agent}}"
      }
    }
  },

  "problem_statement": {
    "user_experience": {
      "workflow_config": "actions:\n  - name: create_new_clusters\n    kind: tool\n    observe: [bloom_details, page_content]\n\n  - name: fact_questionability\n    dependencies: [create_new_clusters]\n    prompt: \"Based on {create_new_clusters.bloom_details}, evaluate...\"",
      "what_happens": [
        "1. ✅ Config validation passes - InputSignatureValidator sees bloom_details in create_new_clusters output",
        "2. ✅ Prompt parsing works - parse_field_references() extracts {create_new_clusters.bloom_details}",
        "3. ❌ Runtime fails - replace_field_references() can't find 'create_new_clusters' in field_context",
        "4. 💥 Error: \"Reference 'create_new_clusters' not found. Available: [bloom_details, page_content, ...]\""
      ],
      "user_confusion": "Why does validation say it's valid but runtime says it's not found?",
      "impact": "Completely blocks {agent.field} pattern from working"
    },
    "technical_root_cause": {
      "data_flow": [
        "Agent 'create_new_clusters' produces: {cluster_id, should_keep_cluster, reasoning, bloom_details, page_content}",
        "Data flows through pipeline as FLAT dict (no agent names attached)",
        "Next agent 'fact_questionability' receives contents = {all fields flat}",
        "DataGenerator._format_prompt() builds field_context by dumping flat contents",
        "field_context = {bloom_details, cluster_id, ...} ← no agent names!",
        "PromptUtils.replace_field_references() looks for field_context['create_new_clusters'] → KeyError"
      ],
      "why_data_is_flat": "By design! Data flows efficiently as flat dicts. Agents just add/transform fields.",
      "the_gap": "We need to RECONSTRUCT agent namespaces for field_context using dependency output signatures"
    }
  },

  "solution_overview": {
    "approach": "Use dependency output signatures to build namespaced field_context without changing data structure",
    "key_insight": "Data stays flat everywhere. We only build agent namespaces in field_context when formatting prompts.",
    "architecture_goals": [
      "✅ No changes to data flow or structure",
      "✅ Enable future agent.input_signature / agent.output_signature API",
      "✅ Clean separation: data (flat) vs field_context (namespaced)",
      "✅ Reuse existing LLMContextUtils.compute_llm_context()"
    ],
    "implementation": [
      "1. Pass dependency_configs to DataGenerator",
      "2. Build namespaced field_context using dependency output signatures",
      "3. Extract fields from flat contents based on each dependency's signature"
    ]
  },

  "implementation_plan": {
    "phase_1_pass_dependency_configs": {
      "priority": "critical",
      "description": "Pass dependency configs to DataGenerator so it knows what each dependency outputs",
      "tasks": [
        {
          "id": "update_data_generator_init",
          "title": "Add dependency_configs parameter to DataGenerator.__init__()",
          "file": "agent_actions/agents/generators/data_generator.py",
          "current_signature": "def __init__(self, agent_config: AgentEntryDict, agent_name: str)",
          "new_signature": "def __init__(self, agent_config: AgentEntryDict, agent_name: str, dependency_configs: Optional[Dict[str, AgentEntryDict]] = None)",
          "implementation": {
            "lines": "21-30",
            "changes": [
              "Add dependency_configs parameter (optional, defaults to {})",
              "Store as self.dependency_configs",
              "Add docstring explaining the parameter"
            ]
          },
          "code": "def __init__(\n    self, \n    agent_config: AgentEntryDict, \n    agent_name: str,\n    dependency_configs: Optional[Dict[str, AgentEntryDict]] = None\n):\n    \"\"\"\n    Initialize the data generator.\n    \n    Args:\n        agent_config: Configuration for the agent\n        agent_name: Name of the agent\n        dependency_configs: Optional dict mapping dependency names to their configs.\n                          Used to build namespaced field_context for {agent.field} references.\n    \"\"\"\n    self.agent_config = agent_config\n    self.agent_name = agent_name\n    self.dependency_configs = dependency_configs or {}",
          "lines_added": 3,
          "lines_modified": 5,
          "backward_compatible": "Yes - optional parameter defaults to {}"
        },
        {
          "id": "update_application_container",
          "title": "Pass dependency_configs when creating DataGenerator",
          "file": "agent_actions/core/runtime/application_container.py",
          "current_location": "Line 95",
          "current_code": "data_generator = DataGenerator(agent_config, agent_name)",
          "new_code": "# Get dependency configs for this agent\ndependency_configs = self._get_dependency_configs_for_agent(agent_config, workflow_config)\ndata_generator = DataGenerator(agent_config, agent_name, dependency_configs)",
          "new_method_needed": {
            "name": "_get_dependency_configs_for_agent",
            "signature": "def _get_dependency_configs_for_agent(self, agent_config: Dict, workflow_config: Any) -> Dict[str, Dict]",
            "logic": [
              "1. Get dependencies from agent_config.get('dependencies', [])",
              "2. For each dependency name, find its config in workflow_config.agents",
              "3. Return dict mapping dependency name to its config"
            ],
            "code": "def _get_dependency_configs_for_agent(\n    self, \n    agent_config: Dict, \n    workflow_config: Any\n) -> Dict[str, Dict]:\n    \"\"\"\n    Get configs for all dependencies of an agent.\n    \n    Args:\n        agent_config: Configuration for the agent\n        workflow_config: Full workflow configuration containing all agent configs\n        \n    Returns:\n        Dict mapping dependency names to their configs\n    \"\"\"\n    dependency_names = agent_config.get('dependencies', [])\n    dependency_configs = {}\n    \n    for dep_name in dependency_names:\n        # Find dependency config in workflow\n        for agent in workflow_config.agents:\n            if agent.get('name') == dep_name:\n                dependency_configs[dep_name] = agent\n                break\n    \n    return dependency_configs",
            "lines_added": 25
          },
          "problem": "ApplicationContainer doesn't have access to workflow_config!",
          "solution": "Need to trace where DataGenerator is created and ensure workflow_config is available"
        },
        {
          "id": "find_datagenerator_creation_points",
          "title": "Find all places DataGenerator is instantiated",
          "action": "Search codebase",
          "expected_locations": [
            "application_container.py (line 95)",
            "Possibly other test files",
            "Need to ensure all have access to dependency configs"
          ],
          "investigation_needed": true
        }
      ],
      "validation_requirements": [
        "✅ DataGenerator can be initialized with dependency_configs",
        "✅ Backward compatible (optional parameter)",
        "✅ All instantiation points updated",
        "✅ No test failures"
      ]
    },

    "phase_2_build_namespaced_field_context": {
      "priority": "critical",
      "description": "Use dependency configs to build field_context with agent namespaces",
      "tasks": [
        {
          "id": "add_build_field_context_method",
          "title": "Add _build_namespaced_field_context() to DataGenerator",
          "file": "agent_actions/agents/generators/data_generator.py",
          "new_method": {
            "name": "_build_namespaced_field_context",
            "signature": "def _build_namespaced_field_context(self, contents: Dict, source_content: Any, loop_context: Optional[Dict], workflow_metadata: Optional[Dict]) -> Dict",
            "purpose": "Build field_context with agent namespaces from flat contents dict",
            "logic": [
              "1. Start with empty field_context",
              "2. Add source content if provided",
              "3. For each dependency:",
              "   a. Get dependency config",
              "   b. Compute dependency's output signature using LLMContextUtils",
              "   c. Extract those fields from flat contents",
              "   d. Add to field_context[dependency_name]",
              "4. Add loop context if provided",
              "5. Add workflow metadata if provided",
              "6. Return field_context"
            ],
            "implementation": "def _build_namespaced_field_context(\n    self,\n    contents: Dict,\n    source_content: Optional[Any] = None,\n    loop_context: Optional[Dict] = None,\n    workflow_metadata: Optional[Dict] = None\n) -> Dict:\n    \"\"\"\n    Build field context with agent namespaces from flat contents.\n    \n    Uses dependency output signatures to reconstruct which fields belong to which agent.\n    Data remains flat in the pipeline; namespacing is only for field_context.\n    \n    Args:\n        contents: Flat dict containing all fields from dependencies\n        source_content: Optional source content for {source.field} references\n        loop_context: Optional loop context for {loop.*} references\n        workflow_metadata: Optional workflow metadata for {workflow.*} references\n        \n    Returns:\n        Namespaced field_context dict for replace_field_references()\n        \n    Example:\n        Input contents (flat):\n            {'bloom_details': '...', 'cluster_id': '...', 'page_content': '...'}\n            \n        Output field_context (namespaced):\n            {\n                'source': {...},\n                'create_new_clusters': {\n                    'bloom_details': '...',\n                    'cluster_id': '...',\n                    'page_content': '...'\n                },\n                'loop': {...},\n                'workflow': {...}\n            }\n    \"\"\"\n    from agent_actions.agents.validators.llm_context_utils import LLMContextUtils\n    \n    field_context = {}\n    \n    # Add source content\n    if source_content:\n        field_context['source'] = source_content\n    \n    # Build namespaced structure from flat contents using dependency signatures\n    dependencies = self.agent_config.get('dependencies', [])\n    \n    for dep_name in dependencies:\n        dep_config = self.dependency_configs.get(dep_name)\n        if not dep_config:\n            # Dependency config not available - skip namespacing for this dependency\n            # This maintains backward compatibility when dependency_configs not provided\n            continue\n        \n        # Compute what fields this dependency outputs\n        # Uses (schema_fields + observe) - drops formula\n        dep_output_fields = LLMContextUtils.compute_llm_context(dep_config)\n        \n        # Extract those fields from flat contents\n        dep_fields = {}\n        for field in dep_output_fields:\n            if field in contents:\n                dep_fields[field] = contents[field]\n        \n        # Add to field_context with agent namespace\n        if dep_fields:\n            field_context[dep_name] = dep_fields\n    \n    # Add special contexts\n    if loop_context:\n        field_context['loop'] = loop_context\n    \n    if workflow_metadata:\n        field_context['workflow'] = workflow_metadata\n    \n    return field_context",
            "lines_added": 70
          }
        },
        {
          "id": "update_format_prompt",
          "title": "Use _build_namespaced_field_context() in _format_prompt()",
          "file": "agent_actions/agents/generators/data_generator.py",
          "current_code": "# Lines 129-146\nfield_context = {}\nif source_content:\n    field_context['source'] = source_content\n\n# Add dependency outputs from contents\nif isinstance(contents, dict):\n    field_context.update(contents)  # ❌ FLAT!\n\n# Add special loop context\nif loop_context:\n    field_context['loop'] = loop_context\n\n# Add workflow metadata\nif workflow_metadata:\n    field_context['workflow'] = workflow_metadata",
          "new_code": "# Build field context with agent namespaces\nfield_context = self._build_namespaced_field_context(\n    contents,\n    source_content,\n    loop_context,\n    workflow_metadata\n)",
          "changes": {
            "lines_removed": 17,
            "lines_added": 6,
            "net_change": -11
          },
          "result": "Much cleaner! All logic moved to dedicated method."
        }
      ],
      "validation_requirements": [
        "✅ field_context has agent namespaces",
        "✅ {agent.field} references resolve correctly",
        "✅ Backward compatible when dependency_configs not provided",
        "✅ LLMContextUtils.compute_llm_context() used correctly",
        "✅ Source, loop, workflow contexts still work"
      ]
    },

