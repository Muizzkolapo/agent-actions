{
  "task_id": "feature_cli_decorator_expansion",
  "title": "CLI Decorator Expansion - Eliminate Boilerplate & Standardize Patterns",
  "type": "feature",
  "priority": "high",
  "status": "planned",
  "created": "2025-10-31",
  "author": "Claude Code",

  "summary": "Expand CLI decorators to eliminate 80+ lines of duplicate error handling boilerplate across all CLI commands. Current state: Only @requires_project exists. Opportunity: Create @handles_user_errors, @validates_args, and helper decorators to standardize patterns and reduce code duplication.",

  "problem_statement": {
    "current_pain_points": [
      "Error handling code duplicated across 8+ CLI command files (39+ occurrences)",
      "Try/except/format_user_error pattern repeated in every command function",
      "Inconsistent error context keys across commands",
      "Command Pattern (Click -> Pydantic -> Command class) requires boilerplate",
      "Difficult to enhance error handling globally (logging, telemetry, etc.)",
      "High maintenance burden when error handling needs to change"
    ],

    "code_smell_examples": {
      "error_handling_duplication": {
        "files_affected": [
          "agent_actions/cli/init.py (lines 87-94, 118-121)",
          "agent_actions/cli/run.py (lines 80-89)",
          "agent_actions/cli/compile.py (similar pattern)",
          "agent_actions/cli/status.py (lines 55-58, 71-74)",
          "agent_actions/cli/list_udfs.py (lines 53-56)",
          "agent_actions/cli/test.py (similar pattern)"
        ],
        "pattern": "try:\n    # logic\nexcept (Error1, Error2) as e:\n    from agent_actions.shared.user_errors import format_user_error\n    error_message = format_user_error(e, context)\n    raise click.ClickException(error_message)\nexcept Exception as e:\n    # same pattern repeated",
        "lines_of_duplication": "~80 lines across all CLI commands"
      },

      "validation_boilerplate": {
        "pattern": "Every command does: Click params -> Pydantic model -> Command class -> execute()",
        "example": "args = RunCommandArgs(agent=agent, ...)\ncommand = RunCommand(args)\ncommand.execute()"
      }
    }
  },

