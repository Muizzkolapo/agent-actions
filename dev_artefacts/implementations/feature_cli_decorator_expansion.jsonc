            "test_handles_user_errors_includes_kwargs_in_context"
          ],
          "test_file": "tests/cli/test_cli_decorators.py",
          "integration_tests": [
            "Run each CLI command and verify error messages still formatted correctly",
            "Test that ValidationError from Pydantic still produces user-friendly output"
          ]
        }
      },

      {
        "name": "@validates_args",
        "priority": "🟡 MEDIUM",
        "impact": "Reduces command functions to pure configuration",
        "effort": "1 hour",
        "location": "agent_actions/cli/cli_decorators.py",
        "status": "OPTIONAL - Review before implementing",

        "purpose": "Automate Pydantic validation + Command Pattern execution",

        "specification": {
          "signature": "def validates_args(args_model: Type[BaseModel], command_class: Type) -> Callable",
          "behavior": [
            "Takes Click kwargs and validates with Pydantic model",
            "Instantiates command_class with validated args",
            "Calls command.execute()",
            "Returns result"
          ],
          "usage": "@validates_args(RunCommandArgs, RunCommand)"
        },

        "implementation": {
          "file": "agent_actions/cli/cli_decorators.py",
          "code": "def validates_args(args_model: Type[BaseModel], command_class: Type):\n    \"\"\"\n    Decorator that validates CLI args with Pydantic and executes command.\n    \n    Automates the Click -> Pydantic -> Command Pattern flow. Eliminates\n    the need to manually instantiate args and command in every CLI function.\n    \n    Args:\n        args_model: Pydantic model class for argument validation\n        command_class: Command class to instantiate and execute\n    \n    Usage:\n        @click.command()\n        @click.option('-a', '--agent', required=True)\n        @validates_args(RunCommandArgs, RunCommand)\n        def run(agent: str, user_code: str):\n            pass  # Decorator handles validation + execution!\n    \n    Note:\n        Command class must have __init__(args: BaseModel) and execute() method.\n    \"\"\"\n    def decorator(func: Callable) -> Callable:\n        @functools.wraps(func)\n        def wrapper(**kwargs):\n            # Validate with Pydantic\n            args = args_model(**kwargs)\n            # Instantiate and execute command\n            command = command_class(args)\n            return command.execute()\n        return wrapper\n    return decorator",

          "dependencies": [
            "functools.wraps",
            "typing.Type",
            "pydantic.BaseModel"
          ],

          "considerations": {
            "pros": [
              "CLI functions become pure configuration (just Click decorators)",
              "Makes Command Pattern more explicit and enforced",
              "Reduces every command to ~3 lines",
              "Impossible to forget validation step"
            ],
            "cons": [
              "May be over-engineering if commands need custom pre/post logic",
              "Hides validation logic (less explicit)",
              "Requires strict adherence to Command Pattern",
              "All command classes must have identical interface"
            ],
            "recommendation": "REVIEW FIRST - Try on 1-2 commands before full rollout"
          }
        },

        "refactoring_plan": {
          "phase_1_pilot": {
            "files": ["agent_actions/cli/status.py", "agent_actions/cli/list_udfs.py"],
            "reason": "Simplest commands - good candidates for pilot"
          },
          "phase_2_evaluate": {
            "decision_criteria": [
              "Does it actually simplify code or just hide complexity?",
              "Are there commands that need custom logic between validation and execution?",
              "Is the Command Pattern interface consistent enough?"
            ]
          },
          "phase_3_rollout": {
            "condition": "Only if pilot successful and team approves",
            "files": ["All remaining CLI commands"]
          }
        },

        "before_after_example": {
          "before": {
            "code": "@click.command()\n@click.option('-a', '--agent', required=True)\n@requires_project\ndef status(agent: str) -> None:\n    try:\n        args = StatusCommandArgs(agent=agent)\n        command = StatusCommand(args)\n        command.execute()\n    except ValidationError as e:\n        from agent_actions.shared.user_errors import format_user_error\n        error_message = format_user_error(e, {'command': 'status'})\n        raise click.ClickException(error_message)",
            "line_count": 11
          },
          "after": {
            "code": "@click.command()\n@click.option('-a', '--agent', required=True)\n@validates_args(StatusCommandArgs, StatusCommand)\n@requires_project\ndef status(agent: str) -> None:\n    pass  # All logic in Command class",
            "line_count": 6,
            "lines_saved": 5,
            "note": "Even simpler if combined with @handles_user_errors"
          }
        }
      },

      {
        "name": "@with_console",
        "priority": "🟢 LOW",
        "impact": "Minor convenience for Rich console usage",
        "effort": "15 minutes",
        "location": "agent_actions/cli/cli_decorators.py",

        "purpose": "Inject Rich Console into commands that need pretty output",

        "specification": {
          "signature": "def with_console(func: Callable) -> Callable",
          "behavior": [
            "Creates Rich Console instance",
            "Injects as 'console' kwarg to decorated function",
            "Allows commands to skip Console() initialization"
          ],
          "usage": "@with_console"
        },

        "implementation": {
          "file": "agent_actions/cli/cli_decorators.py",
          "code": "def with_console(func: Callable) -> Callable:\n    \"\"\"\n    Decorator that injects Rich Console into CLI commands.\n    \n    Eliminates the need for commands to initialize Console themselves.\n    Useful for commands that need pretty tables, colors, etc.\n    \n    Usage:\n        @click.command()\n        @with_console\n        def status(console: Console, agent: str):\n            console.print('[green]Success![/green]')\n    \n    Note:\n        Add 'console: Console' parameter to function signature.\n    \"\"\"\n    @functools.wraps(func)\n    def wrapper(*args, **kwargs):\n        from rich.console import Console\n        kwargs['console'] = Console()\n        return func(*args, **kwargs)\n    return wrapper",

          "usage_example": {
            "before": {
              "code": "class StatusCommand:\n    def __init__(self, args):\n        self.console = Console()\n    \n    def execute(self):\n        self.console.print('Status')"
            },
            "after": {
              "code": "@with_console\ndef status(console: Console, agent: str):\n    console.print('Status')\n    # Or pass to Command class if needed"
            }
          },

          "notes": "Only 2 commands currently use Rich (status, list-udfs). Low ROI unless more commands adopt Rich."
        }
      },

      {
        "name": "@timed_execution",
        "priority": "🟢 LOW",
        "impact": "Nice UX improvement for long-running commands",
        "effort": "15 minutes",
        "location": "agent_actions/cli/cli_decorators.py",

        "purpose": "Display execution time for long-running commands",

        "specification": {
          "signature": "def timed_execution(threshold: float = 1.0) -> Callable",
          "behavior": [
            "Records start time before command execution",
            "Records end time after command completes",
            "Prints elapsed time if > threshold (default 1 second)",
            "Always runs in finally block (even on error)"
          ],
          "usage": "@timed_execution(threshold=2.0)"
        },

        "implementation": {
          "file": "agent_actions/cli/cli_decorators.py",
          "code": "def timed_execution(threshold: float = 1.0):\n    \"\"\"\n    Decorator that displays execution time for long-running commands.\n    \n    Args:\n        threshold: Only display if execution time exceeds this (seconds)\n    \n    Usage:\n        @click.command()\n        @timed_execution(threshold=2.0)\n        def run(agent: str):\n            # Long-running workflow\n            pass\n    \n    Output:\n        ⏱️  Completed in 45.23s\n    \"\"\"\n    def decorator(func: Callable) -> Callable:\n        @functools.wraps(func)\n        def wrapper(*args, **kwargs):\n            import time\n            start = time.time()\n            try:\n                return func(*args, **kwargs)\n            finally:\n                elapsed = time.time() - start\n                if elapsed > threshold:\n                    click.echo(f'\\n⏱️  Completed in {elapsed:.2f}s')\n        return wrapper\n    return decorator",

          "recommended_usage": {
            "commands": ["run", "compile", "batch"],
            "reason": "These are long-running commands where timing is useful"
          }
        }
      }
    ],

    "decorator_stacking_order": {
      "description": "When multiple decorators are used, apply in this order (top to bottom):",
      "order": [
        "@click.command()  # Click's decorator - always first",
        "@click.option(...)  # Click's options",
        "@timed_execution  # Outermost - measures total time including all other decorators",
        "@handles_user_errors  # Catches all exceptions before they bubble up",
        "@validates_args  # Validates input and dispatches to Command class",
        "@with_console  # Injects resources",
        "@requires_project  # Innermost - modifies execution environment (chdir)"
      ],
      "example": "@click.command()\n@click.option('-a', '--agent', required=True)\n@timed_execution\n@handles_user_errors('run')\n@validates_args(RunCommandArgs, RunCommand)\n@requires_project\ndef run(agent: str, console: Console):\n    pass",
      "rationale": {
        "@timed_execution outermost": "Measures total time including error handling",
        "@handles_user_errors before @validates_args": "Catches validation errors too",
        "@requires_project innermost": "Modifies filesystem state, should be last"
      }
    }
  },

