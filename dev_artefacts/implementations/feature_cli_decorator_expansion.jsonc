  "proposed_solution": {
    "overview": "Create 4 new decorators to eliminate boilerplate and standardize CLI patterns",

    "decorators": [
      {
        "name": "@handles_user_errors",
        "priority": "🔥 HIGH",
        "impact": "Eliminates 80+ lines of boilerplate",
        "effort": "30 minutes",
        "location": "agent_actions/cli/cli_decorators.py",

        "purpose": "Standardize error handling for all CLI commands",

        "specification": {
          "signature": "def handles_user_errors(command_name: str, **extra_context) -> Callable",
          "behavior": [
            "Catches all exceptions (except ClickException - don't double-wrap)",
            "Formats errors using format_user_error() with command context",
            "Raises click.ClickException with user-friendly message",
            "Merges command name, extra context, and kwargs into error context"
          ],
          "usage": "@handles_user_errors('run', extra_key='value')"
        },

        "implementation": {
          "file": "agent_actions/cli/cli_decorators.py",
          "code": "def handles_user_errors(command_name: str, **extra_context):\n    \"\"\"\n    Decorator that standardizes error handling for CLI commands.\n    \n    Catches all exceptions, formats them user-friendly via format_user_error(),\n    and raises ClickException. Eliminates try/except boilerplate in commands.\n    \n    Args:\n        command_name: Name of the command for error context\n        **extra_context: Additional context keys to include in error messages\n    \n    Usage:\n        @click.command()\n        @handles_user_errors('run')\n        def run(agent: str):\n            # No try/except needed - just write happy path!\n            command = RunCommand(agent)\n            command.execute()\n    \n    Raises:\n        click.ClickException: All exceptions are caught and re-raised as ClickException\n    \"\"\"\n    def decorator(func: Callable) -> Callable:\n        @functools.wraps(func)\n        def wrapper(*args, **kwargs):\n            try:\n                return func(*args, **kwargs)\n            except click.ClickException:\n                # Don't double-wrap ClickExceptions\n                raise\n            except Exception as e:\n                from agent_actions.shared.user_errors import format_user_error\n                # Merge command context with extra context and kwargs\n                context = {\n                    'command': command_name,\n                    **extra_context,\n                    **kwargs  # Include all CLI arguments in context\n                }\n                error_message = format_user_error(e, context)\n                raise click.ClickException(error_message)\n        return wrapper\n    return decorator",

          "dependencies": [
            "functools.wraps",
            "click.ClickException",
            "agent_actions.shared.user_errors.format_user_error"
          ],

          "type_hints": {
            "command_name": "str",
            "extra_context": "Any",
            "return": "Callable[[Callable], Callable]"
          }
        },

        "refactoring_plan": {
          "files_to_update": [
            "agent_actions/cli/init.py",
            "agent_actions/cli/run.py",
            "agent_actions/cli/compile.py",
            "agent_actions/cli/status.py",
            "agent_actions/cli/list_udfs.py",
            "agent_actions/cli/test.py",
            "agent_actions/validation/validate_udfs.py"
          ],

          "before_after_examples": {
            "init.py": {
              "before": {
                "lines": "101-121",
                "code": "def init(project_name: str, output_dir: Optional[str]=None, template: str='default', force: bool=False) -> None:\n    try:\n        args = InitCommandArgs(project_name=project_name, output_dir=output_dir, template=template, force=force)\n        command = InitCommand(args)\n        command.execute()\n    except PydanticValidationError as e:\n        from agent_actions.shared.user_errors import format_user_error\n        error_message = format_user_error(e, {'command': 'init'})\n        raise click.ClickException(error_message)",
                "line_count": 14
              },
              "after": {
                "code": "@handles_user_errors('init')\ndef init(project_name: str, output_dir: Optional[str]=None, template: str='default', force: bool=False) -> None:\n    args = InitCommandArgs(project_name=project_name, output_dir=output_dir, template=template, force=force)\n    command = InitCommand(args)\n    command.execute()",
                "line_count": 5,
                "lines_saved": 9
              }
            },

            "run.py": {
              "before": {
                "lines": "80-89",
                "code": "except (ValidationError, FileLoadError, ConfigurationError, AgentExecutionError) as e:\n    from agent_actions.shared.user_errors import format_user_error\n    context = {'agent': self.args.agent, 'command': 'run', 'error_type': type(e).__name__}\n    error_message = format_user_error(e, context)\n    raise click.ClickException(error_message)\nexcept Exception as e:\n    from agent_actions.shared.user_errors import format_user_error\n    context = {'agent': self.args.agent, 'command': 'run'}\n    error_message = format_user_error(e, context)\n    raise click.ClickException(error_message)",
                "line_count": 10
              },
              "after": {
                "code": "# Decorator handles all error formatting - just execute!\n# (Error context automatically includes 'agent' kwarg)",
                "line_count": 0,
                "lines_saved": 10,
                "note": "Move @handles_user_errors('run') to function definition line 100"
              }
            }
          },

          "total_impact": {
            "lines_removed": "~80 lines of boilerplate",
            "files_simplified": 7,
            "maintenance_burden_reduction": "90% - error handling now centralized"
          }
        },

        "testing_requirements": {
          "unit_tests": [
            "test_handles_user_errors_catches_exceptions",
