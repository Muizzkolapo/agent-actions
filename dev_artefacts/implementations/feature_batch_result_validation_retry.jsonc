        "needed": "Specific missing custom_ids, expected vs received counts, retry_batch_id"
      },
      "audit_artifacts": {
        "problem": "No audit trail for retry attempts or permanently failed records",
        "needed": [
          "Retry Manifest: Complete audit trail of all retry attempts (JSON)",
          "DLQ File: Dead Letter Queue for permanently failed records (JSONL)"
        ],
        "use_cases": [
          "Compliance (SOC2, ISO 27001) - full audit trail of data processing",
          "Debugging - see exactly what failed and when",
          "Monitoring - track retry patterns and success rates",
          "Recovery - manually reprocess DLQ records"
        ]
      }
    }
  },

  "problem_statement": {
    "user_experience": {
      "scenario_1_silent_data_loss": {
        "workflow": [
          "1. User submits 1000 customer records to batch API",
          "2. Provider processes 995 successfully, 5 fail (rate limit, malformed, etc.)",
          "3. Batch status='completed' (from provider's perspective)",
          "4. System retrieves 995 results",
          "5. ✅ Workflow continues - no errors raised",
          "6. ❌ 5 customer records missing from output",
          "7. User discovers missing records weeks later during audit",
          "8. No way to know which records are missing or why"
        ],
        "user_impact": "Data corruption, compliance failures, loss of trust"
      },
      "scenario_2_with_automatic_retry": {
        "workflow": [
          "1. User submits 1000 customer records to batch API",
          "2. Provider processes 995 successfully, 5 fail",
          "3. Batch status='completed'",
          "4. ✅ System detects 5 missing records (1000 sent - 995 received = 5 missing)",
          "5. ✅ System logs: 'Missing 5 records: rec_23, rec_45, rec_67, rec_89, rec_91'",
          "6. ✅ System automatically resubmits 5 missing records as NEW batch",
          "7. ✅ Tracks retry batch: batch_customers_retry_1",
          "8. ✅ When retry batch completes, merges 995 + 5 = 1000 complete results",
          "9. ✅ User gets all 1000 records with zero manual intervention"
        ],
        "user_impact": "Zero data loss, automatic recovery, no manual work"
      },
      "scenario_3_recursive_retry": {
        "description": "Retry batch also has failures",
        "workflow": [
          "1. Original batch: 100 records → 98 succeed, 2 missing",
          "2. Retry batch 1: Submit 2 records → 1 succeeds, 1 missing (retry_attempt=1)",
          "3. Retry batch 2: Submit 1 record → succeeds (retry_attempt=2)",
          "4. Final result: Merge 98 + 1 + 1 = 100 complete records"
        ],
        "user_impact": "Handles cascading failures gracefully"
      }
    },
    "technical_root_cause": {
      "batch_apis_process_all_records_together": [
        "Batch APIs process all submitted records in parallel",
        "Some records succeed, some fail (rate limits, malformed data, internal errors)",
        "Provider reports counts: '237 completed, 4 failed of 241 total requests'",
        "output.jsonl has only the 237 successful results",
        "error.jsonl may have error info but custom_ids might be malformed/missing",
        "Provider says 'completed' even though 4 records failed"
      ],
      "no_validation_layer": [
        "System trusts batch provider to return complete results",
        "No comparison of submitted count vs retrieved count",
        "No tracking of which custom_ids were submitted",
        "Missing results treated same as complete results"
      ],
      "no_failure_recovery": [
        "When records fail processing, they're lost forever",
        "No mechanism to resubmit failed records",
        "No tracking of which records failed",
        "User must manually identify and resubmit"
      ]
    }
  },

  "solution_overview": {
    "approach": "Detect missing records by comparing sent vs received custom_ids, then automatically resubmit as NEW batch (Dead Letter Queue pattern)",
    "key_principles": [
      "✅ Validate completeness: Compare expected custom_ids against received custom_ids",
      "✅ Automatic retry: Resubmit ONLY missing records as NEW batch",
      "✅ Track relationships: Link retry batches to parent batches",
      "✅ Merge results: Combine original + retry results by custom_id",
      "✅ Recursive retry: Handle retry-of-retry scenarios (up to max depth)",
      "✅ User configurable: Allow users to set max retry depth",
      "✅ Fail loudly: Raise ProcessingError with specific missing IDs if all retries exhausted",
      "✅ Early detection: Validate at retrieval time, not during processing",
      "✅ Detailed context: Include batch_id, expected/received counts, missing IDs, retry_batch_id in errors"
    ],
    "architecture_goals": [
      "✅ Apply consistently across ALL batch retrieval points",
      "✅ Configurable retry depth (max retries per record)",
      "✅ Backward compatible for batches without expected counts",
      "✅ Minimal performance impact (only during retrieval)",
      "✅ Clear logging for transparency",
      "✅ Registry tracks parent-child relationships",
      "✅ Result merging handles duplicates gracefully"
    ],
    "components": [
      "1. Helper methods to collect expected vs received custom_ids",
      "2. Validation and reconciliation logging",
      "3. Record-level retry with batch resubmission (DLQ pattern)",
      "4. Record count tracking in batch registry",
      "5. Parent-child batch tracking in registry",
      "6. Result merging logic across parent and child batches",
      "7. ProcessingError with detailed context for failures",
      "8. User configuration for max retry depth",
      "9. Retry Manifest for complete audit trail (JSON)",
      "10. DLQ File for permanently failed records (JSONL)"
    ],
    "industry_inspiration": {
      "apache_beam_dataflow": {
        "pattern": "Dead Letter Queue (DLQ) for failed records",
        "approach": "Write failed records to separate output, process later",
        "our_adaptation": "Instead of DLQ file, we resubmit as new batch automatically"
      },
      "aws_sqs": {
        "pattern": "Dead Letter Queue for failed messages",
        "approach": "Messages that fail after N retries go to DLQ for manual review",
        "our_adaptation": "Automatic retry with batch resubmission instead of manual"
      },
      "kafka": {
        "pattern": "Retry topics for failed messages",
        "approach": "Failed messages sent to retry topic, processed separately",
        "our_adaptation": "Retry batches are like retry topics"
      }
    }
  },

