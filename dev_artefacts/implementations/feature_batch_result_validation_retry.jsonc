          "missing_custom_ids": ["rec_23", "rec_45", "rec_67", "rec_89", "rec_91"],
          "missing_count": 5,
          "retry_batch_id": "batch_customers_retry_1",
          "retry_file_name": "customers_retry_1",
          "retry_status": "submitted",
          "next_steps": [
            "1. Poll retry batch status: check_batch_status('batch_customers_retry_1')",
            "2. When complete, retrieve: get_batch_results('batch_customers_retry_1')",
            "3. Merge results using merge helper"
          ]
