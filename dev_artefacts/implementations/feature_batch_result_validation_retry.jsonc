      "tasks": [
        {
          "id": "add_collect_retry_batches",
          "title": "Add _collect_retry_batches() helper method",
          "file": "agent_actions/tasks/services/batch_service.py",
          "purpose": "Find all retry batches for a given parent batch",
          "signature": "def _collect_retry_batches(self, parent_batch_id: str, output_directory: str) -> List[Dict[str, Any]]",
          "returns": "List of registry entries for retry batches, sorted by retry_attempt",
          "logic": [
            "1. Load batch registry",
            "2. Filter entries where parent_batch_id matches",
            "3. Sort by retry_attempt ascending",
            "4. Return list of retry batch entries"
          ],
          "implementation": "def _collect_retry_batches(\n    self,\n    parent_batch_id: str,\n    output_directory: str,\n) -> List[Dict[str, Any]]:\n    \"\"\"\n    Collect all retry batches for a given parent batch.\n    \n    Args:\n        parent_batch_id: Parent batch ID\n        output_directory: Output directory\n        \n    Returns:\n        List of retry batch registry entries, sorted by retry_attempt\n    \"\"\"\n    from pathlib import Path\n    import json\n    \n    batch_dir = Path(output_directory) / \"batch\"\n    registry_file = batch_dir / \".batch_registry.json\"\n    \n    if not registry_file.exists():\n        return []\n    \n    try:\n        with open(registry_file, 'r') as f:\n            registry = json.load(f)\n        \n        retry_batches = []\n        for file_name, entry in registry.items():\n            if entry.get(\"parent_batch_id\") == parent_batch_id:\n                entry[\"file_name\"] = file_name\n                retry_batches.append(entry)\n        \n        retry_batches.sort(key=lambda x: x.get(\"retry_attempt\", 0))\n        return retry_batches\n        \n    except Exception as e:\n        print(f\"[WARN] Failed to collect retry batches: {e}\")\n        return []",
          "lines_added": 45
        },
        {
          "id": "add_merge_batch_results",
          "title": "Add _merge_batch_results() method",
          "file": "agent_actions/tasks/services/batch_service.py",
          "purpose": "Merge results from parent and retry batches by custom_id",
          "signature": "def _merge_batch_results(self, parent_results: List[BatchResult], retry_results_list: List[List[BatchResult]]) -> List[BatchResult]",
          "returns": "List[BatchResult] - Merged results with no duplicates",
          "logic": [
            "1. Create merged_dict: Dict[str, BatchResult] keyed by custom_id",
            "2. Add all parent_results to merged_dict",
            "3. For each retry_results batch:",
            "   a. For each result in retry_results:",
            "      - Add to merged_dict (fills missing from parent)",
            "      - If duplicate, prefer retry result (fresher)",
            "4. Return list(merged_dict.values())",
            "5. Log merge stats: parent count, retry count, final count"
          ],
          "implementation": "def _merge_batch_results(\n    self,\n    parent_results: List[BatchResult],\n    retry_results_list: List[List[BatchResult]],\n) -> List[BatchResult]:\n    \"\"\"\n    Merge results from parent batch and retry batches.\n    \n    Combines results by custom_id. If a custom_id appears in multiple\n    batches (parent + retries), the latest result (from retry) is used.\n    \n    Args:\n        parent_results: Results from parent batch\n        retry_results_list: List of results from each retry batch\n        \n    Returns:\n        Merged list of BatchResult objects with no duplicates\n    \"\"\"\n    from agent_actions.integrations.providers.base import BatchResult\n    \n    merged_dict: Dict[str, BatchResult] = {}\n    \n    # Add parent results\n    for result in parent_results:\n        custom_id = str(getattr(result, \"custom_id\", None))\n        if custom_id and custom_id != \"None\":\n            merged_dict[custom_id] = result\n    \n    # Add retry results (overwrites if duplicate - prefer fresher result)\n    for retry_results in retry_results_list:\n        for result in retry_results:\n            custom_id = str(getattr(result, \"custom_id\", None))\n            if custom_id and custom_id != \"None\":\n                merged_dict[custom_id] = result\n    \n    parent_count = len(parent_results)\n    retry_count = sum(len(r) for r in retry_results_list)\n    final_count = len(merged_dict)\n    \n    print(\n        f\"[MERGE] Merged results: parent={parent_count}, \"\n        f\"retries={retry_count}, final={final_count}\"\n    )\n    \n    return list(merged_dict.values())",
          "lines_added": 50
        }
      ],
