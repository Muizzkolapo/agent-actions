    "phase_3_record_retry": {
      "status": "✅ COMPLETED",
      "priority": "critical",
      "description": "Record-level retry with batch resubmission (DLQ pattern)",
      "tasks": [
        {
          "id": "add_retry_constants",
          "title": "Add retry configuration constants",
          "file": "agent_actions/tasks/services/batch_service.py",
          "location": "BatchService class-level constants",
          "implementation": "class BatchService:\n    # Record-level retry with batch resubmission\n    _MAX_RETRY_DEPTH = 2  # Max recursive retry depth (3 total attempts per record)",
          "rationale": "Max depth controls how many times we resubmit missing records as new batches",
          "lines_added": 2
        },
        {
          "id": "add_reconstruct_tasks_for_retry",
          "title": "Add _reconstruct_tasks_for_retry() helper method",
          "file": "agent_actions/tasks/services/batch_service.py",
          "purpose": "Reconstruct batch tasks from context_map for missing records",
          "signature": "def _reconstruct_tasks_for_retry(self, missing_custom_ids: Set[str], context_map: Dict[str, Any], agent_config: Dict[str, Any]) -> List[Dict[str, Any]]",
          "logic": [
            "1. Iterate over missing_custom_ids",
            "2. For each ID, look up original_row in context_map",
            "3. If not found, log warning and skip",
            "4. Extract content from original_row",
            "5. Reconstruct task in same format as original batch submission",
            "6. Return list of reconstructed tasks"
          ],
          "implementation": "def _reconstruct_tasks_for_retry(\n    self,\n    missing_custom_ids: Set[str],\n    context_map: Dict[str, Any],\n    agent_config: Dict[str, Any],\n) -> List[Dict[str, Any]]:\n    \"\"\"\n    Reconstruct batch tasks from context map for missing records.\n    \n    Uses the full original row data stored in context_map to recreate\n    the exact same tasks that were in the original batch submission.\n    \n    Args:\n        missing_custom_ids: Set of custom_ids that need to be retried\n        context_map: Context map with original row data\n        agent_config: Agent configuration (for task formatting)\n        \n    Returns:\n        List of task dictionaries ready for batch submission\n    \"\"\"\n    reconstructed_tasks = []\n    \n    for custom_id in sorted(missing_custom_ids):  # Sort for deterministic order\n        original_row = context_map.get(custom_id)\n        \n        if not original_row:\n            print(f\"[WARN] Cannot reconstruct task for {custom_id}: not found in context_map\")\n            continue\n        \n        # Extract the content that was originally submitted\n        content = original_row.get(\"content\")\n        if not content:\n            print(f\"[WARN] Cannot reconstruct task for {custom_id}: no content in original_row\")\n            continue\n        \n        # Reconstruct task in same format as original\n        reconstructed_task = {\n            \"target_id\": custom_id,\n            \"content\": content,\n            \"source_guid\": original_row.get(\"source_guid\"),\n        }\n        \n        reconstructed_tasks.append(reconstructed_task)\n    \n    return reconstructed_tasks",
          "lines_added": 50
        },
        {
          "id": "add_resubmit_missing_records",
          "title": "Add _resubmit_missing_records_as_batch() method",
          "file": "agent_actions/tasks/services/batch_service.py",
          "purpose": "Resubmit missing records as new batch with parent tracking",
          "signature": "def _resubmit_missing_records_as_batch(self, missing_custom_ids: Set[str], parent_batch_id: str, parent_file_name: str, context_map: Dict[str, Any], agent_config: Dict[str, Any], output_directory: str, provider: BatchProvider, retry_attempt: int, expected_count: int, received_count: int) -> Optional[str]",
          "returns": "Optional[str] - New batch_id for retry batch, or None if failed",
          "logic": [
            "1. Check retry_attempt <= _MAX_RETRY_DEPTH",
            "   - If exceeds: Call _append_to_dlq() for permanently failed records, return None",
            "2. Create retry manifest on first detection: _create_retry_manifest()",
            "3. Reconstruct tasks using _reconstruct_tasks_for_retry()",
            "4. If no tasks reconstructed, return None",
            "5. Generate retry batch name: f\"{parent_file_name}_retry_{retry_attempt}\"",
            "6. Submit retry batch using provider.submit_batch()",
            "7. Save retry batch to registry with parent tracking",
            "8. Mark parent batch with has_retry=True, missing_records",
            "9. Update retry manifest: _update_retry_manifest(status='submitted')",
            "10. Print confirmation with retry batch_id",
            "11. Return retry_batch_id"
          ],
          "implementation": "def _resubmit_missing_records_as_batch(\n    self,\n    missing_custom_ids: Set[str],\n    parent_batch_id: str,\n    parent_file_name: str,\n    context_map: Dict[str, Any],\n    agent_config: Dict[str, Any],\n    output_directory: str,\n    provider: BatchProvider,\n    retry_attempt: int,\n    expected_count: int,\n    received_count: int,\n) -> Optional[str]:\n    \"\"\"\n    Resubmit missing records as a new batch with parent tracking and audit artifacts.\n    \n    Implements Dead Letter Queue (DLQ) pattern by creating a new batch\n    containing ONLY the missing records. Creates/updates audit artifacts\n    (retry manifest and DLQ file) for compliance and debugging.\n    \n    Args:\n        missing_custom_ids: Set of custom_ids that are missing\n        parent_batch_id: Original batch ID\n        parent_file_name: Original batch file name (for naming retry batch)\n        context_map: Context map with original data\n        agent_config: Agent configuration\n        output_directory: Output directory\n        provider: Batch provider\n        retry_attempt: Current retry attempt number (1-indexed)\n        expected_count: Total records submitted in parent batch\n        received_count: Total records received in parent batch\n        \n    Returns:\n        New batch_id for retry batch, or None if retry failed/not possible\n    \"\"\"\n    # Check retry depth\n    if retry_attempt > self._MAX_RETRY_DEPTH:\n        print(\n            f\"[MAX DEPTH] Cannot retry: retry_attempt={retry_attempt} \"\n            f\"exceeds max depth {self._MAX_RETRY_DEPTH}\"\n        )\n        \n        # Append to DLQ for permanently failed records\n        self._append_to_dlq(\n            parent_file_name,\n            output_directory,\n            missing_custom_ids,\n            context_map,\n            retry_attempt,\n            f\"Max retry depth exceeded ({self._MAX_RETRY_DEPTH})\",\n        )\n        \n        return None\n    \n    print(\n        f\"[RETRY START] Resubmitting {len(missing_custom_ids)} missing record(s) \"\n        f\"as new batch (retry_attempt={retry_attempt}/{self._MAX_RETRY_DEPTH})\"\n    )\n    \n    # Reconstruct tasks\n    retry_tasks_data = self._reconstruct_tasks_for_retry(\n        missing_custom_ids, context_map, agent_config\n    )\n    \n    if not retry_tasks_data:\n        print(\"[RETRY ERROR] No tasks could be reconstructed for retry\")\n        return None\n    \n    print(f\"[RETRY] Reconstructed {len(retry_tasks_data)} task(s) from context map\")\n    \n    # Create retry manifest on first detection (retry_attempt == 1)\n    if retry_attempt == 1:\n        self._create_retry_manifest(\n            parent_batch_id,\n            parent_file_name,\n            output_directory,\n            expected_count,\n            received_count,\n            missing_custom_ids,\n            context_map,\n        )\n    \n    # Prepare retry batch name\n    retry_file_name = f\"{parent_file_name}_retry_{retry_attempt}\"\n    \n    # Submit retry batch\n    try:\n        retry_tasks = provider.prepare_tasks(retry_tasks_data, agent_config)\n        retry_batch_id = provider.submit_batch(\n            retry_tasks,\n            retry_file_name,\n            output_directory,\n        )\n        \n        print(f\"[RETRY SUBMITTED] Retry batch submitted: {retry_batch_id}\")\n        \n        # Save retry batch to registry with parent tracking\n        self._save_batch_job_id(\n            retry_batch_id,\n            output_directory,\n            retry_file_name,\n            provider_type=type(provider).__name__.replace('Provider', '').lower(),\n            record_count=len(retry_tasks),\n            parent_batch_id=parent_batch_id,\n            retry_attempt=retry_attempt,\n            retry_for_records=sorted(missing_custom_ids),\n        )\n        \n        # Mark parent batch as having retry\n        self._mark_parent_batch_has_retry(\n            parent_file_name,\n            output_directory,\n            missing_records=sorted(missing_custom_ids),\n        )\n        \n        # Update retry manifest after submission\n        self._update_retry_manifest(\n            parent_file_name,\n            output_directory,\n            retry_batch_id,\n            retry_attempt,\n            missing_custom_ids,\n            status='submitted',\n        )\n        \n        return retry_batch_id\n        \n    except Exception as e:\n        print(f\"[RETRY ERROR] Failed to submit retry batch: {e}\")\n        return None",
          "lines_added": 100
        },
        {
          "id": "add_mark_parent_batch_has_retry",
          "title": "Add _mark_parent_batch_has_retry() helper method",
          "file": "agent_actions/tasks/services/batch_service.py",
          "purpose": "Update parent batch registry entry to indicate it has retry batches",
          "signature": "def _mark_parent_batch_has_retry(self, parent_file_name: str, output_directory: str, missing_records: List[str]) -> None",
          "logic": [
            "1. Load batch registry",
            "2. Find parent batch entry by file_name",
            "3. Update entry: has_retry=True, missing_records=list",
            "4. Save registry"
          ],
          "implementation": "def _mark_parent_batch_has_retry(\n    self,\n    parent_file_name: str,\n    output_directory: str,\n    missing_records: List[str],\n) -> None:\n    \"\"\"\n    Mark parent batch in registry as having retry batches.\n    \n    Args:\n        parent_file_name: Parent batch file name\n        output_directory: Output directory\n        missing_records: List of missing custom_ids\n    \"\"\"\n    from pathlib import Path\n    import json\n    \n    batch_dir = Path(output_directory) / \"batch\"\n    registry_file = batch_dir / \".batch_registry.json\"\n    \n    if not registry_file.exists():\n        return\n    \n    try:\n        with open(registry_file, 'r') as f:\n            registry = json.load(f)\n        \n        if parent_file_name in registry:\n            registry[parent_file_name][\"has_retry\"] = True\n            registry[parent_file_name][\"missing_records\"] = missing_records\n            \n            with open(registry_file, 'w') as f:\n                json.dump(registry, f, indent=2)\n    except Exception as e:\n        print(f\"[WARN] Failed to mark parent batch as having retry: {e}\")",
          "lines_added": 35
        },
        {
          "id": "add_create_retry_manifest",
          "title": "Add _create_retry_manifest() method for audit trail",
          "file": "agent_actions/tasks/services/batch_service.py",
          "purpose": "Create initial retry manifest file when first missing records detected",
          "signature": "def _create_retry_manifest(self, parent_batch_id: str, parent_file_name: str, output_directory: str, submitted_count: int, received_count: int, missing_custom_ids: Set[str], context_map: Dict[str, Any]) -> None",
          "logic": [
            "1. Build manifest structure with parent_batch info",
            "2. Add missing_records list with initial detection info",
            "3. Add retry_summary placeholder",
            "4. Write to {parent_file_name}_retry_manifest.json",
            "5. Handle file already exists gracefully (load and update)"
          ],
          "structure": {
            "parent_batch": {
              "batch_id": "batch_abc123",
              "file_name": "customers.json",
              "submitted_at": "ISO timestamp",
              "submitted_count": 1000,
              "received_count": 995,
              "missing_count": 5
            },
            "missing_records": [
              {
                "custom_id": "rec_23",
                "source_guid": "guid_123",
                "first_detected": "ISO timestamp",
                "retry_history": [],
                "final_status": "pending",
                "recovered_at": null
              }
            ],
            "retry_summary": {
              "total_retries": 0,
              "total_records_retried": 5,
              "recovered_count": 0,
              "permanently_failed_count": 0,
              "retry_batches": []
            }
          },
          "implementation": "def _create_retry_manifest(\n    self,\n    parent_batch_id: str,\n    parent_file_name: str,\n    output_directory: str,\n    submitted_count: int,\n    received_count: int,\n    missing_custom_ids: Set[str],\n    context_map: Dict[str, Any],\n) -> None:\n    \"\"\"\n    Create or update retry manifest file for audit trail.\n    \n    Creates a comprehensive JSON file tracking all retry attempts\n    for compliance, debugging, and monitoring.\n    \n    Args:\n        parent_batch_id: Parent batch ID\n        parent_file_name: Parent batch file name\n        output_directory: Output directory\n        submitted_count: Number of records submitted\n        received_count: Number of results received\n        missing_custom_ids: Set of missing custom_ids\n        context_map: Context map for extracting source_guid\n    \"\"\"\n    from pathlib import Path\n    import json\n    from datetime import datetime\n    \n    batch_dir = Path(output_directory) / \"batch\"\n    manifest_file = batch_dir / f\"{parent_file_name}_retry_manifest.json\"\n    \n    # Load existing manifest if present\n    if manifest_file.exists():\n        try:\n            with open(manifest_file, 'r') as f:\n                manifest = json.load(f)\n        except Exception:\n            manifest = None\n    else:\n        manifest = None\n    \n    # Create new manifest if doesn't exist\n    if not manifest:\n        manifest = {\n            \"parent_batch\": {\n                \"batch_id\": parent_batch_id,\n                \"file_name\": parent_file_name,\n                \"submitted_at\": datetime.now().isoformat(),\n                \"submitted_count\": submitted_count,\n                \"received_count\": received_count,\n                \"missing_count\": len(missing_custom_ids),\n            },\n            \"missing_records\": [],\n            \"retry_summary\": {\n                \"total_retries\": 0,\n                \"total_records_retried\": len(missing_custom_ids),\n                \"recovered_count\": 0,\n                \"permanently_failed_count\": 0,\n                \"retry_batches\": [],\n            },\n        }\n        \n        # Add missing records with metadata\n        for custom_id in sorted(missing_custom_ids):\n            original_row = context_map.get(custom_id, {})\n            source_guid = original_row.get(\"source_guid\")\n            \n            manifest[\"missing_records\"].append({\n                \"custom_id\": custom_id,\n                \"source_guid\": source_guid,\n                \"first_detected\": datetime.now().isoformat(),\n                \"retry_history\": [],\n                \"final_status\": \"pending\",\n                \"recovered_at\": None,\n            })\n    \n    # Write manifest\n    try:\n        with open(manifest_file, 'w') as f:\n            json.dump(manifest, f, indent=2)\n        print(f\"[MANIFEST] Created retry manifest: {manifest_file.name}\")\n    except Exception as e:\n        print(f\"[WARN] Failed to create retry manifest: {e}\")",
          "lines_added": 80
        },
        {
          "id": "add_update_retry_manifest",
          "title": "Add _update_retry_manifest() method to track retry attempts",
          "file": "agent_actions/tasks/services/batch_service.py",
          "purpose": "Update retry manifest when retry batch submitted or completed",
          "signature": "def _update_retry_manifest(self, parent_file_name: str, output_directory: str, retry_batch_id: str, retry_attempt: int, missing_custom_ids: Set[str], status: str = 'submitted') -> None",
          "logic": [
            "1. Load existing retry manifest",
            "2. Update retry_summary.total_retries",
            "3. Add retry batch info to retry_summary.retry_batches",
            "4. For each missing_custom_id, update retry_history",
            "5. If status='completed', update final_status and recovered_at",
            "6. Write updated manifest"
          ],
          "implementation": "def _update_retry_manifest(\n    self,\n    parent_file_name: str,\n    output_directory: str,\n    retry_batch_id: str,\n    retry_attempt: int,\n    missing_custom_ids: Set[str],\n    status: str = 'submitted',\n) -> None:\n    \"\"\"\n    Update retry manifest with retry batch info.\n    \n    Args:\n        parent_file_name: Parent batch file name\n        output_directory: Output directory\n        retry_batch_id: Retry batch ID\n        retry_attempt: Retry attempt number\n        missing_custom_ids: Set of custom_ids being retried\n        status: 'submitted' or 'completed'\n    \"\"\"\n    from pathlib import Path\n    import json\n    from datetime import datetime\n    \n    batch_dir = Path(output_directory) / \"batch\"\n    manifest_file = batch_dir / f\"{parent_file_name}_retry_manifest.json\"\n    \n    if not manifest_file.exists():\n        return\n    \n    try:\n        with open(manifest_file, 'r') as f:\n            manifest = json.load(f)\n        \n        # Update retry summary\n        if status == 'submitted':\n            manifest[\"retry_summary\"][\"total_retries\"] += 1\n            manifest[\"retry_summary\"][\"retry_batches\"].append({\n                \"retry_batch_id\": retry_batch_id,\n                \"retry_attempt\": retry_attempt,\n                \"submitted_at\": datetime.now().isoformat(),\n                \"record_count\": len(missing_custom_ids),\n                \"status\": \"submitted\",\n            })\n        \n        # Update missing records\n        for record in manifest.get(\"missing_records\", []):\n            if record[\"custom_id\"] in missing_custom_ids:\n                retry_entry = {\n                    \"retry_attempt\": retry_attempt,\n                    \"retry_batch_id\": retry_batch_id,\n                    \"submitted_at\": datetime.now().isoformat(),\n                    \"status\": status,\n                }\n                \n                if status == 'completed':\n                    retry_entry[\"result\"] = \"success\"\n                    record[\"final_status\"] = \"recovered\"\n                    record[\"recovered_at\"] = datetime.now().isoformat()\n                    manifest[\"retry_summary\"][\"recovered_count\"] += 1\n                \n                record[\"retry_history\"].append(retry_entry)\n        \n        # Write updated manifest\n        with open(manifest_file, 'w') as f:\n            json.dump(manifest, f, indent=2)\n        \n        print(f\"[MANIFEST] Updated retry manifest: {manifest_file.name}\")\n    except Exception as e:\n        print(f\"[WARN] Failed to update retry manifest: {e}\")",
          "lines_added": 70
        },
        {
          "id": "add_append_to_dlq",
          "title": "Add _append_to_dlq() method for permanently failed records",
          "file": "agent_actions/tasks/services/batch_service.py",
          "purpose": "Append permanently failed records to DLQ file (JSONL format)",
          "signature": "def _append_to_dlq(self, parent_file_name: str, output_directory: str, missing_custom_ids: Set[str], context_map: Dict[str, Any], retry_attempt: int, last_error: str) -> None",
          "logic": [
            "1. Check if retry_attempt exceeds max depth (permanently failed)",
            "2. For each missing custom_id, build DLQ record with metadata",
            "3. Append to {parent_file_name}_dlq.jsonl (one record per line)",
            "4. Update retry manifest to mark records as permanently_failed"
          ],
          "structure_per_line": {
            "custom_id": "rec_99",
            "source_guid": "guid_999",
            "attempts": 3,
            "last_error": "Rate limit exceeded",
            "original_content": {},
            "failed_at": "ISO timestamp"
          },
          "implementation": "def _append_to_dlq(\n    self,\n    parent_file_name: str,\n    output_directory: str,\n    missing_custom_ids: Set[str],\n    context_map: Dict[str, Any],\n    retry_attempt: int,\n    last_error: str,\n) -> None:\n    \"\"\"\n    Append permanently failed records to Dead Letter Queue file.\n    \n    Creates JSONL file with one record per line for easy processing.\n    \n    Args:\n        parent_file_name: Parent batch file name\n        output_directory: Output directory\n        missing_custom_ids: Set of custom_ids that permanently failed\n        context_map: Context map for extracting original content\n        retry_attempt: Final retry attempt number\n        last_error: Error message for failure\n    \"\"\"\n    from pathlib import Path\n    import json\n    from datetime import datetime\n    \n    batch_dir = Path(output_directory) / \"batch\"\n    dlq_file = batch_dir / f\"{parent_file_name}_dlq.jsonl\"\n    \n    try:\n        # Append to DLQ file (JSONL format)\n        with open(dlq_file, 'a') as f:\n            for custom_id in sorted(missing_custom_ids):\n                original_row = context_map.get(custom_id, {})\n                \n                dlq_record = {\n                    \"custom_id\": custom_id,\n                    \"source_guid\": original_row.get(\"source_guid\"),\n                    \"attempts\": retry_attempt + 1,  # Total attempts\n                    \"last_error\": last_error,\n                    \"original_content\": original_row.get(\"content\"),\n                    \"failed_at\": datetime.now().isoformat(),\n                }\n                \n                f.write(json.dumps(dlq_record) + '\\n')\n        \n        print(f\"[DLQ] Appended {len(missing_custom_ids)} record(s) to DLQ: {dlq_file.name}\")\n        \n        # Update retry manifest to mark as permanently failed\n        manifest_file = batch_dir / f\"{parent_file_name}_retry_manifest.json\"\n        if manifest_file.exists():\n            with open(manifest_file, 'r') as f:\n                manifest = json.load(f)\n            \n            for record in manifest.get(\"missing_records\", []):\n                if record[\"custom_id\"] in missing_custom_ids:\n                    record[\"final_status\"] = \"permanently_failed\"\n            \n            manifest[\"retry_summary\"][\"permanently_failed_count\"] = len(missing_custom_ids)\n            \n            with open(manifest_file, 'w') as f:\n                json.dump(manifest, f, indent=2)\n    \n    except Exception as e:\n        print(f\"[WARN] Failed to append to DLQ: {e}\")",
          "lines_added": 65
        }
      ],
      "validation_requirements": [
        "✅ Checks retry depth before resubmission",
        "✅ Reconstructs tasks from context_map correctly",
        "✅ Generates unique retry batch names",
        "✅ Submits retry batch via provider",
        "✅ Saves retry batch to registry with parent tracking",
        "✅ Marks parent batch with has_retry flag",
        "✅ Returns retry_batch_id on success, None on failure",
        "✅ Handles missing context_map data gracefully",
        "✅ Creates retry manifest with complete audit trail",
        "✅ Updates retry manifest when retry batches submitted/completed",
        "✅ Appends permanently failed records to DLQ file (JSONL)",
        "✅ Retry manifest tracks per-record retry history",
        "✅ DLQ file includes original content for manual reprocessing"
      ],
      "estimated_lines": 402
