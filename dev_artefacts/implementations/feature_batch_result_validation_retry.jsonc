  "technical_considerations": {
    "retry_strategy": {
      "max_depth": 2,
      "total_attempts_per_record": 3,
      "delay_strategy": "None (async batch processing, user polls status)",
      "configurable": "Via agent_config['batch_retry']['max_retry_depth']",
      "recursive": "Yes, up to max_depth"
    },
    "custom_id_normalization": {
      "issue": "Custom IDs may be strings or integers",
      "solution": "Convert to str() consistently throughout",
      "locations": [
        "_collect_expected_custom_ids: str(custom_id)",
        "_collect_result_custom_ids: str(custom_id)",
        "_convert_batch_results_to_workflow_format: str(custom_id) when tracking",
        "_merge_batch_results: str(custom_id) when keying"
      ]
    },
    "error_placeholder_handling": {
      "issue": "Providers may add error_line_* placeholders for malformed requests",
      "solution": "Skip custom_ids starting with 'error_line_' in _collect_result_custom_ids",
      "rationale": "These aren't missing records, just provider error reporting"
    },
    "context_map_availability": {
      "issue": "Context map may not always be available",
      "solution": "Fall back to record_count from registry",
      "precedence": "context_map (more accurate) > registry record_count > no validation",
      "backward_compat": "If neither available, retrieve without validation"
    },
    "agent_config_availability": {
      "issue": "agent_config may not be available in get_batch_results() context",
      "solution": "If agent_config is None, skip automatic retry but still validate",
      "affected_methods": "get_batch_results() - cannot trigger automatic retry without config",
      "user_impact": "Users should use process_batch_results() or retrieve_and_process_batch_results() for full automatic retry support"
    },
    "performance_impact": {
      "validation_overhead": "Minimal - only during result retrieval (not in hot path)",
      "operations": [
        "Set operations for custom_id comparison: O(n)",
        "Registry file I/O: once per batch retrieval"
      ],
      "retry_overhead": "One additional batch submission per set of missing records",
      "retry_operations": [
        "Task reconstruction: O(m) where m = missing count",
        "Batch submission: same as original submission",
        "No blocking wait - user polls status"
      ],
      "impact": "Negligible compared to batch API call time (minutes to hours)"
    },
    "error_propagation": {
      "pattern": "except Exception as e:\n    if isinstance(e, ProcessingError):\n        raise",
      "why": "ProcessingError already has detailed context - don't wrap it",
      "locations": "Apply in process_all_batch_results_to_workflow_output where exceptions are caught",
      "retry_context": "Check for retry_batch_id in error.context to provide user guidance"
    },
    "recursive_retry": {
      "scenario": "Retry batch also has missing records",
      "handling": [
        "1. _is_retry_batch() detects batch is retry",
        "2. Skips automatic retry to avoid infinite recursion",
        "3. Raises ProcessingError with is_retry_batch=True",
        "4. User must manually inspect and decide next steps"
      ],
      "future_enhancement": "Could auto-submit retry-of-retry up to max_depth"
    },
    "result_merging_strategy": {
      "deduplication": "Use dict keyed by custom_id",
      "conflict_resolution": "Prefer retry result over parent (fresher data)",
      "rationale": "If record appears in both parent and retry, retry is more recent",
      "edge_case": "Record in parent with error, in retry with success → use retry"
    }
  },

