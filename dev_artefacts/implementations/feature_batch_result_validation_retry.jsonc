    "phase_5_orchestration": {
      "status": "✅ COMPLETED",
      "priority": "critical",
      "description": "Orchestrate validation → retry flow and integrate with existing retrieval points",
      "tasks": [
        {
          "id": "add_retrieve_results_with_validation_and_retry",
          "title": "Add _retrieve_results_with_validation_and_retry() orchestration method",
          "file": "agent_actions/tasks/services/batch_service.py",
          "purpose": "Orchestrate validation → automatic retry → error with retry_batch_id",
          "signature": "def _retrieve_results_with_validation_and_retry(self, provider: BatchProvider, batch_id: str, output_directory: Optional[str], *, context_map: Optional[Dict[str, Any]] = None, agent_config: Optional[Dict[str, Any]] = None, record_count: Optional[int] = None, file_name: Optional[str] = None) -> List[BatchResult]",
          "returns": "List[BatchResult] - Results after validation (raises error if retry needed)",
          "logic": [
            "STEP 1: Retrieve results (current behavior works perfectly)",
            "1. Retrieve results from provider.retrieve_results()",
            "",
            "STEP 2: Validate completeness",
            "2. Collect expected_custom_ids from context_map",
            "3. Collect received_custom_ids from batch_results",
            "4. Calculate missing_ids = expected_ids - received_ids",
            "5. If no missing: Log reconciliation ✅, return results",
            "",
            "STEP 3: Check if this is a retry batch (avoid recursion)",
            "6. If is_retry_batch: Raise ProcessingError (don't retry retries)",
            "",
            "STEP 4: Automatic retry for missing records",
            "7. If missing_ids and agent_config available:",
            "   a. Call _resubmit_missing_records_as_batch()",
            "   b. Get retry_batch_id",
            "   c. Raise ProcessingError with retry_batch_id for user polling",
            "8. If agent_config not available: Raise ProcessingError (can't retry)"
          ],
          "implementation": "def _retrieve_results_with_validation_and_retry(\n    self,\n    provider: BatchProvider,\n    batch_id: str,\n    output_directory: Optional[str],\n    *,\n    context_map: Optional[Dict[str, Any]] = None,\n    agent_config: Optional[Dict[str, Any]] = None,\n    record_count: Optional[int] = None,\n    file_name: Optional[str] = None,\n) -> List[BatchResult]:\n    \"\"\"\n    Retrieve batch results with validation and automatic retry.\n    \n    Flow:\n    1. Retrieve results (works perfectly - no download issues)\n    2. Validate: Compare sent vs received custom_ids\n    3. If missing: Automatically resubmit as new batch\n    4. Raise ProcessingError with retry_batch_id for user to poll\n    \n    Args:\n        provider: Batch provider\n        batch_id: Batch ID to retrieve\n        output_directory: Output directory\n        context_map: Context map for validation and reconstruction\n        agent_config: Agent config for retry batch submission\n        record_count: Fallback record count\n        file_name: Batch file name\n        \n    Returns:\n        Complete list of BatchResult objects\n        \n    Raises:\n        ProcessingError: If records missing (with retry_batch_id in context if retry triggered)\n    \"\"\"\n    from agent_actions.core.exceptions import ProcessingError\n    \n    # STEP 1: Retrieve results (current implementation works perfectly)\n    batch_results = provider.retrieve_results(batch_id, output_directory)\n    \n    # STEP 2: Validate completeness\n    expected_custom_ids = self._collect_expected_custom_ids(context_map or {})\n    expected_count = len(expected_custom_ids)\n    \n    if expected_count == 0 and record_count:\n        expected_count = record_count\n    \n    if expected_count == 0:\n        # Cannot validate - return without validation (backward compat)\n        return batch_results\n    \n    result_custom_ids = self._collect_result_custom_ids(batch_results)\n    received_count = len(result_custom_ids) if expected_custom_ids else len(batch_results)\n    \n    # Calculate missing\n    if expected_custom_ids:\n        missing_ids = expected_custom_ids - result_custom_ids\n    else:\n        missing_ids = set() if received_count >= expected_count else set()\n    \n    # Success - all records received\n    if not missing_ids and received_count >= expected_count:\n        self._log_batch_reconciliation(\n            batch_id=batch_id,\n            expected_count=expected_count,\n            received_count=received_count,\n            file_name=file_name,\n        )\n        return batch_results\n    \n    # Missing records detected\n    print(\n        f\"[MISSING RECORDS] Batch {batch_id}: expected {expected_count} result(s) but received \"\n        f\"{received_count}. Missing: {', '.join(sorted(missing_ids)[:5])}{'...' if len(missing_ids) > 5 else ''}\"\n    )\n    \n    # STEP 3: Check if this is a retry batch (avoid recursion)\n    is_retry_batch = self._is_retry_batch(file_name, output_directory)\n    \n    if is_retry_batch:\n        print(\n            f\"[SKIP RETRY] This is a retry batch. Not triggering recursive retry. \"\n            f\"Raising error for {len(missing_ids)} missing record(s).\"\n        )\n        raise ProcessingError(\n            f\"Retry batch returned incomplete results\",\n            context={\n                'batch_id': batch_id,\n                'file_name': file_name,\n                'missing_custom_ids': sorted(missing_ids),\n                'missing_count': len(missing_ids),\n                'is_retry_batch': True,\n            }\n        )\n    \n    # STEP 4: Automatic retry\n    if not agent_config:\n        print(\n            f\"[SKIP RETRY] Cannot trigger retry: agent_config not provided. \"\n            f\"Raising error for {len(missing_ids)} missing record(s).\"\n        )\n        raise ProcessingError(\n            f\"Batch returned incomplete results and cannot retry\",\n            context={\n                'batch_id': batch_id,\n                'file_name': file_name,\n                'missing_custom_ids': sorted(missing_ids),\n                'missing_count': len(missing_ids),\n                'reason': 'agent_config not provided',\n            }\n        )\n    \n    # Determine retry attempt number\n    # If this is already a retry batch, get its retry_attempt and increment\n    # Otherwise, this is the first retry (retry_attempt=1)\n    current_retry_attempt = self._get_retry_attempt_from_registry(file_name, output_directory)\n    next_retry_attempt = current_retry_attempt + 1\n    \n    retry_batch_id = self._resubmit_missing_records_as_batch(\n        missing_ids,\n        batch_id,\n        file_name or 'batch',\n        context_map or {},\n        agent_config,\n        output_directory or '.',\n        provider,\n        retry_attempt=next_retry_attempt,\n        expected_count=expected_count,\n        received_count=received_count,\n    )\n    \n    if not retry_batch_id:\n        raise ProcessingError(\n            f\"Batch returned incomplete results and retry submission failed\",\n            context={\n                'batch_id': batch_id,\n                'file_name': file_name,\n                'missing_custom_ids': sorted(missing_ids),\n                'missing_count': len(missing_ids),\n                'retry_status': 'submission_failed',\n            }\n        )\n    \n    # Retry batch submitted successfully\n    print(\n        f\"[RETRY SUCCESS] Retry batch submitted: {retry_batch_id}. \"\n        f\"Poll status with check_batch_status('{retry_batch_id}') \"\n        f\"and retrieve with get_batch_results('{retry_batch_id}') when complete.\"\n    )\n    \n    # Raise error with retry_batch_id for user to poll\n    raise ProcessingError(\n        f\"Batch returned incomplete results. Retry batch submitted.\",\n        context={\n            'batch_id': batch_id,\n            'file_name': file_name,\n            'missing_custom_ids': sorted(missing_ids),\n            'missing_count': len(missing_ids),\n            'retry_batch_id': retry_batch_id,\n            'retry_file_name': f\"{file_name}_retry_1\" if file_name else None,\n            'retry_status': 'submitted',\n            'next_steps': [\n                f\"1. Poll retry batch status: check_batch_status('{retry_batch_id}')\",\n                f\"2. When complete, retrieve: get_batch_results('{retry_batch_id}')\",\n                \"3. Merge results using merge helper\",\n            ],\n        }\n    )",
          "lines_added": 155
        },
        {
          "id": "add_get_retry_attempt_helper",
          "title": "Add _get_retry_attempt_from_registry() helper method",
          "file": "agent_actions/tasks/services/batch_service.py",
          "purpose": "Get current retry_attempt number for a batch from registry",
          "signature": "def _get_retry_attempt_from_registry(self, file_name: Optional[str], output_directory: str) -> int",
          "logic": [
            "1. If file_name is None, return 0 (not a retry batch)",
            "2. Load registry",
            "3. Check if registry[file_name] has 'retry_attempt' field",
            "4. Return retry_attempt if exists, else 0 (parent batch)"
          ],
          "implementation": "def _get_retry_attempt_from_registry(self, file_name: Optional[str], output_directory: str) -> int:\n    \"\"\"\n    Get the current retry_attempt number for a batch.\n    \n    Args:\n        file_name: Batch file name\n        output_directory: Output directory\n        \n    Returns:\n        Current retry_attempt number (0 for parent batches, 1+ for retry batches)\n    \"\"\"\n    from pathlib import Path\n    import json\n    \n    if not file_name:\n        return 0\n    \n    batch_dir = Path(output_directory) / \"batch\"\n    registry_file = batch_dir / \".batch_registry.json\"\n    \n    if not registry_file.exists():\n        return 0\n    \n    try:\n        with open(registry_file, 'r') as f:\n            registry = json.load(f)\n        \n        entry = registry.get(file_name, {})\n        return entry.get(\"retry_attempt\", 0)\n        \n    except Exception:\n        return 0",
          "lines_added": 35
        },
        {
          "id": "add_is_retry_batch_helper",
          "title": "Add _is_retry_batch() helper method",
          "file": "agent_actions/tasks/services/batch_service.py",
          "purpose": "Check if a batch is a retry batch (to avoid recursive retry)",
          "signature": "def _is_retry_batch(self, file_name: Optional[str], output_directory: str) -> bool",
          "logic": [
            "1. If file_name is None, return False",
            "2. Load registry",
            "3. Check if registry[file_name] has 'parent_batch_id' field",
            "4. Return True if has parent, False otherwise"
          ],
          "implementation": "def _is_retry_batch(self, file_name: Optional[str], output_directory: str) -> bool:\n    \"\"\"\n    Check if a batch is a retry batch.\n    \n    Args:\n        file_name: Batch file name\n        output_directory: Output directory\n        \n    Returns:\n        True if this is a retry batch, False otherwise\n    \"\"\"\n    from pathlib import Path\n    import json\n    \n    if not file_name:\n        return False\n    \n    batch_dir = Path(output_directory) / \"batch\"\n    registry_file = batch_dir / \".batch_registry.json\"\n    \n    if not registry_file.exists():\n        return False\n    \n    try:\n        with open(registry_file, 'r') as f:\n            registry = json.load(f)\n        \n        entry = registry.get(file_name, {})\n        return \"parent_batch_id\" in entry\n        \n    except Exception:\n        return False",
          "lines_added": 35
        }
      ],
      "validation_requirements": [
