  "implementation_plan": {
    "phase_1_helper_methods": {
      "priority": "critical",
      "status": "✅ COMPLETED",
      "description": "Add methods to collect and compare custom_ids from context_map and batch_results",
      "tasks": [
        {
          "id": "add_collect_expected_custom_ids",
          "title": "Add _collect_expected_custom_ids() method",
          "file": "agent_actions/tasks/services/batch_service.py",
          "purpose": "Extract custom_ids of records that were submitted to batch API",
          "signature": "def _collect_expected_custom_ids(self, context_map: Dict[str, Any]) -> Set[str]",
          "logic": [
            "1. Iterate over context_map items",
            "2. Filter for records with _batch_filter_status='included' (actually submitted)",
            "3. Collect their custom_ids as strings",
            "4. Return set of expected custom_ids"
          ],
          "implementation": "def _collect_expected_custom_ids(self, context_map: Dict[str, Any]) -> Set[str]:\n    \"\"\"\n    Collect custom_ids of records that were submitted to batch API.\n    \n    Only counts records with _batch_filter_status='included' since\n    filtered records were never submitted.\n    \n    Args:\n        context_map: Dict mapping custom_id to original row data\n        \n    Returns:\n        Set of custom_ids (as strings) that were submitted\n    \"\"\"\n    return {\n        str(custom_id)\n        for custom_id, original_row in (context_map or {}).items()\n        if original_row.get(\"_batch_filter_status\", \"included\") == \"included\"\n    }",
          "lines_added": 18
        },
        {
          "id": "add_collect_result_custom_ids",
          "title": "Add _collect_result_custom_ids() method",
          "file": "agent_actions/tasks/services/batch_service.py",
          "purpose": "Extract custom_ids from batch results, ignoring error placeholders",
          "signature": "def _collect_result_custom_ids(self, batch_results: List[BatchResult]) -> Set[str]",
          "logic": [
            "1. Iterate over batch_results",
            "2. Get custom_id from each BatchResult",
            "3. Skip if custom_id is None",
            "4. Skip if custom_id starts with 'error_line_' (internal error placeholders)",
            "5. Convert to string and add to set",
            "6. Return set of result custom_ids"
          ],
          "implementation": "def _collect_result_custom_ids(self, batch_results: List[BatchResult]) -> Set[str]:\n    \"\"\"\n    Collect custom_ids from batch results.\n    \n    Ignores internal error placeholders (error_line_*) which are not\n    real missing records, just provider-side errors.\n    \n    Args:\n        batch_results: List of BatchResult objects from provider\n        \n    Returns:\n        Set of custom_ids (as strings) in the results\n    \"\"\"\n    result_ids: Set[str] = set()\n    for batch_result in batch_results or []:\n        custom_id = getattr(batch_result, \"custom_id\", None)\n        if not custom_id:\n            continue\n        custom_id_str = str(custom_id)\n        # Ignore internal error placeholders such as error_line_1\n        if custom_id_str.startswith(\"error_line_\"):\n            continue\n        result_ids.add(custom_id_str)\n    return result_ids",
          "lines_added": 25
        }
      ],
      "validation_requirements": [
        "✅ _collect_expected_custom_ids returns only 'included' records",
        "✅ _collect_result_custom_ids skips error placeholders",
        "✅ Both return Set[str] for easy comparison",
        "✅ Handle None/empty inputs gracefully"
      ],
      "estimated_lines": 43
