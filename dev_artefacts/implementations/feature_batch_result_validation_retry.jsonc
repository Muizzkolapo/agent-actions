          "2. _retrieve_results_with_validation_and_retry() called",
          "3. Validation: expected=1, received=1 ✅",
          "4. All records received!",
          "5. Returns BatchResult for rec_91"
        ]
      },
      "step_8_user_merges_results": {
        "action": "User merges all results manually",
        "what_happens": [
          "1. Load results from batch_abc123 (95 records)",
