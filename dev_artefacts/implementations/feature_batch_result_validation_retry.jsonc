          "7. Mark parent batch: has_retry=True, missing_records=['rec_23',...]",
          "8. _update_retry_manifest() called with status='submitted'",
          "9. Manifest updated with retry batch info"
        ],
        "files_created": [
          "batch/customers_retry_manifest.json (5 missing records tracked)",
          "batch/customers_retry_1_input.jsonl (5 records)",
          "batch/.batch_registry.json (updated: customers has_retry=True, retry_1 with parent_batch_id)"
