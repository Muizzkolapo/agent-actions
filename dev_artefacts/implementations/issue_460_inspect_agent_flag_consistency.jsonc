{
  "title": "Make inspect commands consistent with run command using -a flag for agent names",
  "issue": "#460",
  "priority": "high",
  "type": "feature",
  "estimated_effort": "4-6 hours",
  "risk_level": "low",
  "description": "Update all inspect commands to use the -a/--agent flag pattern consistent with the run command, instead of requiring full workflow file paths. This improves user experience by making all CLI commands work the same way with automatic project root detection and agent name resolution.",

  "current_state": {
    "what_exists": {
      "run_command_pattern": {
        "file": "agent_actions/tasks/run.py",
        "lines": "144-173",
        "functionality": [
          "Uses -a/--agent flag for agent name",
          "Has @requires_project decorator for automatic project root detection",
          "Uses ProjectPathsFactory.create_project_paths() for path resolution",
          "Auto-constructs workflow file path from agent name",
          "Works from any subdirectory within project"
        ],
        "usage": "agent run -a my_agent",
        "status": "✅ Perfect UX pattern to replicate"
      },
      "inspect_commands_current": {
        "file": "agent_actions/tasks/inspect.py",
        "lines": "1-486",
        "functionality": [
          "signatures - Display input/output signatures for agents",
          "field-flow - Validate field dependencies across agents", 
          "conflicts - Detect field name conflicts between dependency agents"
        ],
        "current_usage": [
          "agent inspect signatures /full/path/to/workflow.yml",
          "agent inspect field-flow /full/path/to/workflow.yml",
          "agent inspect conflicts /full/path/to/workflow.yml [agent_name]"
        ],
        "problems": [
          "Requires full workflow file paths (inconsistent with run)",
          "No @requires_project decorator (must be run from project root)",
          "Different argument pattern than run command",
          "Poor user experience - users must remember different patterns"
        ],
        "status": "❌ Inconsistent UX that needs fixing"
      },
      "project_path_infrastructure": {
        "file": "agent_actions/tasks/services/project_paths_factory.py",
        "functionality": [
          "ProjectPathsFactory.create_project_paths() for path resolution",
          "Auto-discovers workflow files from agent names",
          "Works with @requires_project decorator pattern"
        ],
        "status": "✅ Ready to use - no changes needed"
      },
      "cli_decorators": {
        "file": "agent_actions/core/cli_decorators.py", 
        "functionality": [
          "@requires_project decorator for automatic project root detection",
          "Changes CWD to project root before command execution",
          "Shows user-friendly project root feedback"
        ],
        "status": "✅ Ready to use - no changes needed"
      }
    },
    "what_is_missing": {
      "consistent_cli_pattern": {
        "problem": "Inspect commands use workflow_path argument instead of -a flag",
        "needed": "Change all inspect commands to use -a/--agent pattern"
      },
      "project_root_detection": {
        "problem": "Inspect commands lack @requires_project decorator",
        "needed": "Add decorator to enable running from subdirectories"
      },
      "agent_name_resolution": {
        "problem": "Inspect commands don't use ProjectPathsFactory for path resolution", 
        "needed": "Replace manual path handling with ProjectPathsFactory pattern"
      },
      "argument_validation": {
        "problem": "Validator models expect workflow_path instead of agent name",
        "needed": "Update SignaturesCommandArgs, FieldFlowCommandArgs, ConflictsCommandArgs"
      }
    }
  },

  "problem_statement": {
    "user_pain_points": [
      "Must remember different command patterns for run vs inspect",
      "Must provide full workflow file paths for inspect commands", 
      "Must run inspect commands from project root (no subdirectory support)",
      "Inconsistent UX across CLI - some commands use -a flag, others don't",
      "Poor discoverability - users expect all commands to work the same way"
    ],
    "use_cases": [
      {
        "name": "Developer debugging workflow",
        "description": "Developer wants to inspect agent signatures while working in subdirectory",
        "current": "cd ../../ && agent inspect signatures ./path/to/workflow.yml",
        "desired": "agent inspect signatures -a my_agent  # from any directory",
        "benefit": "Same pattern as run command, works from anywhere"
      },
      {
        "name": "CI/CD pipeline inspection",
        "description": "Automated scripts inspecting workflow before execution", 
        "current": "Must construct full paths and ensure correct working directory",
        "desired": "agent inspect field-flow -a my_agent  # consistent with run",
        "benefit": "Simplified automation scripts, same pattern everywhere"
      },
      {
        "name": "New user onboarding",
        "description": "New users learning the CLI",
        "current": "Must learn different patterns: 'run -a agent' vs 'inspect signatures /path'",
        "desired": "Single consistent pattern: all commands use -a flag",
        "benefit": "Faster learning curve, less cognitive load"
      }
    ],
    "business_impact": "Improved developer experience leads to faster adoption and fewer support questions"
  },

  "solution_overview": {
    "approach": "Apply the proven run command pattern to all inspect commands",
    "key_insight": "All necessary infrastructure exists - just need to change argument parsing and add decorators",
    "backward_compatibility": "Can maintain some backward compatibility with deprecation warnings",
    "deliverables": [
      "Update inspect command arguments to use -a/--agent pattern",
      "Add @requires_project decorator to all inspect commands",
      "Update validator models to expect agent names instead of paths", 
      "Update error messages and help text",
      "Add tests for new argument patterns",
      "Update documentation"
    ]
  },

