          "id": "update_fieldflow_command",
          "title": "Update InspectFieldFlowCommand implementation",
          "file": "agent_actions/tasks/inspect.py", 
          "lines": "161-284",
          "changes": {
            "constructor": "Accept agent_name instead of workflow_path",
            "path_resolution": "Use ProjectPathsFactory.create_project_paths(agent_name) pattern",
            "config_loading": "Remove manual defaults.yml creation - use ProjectPathsFactory"
          },
          "implementation": "Same pattern as signatures command - reuse path resolution logic",
          "lines_modified": "~30 lines",
          "lines_removed": "~25 lines"
        },
        {
          "id": "update_conflicts_command", 
          "title": "Update InspectConflictsCommand implementation",
          "file": "agent_actions/tasks/inspect.py",
          "lines": "286-401",
          "changes": {
            "constructor": "Accept agent_name and filter_agent instead of workflow_path and agent_name",
            "path_resolution": "Use ProjectPathsFactory.create_project_paths(agent_name) pattern",
            "config_loading": "Remove manual defaults.yml creation - use ProjectPathsFactory",
            "filtering_logic": "Update to use filter_agent for specific agent filtering"
          },
          "implementation": "Same pattern as other commands but with filter_agent handling",
          "lines_modified": "~30 lines", 
          "lines_removed": "~25 lines"
        },
        {
          "id": "extract_common_path_logic",
          "title": "Extract common path resolution logic",
          "file": "agent_actions/tasks/inspect.py",
          "rationale": "All three commands now use identical ProjectPathsFactory pattern",
          "implementation": {
            "create_method": "_create_project_paths_and_config_manager",
            "signature": "def _create_project_paths_and_config_manager(self, agent_name: str) -> ConfigManager",
            "logic": [
              "1. paths = ProjectPathsFactory.create_project_paths(agent_name, agent_name)",
              "2. workflow_path = paths.agent_config_dir / f'{agent_name}.yml'", 
              "3. config_manager = ConfigManager(str(workflow_path), str(paths.default_config_path))",
              "4. config_manager.load_configs() and other standard setup",
              "5. return config_manager"
            ],
            "used_by": "All three command classes",
            "benefit": "DRY principle - no code duplication"
          },
          "lines_added": "~15 lines",
          "lines_removed": "~75 lines (3x25 duplicate lines)"
        }
      ],
      "validation_requirements": [
        "✓ All commands use ProjectPathsFactory for path resolution", 
        "✓ No manual temp file creation/cleanup needed",
        "✓ Error messages reference agent names not file paths",
        "✓ Common logic extracted to avoid duplication"
      ]
    },

