    "phase_2_command_implementations": {
      "priority": "critical",
      "description": "Update command implementation classes to use new pattern",
      "status": "pending",
      "tasks": [
        {
          "id": "update_signatures_command",
          "title": "Update InspectSignaturesCommand implementation",
          "file": "agent_actions/tasks/inspect.py",
          "lines": "27-159",
          "changes": {
            "constructor": "Accept agent_name instead of workflow_path",
            "path_resolution": "Use ProjectPathsFactory.create_project_paths(agent_name) pattern",
