            "error_handling": "Update error messages to reference agent names not paths"
          },
          "new_logic": {
            "step_1": "Get agent_name from args",
            "step_2": "Use ProjectPathsFactory.create_project_paths(agent_name, agent_name) for paths",
            "step_3": "Construct workflow_path from paths.agent_config_dir / f'{agent_name}.yml'",
            "step_4": "Use paths.default_config_path for defaults (no temp file creation)",
            "step_5": "Pass resolved paths to ConfigManager"
          },
          "remove_code": [
            "Manual defaults file discovery/creation (lines 63-86)",
            "Manual temp file cleanup (lines 85-86, 211-212, 343-344)"
          ],
