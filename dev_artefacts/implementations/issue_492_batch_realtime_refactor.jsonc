  "implementation_plan": {
    "phase_1": {
      "title": "Extract WHERE clause and conditional filtering logic",
      "priority": "P0 - Critical",
      "estimated_effort": "3-4 hours",
      "tasks": [
        {
          "task": "Create FilterService class",
          "file": "agent_actions/preprocessing/filter_service.py",
          "purpose": "Centralized filtering logic for WHERE and conditional clauses",
          "methods": [
            {
              "name": "apply_where_clause_filtering(data: List[Dict], where_clause_config: Dict) -> Tuple[List[Dict], Dict[str, str]]",
              "returns": "Tuple of (filtered_data, status_map)",
              "description": "Apply WHERE clause filtering with behavior support (filter/skip)",
              "shared_by": ["batch_service.py", "target_content_processor.py"]
            },
            {
              "name": "apply_conditional_clause(row: Dict, conditional_clause: str) -> bool",
              "returns": "True if row passes conditional, False otherwise",
              "description": "Evaluate conditional clause using execute_user_defined_function",
              "shared_by": ["batch_service.py"]
            },
            {
              "name": "filter_single_item(item: Dict, where_clause_config: Dict) -> Tuple[bool, str]",
              "returns": "Tuple of (should_include, filter_status)",
              "description": "Filter single item, return inclusion decision and status",
              "shared_by": ["batch_service.py", "target_content_processor.py"]
            }
          ],
          "implementation_notes": [
            "Consolidate WHERE clause logic from batch_service.py:276-382",
            "Consolidate WHERE clause logic from target_content_processor.py:290-334",
            "Support both 'filter' and 'skip' behaviors",
            "Handle passthrough_on_error configuration",
            "Return status map for batch mode context tracking",
            "Use get_global_filter() internally"
          ]
        },
        {
          "task": "Refactor batch_service.py to use FilterService",
          "file": "agent_actions/llm_invocation/batch/batch_service.py",
          "changes": [
            "Import FilterService",
            "Replace WHERE clause logic (lines 276-382) with FilterService.filter_single_item()",
            "Use returned status_map to set _batch_filter_status in context_map",
            "Keep batch-specific context_map tracking logic",
            "Remove duplicated WHERE clause code"
          ],
          "lines_removed": "~100 lines",
          "lines_added": "~10 lines"
        },
        {
          "task": "Refactor target_content_processor.py to use FilterService",
          "file": "agent_actions/prompt_generation/target_content_processor.py",
