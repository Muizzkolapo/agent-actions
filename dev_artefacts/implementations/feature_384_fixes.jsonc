          "title": "Improve error context in parallel execution",
          "files": ["agent_actions/core/graph/agent_workflow.py"],
          "implementation": {
            "change": "Use asyncio.gather(*tasks, return_exceptions=True)",
            "then": "results = await asyncio.gather(*tasks, return_exceptions=True)\nerrors = [(agent, result) for agent, result in zip(pending_agents, results) \n          if isinstance(result, Exception)]\nif errors:\n    error_msg = '\\n'.join([f'{agent}: {str(err)}' for agent, err in errors])\n    raise WorkflowError('parallel_execution_failures', \n                       f'Multiple agents failed:\\n{error_msg}')",
