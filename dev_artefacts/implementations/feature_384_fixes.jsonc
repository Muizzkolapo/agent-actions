            "logic": "# After gather, check for failures\nfailed_agents = [a for a in level_agents if self.agent_status[a]['status'] == 'failed']\nif failed_agents and batch_pending:\n    raise WorkflowError('batch_submission_partial_failure', \n                       f'Batch agents failed: {failed_agents}')\nelif batch_pending:\n    # All succeeded, early exit\n    return",
