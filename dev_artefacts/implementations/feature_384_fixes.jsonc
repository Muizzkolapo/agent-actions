{
  "title": "Fix Critical Issues in Parallel Execution Implementation",
  "parent_issue": "#384",
  "priority": "critical",
  "type": "bugfix",
  "description": "Address critical issues found in senior engineer review before shipping parallel execution feature to production. Focus on race conditions, test configuration, and error handling.",

  "review_findings": {
    "overall_assessment": "Ship with Fixes - Core architecture is solid but 4 critical/high issues must be resolved",
    "recommendation": "Fix C1, C2, H1, H2 before merge",
    "estimated_effort": "1-2 days",
    "risk_after_fixes": "Low"
  },

  "critical_issues": {
    "C1_race_condition": {
      "severity": "critical",
      "title": "Race Condition: previous_agent_type Shared State",
      "location": "agent_actions/core/graph/agent_workflow.py:152",
      "problem": "self.previous_agent_type is instance state modified by parallel agents in _run_single_agent_async(). When multiple agents run concurrently, they race to update this field, causing non-deterministic behavior.",
      "impact": "Agents may see incorrect 'previous agent' information, breaking workflows that depend on this state",
      "code_snippet": "self.previous_agent_type = agent_name  # RACE CONDITION",
      "decision_needed": "Architecture decision required on how to handle previous_agent_type in parallel execution",
      "options": [
        {
          "option_1": "Remove previous_agent_type from parallel execution",
          "pros": ["Simple", "No race condition", "agent_idx already provides ordering"],
          "cons": ["Breaking change if workflows rely on this value"],
          "implementation": "Document that previous_agent_type is undefined for parallel agents"
        },
        {
          "option_2": "Make previous_agent_type dependency-based",
          "pros": ["Semantically correct", "Each agent knows its immediate dependencies"],
          "cons": ["Parallel agents may have multiple dependencies", "More complex logic"],
          "implementation": "Pass previous_agent_type as parameter derived from dependency graph"
        },
        {
          "option_3": "Use task-local storage",
          "pros": ["No race condition", "Maintains compatibility"],
          "cons": ["More complex", "Requires contextvars"],
          "implementation": "Use contextvars.ContextVar for per-agent storage"
        }
      ],
      "recommended_solution": "Option 1 - Remove from parallel execution",
      "rationale": "previous_agent_type is ambiguous for parallel agents (no single 'previous' agent). agent_idx provides ordering. Document the behavioral change."
    },

    "C2_conflicting_cli_flags": {
      "severity": "critical",
      "title": "Conflicting CLI Flags Not Validated",
      "location": "agent_actions/tasks/run.py:93-100",
      "problem": "User can pass both --parallel and --no-parallel simultaneously. The code checks parallel first, making --no-parallel unreachable if both are set.",
      "impact": "Silent failure - user intent is unclear, leading to confusion",
      "code_snippet": "if self.args.parallel:\n    use_parallel = True\nelif self.args.no_parallel:  # Unreachable if both True\n    use_parallel = False",
      "solution": {
        "file": "agent_actions/agents/validators/run_validator.py",
        "implementation": "Add Pydantic model_validator for mutual exclusion",
        "code": "@model_validator(mode='after')\ndef check_parallel_flags(self):\n    if self.parallel and self.no_parallel:\n        raise ValueError('Cannot specify both --parallel and --no-parallel')\n    return self"
      }
    }
  },

  "high_severity_issues": {
    "H1_async_test_configuration": {
      "severity": "high",
      "title": "Async Test Configuration Missing",
      "location": "tests/integration/test_level_parallel_execution.py, tests/integration/test_parallel_performance.py",
      "problem": "All 9 integration/performance tests fail with 'async def functions are not natively supported'. Tests use @pytest.mark.asyncio but pytest-asyncio is not configured.",
      "impact": "ZERO integration test coverage for the core feature. Unit tests pass but don't test actual async execution.",
      "current_state": "9 tests failing with asyncio plugin error",
      "solution": {
        "step_1": "Add pytest-asyncio to requirements",
        "step_2": "Configure in pytest.ini: asyncio_mode = auto",
        "step_3": "Run all tests to verify they pass"
      },
      "validation": "All 9 integration/performance tests must pass before merge"
    },

    "H2_batch_mode_race": {
      "severity": "high",
      "title": "Batch Mode Race Condition in Parallel Levels",
      "location": "agent_actions/core/graph/agent_workflow.py:74-83",
      "problem": "When multiple batch agents submit in parallel (same level), the workflow exits on the first batch submission. If one batch agent fails while others succeed, workflow exits thinking all succeeded.",
      "impact": "On re-run, failures surface unexpectedly",
      "code_snippet": "if batch_pending:\n    # Early exit - what about failed agents in same level?\n    return",
      "solution": "Check for failed agents in same level before early exit. If any agent failed, don't exit early - raise error instead.",
      "implementation": {
        "check_failures": "After gather, check if any agent status is 'failed'",
        "logic": "if any_failed and batch_pending: raise error instead of returning",
        "preserve_behavior": "If all agents succeeded and batch pending, early exit as before"
      }
    },

    "H3_error_context_lost": {
      "severity": "high",
      "title": "Error Context Lost in Parallel Execution",
      "location": "agent_actions/core/graph/agent_workflow.py:71",
      "problem": "asyncio.gather(*tasks) uses fail-fast mode. When one agent fails, other agents are cancelled immediately, losing their progress/state. No context about which agent failed.",
      "impact": "Debugging parallel failures is difficult - only first error surfaces, masking other issues",
      "current_code": "await asyncio.gather(*tasks)  # Fail-fast mode",
      "solutions": [
        {
          "option_1": "Use return_exceptions=True",
          "code": "results = await asyncio.gather(*tasks, return_exceptions=True)",
          "then": "Aggregate all errors and raise comprehensive error message",
          "pros": ["See all failures", "Better debugging"],
          "cons": ["All agents run even if first fails"]
        },
        {
          "option_2": "Keep fail-fast but improve logging",
          "code": "try:\n    await asyncio.gather(*tasks)\nexcept Exception as e:\n    # Log context about which agent failed and what others were doing\n    raise",
          "pros": ["Fast failure", "No wasted resources"],
          "cons": ["Only see first error"]
        }
      ],
      "recommended_solution": "Option 1 - Better for debugging parallel workflows",
      "rationale": "Users need to see all failures to fix issues efficiently"
    }
  },

  "medium_severity_issues": {
    "M1_execution_order_lost": {
      "severity": "medium",
      "title": "No Preservation of Execution Order in Logs",
      "location": "agent_actions/core/graph/agent_workflow.py:61",
      "problem": "Log message 'X agents in parallel' doesn't preserve original execution order",
      "impact": "User can't easily correlate logs to config file order",
      "solution": "Sort agents by original index before logging completion"
    },

    "M2_concurrency_limit_not_exposed": {
      "severity": "medium",
      "title": "Concurrency Limit Not Exposed to User",
      "location": "agent_actions/core/graph/agent_workflow.py:25",
      "problem": "concurrency_limit=5 is hardcoded. User cannot override via CLI.",
      "impact": "Can't optimize for different hardware or rate limits",
      "solution": "Add --concurrency-limit N CLI flag, defaulting to 5"
    },

    "M3_agent_index_preservation": {
      "severity": "medium",
      "title": "Agent Index Preservation Unclear and Inefficient",
      "location": "agent_actions/core/graph/agent_workflow.py:57, 68",
      "problem": "Uses self.execution_order.index(agent) - O(n) lookup per agent",
      "impact": "Performance degrades with large workflows; logic is hard to follow",
      "solution": "Pre-compute index map: self.agent_indices = {agent: i for i, agent in enumerate(self.execution_order)} in __init__()"
    },

    "M4_circular_dependency_error": {
      "severity": "medium",
      "title": "Circular Dependency Error Context Insufficient",
      "location": "agent_actions/core/graph/agent_workflow.py:296-300",
      "problem": "Error shows assigned and remaining sets, but doesn't indicate which dependency caused the cycle",
      "impact": "User can't identify the problematic edge",
      "solution": "Track last attempted dependencies and include in error message"
    }
  },

  "low_severity_issues": {
    "L1": {
      "title": "Documentation Claims Non-Existent Performance Metrics",
      "location": "dev_artefacts/markdown_docs/parallel-execution.md:342-365",
      "solution": "Either implement the metrics or remove from docs"
    },
    "L2": {
      "title": "Empty Workflow Edge Case Not Practical",
      "location": "tests/core/graph/test_execution_levels.py:203-212",
      "solution": "Remove test or add guard in _compute_execution_levels()"
    },
    "L3": {
      "title": "Inconsistent hasattr Checks",
      "location": "agent_actions/tasks/run.py:93, 97",
      "solution": "Direct access: if self.args.parallel: (Pydantic defaults to False)"
    }
  },

  "missing_tests": [
    "Integration test for actual workflow execution (all async tests currently fail)",
    "Test for conflicting --parallel/--no-parallel flags",
    "Test for partial batch failure in parallel level",
