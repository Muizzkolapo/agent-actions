            "update_function": "def run(agent: str, user_code: Optional[str], use_tools: bool, force: bool, parallel: bool = False) -> None:",
            "update_args": "args = RunCommandArgs(agent=agent, user_code=user_code, use_tools=use_tools, force=force, parallel=parallel)",
            "update_validator": "Add parallel: bool = False to RunCommandArgs in run_validator.py"
          },
          "logic": {
            "auto_mode": "if not parallel: use auto-detection",
            "forced_mode": "if parallel: always use async_run()"
