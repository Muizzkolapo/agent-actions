          "id": "fix_previous_agent_type_race",
          "title": "Fix race condition in previous_agent_type",
          "severity": "critical",
          "file": "agent_actions/core/graph/agent_workflow.py",
          "location": "Line 152 in _run_single_agent_async()",
          "problem": "self.previous_agent_type is shared state modified by parallel agents, causing race condition",
          "impact": "Agents may see incorrect 'previous agent' information, breaking workflows",
          "solution": {
            "approach": "Remove self.previous_agent_type = agent_name from parallel execution",
            "rationale": "previous_agent_type is ambiguous for parallel agents (no single 'previous' agent)",
            "breaking_change": true,
            "mitigation": "Document that previous_agent_type is undefined for parallel agents, use agent_idx for ordering"
          },
          "implementation": {
            "step_1": "Remove self.previous_agent_type = agent_name from _run_single_agent_async()",
