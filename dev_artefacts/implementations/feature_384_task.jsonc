{
  "title": "Enable parallel execution for loop agents (Issue #384)",
  "issue": "#384",
  "priority": "high",
  "type": "feature",
  "description": "Enable parallel execution for loop agents that have identical dependencies. Currently, loop agents run sequentially even though the infrastructure (async_run, LoopOutputCorrelator) exists to support parallel execution. This will provide significant performance improvements for map-reduce patterns and batch processing tasks.",

  "current_state": {
    "what_exists": {
      "async_run_infrastructure": {
        "file": "agent_actions/core/graph/agent_workflow.py",
        "lines": "25-96",
        "functionality": [
          "async_run() method with asyncio support",
          "Semaphore-based concurrency limiting",
          "Parallel execution of agents using asyncio.gather",
          "Thread-safe status management",
          "Error aggregation for parallel failures"
        ],
        "status": "✅ Fully implemented but never invoked"
      },
      "loop_correlation": {
        "file": "agent_actions/core/graph/loop_correlator.py",
        "functionality": [
          "Correlates outputs from parallel loop executions",
          "Merges results by source_guid or loop_correlation_id",
          "Supports explicit loop consumption patterns",
          "Designed specifically for parallel map-reduce"
        ],
        "status": "✅ Production-ready for parallel loops"
      },
      "loop_expansion": {
        "file": "agent_actions/core/parser/action_expander.py",
        "lines": "374-425",
        "functionality": [
          "Creates loop agents with proper dependencies",
          "Parallel mode (default): All iterations depend on same parent",
          "Sequential mode: Chains dependencies (iter_2 <- iter_1)",
          "Loop metadata: is_loop_agent, loop_base_name, loop_iteration, loop_mode"
        ],
        "status": "✅ Supports both parallel and sequential dependency structures"
      },
      "sequential_execution": {
        "file": "agent_actions/core/graph/agent_workflow.py",
        "lines": "380-590",
        "method": "run()",
        "functionality": [
          "Sequential execution through execution_order list",
          "Dependencies enforced by execution order",
          "Status tracking per agent",
          "Batch mode support"
        ],
        "status": "✅ Current default - always used by CLI"
      }
    },
    "what_is_missing": {
      "cli_integration": {
        "file": "agent_actions/tasks/run.py",
        "current_line": "90: workflow.run()",
        "problem": "CLI always calls sequential run(), never async_run()",
        "needed": "Logic to detect when parallel execution should be used"
      },
      "parallel_detection": {
        "problem": "No mechanism to identify parallel loop groups",
        "needed": "Detect agents with: same dependencies + is_loop_agent + loop_mode='parallel'"
      },
      "execution_strategy": {
        "problem": "No decision logic for parallel vs sequential",
        "needed": "Determine when to use async_run() vs run()"
      }
    }
  },

  "problem_statement": {
    "user_pain_points": [
      "Loop agents run sequentially even when they could run in parallel",
      "3 distractor generation loops take 3× longer than necessary",
      "Batch processing with parallel loops gets no performance benefit",
      "Infrastructure exists but is never utilized",
      "No way to opt into parallel execution even explicitly"
    ],
    "use_cases": [
      {
        "name": "Multiple Distractor Generation",
        "description": "Generate 3 different types of distractors in parallel",
        "current": "generate_distractors_1 → generate_distractors_2 → generate_distractors_3 (90s)",
        "desired": "All 3 run in parallel (30s total)",
        "speedup": "3× faster"
      },
      {
        "name": "Batch Processing Tasks",
        "description": "Process multiple batches of data independently",
        "current": "batch_1 → batch_2 → batch_3 → batch_4 (sequential)",
        "desired": "All batches run in parallel",
        "speedup": "4× faster"
      },
      {
        "name": "Map-Reduce Patterns",
        "description": "Parallel map phase followed by reduce",
        "current": "mapper_1 → mapper_2 → mapper_3 → reducer (slow map phase)",
        "desired": "mappers run in parallel → reducer",
        "speedup": "Significant improvement for map phase"
      }
    ],
    "business_impact": "Unlock performance improvements for existing workflows without any config changes"
  },

  "solution_overview": {
    "approach": "Auto-detect parallel loop groups and use existing async_run() infrastructure",
    "key_insight": "All infrastructure exists - just need to wire CLI to async_run() for parallel loops",
    "backward_compatibility": "100% - sequential execution remains default, parallel only for detected loop groups",
    "deliverables": [
      "Parallel loop group detection logic",
      "CLI integration to use async_run() for parallel loops",
      "Optional --parallel flag for explicit control",
      "Tests for parallel loop execution",
      "Documentation for parallel loops"
    ]
  },

  "implementation_approach": {
    "option_1_auto_detect": {
      "title": "Auto-detect parallel loops (RECOMMENDED)",
      "description": "Automatically detect loop agents with parallel mode and identical dependencies",
      "pros": [
        "Zero configuration - just works",
        "No breaking changes",
        "Users get performance improvement automatically",
        "Leverages loop_mode metadata from issue #381"
      ],
      "cons": [
        "Less explicit - users may not know when parallel execution happens",
        "Need good logging to show what's running in parallel"
      ],
      "detection_logic": {
        "step_1": "Check if any agents have is_loop_agent=True",
        "step_2": "Filter for agents with loop_mode='parallel'",
        "step_3": "Group by loop_base_name",
        "step_4": "Verify all agents in group have identical dependencies",
        "step_5": "If parallel loop group found, use async_run()"
      }
    },
    "option_2_cli_flag": {
      "title": "Add --parallel CLI flag",
      "description": "Explicit opt-in via command-line flag",
      "pros": [
        "Explicit user control",
        "Easy to debug (compare with/without flag)",
        "Simple implementation"
      ],
      "cons": [
        "Requires user to know about and use the flag",
        "Manual opt-in reduces adoption",
        "Extra CLI surface area"
      ],
      "usage": "agent-actions run -a my_workflow --parallel"
    },
    "option_3_config_driven": {
      "title": "Configuration-driven via workflow YAML",
      "description": "Add execution_mode field to workflow config",
      "pros": [
        "Persistent configuration",
        "Per-workflow control",
        "Documented in workflow file"
      ],
      "cons": [
        "Requires config changes",
        "More complex than auto-detect",
        "Schema changes needed"
      ],
      "config_example": {
        "execution_mode": "auto | sequential | parallel"
      }
    },
    "recommended_approach": {
      "primary": "Option 1: Auto-detect",
      "secondary": "Option 2: CLI flag as override",
      "rationale": "Auto-detect provides best UX, CLI flag allows explicit control when needed"
    }
  },

  "phases": {
    "phase_1_detection_logic": {
      "priority": "critical",
      "description": "Implement parallel loop group detection",
      "status": "completed",
          "completed_date": "2025-10-03",
      "tasks": [
        {
          "id": "add_parallel_loop_detector",
          "title": "Add detect_parallel_loop_groups() to AgentWorkflow",
          "file": "agent_actions/core/graph/agent_workflow.py",
          "implementation": {
            "method_signature": "def _detect_parallel_loop_groups(self) -> bool",
            "logic": [
              "1. Scan execution_order for agents with is_loop_agent=True",
              "2. Filter for agents with loop_mode='parallel'",
              "3. Group agents by loop_base_name",
              "4. For each group, verify all agents have identical dependencies",
              "5. Return True if any parallel loop groups found with >1 agent"
            ],
            "return_value": "True if parallel loops detected, False otherwise"
          },
          "pseudocode": "def _detect_parallel_loop_groups(self) -> bool:\n    # Find all loop agents\n    loop_agents = [\n        agent for agent in self.execution_order\n        if self.agent_configs[agent].get('is_loop_agent')\n        and self.agent_configs[agent].get('loop_mode') == 'parallel'\n    ]\n    \n    if not loop_agents:\n        return False\n    \n    # Group by loop_base_name\n    from collections import defaultdict\n    loop_groups = defaultdict(list)\n    for agent in loop_agents:\n        base_name = self.agent_configs[agent].get('loop_base_name')\n        loop_groups[base_name].append(agent)\n    \n    # Check if any group has multiple agents (actual parallelism)\n    for base_name, agents in loop_groups.items():\n        if len(agents) > 1:\n            # Verify identical dependencies\n            deps = [tuple(self.agent_configs[a].get('dependencies', [])) for a in agents]\n            if len(set(deps)) == 1:  # All have same dependencies\n                return True\n    \n    return False",
          "lines_added": "~30 lines",
          "status": "completed",
          "completed_date": "2025-10-03"
        },
        {
          "id": "add_logging_for_detection",
          "title": "Add console logging for parallel detection",
          "file": "agent_actions/core/graph/agent_workflow.py",
          "implementation": {
            "log_messages": [
              "self.console.print('[blue]Detected parallel loop groups - using async execution[/blue]')",
              "self.console.print(f'[blue]Parallel loops: {loop_group_names}[/blue]')",
              "self.console.print(f'[blue]Expected speedup: {len(agents)}× for {len(loop_groups)} loop groups[/blue]')"
            ]
          },
          "lines_added": "~5 lines",
          "status": "completed",
          "completed_date": "2025-10-03"
        }
      ],
      "validation_requirements": [
        "✓ Detects parallel loops with loop_mode='parallel'",
        "✓ Ignores sequential loops (loop_mode='sequential')",
        "✓ Handles single-iteration loops (no parallelism needed)",
        "✓ Verifies identical dependencies within loop group",
        "✓ Returns False when no parallel loops present"
      ]
    },

