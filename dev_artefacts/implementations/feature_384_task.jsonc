    "discovery_date": "2025-10-03",
    "discovery_method": "User reported batch mode repeatedly resubmitting same batch",
    "phase": "phase_7_post_merge_bug_fix",
    "bugs": [
      {
        "id": "H5",
        "severity": "high",
        "category": "batch_mode",
        "title": "Batch mode repeatedly resubmits same batch in parallel execution",
        "description": "Agents with run_mode='batch' would resubmit the same batch on every workflow run instead of checking batch status",
        "root_cause": "_run_single_agent_async() only checked for 'completed' status, not 'batch_submitted' status like sequential run() does",
        "detection": "User noticed batch jobs being resubmitted repeatedly, never completing",
        "impact": "Batch mode completely broken in parallel execution - workflows would never complete",
        "affected_code": "agent_actions/core/graph/agent_workflow.py:142-178",
        "issue_details": {
          "symptoms": [
            "First run: Agent submits batch → status='batch_submitted' → workflow exits",
            "Second run: Agent with status='batch_submitted' RE-RUNS and RE-SUBMITS same batch",
            "Third run: Same resubmission happens again",
            "Workflow never progresses past first batch agent"
          ],
          "code_comparison": {
            "sequential_run_method": {
              "location": "Lines 602-626",
              "behavior": "if current_status == 'batch_submitted': check batch status via _handle_batch_agent()",
              "works": true
            },
            "async_run_method_before_fix": {
              "location": "Lines 142-146",
              "behavior": "Only checked 'completed' status, skipped 'batch_submitted' check",
              "works": false,
              "bug": "Agents with 'batch_submitted' status fall through and re-execute"
            }
          }
        },
        "solution": {
          "approach": "Add batch_submitted status check in _run_single_agent_async() to mirror sequential run() logic",
          "file": "agent_actions/core/graph/agent_workflow.py",
          "location": "Lines 148-178",
          "implementation": {
            "step_1": "Check if current_status == 'batch_submitted'",
            "step_2": "Set status to 'checking_batch'",
            "step_3": "Call _handle_batch_agent() asynchronously to check batch status",
            "step_4": "Handle 3 outcomes: completed (mark done), in_progress (keep waiting), failed (raise error)",
            "step_5": "Only run agent if status is NOT completed and NOT batch_submitted"
          },
          "code_added": {
            "lines": "148-178",
            "snippet": "# Check if agent has batch already submitted (from previous run)\nif current_status == 'batch_submitted':\n    self._update_status(agent_name, 'checking_batch')\n    \n    # Check batch status instead of re-running agent\n    output_folder, batch_status = await asyncio.to_thread(\n        self._handle_batch_agent,\n        agent_name,\n        agent_idx\n    )\n    \n    if batch_status == 'completed':\n        self._update_status(agent_name, 'completed')\n        self.ephemeral_directories.append({...})\n        return\n    elif batch_status == 'in_progress':\n        self._update_status(agent_name, 'batch_submitted')\n        return\n    else:\n        # Batch failed\n        raise Exception(f'Batch job for {agent_name} failed')"
          }
        },
        "testing": {
          "tests_run": [
            "tests/integration/test_level_parallel_execution.py (6 tests - all pass)",
            "tests/core/graph/test_agent_workflow_sequential_loops.py (9 tests - all pass)",
            "tests/core/graph/test_loop_correlator.py (16 tests - all pass)"
          ],
          "total_tests": "31 tests passing",
          "regression_check": "No regressions - all existing tests still pass",
          "batch_test_note": "test_batch_sequential_loop.py tests already failing (pre-existing - requires real batch backend)"
        },
        "files_modified": [
          {
            "file": "agent_actions/core/graph/agent_workflow.py",
            "lines_added": 31,
            "lines_modified": 0,
            "changes": "Added batch_submitted status handling in _run_single_agent_async()"
          }
        ],
        "validation": {
          "before_fix": "Batch agents repeatedly resubmit same batch, workflow never completes",
          "after_fix": "Batch agents check status, complete when batch finishes, workflow progresses normally",
          "verified_by": "31 passing tests including test_batch_agents_in_parallel_level"
        },
        "lessons_learned": [
          "When implementing new execution modes (async), ensure ALL status transitions from existing modes (sequential) are mirrored",
          "Batch mode has special status lifecycle: pending → running → batch_submitted → checking_batch → completed",
          "Missing a single status check can completely break a feature",
          "Test both sequential AND parallel execution paths for all run modes (online, batch)"
        ],
