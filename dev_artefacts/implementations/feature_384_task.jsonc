        {
          "id": "fix_batch_mode_race_condition",
          "title": "Fix batch mode race condition in parallel levels",
          "severity": "high",
          "file": "agent_actions/core/graph/agent_workflow.py",
          "location": "Lines 74-83 in async_run()",
          "problem": "When multiple batch agents submit in parallel, workflow exits on first submission without checking for failures",
          "impact": "If one batch agent fails while others succeed, workflow exits thinking all succeeded",
          "solution": {
            "approach": "Check for failed agents in same level before early exit",
            "logic": "if any_failed and batch_pending: raise error\nelif batch_pending: return  # All succeeded",
            "preserve_behavior": "Early exit only if all agents succeeded"
          },
          "implementation": {
            "check_failures": "After gather, check if any agent status is 'failed'",
            "raise_error": "If failures detected, raise WorkflowError instead of early exit",
            "add_test": "Add test for partial batch failure in parallel level"
          },
          "lines_modified": 10,
          "status": "completed",
          "completed_date": "2025-10-03"
        },
        {
          "id": "improve_error_context_parallel",
          "title": "Improve error context in parallel execution",
          "severity": "high",
          "file": "agent_actions/core/graph/agent_workflow.py",
          "location": "Line 71 in async_run()",
          "problem": "asyncio.gather uses fail-fast mode - only first error surfaces, masking other issues",
          "impact": "Debugging parallel failures is difficult",
          "solution": {
            "approach": "Use asyncio.gather(*tasks, return_exceptions=True)",
            "aggregate_errors": "Collect all errors and raise comprehensive error message",
            "benefit": "Users see all failures at once for better debugging"
          },
          "implementation": {
            "change": "results = await asyncio.gather(*tasks, return_exceptions=True)",
            "process": "errors = [(agent, result) for agent, result in zip(pending_agents, results) if isinstance(result, Exception)]",
            "raise": "if errors: raise WorkflowError with all error messages",
            "add_test": "Test that all parallel errors are reported"
          },
          "lines_modified": 15,
          "status": "completed",
          "completed_date": "2025-10-03"
        },
        {
          "id": "expose_concurrency_limit_cli",
          "title": "Expose concurrency limit to CLI",
          "severity": "medium",
          "files": [
            "agent_actions/tasks/run.py",
            "agent_actions/agents/validators/run_validator.py",
            "agent_actions/core/graph/agent_workflow.py"
          ],
          "problem": "concurrency_limit=5 is hardcoded, user cannot override",
          "impact": "Can't optimize for different hardware or API rate limits",
          "solution": {
            "add_cli_flag": "@click.option('--concurrency-limit', type=int, default=5)",
            "add_to_args": "concurrency_limit: int = Field(5, description='Max concurrent agents')",
            "use_in_workflow": "asyncio.run(workflow.async_run(concurrency_limit=self.args.concurrency_limit))"
          },
          "lines_added": 10,
          "status": "completed",
          "completed_date": "2025-10-03"
        },
        {
          "id": "optimize_agent_index_lookup",
          "title": "Pre-compute agent indices for O(1) lookup",
          "severity": "medium",
          "file": "agent_actions/core/graph/agent_workflow.py",
          "problem": "Uses self.execution_order.index(agent) - O(n) lookup per agent",
          "impact": "Performance degrades with large workflows",
          "solution": {
            "add_to_init": "self.agent_indices = {agent: i for i, agent in enumerate(self.execution_order)}",
            "replace_usage": "agent_idx = self.agent_indices[agent_name]"
          },
          "lines_added": 1,
          "lines_modified": 2,
          "status": "completed",
          "completed_date": "2025-10-03"
        },
        {
          "id": "preserve_execution_order_logs",
          "title": "Preserve execution order in parallel logs",
          "severity": "medium",
          "file": "agent_actions/core/graph/agent_workflow.py",
          "problem": "Log messages don't preserve original execution order",
          "impact": "User can't correlate logs to config file order",
          "solution": {
            "sort_before_log": "sorted_agents = sorted(level_agents, key=lambda a: self.agent_indices[a])",
            "use_sorted": "Use sorted_agents in log messages"
          },
          "lines_modified": 5,
          "status": "completed",
          "completed_date": "2025-10-03"
        },
        {
          "id": "fix_loop_agent_file_path_resolution",
          "title": "Fix loop agents receiving staging paths instead of dependency target paths",
          "severity": "high",
          "file": "agent_actions/core/graph/agent_workflow.py",
          "location": "File path resolution for loop agents",
          "problem": "Loop agents in parallel execution receive staging paths instead of target paths from their dependencies. generate_distractors loop agents get '.../agent_io/staging/Azure_ai_combined_mslearn.json' instead of '.../agent_io/target/node_10_add_answer_text/Azure_ai_combined_mslearn.json'",
          "impact": "Loop agents fail with 'Path structure error when deriving source' when running in parallel, breaking workflows",
          "discovered_during": "Testing parallel execution with qanalabs-quiz-gen workflow",
          "error_message": "Path structure error when deriving source [Context: file_path=/Users/muizz/Documents/codeshop/qanalabs/qanalabs-actions/qanalabs/agent_workflow/qanalabs-quiz-gen/agent_io/staging/Azure_ai_combined_mslearn.json]",
          "root_cause": "source_data_loader.py expects 'agent_io/target/node_X_agent_name/' structure but receives 'agent_io/staging/' path",
          "solution": {
            "approach": "Ensure loop agents resolve input file paths from their dependency's output directory",
            "investigation_needed": true,
            "steps": [
              "1. Find where loop agents get their file_path parameter",
              "2. Verify dependency output path is correctly passed to loop agents",
              "3. Check if this is specific to parallel execution or affects sequential too",
              "4. Fix path resolution to use dependency's target output directory",
              "5. Add test for loop agent file path resolution"
            ]
          },
          "affected_workflow": "qanalabs-quiz-gen with generate_distractors loop (3 iterations)",
          "test_case": {
            "setup": "Workflow with loop agents depending on previous agent",
            "expected": "Loop agents receive '.../agent_io/target/node_X_dependency_name/file.json'",
            "actual": "Loop agents receive '.../agent_io/staging/file.json'",
            "verify": "Loop agents can successfully load source data from dependency output"
          },
          "lines_to_investigate": [
            "agent_actions/core/graph/agent_workflow.py - where file paths are passed to agents",
            "agent_actions/agents/extractors/source_data_loader.py:41-140 - where path validation happens"
          ],
          "status": "completed",
          "completed_date": "2025-10-03"
        }
      ],
