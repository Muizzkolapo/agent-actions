{
  "title": "Implement Unified Field Referencing Pattern {reference.field} (Issue #429)",
  "issue": "#429",
  "priority": "high",
  "type": "feature",
  "description": "Replace inconsistent field access patterns (source_context{{}}, return_collection[]) with unified {reference.field} syntax for clear, explicit field referencing in agent prompts.",

  "current_state": {
    "what_exists": {
      "return_collection_pattern": {
        "file": "agent_actions/agents/transformers/prompt_utils.py",
        "lines": "59-87",
        "pattern": "return_collection[field1, field2]",
        "functionality": [
          "Case-insensitive field matching",
          "Multiple field extraction",
          "Nested dict navigation",
          "Flattens nested structures"
        ],
        "problems": [
          "Ambiguous - doesn't show data source",
          "Unclear which agent's output being accessed",
          "Can't explicitly reference dependency fields"
        ]
      },
      "source_context_pattern": {
        "file": "agent_actions/agents/transformers/prompt_utils.py",
        "lines": "92-149",
        "pattern": "source_context{{['field']}}",
        "functionality": [
          "Access original workflow input",
          "Field selection with list syntax",
          "Returns JSON formatted content"
        ],
        "problems": [
          "Verbose and unintuitive syntax",
          "Inconsistent with other patterns",
          "Double braces confusing"
        ]
      },
      "dispatch_task_pattern": {
        "file": "agent_actions/agents/transformers/prompt_utils.py",
        "lines": "152-217",
        "pattern": "dispatch_task(function_name)",
        "functionality": "Calls user-defined functions",
        "status": "✅ Keep as is - works well"
      },
      "prompt_formatting": {
        "file": "agent_actions/agents/transformers/prompt_formatter.py",
        "lines": "40-71",
        "method": "format_prompt()",
        "flow": [
          "Get raw prompt",
          "Replace source_context placeholder",
          "Replace return_collection placeholders",
          "Return formatted prompt"
        ]
      }
    },
    "what_is_missing": {
      "unified_pattern": {
        "problem": "No single consistent pattern for field access",
        "needed": "{reference.field} syntax for all field references"
      },
      "explicit_dependency_access": {
        "problem": "Can't explicitly reference {agent.field}",
        "needed": "Clear syntax to access dependency outputs"
      },
      "source_reference": {
        "problem": "source_context{{}} is awkward",
        "needed": "{source.field} for consistency"
      },
      "context_building": {
        "problem": "No centralized context with all available references",
        "needed": "Build context with source + all dependency outputs"
      }
    }
  },

  "problem_statement": {
    "user_pain_points": [
      "return_collection[metrics] - from which agent?",
      "source_context{{['field']}} - too verbose",
      "Can't explicitly reference dependency fields",
      "Inconsistent patterns are confusing",
      "Makes field validation impossible (#412)"
    ],
    "examples": [
      {
        "problem": "Ambiguous dependency access",
        "current": "return_collection[metrics]",
        "issue": "Which agent does this come from?",
        "desired": "{extractor.metrics}"
      },
      {
        "problem": "Verbose source access",
        "current": "source_context{{['page_content']}}",
        "issue": "Too complex, inconsistent syntax",
        "desired": "{source.page_content}"
      },
      {
        "problem": "No explicit cross-agent references",
        "current": "Can't do it",
        "issue": "Need to reference specific agent fields",
        "desired": "{extractor.metrics} and {classifier.labels}"
      }
    ]
  },

  "solution_overview": {
    "approach": "Implement unified {reference.field} pattern for all field access",
    "key_patterns": [
      "{source.field} - Original workflow input",
      "{agent.field} - Dependency agent output",
      "{agent.nested.field} - Nested field access",
      "dispatch_task() - User functions (unchanged)"
    ],
    "backward_compatibility": "Phase in with deprecation warnings, then remove old patterns",
    "migration": "Provide auto-migration tool for existing configs"
  },

  "implementation_approach": {
    "pattern_recognition": {
      "regex": "r'\\{([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)+)\\}'",
      "matches": [
        "{source.page_content}",
        "{extractor.metrics}",
        "{analyzer.results.count}",
        "{loop.item.id}"
      ],
      "does_not_match": [
        "{field} - single word, no dot",
        "{{field}} - double braces",
        "{123.field} - starts with number"
      ]
    },
    "reference_resolution": {
      "steps": [
        "1. Parse reference into parts: 'extractor.metrics.count' → ['extractor', 'metrics', 'count']",
        "2. Get reference name: parts[0] = 'extractor'",
        "3. Get field path: parts[1:] = ['metrics', 'count']",
        "4. Look up reference in context: context['extractor']",
        "5. Navigate field path: data['metrics']['count']",
        "6. Return resolved value"
      ],
      "error_cases": [
        "Reference not in context → 'Reference extractor not found. Available: [source, preprocessor]'",
        "Field not found → 'Field metrics.count not found in extractor'",
        "Invalid field type → 'Cannot access field on non-dict type'"
      ]
    },
    "context_building": {
      "structure": {
        "source": "Original workflow input (first source item)",
        "agent_name": "Each dependency agent's output",
        "loop": "Loop context (if in loop)",
        "workflow": "Workflow metadata"
      },
      "example": {
        "source": {"page_content": "...", "metadata": {}},
        "extractor": {"metrics": {}, "summary": "..."},
        "preprocessor": {"cleaned_text": "..."},
        "loop": {"index": 0, "item": {}}
      }
    }
  },

  "phases": {
    "phase_1_core_implementation": {
      "priority": "critical",
      "status": "✅ COMPLETED (2025-10-05)",
      "description": "Implement core {reference.field} pattern matching and resolution",
      "tasks": [
        {
          "id": "add_field_reference_parser",
          "status": "✅ completed",
          "title": "Add parse_field_references() to PromptUtils",
          "file": "agent_actions/agents/transformers/prompt_utils.py",
          "implementation": {
            "method": "parse_field_references(prompt: str) -> List[FieldReference]",
            "logic": [
              "1. Use regex to find all {reference.field} patterns",
              "2. Parse each into reference name and field path",
              "3. Return list of FieldReference objects"
            ],
            "regex": "r'\\{([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)+)\\}'",
            "return_type": "List[FieldReference(reference: str, field_path: List[str], full_match: str)]"
          },
          "pseudocode": "@staticmethod\ndef parse_field_references(prompt: str) -> List[Dict]:\n    pattern = r'\\{([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)+)\\}'\n    references = []\n    \n    for match in re.finditer(pattern, prompt):\n        full_ref = match.group(1)  # 'extractor.metrics.count'\n        parts = full_ref.split('.')\n        \n        references.append({\n            'reference': parts[0],      # 'extractor'\n            'field_path': parts[1:],    # ['metrics', 'count']\n            'full_match': match.group(0) # '{extractor.metrics.count}'\n        })\n    \n    return references",
          "lines_added": "~25 lines"
        },
        {
          "id": "add_resolve_field_reference",
          "status": "✅ completed",
          "title": "Add resolve_field_reference() to PromptUtils",
          "file": "agent_actions/agents/transformers/prompt_utils.py",
          "implementation": {
            "method": "resolve_field_reference(reference: str, field_path: List[str], context: dict) -> Any",
            "logic": [
              "1. Check if reference exists in context",
              "2. Navigate field path through nested dicts",
              "3. Handle errors for missing refs/fields",
              "4. Return resolved value"
            ]
          },
          "pseudocode": "@staticmethod\ndef resolve_field_reference(reference: str, field_path: List[str], context: dict) -> Any:\n    # Check reference exists\n    if reference not in context:\n        available = ', '.join(context.keys())\n        raise ValueError(\n            f\"Reference '{reference}' not found. Available: [{available}]\"\n        )\n    \n    data = context[reference]\n    \n    # Navigate field path\n    for field in field_path:\n        if isinstance(data, dict) and field in data:\n            data = data[field]\n        elif isinstance(data, list) and field.isdigit():\n            # Handle array index: {agent.items.0}\n            idx = int(field)\n            if 0 <= idx < len(data):\n                data = data[idx]\n            else:\n                raise ValueError(f\"Index {idx} out of range\")\n        else:\n            field_str = '.'.join(field_path)\n            raise ValueError(\n                f\"Field '{field_str}' not found in '{reference}'\"\n            )\n    \n    return data",
          "lines_added": "~30 lines"
        },
        {
          "id": "add_replace_field_references",
          "status": "✅ completed",
          "title": "Add replace_field_references() to PromptUtils",
          "file": "agent_actions/agents/transformers/prompt_utils.py",
          "implementation": {
            "method": "replace_field_references(prompt: str, context: dict) -> str",
            "logic": [
              "1. Parse all field references from prompt",
              "2. Resolve each reference using context",
              "3. Convert value to string (JSON if dict/list)",
              "4. Replace in prompt",
              "5. Return updated prompt"
            ]
          },
          "pseudocode": "@staticmethod\ndef replace_field_references(prompt: str, context: dict) -> str:\n    references = PromptUtils.parse_field_references(prompt)\n    \n    for ref in references:\n        try:\n            value = PromptUtils.resolve_field_reference(\n                ref['reference'],\n                ref['field_path'],\n                context\n            )\n            \n            # Convert to string\n            if isinstance(value, (dict, list)):\n                value_str = json.dumps(value, indent=2)\n            else:\n                value_str = str(value)\n            \n            # Replace in prompt\n            prompt = prompt.replace(ref['full_match'], value_str)\n            \n        except ValueError as e:\n            # Re-raise with context\n            raise ValueError(\n                f\"Error resolving {ref['full_match']}: {str(e)}\"\n            )\n    \n    return prompt",
          "lines_added": "~25 lines"
        },
        {
          "id": "integrate_into_format_prompt",
          "status": "✅ completed",
          "title": "Integrate into PromptFormatter.format_prompt()",
          "file": "agent_actions/agents/transformers/prompt_formatter.py",
          "lines": "40-71",
          "implementation": {
            "add_context_param": "format_prompt(raw_prompt, source_content, context_data, field_context=None)",
            "update_logic": [
              "1. First replace source_context (keep for backward compat)",
              "2. Then replace {reference.field} patterns (NEW)",
              "3. Then replace return_collection (keep for backward compat)",
              "4. Return formatted prompt"
            ]
          },
          "pseudocode": "@staticmethod\ndef format_prompt(raw_prompt, source_content, context_data, field_context=None):\n    try:\n        # Backward compat: source_context{{}}\n        source_loaded_prompt = PromptUtils.replace_source_context_placeholder(\n            raw_prompt,\n            source_content\n        )\n        \n        # NEW: {reference.field} pattern\n        if field_context:\n            source_loaded_prompt = PromptUtils.replace_field_references(\n                source_loaded_prompt,\n                field_context\n            )\n        \n        # Backward compat: return_collection[]\n        formatted_prompt, _ = PromptUtils.replace_placeholders(\n            source_loaded_prompt,\n            context_data\n        )\n        \n        return formatted_prompt\n    except Exception as e:\n        raise PromptValidationError(...)",
          "lines_modified": "~15 lines"
        },
        {
          "id": "build_field_context",
          "status": "✅ completed",
          "title": "Add context building in agent execution",
          "file": "agent_actions/agents/generators/data_generator.py",
          "implementation": {
            "location": "Where agent is executed with dependencies",
            "logic": [
              "1. Get source data (original workflow input)",
              "2. Get all dependency outputs",
              "3. Build field_context dict",
              "4. Pass to format_prompt()"
            ]
          },
          "pseudocode": "# In agent execution\ndef run_agent(agent_config, source_data, dependency_outputs):\n    # Build field context\n    field_context = {\n        'source': source_data  # Original workflow input\n    }\n    \n    # Add all dependency outputs\n    for dep_name, dep_output in dependency_outputs.items():\n        field_context[dep_name] = dep_output\n    \n    # Add loop context if in loop\n    if agent_config.get('is_loop_agent'):\n        field_context['loop'] = {\n            'index': loop_iteration,\n            'item': current_item\n        }\n    \n    # Format prompt with field context\n    formatted_prompt = PromptFormatter.format_prompt(\n        raw_prompt,\n        source_content,\n        context_data,\n        field_context=field_context  # NEW parameter\n    )",
          "lines_added": "~20 lines"
        }
      ],
      "validation_requirements": [
        "✅ Regex correctly matches {reference.field} patterns",
        "✅ Nested field access works: {agent.data.nested.field}",
        "✅ Array index access works: {agent.items.0}",
        "✅ Error messages clear for missing refs/fields",
        "✅ Context built correctly with source + dependencies",
        "✅ Integration with format_prompt() works"
      ],
      "completion_summary": "All tasks completed. 24/24 tests passing. No regressions. Backward compatible."
    },

