  "technical_considerations": {
    "pattern_priority": {
      "order": [
        "1. {reference.field} - NEW pattern (highest priority)",
        "2. source_context{{}} - OLD, backward compat with warning",
        "3. return_collection[] - OLD, backward compat with warning",
        "4. dispatch_task() - Keep as is"
      ],
      "note": "Process in order, newer patterns override older ones"
    },
    "value_serialization": {
      "dict_or_list": "JSON.dumps(value, indent=2)",
      "string": "value",
      "number": "str(value)",
      "bool": "str(value).lower()",
      "none": "'null'"
    },
