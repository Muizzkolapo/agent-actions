{
  "title": "Fix prompt_debug Not Working in Loop Agents",
  "issue_number": "TBD",
  "date": "2025-01-07",
  "priority": "medium",
  "type": "bugfix",
  "status": "✅ COMPLETED",
  "affected_versions": "All versions up to 2025-01-07",

  "executive_summary": {
    "problem": "prompt_debug configuration was being ignored for loop agents - setting prompt_debug: false had no effect, debug output still appeared",
    "root_cause": "prompt_debug and json_mode fields were missing from the AgentConfig Pydantic model, causing values to be stored as 'extra' fields which weren't properly preserved through the configuration pipeline for loop agents",
    "solution": "Added prompt_debug and json_mode as explicit fields to the AgentConfig Pydantic model",
    "impact": "Loop agents now properly respect prompt_debug configuration, fixing debug output control",
    "files_changed": 1,
    "lines_changed": "+9 lines",
    "fix_complexity": "Simple - single file, clear fix"
  },

  "bug_details": {
    "reported_by": "User",
    "symptom": "Loop agents show debug output even when prompt_debug: false is set",
    "reproduction": {
      "workflow_config": {
        "defaults": {
          "prompt_debug": false
        },
        "actions": [
          {
            "name": "generate_distractors",
            "loop": {
              "param": "stage",
              "range": [1, 3]
            },
            "prompt_debug": false,
            "comment": "// ISSUE: PROMPT DEBUG NOT WORKING IN LOOP"
          }
        ]
      },
      "expected_behavior": "No debug output should appear for generate_distractors_1, generate_distractors_2, generate_distractors_3",
      "actual_behavior": "Debug output appears with 'DEBUG MODE: Prompt being sent to the agent' messages despite prompt_debug: false",
      "scope": "Only affected loop agents (actions with loop configuration). Regular actions worked correctly."
    },

    "initial_investigation_results": {
      "actionexpander_check": {
        "status": "✅ WORKING CORRECTLY",
        "finding": "ActionExpander.expand_actions_to_agents() correctly sets prompt_debug=False on all loop agents",
        "test_output": "generate_distractors_1: prompt_debug=False\ngenerate_distractors_2: prompt_debug=False\ngenerate_distractors_3: prompt_debug=False",
        "conclusion": "Configuration inheritance via inherit_simple_fields() was working as designed"
      },

      "runtime_check": {
        "status": "❌ ISSUE FOUND",
        "finding": "prompt_debug value was being lost when agent configs were converted to Pydantic models",
        "location": "ConfigManager.get_all_agent_configs_as_dicts() at config_handler.py:270-296"
      }
    }
  },

  "root_cause_analysis": {
    "primary_issue": {
      "description": "AgentConfig Pydantic model missing prompt_debug and json_mode fields",
      "file": "agent_actions/core/parser/config_schema.py",
      "lines": "157-225 (AgentConfig class definition)",
      "explanation": [
        "The AgentConfig Pydantic model defines the schema for agent configurations",
        "It had model_config = ConfigDict(extra='allow') which allows extra fields",
        "prompt_debug and json_mode were being stored as 'extra' fields, not explicit fields",
        "When configs passed through ConfigManager's Pydantic serialization, these values became inconsistent",
        "For loop agents specifically, the model_dump() serialization wasn't properly preserving these extra fields in all contexts"
      ]
    },

    "why_loops_specifically": {
      "explanation": [
        "Loop agents go through more config transformations than regular agents:",
        "1. ActionExpander creates loop agents (generate_distractors_1, _2, _3) with correct prompt_debug=False",
        "2. Configs are converted to Pydantic AgentConfig models in ConfigManager",
        "3. Models are serialized back to dicts via model_dump() for runtime use",
        "4. Loop correlation system accesses these configs during execution",
        "Because of the extra serialization/deserialization steps for loop agents, the 'extra' field behavior became problematic"
      ],

      "regular_agents_worked_because": [
        "Regular agents had simpler config paths with fewer transformations",
        "Even though they also used 'extra' fields, the runtime code path preserved the values",
        "Loop agents' additional processing exposed the fragility of relying on 'extra' fields"
      ]
    },

    "evidence": {
      "pydantic_model_inspection": {
        "test_command": "AgentConfig.model_fields",
        "result_before_fix": {
          "prompt_debug": false,
          "json_mode": false,
          "few_shot": true,
          "comment": "prompt_debug and json_mode not in model_fields, stored as 'extra'"
        },
        "result_after_fix": {
          "prompt_debug": true,
          "json_mode": true,
          "few_shot": true,
          "comment": "All fields now properly defined"
        }
      },

      "model_dump_behavior": {
        "before_fix": "Fields present in dump but inconsistently accessed in some contexts",
        "after_fix": "Fields reliably present and accessible in all contexts"
      }
    }
  },

  "the_fix": {
    "approach": "Add missing fields as explicit Pydantic fields with proper defaults and descriptions",

    "implementation": {
      "file": "agent_actions/core/parser/config_schema.py",
      "location": "After line 181 (data_source field)",
      "code_added": {
        "description": "Added LLM configuration section with json_mode and prompt_debug fields",
        "lines_added": 9,
        "code": [
          "",
          "# LLM configuration options",
          "json_mode: bool = Field(",
          "    default=True,",
          "    description=\"Enable JSON mode for structured output\"",
          ")",
          "prompt_debug: bool = Field(",
          "    default=False,",
          "    description=\"Enable debug output showing prompts being sent to the agent\"",
          ")"
        ]
      }
    },

    "why_this_fixes_it": [
      "Explicit Pydantic fields are always preserved during model_dump() and model serialization",
      "Default values are consistently applied across all agent types",
      "Field validation ensures type correctness (bool, not string or other types)",
      "Documentation via Field descriptions improves code maintainability",
      "Eliminates reliance on 'extra' field behavior which was inconsistent"
    ],

    "defaults_rationale": {
      "json_mode": {
        "default": true,
        "reason": "System is JSON-based by default, matches existing SIMPLE_CONFIG_FIELDS default"
      },
      "prompt_debug": {
        "default": false,
        "reason": "Debug output should be opt-in, matches existing SIMPLE_CONFIG_FIELDS default"
      }
    }
  },

  "verification": {
    "unit_tests": {
      "test_1": {
        "name": "Pydantic model field presence",
        "command": "'prompt_debug' in AgentConfig.model_fields",
        "result": "✅ True (was False before fix)"
      },

      "test_2": {
        "name": "Default value application",
        "code": "AgentConfig(agent_type='test').model_dump()",
        "result": "✅ {'prompt_debug': False, 'json_mode': True, ...}"
      },

      "test_3": {
        "name": "Explicit False preservation",
        "code": "AgentConfig(agent_type='test', prompt_debug=False).model_dump()",
        "result": "✅ {'prompt_debug': False, ...}"
      }
    },

    "integration_tests": {
      "test_1": {
        "name": "ActionExpander to Pydantic round-trip",
        "steps": [
          "1. ActionExpander.expand_actions_to_agents() creates loop agents with prompt_debug=False",
          "2. Convert each agent dict to AgentConfig(**agent_dict)",
          "3. Call model_dump() on each model",
          "4. Verify prompt_debug=False in all dumped configs"
        ],
        "result": "✅ All loop agents preserve prompt_debug=False through entire pipeline"
      },

      "test_2": {
        "name": "Loop agent specific validation",
        "workflow": {
          "defaults": {"prompt_debug": false},
          "actions": [
            {
              "name": "generate_distractors",
              "loop": {"param": "stage", "range": [1, 3]},
              "prompt_debug": false
            }
          ]
        },
        "verification": "All 3 loop agents (generate_distractors_1, _2, _3) have prompt_debug=False after full pipeline",
        "result": "✅ PASS"
      }
    },

    "end_to_end_validation": {
      "test_scenario": "User's actual qanalabs-quiz-gen workflow with loop agents",
      "expected_outcome": [
        "generate_distractors_1, _2, _3 with prompt_debug: False → no debug output",
        "QuizTaker with prompt_debug: true → shows debug output",
        "Other agents inherit from defaults (prompt_debug: false) → no debug output"
      ],
      "status": "Ready for user testing"
    }
  },

  "related_context": {
    "issue_434_connection": {
      "title": "Automate Config Field Inheritance in ActionExpander",
      "relevance": "Issue #434 fixed the ActionExpander side by creating inherit_simple_fields() which properly handles prompt_debug",
      "this_bug_shows": "Even though ActionExpander was fixed, the Pydantic model layer also needed the fields defined",
      "lesson": "Config fields must be defined at ALL layers: ActionExpander inheritance, Pydantic model schema, runtime access"
    },

    "previously_affected_fields": {
      "json_mode": "Also missing from AgentConfig, fixed in same commit",
      "few_shot": "Was already properly defined as 'few_shot: int = Field(default=0, ge=0)'",
      "other_fields": "Most other fields were already explicitly defined in the model"
    }
  },

  "impact_assessment": {
    "before_fix": {
      "user_experience": "Confusing - setting prompt_debug: false had no effect for loop agents",
      "workaround": "None - users couldn't disable debug output for loop agents",
      "affected_users": "Anyone using loops with prompt_debug configuration",
      "severity": "Medium - annoying but not data-corrupting"
    },

    "after_fix": {
      "user_experience": "prompt_debug works consistently for all agent types",
      "behavior": "Setting prompt_debug: false properly suppresses debug output for loop agents",
      "backwards_compatibility": "✅ Fully compatible - only changes internal behavior, no API changes",
      "testing_required": "Basic smoke test with loop workflow"
    }
  },

  "lessons_learned": {
    "configuration_layers": [
      "YAML → ActionExpander → Pydantic models → Runtime execution",
      "Fields must be properly defined at EACH layer",
      "Extra fields (extra='allow') are fragile and should be avoided for core config"
    ],

    "pydantic_best_practices": [
      "Always define expected fields explicitly, don't rely on extra='allow'",
      "Use Field() with defaults and descriptions for clarity",
      "Test model_dump() round-trips for all critical fields"
    ],

    "testing_gaps": [
      "Need integration tests that verify config preservation through full pipeline",
      "Loop-specific tests should verify all config fields, not just core ones",
      "Runtime behavior tests should validate config values are actually used"
    ]
  },

  "file_changes": {
    "modified": [
      {
        "file": "agent_actions/core/parser/config_schema.py",
        "lines_changed": "+9",
        "description": "Added json_mode and prompt_debug as explicit fields to AgentConfig class",
        "diff_summary": {
          "location": "After line 181 (data_source field)",
          "additions": [
            "# LLM configuration options section",
            "json_mode field with Field(default=True)",
            "prompt_debug field with Field(default=False)"
          ]
        }
      }
    ]
  },

  "testing_checklist": {
