        "openai": "Not overridden - uses base default",
        "ollama": "Not overridden - uses base default"
      },
      "standardization_approach": "Template Method with hook",
      "template_method_hooks": [
        "_validate_provider_specific_config(agent_config: Dict) -> Tuple[bool, Optional[str]]"
      ],
      "base_class_implementation": {
        "method": "validate_config(agent_config: Dict) -> Tuple[bool, Optional[str]]",
        "logic": [
          "# Base validation (common to all)",
          "if not agent_config:",
          "    return (False, 'agent_config is required')",
          "",
          "# Provider-specific validation",
          "return self._validate_provider_specific_config(agent_config)"
