  "critical_bugs_found": {
    "bug_1": {
      "severity": "HIGH",
      "location": "gemini/provider.py:137",
      "issue": "submit_batch() return type mismatch",
      "description": "Returns str instead of Tuple[str, str] - breaks BatchProvider interface contract",
      "impact": "Callers expecting (batch_id, status) tuple will fail",
      "fix": "Return (batch_job.name, 'in_progress') instead of batch_job.name"
    },
    "bug_2": {
      "severity": "MEDIUM",
      "location": "gemini/provider.py:235-243",
      "issue": "validate_config() has hidden side effect",
      "description": "Stores _last_model_name instance variable without clear indication",
      "impact": "Confusing coupling between validation and state management",
      "fix": "Extract to _store_model_name() or document clearly"
    },
    "bug_3": {
      "severity": "LOW",
      "location": "openai/provider.py:88-91, ollama/provider.py:119-122",
      "issue": "Duplicate JSON parsing logic",
      "description": "Same try/except pattern repeated multiple times",
      "impact": "Maintenance burden, inconsistent error handling",
      "fix": "Use base class _parse_json_content() helper"
    }
  },

