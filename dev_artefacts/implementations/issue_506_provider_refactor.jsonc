      "standardization_approach": "Template Method with significant provider variation",
      "template_method_hooks": [
        "_prepare_batch_input_file(tasks: List[Dict], batch_dir: Path, batch_name: str) -> Path",
        "_submit_to_provider_api(input_file: Path, batch_name: str) -> Tuple[str, str]"
      ],
      "base_class_implementation": {
        "method": "submit_batch(tasks: List[Dict], batch_name: str, output_directory: Optional[str]) -> Tuple[str, str]",
        "logic": [
          "batch_dir = self._get_batch_directory(output_directory)",
          "input_file = self._prepare_batch_input_file(tasks, batch_dir, batch_name)",
          "logger.info(f'Submitting batch with {len(tasks)} tasks to {self.__class__.__name__}...')",
          "return self._submit_to_provider_api(input_file, batch_name)"
        ]
      },
      "savings_per_provider": "5-15 LOC",
      "total_savings": "40-60 LOC",
      "risk": "MEDIUM",
      "fixes_bug": "Gemini return type mismatch"
