      "common_pattern": "try: status = client.check(batch_id)\nexcept VendorAPIError: handle error\nreturn normalize_status(status)",
      "standardization_approach": "Template Method",
      "template_method_hooks": [
        "_fetch_status(batch_id: str) -> str - Provider-specific API call",
        "_normalize_status(raw_status: str) -> str - Provider-specific mapping"
      ],
      "base_class_implementation": {
        "method": "check_status(batch_id: str) -> str",
        "logic": [
          "try:",
          "    raw_status = self._fetch_status(batch_id)",
          "    return self._normalize_status(raw_status)",
          "except Exception as e:",
          "    raise self._handle_status_error(batch_id, e)"
        ]
      },
      "savings_per_provider": "2-8 LOC",
      "total_savings": "32 LOC",
      "risk": "LOW"
    },
    "validate_config": {
      "similarity": "20%",
      "current_state": {
        "anthropic": "Lines 399-417 (19 LOC) - Validates version and caching params",
