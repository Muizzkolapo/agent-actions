    },
    "retrieve_results": {
      "similarity": "70%",
      "current_state": {
        "anthropic": "Lines 303-355 (53 LOC)",
        "openai": "Lines 134-183 (50 LOC)",
        "gemini": "Lines 177-233 (57 LOC)",
        "ollama": "Lines 290-301 (12 LOC)"
      },
      "common_pattern": [
        "1. Check batch status (if not completed, return [])",
        "2. Fetch raw results with retry logic",
        "3. Write to file if output_directory specified",
        "4. Parse results line by line",
        "5. Return List[BatchResult]"
      ],
      "standardization_approach": "Template Method with pipeline",
      "template_method_hooks": [
        "_fetch_raw_results(batch_id: str) -> bytes - Provider-specific fetch",
        "_get_result_file_name(batch_id: str) -> str - Provider-specific naming"
      ],
      "base_class_implementation": {
        "method": "retrieve_results(batch_id: str, output_directory: Optional[str]) -> List[BatchResult]",
        "pipeline": [
          "1. status = self.check_status(batch_id)",
          "2. if status != 'completed': return []",
          "3. raw_results = self._retry_with_backoff(lambda: self._fetch_raw_results(batch_id))",
          "4. if output_directory:",
          "       file_path = self._write_results_to_file(batch_id, raw_results, output_directory)",
          "   else:",
          "       file_path = self._write_results_to_temp_file(batch_id, raw_results)",
          "5. return self._read_jsonl_file(file_path)"
        ]
      },
      "savings_per_provider": "35-45 LOC",
      "total_savings": "140-180 LOC",
      "risk": "MEDIUM"
    },
    "parse_provider_response": {
      "similarity": "60%",
      "current_state": {
        "anthropic": "Lines 95-214 (119 LOC, CC 49) - HIGHLY COMPLEX",
        "openai": "Lines 57-93 (37 LOC, CC 8) - Simple dict access",
        "gemini": "Lines 73-120 (48 LOC, CC 10) - Candidate list parsing",
        "ollama": "Lines 79-139 (61 LOC, CC 9) - OpenAI-format parsing"
      },
      "common_pattern": [
        "1. Extract custom_id",
        "2. Check for errors",
        "3. Extract content from response",
        "4. Try parsing content as JSON",
        "5. Extract usage/metadata",
        "6. Return BatchResult"
      ],
      "standardization_approach": "Template Method with Strategy Pattern for content extraction",
      "template_method_hooks": [
        "_extract_error_from_response(response: Any) -> Optional[str]",
        "_extract_content_from_response(response: Any) -> Any",
        "_extract_metadata_from_response(response: Any) -> Dict",
        "_extract_usage_from_response(response: Any) -> Optional[Dict]"
      ],
      "base_class_implementation": {
        "method": "parse_provider_response(raw_response: Any) -> BatchResult",
        "pipeline": [
          "custom_id = self._extract_custom_id(raw_response)",
          "error = self._extract_error_from_response(raw_response)",
          "if error:",
          "    return BatchResult(custom_id, None, False, error)",
          "",
          "content = self._extract_content_from_response(raw_response)",
          "content = self._parse_json_content(content) if isinstance(content, str) else content",
          "metadata = self._extract_metadata_from_response(raw_response)",
          "usage = self._extract_usage_from_response(raw_response)",
          "",
          "return BatchResult(custom_id, content, True, None, metadata, usage)"
        ]
      },
      "anthropic_specific_refactoring": {
        "goal": "Reduce CC 49 → 8-12",
        "extracted_helpers": [
          "_get_attribute_or_key() - Unified object/dict accessor",
          "_extract_tool_use_content() - Tool use extraction",
          "_extract_text_content() - Text block extraction",
          "_parse_content_list() - Content list processing"
        ]
      },
      "savings_per_provider": "10-30 LOC (Anthropic: 70+ LOC)",
      "total_savings": "150-200 LOC",
      "risk": "HIGH - Most complex refactoring"
    },
    "submit_batch": {
