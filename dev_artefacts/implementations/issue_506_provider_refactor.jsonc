        "_wrap_provider_request(body: Dict, custom_id: str) -> Dict"
      ],
      "base_class_implementation": {
        "method": "format_task_for_provider(batch_task: BatchTask, schema: Optional[Dict]) -> Dict",
        "logic": [
          "messages = self._build_provider_messages(batch_task.prompt, batch_task.user_content)",
          "body = self._build_provider_request_body(messages, batch_task.model_config, schema)",
          "return self._wrap_provider_request(body, batch_task.custom_id)"
        ]
      },
