{
  "issue": "487",
  "title": "Extract Shared Prompt Preparation Service",
  "status": "planned",
  "priority": "high",
  "estimated_effort": "2-3 days",
  "context": {
    "problem": "Online and batch modes have duplicated prompt preparation logic in separate code paths, leading to divergent behavior and maintenance burden",
    "discovery": "While implementing context_scope feature, it worked in online mode but completely failed in batch mode because the implementations diverged",
    "related_work": {
      "pr_499": {
        "issue": "492",
        "scope": "Extracted FilterService, LLMContextBuilder, and PromptFormatter",
        "impact": "Eliminated ~160 lines of duplication for filtering and context building",
        "limitation": "Did NOT extract the full prompt preparation orchestration - still have duplicated workflow"
      }
    },
    "current_state_after_pr_499": {
      "shared_components": [
        "PromptFormatter.get_raw_prompt() - unified prompt loading",
        "LLMContextBuilder - unified LLM context building (mode-specific implementations)",
        "FilterService - unified WHERE clause filtering"
      ],
      "still_duplicated": [
        "Calling ContextScopeProcessor.build_field_context_with_history() in both modes",
        "Calling ContextScopeProcessor.apply_context_scope() in both modes",
        "Calling PromptUtils.replace_field_references() in both modes",
        "Few-shot sample enrichment (SampleEnricher.append_few_shot_samples())",
        "Different orchestration logic for when/how to apply transformations",
        "BUG: Batch mode appears to skip few-shot sample enrichment entirely!"
      ]
    }
  },

  "current_implementations": {
    "online_mode": {
      "file": "agent_actions/prompt_generation/data_generator.py",
      "method": "_format_prompt",
      "lines": "110-159",
      "flow": [
        "1. PromptFormatter.get_raw_prompt() - load prompt",
        "2. _build_namespaced_field_context() - wrapper around ContextScopeProcessor.build_field_context_with_history()",
        "3. ContextScopeProcessor.apply_context_scope() - split into prompt/llm/passthrough contexts",
        "4. PromptUtils.replace_field_references() - {action.field} substitution",
        "5. SampleEnricher.append_few_shot_samples() - add examples (in create_agent_with_data)",
        "6. run_dynamic_agent() receives llm_context separately"
      ]
    },
    "batch_mode": {
      "file": "agent_actions/llm_invocation/batch/batch_service.py",
      "method": "prepare_batch_tasks_from_data",
      "lines": "263-373",
      "flow": [
        "1. PromptFormatter.get_raw_prompt() - load prompt",
        "2. ContextScopeProcessor.build_field_context_with_history() - build field context with history",
        "3. ContextScopeProcessor.apply_context_scope() - split into prompt/llm/passthrough contexts",
        "4. LLMContextBuilder.build_llm_context_for_batch() - merge row_content + llm_context + apply drops",
        "5. PromptUtils.replace_field_references() - {action.field} substitution",
        "6. PromptUtils.inject_function_outputs_into_prompt() - inject llm_full_context",
        "7. Few-shot samples NOT applied (BUG!)"
      ],
      "bugs_found": [
        "Few-shot sample enrichment missing in batch mode",
        "Different context injection approach (inject_function_outputs vs passing to agent builder)"
      ]
    }
  },

  "proposed_solution": {
    "overview": "Create a unified PromptPreparationService that both modes use for ALL prompt preparation steps",
    "new_file": "agent_actions/prompt_generation/prompt_preparation_service.py",
    "key_principle": "Single point of truth for prompt preparation orchestration - both modes MUST use this service"
  },

  "architecture": {
    "service_class": "PromptPreparationService",
    "main_method": "prepare_prompt_with_context",
    "result_object": "PromptPreparationResult",

    "result_structure": {
      "formatted_prompt": "str - Fully rendered prompt ready for LLM",
      "llm_context": "Dict - Full context for LLM (JSON serialized)",
      "passthrough_fields": "Dict - Fields to merge into output later",
      "metadata": "Dict - Debug info (field_context_keys, include_fields, passthrough_fields)"
    },

    "preparation_steps": [
      "1. Load raw prompt using PromptFormatter",
      "2. Build field context with historical node loading via ContextScopeProcessor.build_field_context_with_history()",
      "3. Apply context_scope transformations via ContextScopeProcessor.apply_context_scope()",
      "4. Build LLM context using mode-specific approach (batch vs realtime)",
      "5. Render prompt with {action.field} substitutions via PromptUtils.replace_field_references()",
      "6. Apply few-shot samples via SampleEnricher.append_few_shot_samples()",
      "7. Return comprehensive result object"
    ],

    "mode_specific_handling": {
      "approach": "Strategy pattern - service accepts mode parameter",
      "modes": ["batch", "realtime"],
      "differences": {
        "llm_context_building": {
          "batch": "Use LLMContextBuilder.build_llm_context_for_batch(row_content, llm_context, context_scope)",
          "realtime": "Use LLMContextBuilder.build_llm_context_for_realtime(processed_context, llm_additional_context, context_scope)"
        },
        "context_injection": {
          "batch": "Inject into prompt via PromptUtils.inject_function_outputs_into_prompt()",
          "realtime": "Pass llm_context separately to agent_builder.create_dynamic_agent()"
        }
      }
    }
  },

