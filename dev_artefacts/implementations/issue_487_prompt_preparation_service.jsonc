  "api_design": {
    "service_signature": `
@dataclass
class PromptPreparationResult:
    """Result of prompt preparation."""
    formatted_prompt: str           # Fully rendered prompt ready for LLM
    llm_context: Dict[str, Any]     # Full context for LLM (JSON serialized)
    passthrough_fields: Dict        # Fields to merge into output
    metadata: Dict                  # Debug info

class PromptPreparationService:
    """Unified prompt preparation for batch and realtime modes."""

    @staticmethod
    def prepare_prompt_with_context(
        agent_config: Dict[str, Any],
        agent_name: str,
        contents: Dict[str, Any],
        *,
        mode: Literal['batch', 'realtime'] = 'realtime',
        agent_indices: Optional[Dict[str, int]] = None,
        dependency_configs: Optional[Dict[str, Dict]] = None,
        source_content: Optional[Any] = None,
        loop_context: Optional[Dict] = None,
        workflow_metadata: Optional[Dict] = None,
        current_item: Optional[Dict] = None,
        file_path: Optional[str] = None,
        tools_path: Optional[str] = None
    ) -> PromptPreparationResult:
        """
        Prepare prompt with all transformations applied.

        This is the SINGLE POINT OF TRUTH for prompt preparation.
        Both batch and realtime modes MUST use this service.
        """
        # Implementation steps 1-7 from architecture.preparation_steps
        ...
`,

    "usage_online_mode": `
# agent_actions/prompt_generation/data_generator.py

from agent_actions.prompt_generation.prompt_preparation_service import (
    PromptPreparationService
)

def create_agent_with_data(self, contents, source_content=None, ...):
    # Prepare prompt using unified service
    prep_result = PromptPreparationService.prepare_prompt_with_context(
        agent_config=self.agent_config,
        agent_name=self.agent_name,
        contents=contents,
        mode='realtime',  # Specify mode
        agent_indices=self.agent_indices,
        dependency_configs=self.dependency_configs,
        source_content=source_content,
        loop_context=loop_context,
        workflow_metadata=workflow_metadata,
        current_item=current_item,
        file_path=file_path
    )

    # Pass to agent builder (simplified - context already prepared)
    response, executed = run_dynamic_agent(
        self.agent_config,
        self.agent_name,
        contents,
        prep_result.formatted_prompt,
        tools_path=self.agent_config.get('tools', {}).get('path'),
        tool_args=self.agent_config.get('tool_args', {}),
        source_content=source_content,
        llm_additional_context=prep_result.llm_context  # Already built!
    )

    return (response, executed, prep_result.passthrough_fields)
`,

    "usage_batch_mode": `
# agent_actions/llm_invocation/batch/batch_service.py

from agent_actions.prompt_generation.prompt_preparation_service import (
    PromptPreparationService
)

def prepare_batch_tasks_from_data(self, agent_config, data, ...):
    prepared_data = []

    for row in data:
        # ... filtering logic ...

        # Prepare prompt using unified service
        prep_result = PromptPreparationService.prepare_prompt_with_context(
            agent_config=agent_config,
            agent_name=agent_config.get('agent_type'),
            contents=row_content,
            mode='batch',  # Specify mode
            agent_indices=self.agent_indices,
            dependency_configs=self.dependency_configs,
            source_content=row_content,
            current_item=self.context_map.get(custom_id),
            file_path=file_path_for_history,
            tools_path=tools_path
        )

        # Store passthrough for later
        if prep_result.passthrough_fields and custom_id in self.context_map:
            self.context_map[custom_id]['_passthrough_fields'] = prep_result.passthrough_fields

        # Create batch task (context and prompt already prepared!)
        prepared_item = {
            'target_id': custom_id,
            'content': prep_result.llm_context,      # Already fully built!
            'prompt': prep_result.formatted_prompt   # Already has few-shot samples!
        }
        prepared_data.append(prepared_item)

    return provider.prepare_tasks(prepared_data, provider_config)
`
