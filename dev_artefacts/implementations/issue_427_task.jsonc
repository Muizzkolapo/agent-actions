{
  "title": "Fix Batch Mode Tests: Mock BatchProviderFactory (Issue #427)",
  "issue": "#427",
  "priority": "high",
  "type": "bugfix",
  "status": "READY TO START",
  "description": "Batch processing tests are calling real OpenAI API instead of using mocks, causing all 13 batch-related tests to fail. Tests need to properly mock BatchProviderFactory to prevent real API calls during testing.",

  "executive_summary": {
    "problem": "Batch tests mock BatchService but not BatchProviderFactory, causing real API calls with fake batch IDs that fail",
    "solution": "Add @patch decorator for BatchProviderFactory.create_provider() to return mock providers that simulate batch API behavior",
    "impact": "Fixes 13 failing batch tests, prevents real API calls during testing, enables reliable CI/CD",
    "implementation": "3 phases: (1) Create mock provider fixtures, (2) Update test decorators, (3) Verify all tests pass",
    "estimated_effort": "2-3 hours",
    "affected_tests": "13 tests (4 batch_loop_correlation, 4 batch_sequential_error, 4 batch_sequential_loop, 1 sequential_loop_parity)"
  },

  "problem_statement": {
    "root_cause": {
      "description": "Tests use partial mocking that doesn't cover the BatchProviderFactory, causing real API clients to be created",
      "execution_flow": [
        "1. Test mocks BatchService class (test_batch_loop_correlation.py:83)",
        "2. Mock configured: check_batch_status.return_value = ('completed', ...) (line 204)",
        "3. Workflow calls _handle_batch_agent() → _get_batch_registry_status()",
        "4. Registry status checker calls check_status(batch_id) for each entry",
        "5. check_status() calls _get_provider_for_batch_id()",
        "6. Provider getter calls BatchProviderFactory.create_provider() ← NOT MOCKED!",
        "7. Real OpenAIBatchProvider created with real API client from env OPENAI_API_KEY",
        "8. Real provider calls client.batches.retrieve(fake_test_batch_id)",
        "9. OpenAI API returns error/failed for non-existent batch ID",
        "10. Test fails with 'Batch job for input failed'"
      ],
      "key_files": {
        "batch_service.py:932": "BatchProviderFactory.create_provider(provider_type) - creates real provider",
        "batch_service.py:941-942": "check_status() calls _get_provider_for_batch_id() which bypasses mock",
        "provider.py:236": "OpenAIBatchProvider.check_status() calls real API client.batches.retrieve()",
        "factory.py:51-52": "OpenAIBatchProvider(api_key=os.getenv('OPENAI_API_KEY')) - gets real key from env"
      }
    },
    "evidence": {
      "test_results": {
        "sequential_loop_tests": "✅ 9/9 passing (no batch API calls)",
        "batch_loop_correlation": "❌ 4/4 failing",
        "batch_sequential_error": "❌ 4/4 failing",
        "batch_sequential_loop": "❌ 4/4 failing",
        "sequential_loop_parity": "❌ 1/3 failing (batch variant)",
        "batch_service_filtering": "✅ 6/6 passing",
        "total_failing": "13 batch tests"
      },
      "error_pattern": "All failures show 'Batch job for input failed' immediately after submission",
      "symptoms": [
        "Tests fail even when mocks are configured",
        "Error occurs during batch status checking, not submission",
        "No output directories created (jobs never processed)",
        "Status stuck in 'pending' or 'batch_submitted'"
      ]
    },
    "why_mock_doesnt_work": {
      "current_mock": "MockBatchService.return_value.check_batch_status.return_value = ...",
      "problem": "Internal methods bypass the mocked instance method",
      "explanation": [
        "Tests mock BatchService instance methods at the public API level",
        "But internal implementation calls _get_batch_registry_status()",
        "Which calls check_status() which calls _get_provider_for_batch_id()",
        "Which directly imports and calls BatchProviderFactory (not on self)",
        "This bypasses the instance mock entirely"
      ]
    }
  },

  "solution_design": {
    "approach": "Add comprehensive mocking at the factory level to intercept provider creation",
    "architecture": {
      "mock_provider_fixture": {
        "purpose": "Create a mock BatchProvider that simulates API behavior without real calls",
        "methods_to_mock": [
          "submit_batch(tasks, batch_name, output_dir) → returns fake_batch_id",
          "check_status(batch_id) → returns 'completed' or configured status",
          "retrieve_results(batch_id, output_dir) → returns mock BatchResult objects"
        ],
        "behavior": "Returns predictable test data without API calls"
      },
      "factory_patch": {
        "target": "agent_actions.integrations.providers.factory.BatchProviderFactory.create_provider",
        "decorator": "@patch('agent_actions.integrations.providers.factory.BatchProviderFactory.create_provider')",
        "return_value": "mock_batch_provider fixture",
        "scope": "Applied to all batch test functions"
      },
      "test_structure": {
        "fixtures": [
          "mock_batch_provider() - returns configured mock provider",
          "batch_registry_data() - provides test registry structures",
          "fake_batch_results() - provides test BatchResult objects"
        ],
        "decorators": [
          "@patch('...BatchProviderFactory.create_provider')",
          "@patch('...BatchService') - keep existing",
          "Other existing patches remain unchanged"
        ]
      }
    },
    "key_decisions": {
      "decision_1": {
        "question": "Where to apply the mock?",
        "options": [
          "Option A: Mock at BatchService level (current approach)",
          "Option B: Mock at BatchProviderFactory level (proposed)",
          "Option C: Mock at OpenAI client level"
        ],
        "chosen": "Option B - Mock at BatchProviderFactory level",
        "rationale": [
          "Intercepts provider creation before real clients instantiated",
          "Works for all provider types (OpenAI, Anthropic, Gemini)",
          "Doesn't require mocking each provider's client library",
          "Single point of control for all batch providers"
        ]
      },
      "decision_2": {
        "question": "Mock implementation strategy?",
        "options": [
          "Option A: Use MagicMock with return_value configuration",
          "Option B: Create a real MockBatchProvider class",
          "Option C: Use side_effect to return provider per call"
        ],
        "chosen": "Option A - MagicMock with return_value",
        "rationale": [
          "Simpler to configure and maintain",
          "Sufficient for test needs",
          "Can use side_effect for dynamic behavior if needed",
          "Follows existing test patterns"
        ]
      },
      "decision_3": {
        "question": "How to handle different batch statuses in tests?",
        "options": [
          "Option A: Mock always returns 'completed'",
          "Option B: Mock returns status based on test parameter",
          "Option C: Use side_effect to return different statuses per call"
        ],
        "chosen": "Option C - side_effect for dynamic status",
        "rationale": [
          "Tests need to simulate in_progress → completed transitions",
          "Allows testing of retry logic and status polling",
          "More realistic test scenarios"
        ]
      }
    }
  },

  "implementation_phases": {
    "phase_1_create_mock_fixtures": {
      "description": "Create reusable mock provider fixtures in conftest.py",
      "tasks": [
        {
          "task": "Create mock_batch_provider fixture",
          "file": "tests/integration/conftest.py",
          "implementation": "pytest fixture that returns MagicMock with configured methods",
          "details": {
            "submit_batch": "Returns 'batch_test_id_001'",
            "check_status": "Returns 'completed' by default, configurable via test parameter",
            "retrieve_results": "Returns list of BatchResult objects with test data"
          }
        },
        {
          "task": "Create status_sequence fixture",
          "file": "tests/integration/conftest.py",
          "implementation": "Fixture that simulates status transitions (validating → in_progress → completed)",
          "details": "Uses itertools.cycle or list to return different statuses on successive calls"
        },
        {
          "task": "Create mock_batch_results fixture",
          "file": "tests/integration/conftest.py",
          "implementation": "Returns sample BatchResult objects that match test expectations",
          "details": "Includes custom_id, content, success=True, metadata matching test scenarios"
        }
      ],
      "estimated_time": "45 minutes",
      "testing": "Run pytest tests/integration/conftest.py to verify fixtures load correctly"
    },

    "phase_2_update_batch_loop_correlation_tests": {
      "description": "Update test_batch_loop_correlation.py to use BatchProviderFactory mock",
      "tasks": [
        {
          "task": "Add BatchProviderFactory patch decorator",
          "file": "tests/integration/test_batch_loop_correlation.py",
          "line": "~80 (before existing patches)",
          "implementation": "@patch('agent_actions.integrations.providers.factory.BatchProviderFactory.create_provider')",
          "details": "Add as first decorator so it's available to all test methods"
        },
        {
          "task": "Update _create_workflow_with_correlation method",
          "file": "tests/integration/test_batch_loop_correlation.py",
          "line": "~72-220",
          "changes": [
            "Add mock_factory parameter to method signature",
            "Configure mock_factory.return_value = mock_batch_provider",
            "Remove or update line 204 (mock_batch_service.check_batch_status) - now redundant"
          ]
        },
        {
          "task": "Update all test methods to pass mock_factory",
          "file": "tests/integration/test_batch_loop_correlation.py",
          "affected_tests": [
            "test_batch_loop_correlation_creation",
            "test_batch_loop_correlation_structure",
            "test_batch_loop_consumer_receives_correlated_data",
            "test_batch_loop_correlation_with_multiple_sources"
          ],
          "changes": "Add mock_factory parameter to test signature and pass to _create_workflow_with_correlation"
        }
      ],
      "estimated_time": "30 minutes",
      "testing": "pytest tests/integration/test_batch_loop_correlation.py -v"
    },

    "phase_3_update_batch_sequential_error_tests": {
      "description": "Update test_batch_sequential_error.py with factory mocking",
      "tasks": [
        {
          "task": "Add BatchProviderFactory patch",
          "file": "tests/integration/test_batch_sequential_error.py",
          "implementation": "Same pattern as phase_2",
          "details": "Add decorator and configure mock to simulate error scenarios"
        },
        {
          "task": "Configure mock for error simulation",
          "file": "tests/integration/test_batch_sequential_error.py",
          "special_handling": "Mock check_status should return 'failed' for error tests",
          "affected_tests": [
            "test_batch_error_stops_sequential_loop",
            "test_batch_error_reported_correctly",
            "test_batch_partial_failure_handling",
            "test_batch_error_recovery"
          ]
        }
      ],
      "estimated_time": "30 minutes",
      "testing": "pytest tests/integration/test_batch_sequential_error.py -v"
    },

    "phase_4_update_batch_sequential_loop_tests": {
      "description": "Update test_batch_sequential_loop.py with factory mocking",
      "tasks": [
        {
          "task": "Add BatchProviderFactory patch",
          "file": "tests/integration/test_batch_sequential_loop.py",
          "implementation": "Same pattern as phase_2"
        },
        {
          "task": "Configure sequential status transitions",
          "file": "tests/integration/test_batch_sequential_loop.py",
          "details": "Mock should simulate multiple loop iterations with different batch IDs",
          "affected_tests": [
            "test_batch_sequential_loop_basic",
            "test_batch_sequential_loop_dependencies",
            "test_batch_sequential_loop_correlation",
            "test_batch_sequential_loop_output_structure"
          ]
        }
      ],
      "estimated_time": "30 minutes",
      "testing": "pytest tests/integration/test_batch_sequential_loop.py -v"
    },

    "phase_5_update_sequential_loop_parity_test": {
      "description": "Fix the batch variant in test_sequential_loop_parity.py",
      "tasks": [
        {
          "task": "Add BatchProviderFactory patch to batch tests",
          "file": "tests/integration/test_sequential_loop_parity.py",
          "implementation": "Add patch decorator to test_batch_sequential_loop_parity",
          "note": "This test compares online vs batch mode, so only batch variant needs fix"
        }
      ],
      "estimated_time": "15 minutes",
      "testing": "pytest tests/integration/test_sequential_loop_parity.py -v"
    },

    "phase_6_verification": {
      "description": "Run all tests and verify no real API calls",
      "tasks": [
        {
          "task": "Run all batch tests",
          "command": "pytest tests/integration/ -k batch -v",
          "expected": "All 13 previously failing tests now pass"
        },
        {
          "task": "Verify no real API calls",
          "method": "Check test output for OpenAI API calls, check network traffic",
          "tools": "pytest --log-cli-level=DEBUG or network monitoring"
        },
        {
          "task": "Run full test suite",
          "command": "pytest tests/ -v",
          "expected": "All tests pass (including 93 existing + new ones)"
        },
        {
          "task": "Update test documentation",
          "file": "tests/integration/README.md or test docstrings",
          "content": "Document that tests use mocked providers and don't require API keys"
        }
      ],
      "estimated_time": "30 minutes",
      "success_criteria": [
        "✅ All 13 batch tests pass",
        "✅ No real API calls made during tests",
        "✅ Tests run without OPENAI_API_KEY env var",
        "✅ All other tests still pass"
      ]
    }
  },

