    "mock_implementation_example": {
      "conftest.py": "# Fixture example\n@pytest.fixture\ndef mock_batch_provider():\n    mock_provider = MagicMock(spec=BatchProvider)\n    mock_provider.submit_batch.return_value = 'batch_test_id_001'\n    mock_provider.check_status.return_value = 'completed'\n    mock_provider.retrieve_results.return_value = [\n        BatchResult(\n            custom_id='1',\n            content={'result': 'test_data'},\n            success=True,\n            metadata={'test': True}\n        )\n    ]\n    return mock_provider",

      "test_usage": "# Test usage example\n@patch('agent_actions.integrations.providers.factory.BatchProviderFactory.create_provider')\ndef test_batch_operation(mock_factory, mock_batch_provider):\n    mock_factory.return_value = mock_batch_provider\n    # ... rest of test\n    # mock_batch_provider methods called instead of real API",

      "dynamic_status": "# Dynamic status example\ndef mock_batch_provider_with_transitions():\n    mock = MagicMock(spec=BatchProvider)\n    statuses = iter(['validating', 'in_progress', 'in_progress', 'completed'])\n    mock.check_status.side_effect = lambda batch_id: next(statuses)\n    return mock"
    },

