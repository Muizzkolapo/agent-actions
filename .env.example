# Agent Actions Environment Configuration
# Copy this file to .env and fill in your actual values

# ===========================================
# API Keys for LLM Providers
# ===========================================
# OpenAI API Key (required for OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (required for Claude models)
CLAUDE_API_KEY=your_claude_api_key_here
# Alternative name used in some parts of the codebase
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google API Key (required for Gemini models)
GOOGLE_API_KEY=your_google_api_key_here

# ===========================================
# Application Environment
# ===========================================
# Environment setting (development, staging, production)
AGENT_ACTIONS_ENV=development

# ===========================================
# Optional Configuration
# ===========================================
# Default timeout for API requests (seconds)
DEFAULT_API_TIMEOUT=120

# Maximum retries for API requests
DEFAULT_MAX_RETRIES=3

# Enable debug logging (true/false)
DEBUG_LOGGING=false

# Cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL=300

# ===========================================
# Database Configuration (if applicable)
# ===========================================
# DATABASE_URL=postgresql://user:password@localhost:5432/agent_actions

# ===========================================
# Performance Settings
# ===========================================
# Default batch size for processing
DEFAULT_BATCH_SIZE=100

# Enable parallel processing (true/false)
ENABLE_PARALLEL_PROCESSING=true

# Maximum number of concurrent operations
MAX_CONCURRENCY=10