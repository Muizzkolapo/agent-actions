{% macro quiz_workflow(
    agent_type,
    model_vendor,
    model_name,
    dependencies,
    api_key,
    schema_name,
    prompt,
    few_shot=0,
    prompt_debug=False,
    is_operational=True,
    side_collection=[],
    json_mode=True,
    granularity="Record",
    run_mode="online",
    tokenizer_model="o200k_base",
    split_method="tiktoken",
    remove_collection=[],
    schema=None,
    where_clause=None
) -%}
    agent_type: {{ agent_type }}
    dependencies: {{ dependencies }}
    api_key: {{ api_key }}
    model_vendor: {{ model_vendor }}
    model_name: {{ model_name }}
    {%- if schema is not none %}
    schema: {{ schema }}
    {%- else %}
    schema_name: {{ schema_name }}
    {%- endif %}
    few_shot: {{ few_shot }}
    is_operational: {{ is_operational }}
    side_collection: {{ side_collection }}
    json_mode: {{ json_mode }}
    run_mode: {{ run_mode }}
    granularity: {{ granularity }}
    remove_collection: {{ remove_collection }}
    {%- if where_clause is not none %}
    where_clause:
      {%- if where_clause is mapping %}
      clause: >-
        {{ where_clause.get('clause', '') }}
      scope: {{ where_clause.get('scope', 'item') }}
      {%- else %}
      clause: >-
        {{ where_clause }}
      scope: item
      {%- endif %}
    {%- endif %}
    prompt: {{ prompt }}
    tokenizer_model: {{ tokenizer_model }}
    split_method: {{ split_method }}
    prompt_debug: {{ prompt_debug }}
{%- endmacro %}






