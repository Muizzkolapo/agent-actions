{% macro quiz_workflow_loop(
    agent_type,
    model_vendor,
    model_name,
    dependencies,
    api_key,
    prompts,
    schema_name,
    few_shot=0,
    prompt_debug=False,
    is_operational=True,
    side_collection=[],
    json_mode=True,
    granularity="Record",
    remove_collection=[]
) -%}
    {# Create a namespace to store the previous prompt #}
    {% set ns = namespace(previous_prompt=None) %}
    {%- for prompt in prompts -%}
        {% set current_agent_type = prompt.split('.')[-1] %}
        
        {{ quiz_workflow(
            agent_type=current_agent_type,
            model_vendor=model_vendor,
            model_name=model_name,
            dependencies=ns.previous_prompt is not none and [ns.previous_prompt] or [],
            api_key=api_key,
            schema_name=schema_name,
            prompt=prompt,
            few_shot=few_shot,
            prompt_debug=prompt_debug,
            is_operational=is_operational,
            side_collection=side_collection,
            json_mode=json_mode,
            granularity=granularity,
            remove_collection=remove_collection
        ) }}
        
        {# Update the namespace variable for the next iteration #}
        {% set ns.previous_prompt = prompt.split('.')[-1] %}
    {% endfor %}
{%- endmacro %}





